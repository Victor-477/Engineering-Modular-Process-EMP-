// ============================================================
//  plugins.cryo — módulos EXTERNOS, carregados em tempo de execução
//
//  A linguagem não carrega código dinamicamente (não há dlopen nem
//  "load .pyro" — L-06). Um plugin é, portanto, OUTRO PROCESSO: um
//  executável Cryo que fala HTTP em localhost. Para instalá-lo basta
//  copiar o .exe e um manifesto `plugins/<id>.plugin`; o núcleo não
//  é recompilado.
//
//  O manifesto é chave=valor por linha (não JSON: um manifesto
//  malformado não pode derrubar o servidor — L-05):
//
//      id=qualidade
//      nome=Qualidade e Não Conformidades
//      versao=1.0.0
//      prefixo=/api/qualidade
//      url=http://127.0.0.1:8091
//      assina=producao.apontada,op.concluida
//      perfis_escrita=admin,qualidade
//
//  Protocolo (o plugin implementa três rotas):
//    GET  <url>/saude   -> "ok"
//    POST <url>/req     corpo: metodo=&rota=&query=&corpo=&usuario=&perfil=
//                       resposta: "<status>|<content-type>\n<corpo>"
//    POST <url>/evento  corpo: id=&tipo=&origem=&dados=&ts=
//
//  Eventos do plugin: a resposta do /req pode trazer, entre o cabeçalho
//  e o corpo, linhas "@evento <tipo>|<dados>". O núcleo as publica no
//  barramento (origem = id do plugin), entregues depois da resposta como
//  as de qualquer módulo. É o ÚNICO jeito de um plugin avisar o ERP de um
//  fato: ele não pode chamar a API do EMP no meio de um /req, porque o
//  servidor atende uma requisição por vez e está esperando justamente
//  esse /req — a chamada de volta só termina no tempo-limite (o
//  recebimento de compra fazia isso e perdia a entrada no estoque). Por
//  segurança o tipo precisa começar com "<id>.": um plugin não publica
//  maquina.parada nem producao.apontada; os demais são descartados.
//
//  O descritor do plugin é um k::Modulo comum cujas funções são
//  CLOSURES que capturam a URL — para o registro, um plugin é
//  indistinguível de um módulo interno.
// ============================================================

import "contrato.cryo" as k;
import "form.cryo"     as form;
import "eventos.cryo"  as ev;

// A resposta de um /req já separada: o que vai ao cliente e os eventos
// que o plugin pediu para publicar ("tipo|dados", já filtrados).
pub struct RespostaPlugin {
    k::Resposta resposta;
    string[] eventos;
    int recusados;
}

// Lê "<status>|<tipo>\n[@evento tipo|dados\n]*<corpo>". Puro, testável.
// Status 0 quando falta o cabeçalho.
pub fn ler_resposta(string id, string bruto) -> RespostaPlugin ={
    string[] nenhum = [];
    k::Resposta ruim = k::Resposta { status: 0, tipo: "", corpo: "" };
    int nl = find(bruto, "\n");
    if (nl <= 0) { return RespostaPlugin { resposta: ruim, eventos: nenhum, recusados: 0 }; }
    string cab = bruto[0..nl];
    int bar = find(cab, "|");
    if (bar <= 0) { return RespostaPlugin { resposta: ruim, eventos: nenhum, recusados: 0 }; }
    string resto = bruto[nl + 1..];
    string[] eventos = [];
    int recusados = 0;
    while (starts_with(resto, "@evento ")) {
        int fim = find(resto, "\n");
        string linha = resto;
        if (fim >= 0) {
            linha = resto[0..fim];
            resto = resto[fim + 1..];
        } else {
            resto = "";
        }
        string ev_txt = trim(linha[8..]);
        int sep = find(ev_txt, "|");
        string tipo = ev_txt;
        if (sep >= 0) { tipo = ev_txt[0..sep]; }
        if (len(id) > 0 && starts_with(tipo, id + ".") && len(tipo) > len(id) + 1) {
            eventos = concat(eventos, [ev_txt]);
        } else {
            recusados = recusados + 1;
        }
    }
    return RespostaPlugin {
        resposta: k::Resposta { status: parse_int(cab[0..bar]) ?? 502, tipo: cab[bar + 1..], corpo: resto },
        eventos: eventos, recusados: recusados
    };
}

fn _lista(string s) -> string[] ={
    string[] out = [];
    for (string p in split(s, ",")) {
        if (len(trim(p)) > 0) { out = concat(out, [trim(p)]); }
    }
    return out;
}

fn _ler_manifesto(string texto) -> map<string,string> ={
    map<string,string> m = {};
    for (string linha in split(replace(texto, "\r", ""), "\n")) {
        string l = trim(linha);
        int eq = find(l, "=");
        if (eq > 0 && !starts_with(l, "#")) {
            m[trim(l[0..eq])] = trim(l[eq + 1..]);
        }
    }
    return m;
}

// ── disjuntor (circuit breaker) ───────────────────────────
// O servidor atende uma requisição por vez (L-09): um plugin fora do
// ar custa ~2 s POR CHAMADA a todo o ERP. Após 3 falhas seguidas o
// plugin fica "aberto" por 30 s e as chamadas falham na hora.
map<string,int> _falhas = {};
map<string,int> _aberto_ate = {};

fn _disponivel(string url) -> bool ={
    if (has(_aberto_ate, url) && now_ms() < _aberto_ate[url]) { return false; }
    return true;
}

fn _resultado(string url, bool ok) ={
    if (ok) {
        _falhas[url] = 0;
        return;
    }
    int n = 1;
    if (has(_falhas, url)) { n = _falhas[url] + 1; }
    _falhas[url] = n;
    if (n >= 3) {
        _aberto_ate[url] = now_ms() + 30000;
        _falhas[url] = 0;
    }
}

fn _saude(string url) -> bool ={
    return trim(http_get(url + "/saude")) == "ok";
}

fn _proxy(string id, string url, k::Requisicao r) -> k::Resposta ={
    string env = "metodo=" + url_encode(r.metodo)
        + "&rota=" + url_encode(r.rota)
        + "&query=" + url_encode(r.query)
        + "&corpo=" + url_encode(r.corpo)
        + "&usuario=" + url_encode(r.usuario)
        + "&perfil=" + url_encode(r.perfil);
    if (!_disponivel(url)) {
        return k::erro(503, "plugin em " + url + " suspenso após falhas repetidas");
    }
    string bruto = http_post(url + "/req", env);
    int nl = find(bruto, "\n");
    _resultado(url, nl > 0);
    if (nl <= 0) {
        return k::erro(502, "plugin em " + url + " não respondeu");
    }
    RespostaPlugin rp = ler_resposta(id, bruto);
    if (rp.resposta.status == 0) { return k::erro(502, "resposta de plugin malformada"); }
    for (string e in rp.eventos) {
        int sep = find(e, "|");
        if (sep < 0) { ev::publicar(e, id, ""); } else { ev::publicar(e[0..sep], id, e[sep + 1..]); }
    }
    if (rp.recusados > 0) {
        print("  [plugin " + id + "] " + to_string(rp.recusados)
            + " evento(s) recusado(s): o tipo precisa começar com " + id + ".");
    }
    return rp.resposta;
}

fn _evento(string url, k::Evento e) -> bool ={
    string corpo = "id=" + to_string(e.id) + "&tipo=" + url_encode(e.tipo)
        + "&origem=" + url_encode(e.origem) + "&dados=" + url_encode(e.dados)
        + "&ts=" + to_string(e.ts);
    if (!_disponivel(url)) { return false; }    // evento perdido: ver L-10
    bool ok = len(http_post(url + "/evento", corpo)) > 0;
    _resultado(url, ok);
    return ok;
}

fn _fabricar(map<string,string> m) -> k::Modulo ={
    string url = m["url"];
    return k::Modulo {
        id: m["id"],
        nome: form::campo_ou(m, "nome", m["id"]),
        versao: form::campo_ou(m, "versao", "0.0.0"),
        contrato: parse_int(form::campo_ou(m, "contrato", "1")) ?? 1,
        prefixo: m["prefixo"],
        depende: _lista(form::campo(m, "depende")),
        assina: _lista(form::campo(m, "assina")),
        perfis_escrita: _lista(form::campo_ou(m, "perfis_escrita", "admin")),
        iniciar: (string dir) => _saude(url),
        rotear: (k::Requisicao r) => _proxy(m["id"], url, r),
        ao_evento: (k::Evento e) => _evento(url, e)
    };
}

pub fn descobrir(string dir) -> k::Modulo[] ={
    k::Modulo[] achados = [];
    if (!is_dir(dir)) { return achados; }
    for (string nome in list_dir(dir)) {
        if (!ends_with(nome, ".plugin")) { continue; }
        map<string,string> m = _ler_manifesto(read_file(dir + "/" + nome));
        if (!has(m, "id") || !has(m, "prefixo") || !has(m, "url")) {
            print("  [plugin ignorado] " + nome + ": precisa de id, prefixo e url");
            continue;
        }
        if (!starts_with(m["prefixo"], "/api/")) {
            print("  [plugin ignorado] " + nome + ": prefixo deve começar com /api/");
            continue;
        }
        achados = concat(achados, [_fabricar(m)]);
    }
    return achados;
}
