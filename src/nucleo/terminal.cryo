// ============================================================
//  terminal.cryo — terminal do operador, servido em GET /terminal
//
//  Uma página por posto (/terminal#PRENSA-01), para o tablet ao lado
//  da máquina: uma instrução por vez, botões grandes, atualização a
//  cada 1 s. Inspirado no padrão de terminais manuais do MES4
//  (docs/ANALISE_FACTORYVIEWS.md, seção 5), no visual Forja
//  (docs/DESIGN_SYSTEM.md) — os tokens vêm de painel::tokens_css().
//
//  A página não exige autenticação; a API sim. O token fica em
//  localStorage (emp_token), o mesmo do painel; o operador também
//  (emp_operador).
//
//  Ao editar: aspas viram \", barras invertidas \\ e `${` vira
//  \${ (senão é interpolação Cryo).
// ============================================================

import "painel.cryo" as painel;

fn _linhas() -> string[] ={
    return [
        "<!doctype html>",
        "<html lang=\"pt-br\">",
        "<head>",
        "<meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">",
        "<title>EMP · Terminal do operador</title>",
        "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">",
        "<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap\" rel=\"stylesheet\">",
        "<style>",
        painel::tokens_css(),
        "*{box-sizing:border-box}",
        "html,body{height:100%}",
        "body{margin:0;font-family:var(--f-body);font-size:18px;line-height:1.45;color:var(--ink);background:var(--bg);background-image:radial-gradient(var(--dot) 1px,transparent 1.2px);background-size:22px 22px;-webkit-font-smoothing:antialiased;display:flex;flex-direction:column;-webkit-tap-highlight-color:transparent}",
        "svg{display:block}",
        "a{color:var(--forja-ink)}",
        ":focus-visible{outline:3px solid var(--forja);outline-offset:3px}",
        ".oculto{display:none!important}",
        ".mono{font-family:var(--f-mono)}",
        "/* ── barra do posto (console) ───────────────────────────── */",
        ".barra{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin:12px 12px 0;padding:12px 14px 12px 18px;border-radius:var(--r-xl);background:var(--console);color:var(--console-ink);box-shadow:var(--sh-2);overflow:hidden}",
        ".barra::before{content:\"\";position:absolute;inset:auto -60px -120px auto;width:260px;height:260px;background:radial-gradient(circle,rgba(255,90,31,.25),transparent 65%);pointer-events:none}",
        ".marca{display:flex;align-items:center;gap:12px;text-decoration:none;color:inherit}",
        ".marca svg{width:40px;height:40px;flex:none}",
        ".marca b{display:block;font-family:var(--f-display);font-size:22px;color:#fff;line-height:1}",
        ".marca small{display:block;font-family:var(--f-mono);font-size:10px;letter-spacing:1.4px;color:#8a909b;margin-top:5px}",
        ".posto-atual{display:flex;flex-direction:column;padding-left:18px;border-left:1px solid #2f333c}",
        ".posto-atual small,.quem small{font-family:var(--f-mono);font-size:10px;letter-spacing:1.4px;color:#8a909b}",
        ".posto-atual b{font-family:var(--f-display);font-size:30px;color:#fff;line-height:1.05;letter-spacing:-.4px}",
        ".barra .dir{margin-left:auto;display:flex;align-items:center;gap:10px;flex-wrap:wrap}",
        ".quem{display:flex;flex-direction:column;align-items:flex-end;background:none;border:0;color:#fff;box-shadow:none;height:auto;padding:4px 8px;font-weight:600;font-size:16px;min-height:48px;justify-content:center}",
        ".quem:hover{transform:none;box-shadow:none;background:var(--console-2)}",
        ".selo{display:inline-flex;align-items:center;gap:9px;min-height:48px;padding:0 16px;border-radius:99px;background:var(--console-2);font-family:var(--f-mono);font-size:14px;color:#d7d9de}",
        ".selo::before{content:\"\";width:10px;height:10px;border-radius:50%;background:var(--ok);flex:none}",
        ".selo.vivo::before{animation:pulso-selo .9s var(--ease)}",
        ".selo.sem{background:var(--bad-strong);color:#fff}",
        ".selo.sem::before{background:#fff}",
        ".redondo{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:var(--console-2);border:1px solid #2f333c;color:#fff;cursor:pointer;padding:0;box-shadow:none}",
        ".redondo svg{width:22px;height:22px;fill:currentColor}",
        ".redondo:hover{color:var(--forja-2);transform:none;box-shadow:none}",
        "/* ── configuração (operador, token) ─────────────────────── */",
        ".cfg{margin:10px 12px 0;padding:16px 18px;border-radius:var(--r-lg);background:var(--surface);border:1px solid var(--line);box-shadow:var(--sh-1);display:flex;flex-wrap:wrap;gap:14px;align-items:end}",
        "label{display:flex;flex-direction:column;gap:6px;font-size:14px;font-weight:600;color:var(--ink-2)}",
        "input,select,textarea,button{font:inherit}",
        "input,select,textarea{min-height:52px;padding:0 14px;border:1px solid var(--line);border-radius:14px;background:var(--surface-2);color:var(--ink);min-width:0;font-size:18px}",
        "textarea{padding:12px 14px;resize:vertical}",
        "input:focus,select:focus,textarea:focus{outline:0;border-color:var(--forja);box-shadow:0 0 0 4px var(--forja-soft);background:var(--surface)}",
        "/* ── botões grandes ─────────────────────────────────────── */",
        "button{min-height:52px;padding:0 22px;border:0;border-radius:16px;background:linear-gradient(135deg,var(--forja),var(--forja-2));color:var(--on-forja);font-weight:700;font-size:18px;cursor:pointer;box-shadow:0 6px 16px rgba(255,90,31,.25);transition:transform .15s var(--ease),box-shadow .15s,opacity .15s;touch-action:manipulation}",
        "button:hover{transform:translateY(-1px);box-shadow:var(--glow)}",
        "button:active{transform:scale(.98)}",
        "button:disabled{opacity:.45;cursor:not-allowed;transform:none;box-shadow:none}",
        "button.sec{background:var(--surface);color:var(--ink);box-shadow:none;border:2px solid var(--line)}",
        "button.ok{background:var(--ink);color:var(--surface);box-shadow:none}",
        "button.bad{background:var(--bad-strong);color:#fff;box-shadow:0 6px 16px rgba(229,56,59,.25)}",
        "button.bad-l{background:var(--surface);color:var(--bad-ink);border:2px solid var(--bad);box-shadow:none}",
        ".grande{min-height:84px;font-size:24px;border-radius:20px;display:flex;align-items:center;justify-content:center;gap:12px;padding:0 26px}",
        ".grande svg{width:30px;height:30px;fill:currentColor;flex:none}",
        "/* ── telas ──────────────────────────────────────────────── */",
        "main{flex:1;padding:16px 12px 24px;min-height:0}",
        ".titulo-pg{font-family:var(--f-display);font-size:40px;font-weight:700;letter-spacing:-.8px;margin:18px 6px 4px}",
        ".sub-pg{color:var(--ink-2);margin:0 6px 22px;font-size:18px}",
        ".trilha{font-family:var(--f-mono);font-size:12px;letter-spacing:1.4px;color:var(--muted);text-transform:uppercase;margin:12px 6px 0}",
        ".grade-postos{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}",
        ".cartao-posto{position:relative;display:flex;flex-direction:column;gap:8px;min-height:150px;padding:22px;border-radius:var(--r-lg);background:var(--surface);border:1px solid var(--line);border-left:6px solid var(--ok);box-shadow:var(--sh-1);text-decoration:none;color:var(--ink);overflow:hidden;transition:transform .2s var(--ease),box-shadow .2s var(--ease)}",
        ".cartao-posto:hover{transform:translateY(-3px);box-shadow:var(--sh-2)}",
        ".cartao-posto b{font-family:var(--f-display);font-size:30px;letter-spacing:-.5px;line-height:1.05}",
        ".cartao-posto span.d{color:var(--ink-2);font-size:16px}",
        ".cartao-posto .ir{margin-top:auto;font-family:var(--f-mono);font-size:13px;letter-spacing:1px;color:var(--forja-ink);font-weight:600}",
        ".cartao-posto.PARADO{border-left-color:var(--bad)}",
        ".cartao-posto.PARADO::before{content:\"\";position:absolute;left:0;right:0;top:0;height:6px;background:repeating-linear-gradient(-45deg,var(--bad) 0 8px,#ffd400 8px 16px)}",
        ".palco{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:16px;align-items:start}",
        ".cartao{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-xl);box-shadow:var(--sh-1);min-width:0}",
        "/* ── instrução: uma por vez ─────────────────────────────── */",
        ".instrucao{position:relative;padding:26px 30px 30px;border-left:8px solid var(--line);overflow:hidden}",
        ".instrucao.e-wait{border-left-color:var(--info)}",
        ".instrucao.e-act{border-left-color:var(--forja)}",
        ".instrucao.e-ok{border-left-color:var(--ok)}",
        ".instrucao.e-bad{border-left-color:var(--bad)}",
        ".instrucao.pisca{animation:pisca 1.1s var(--ease) 1}",
        ".i-topo{display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px;font-size:16px;color:var(--ink-2)}",
        ".i-topo .id{font-size:16px}",
        ".i-topo .etapa{font-family:var(--f-mono);font-size:14px;letter-spacing:1px;text-transform:uppercase;color:var(--muted)}",
        ".i-topo .tag{margin-left:auto}",
        ".i-titulo{font-family:var(--f-display);font-size:60px;font-weight:700;line-height:1.02;letter-spacing:-1.4px;margin:18px 0 10px}",
        ".i-frase{font-size:26px;line-height:1.35;color:var(--ink);margin:0 0 22px;max-width:36ch}",
        ".i-frase.vaz{color:var(--muted)}",
        ".i-nums{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:14px}",
        ".i-nums div{padding:14px 16px;border-radius:var(--r-md);background:var(--surface-2);border:1px solid var(--line)}",
        ".i-nums small{display:block;font-family:var(--f-mono);font-size:12px;letter-spacing:1.3px;color:var(--muted)}",
        ".i-nums b{display:block;font-family:var(--f-display);font-size:44px;font-weight:700;line-height:1.05;letter-spacing:-1px;font-variant-numeric:tabular-nums}",
        ".i-nums .neg b{color:var(--bad-ink)}",
        ".led{display:flex;gap:4px;align-items:center;margin-bottom:24px}",
        ".led i{flex:1;height:12px;border-radius:4px;background:var(--line)}",
        ".led i.on{background:var(--forja)}",
        ".led.cheio i.on{background:var(--ok)}",
        ".led span{font-family:var(--f-mono);font-size:15px;color:var(--muted);margin-left:10px;min-width:48px;text-align:right}",
        ".i-acoes{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}",
        ".i-acoes .tudo{grid-column:1/-1}",
        ".i-acoes .menor{min-height:64px;font-size:19px}",
        ".campos{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;margin-bottom:16px}",
        ".campo-n{display:flex;flex-direction:column;gap:8px}",
        ".campo-n>span{font-family:var(--f-mono);font-size:13px;letter-spacing:1.3px;color:var(--muted);text-transform:uppercase}",
        ".passo{display:grid;grid-template-columns:72px minmax(0,1fr) 72px;gap:8px}",
        ".passo button{min-height:84px;font-size:34px;padding:0;border-radius:18px}",
        ".passo input{min-height:84px;font-family:var(--f-display);font-size:44px;font-weight:700;text-align:center;font-variant-numeric:tabular-nums;border-radius:18px}",
        ".medida input{min-height:64px;font-size:28px;font-family:var(--f-display);font-weight:600}",
        ".medida small{font-family:var(--f-mono);font-size:13px;color:var(--muted)}",
        ".medida.dentro input{border-color:var(--ok);box-shadow:0 0 0 3px var(--ok-soft)}",
        ".medida.fora input{border-color:var(--bad);box-shadow:0 0 0 3px var(--bad-soft)}",
        ".medida .res{font-size:14px;font-weight:700}",
        ".medida.dentro .res{color:var(--ok-ink)}",
        ".medida.fora .res{color:var(--bad-ink)}",
        ".motivos{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 14px}",
        ".motivos button{min-height:52px;font-size:16px;font-weight:600}",
        ".falhou{padding:16px 18px;border-radius:var(--r-md);margin-bottom:18px;font-size:20px;color:var(--bad-ink);background:repeating-linear-gradient(-45deg,var(--bad-soft) 0 10px,var(--surface) 10px 14px);box-shadow:inset 0 0 0 2px var(--bad-soft)}",
        ".bloqueio{margin-top:14px;font-size:16px;color:var(--bad-ink);font-weight:600}",
        "/* ── nenhuma tarefa ─────────────────────────────────────── */",
        ".nada{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:440px;padding:40px 24px;border-left-color:var(--line)}",
        ".nada .ico{width:96px;height:96px;border-radius:30px;display:grid;place-items:center;background:var(--ok-soft);color:var(--ok-ink);margin-bottom:22px}",
        ".nada .ico svg{width:52px;height:52px;fill:currentColor}",
        ".nada h1{font-family:var(--f-display);font-size:52px;margin:0 0 8px;letter-spacing:-1px}",
        ".nada p{font-size:22px;color:var(--ink-2);margin:0;max-width:30ch}",
        "/* ── posto parado ───────────────────────────────────────── */",
        ".parada{position:relative;display:flex;align-items:center;gap:20px;margin-bottom:16px;padding:26px 26px 22px;border-radius:var(--r-xl);background:var(--console);color:#fff;box-shadow:var(--sh-2);overflow:hidden}",
        ".parada::before{content:\"\";position:absolute;left:0;right:0;top:0;height:12px;background:repeating-linear-gradient(-45deg,var(--bad) 0 14px,#ffd400 14px 28px)}",
        ".parada .ico{width:72px;height:72px;border-radius:22px;display:grid;place-items:center;background:var(--bad-strong);flex:none}",
        ".parada .ico svg{width:40px;height:40px;fill:#fff}",
        ".parada b{display:block;font-family:var(--f-display);font-size:40px;letter-spacing:-.6px;line-height:1.05}",
        ".parada span{display:block;font-size:20px;color:#e6e8ec;margin-top:6px}",
        ".parada small{font-family:var(--f-mono);font-size:13px;letter-spacing:1.3px;color:#ffb98f}",
        "/* ── fila do posto ──────────────────────────────────────── */",
        ".fila{padding:20px}",
        ".fila h2{font-family:var(--f-display);font-size:22px;font-weight:600;margin:0 0 14px;display:flex;align-items:center;gap:10px}",
        ".fila h2 .cont{margin-left:auto;font-family:var(--f-mono);font-size:13px;font-weight:500;color:var(--muted);background:var(--surface-2);border:1px solid var(--line);padding:3px 12px;border-radius:99px}",
        ".tarefa{display:grid;grid-template-columns:1fr auto;gap:4px 10px;align-items:center;width:100%;min-height:76px;padding:12px 14px;margin-bottom:10px;border-radius:var(--r-md);background:var(--surface-2);border:1px solid var(--line);border-left:6px solid var(--line);color:var(--ink);text-align:left;font-weight:400;font-size:16px;box-shadow:none}",
        ".tarefa:hover{transform:none;box-shadow:none;border-color:var(--forja-soft)}",
        ".tarefa.e-wait{border-left-color:var(--info)}",
        ".tarefa.e-act{border-left-color:var(--forja)}",
        ".tarefa.e-bad{border-left-color:var(--bad)}",
        ".tarefa.sel{background:var(--surface);border-color:var(--forja);border-left-color:var(--forja);box-shadow:0 0 0 3px var(--forja-soft)}",
        ".tarefa b{font-family:var(--f-display);font-size:19px;font-weight:600}",
        ".tarefa small{grid-column:1/-1;color:var(--muted);font-size:14px}",
        ".fila .vazio{color:var(--muted);text-align:center;padding:26px 0;font-size:17px}",
        "/* ── estados: ícone + cor ───────────────────────────────── */",
        ".id{font-family:var(--f-mono);font-size:13px;font-weight:600;padding:3px 9px;border-radius:9px;background:var(--surface-2);border:1px solid var(--line);white-space:nowrap}",
        ".tag{display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 14px;border-radius:99px;font-size:15px;font-weight:700;white-space:nowrap;background:var(--neutral-soft);color:var(--ink-2)}",
        ".tag svg{width:17px;height:17px;fill:currentColor;flex:none}",
        ".st-ok{background:var(--ok-soft);color:var(--ok-ink)}",
        ".st-wait{background:var(--info-soft);color:var(--info-ink)}",
        ".st-act{background:var(--forja-soft);color:var(--forja-ink)}",
        ".st-act svg{animation:vivo 1.6s infinite}",
        ".st-bad{color:var(--bad-ink);background:repeating-linear-gradient(-45deg,var(--bad-soft) 0 7px,var(--surface) 7px 10px);box-shadow:inset 0 0 0 1px var(--bad-soft)}",
        ".barra .tag{background:var(--console-2);color:#fff}",
        ".barra .tag.st-bad{background:var(--bad-strong);box-shadow:none}",
        ".barra .tag.st-ok svg{color:var(--ok)}",
        "/* ── mensagem ───────────────────────────────────────────── */",
        ".msg{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:20;display:flex;align-items:center;gap:14px;max-width:min(680px,calc(100vw - 24px));padding:18px 26px;border-radius:22px;background:var(--console);color:#fff;font-size:20px;font-weight:600;box-shadow:var(--sh-2);animation:entra .25s var(--ease)}",
        ".msg::before{content:\"\";width:14px;height:14px;border-radius:50%;background:var(--ok);flex:none}",
        ".msg.erro::before{background:var(--bad)}",
        ".msg.aviso::before{background:var(--warn)}",
        "@keyframes pulso-selo{0%{box-shadow:0 0 0 0 rgba(15,159,110,.7)}100%{box-shadow:0 0 0 12px rgba(15,159,110,0)}}",
        "@keyframes vivo{50%{opacity:.35}}",
        "@keyframes pisca{0%,100%{background:var(--surface)}35%{background:var(--bad-soft)}}",
        "@keyframes entra{from{opacity:0;transform:translate(-50%,8px)}to{opacity:1;transform:translate(-50%,0)}}",
        "@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}",
        "@media (max-width:1100px){.palco{grid-template-columns:1fr}.i-titulo{font-size:50px}}",
        "@media (max-width:700px){.posto-atual{border:0;padding:0}.posto-atual b{font-size:24px}.marca small{display:none}.i-titulo{font-size:40px}.i-frase{font-size:21px}.i-nums{grid-template-columns:repeat(2,minmax(0,1fr))}.i-nums b{font-size:34px}.instrucao{padding:20px}.titulo-pg{font-size:32px}.parada b{font-size:30px}}",
        "</style>",
        "</head>",
        "<body>",
        "<header class=\"barra\">",
        "<a class=\"marca\" href=\"#\" title=\"Trocar de posto\"><svg viewBox=\"0 0 40 40\" aria-hidden=\"true\"><defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#ff5a1f\"/><stop offset=\"1\" stop-color=\"#ff9a3d\"/></linearGradient></defs><rect x=\"2\" y=\"2\" width=\"36\" height=\"36\" rx=\"11\" fill=\"url(#g)\"/><rect x=\"10\" y=\"10\" width=\"20\" height=\"5\" rx=\"2.5\" fill=\"#fff\"/><rect x=\"10\" y=\"17.5\" width=\"13\" height=\"5\" rx=\"2.5\" fill=\"#fff\" opacity=\".85\"/><rect x=\"10\" y=\"25\" width=\"20\" height=\"5\" rx=\"2.5\" fill=\"#fff\"/><circle cx=\"28\" cy=\"20\" r=\"2.5\" fill=\"#fff\" opacity=\".85\"/></svg><div><b>EMP</b><small>TERMINAL DO OPERADOR</small></div></a>",
        "<div class=\"posto-atual oculto\" id=\"b-posto\"><small>POSTO</small><b id=\"t-posto\">—</b></div>",
        "<span id=\"t-estado\"></span>",
        "<div class=\"dir\">",
        "<span class=\"selo\" id=\"selo\">conectando…</span>",
        "<button class=\"quem\" id=\"btn-quem\" aria-label=\"Operador e acesso\"><small>OPERADOR</small><span id=\"t-operador\">—</span></button>",
        "<button class=\"redondo\" id=\"btn-cfg\" title=\"Operador, token e posto\" aria-label=\"Operador, token e posto\"><svg viewBox=\"0 0 24 24\"><path d=\"M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.48.48 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.48.48 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z\"/></svg></button>",
        "</div>",
        "</header>",
        "<form class=\"cfg oculto\" id=\"cfg\">",
        "<label>Operador<input id=\"c-operador\" autocomplete=\"off\" placeholder=\"seu nome ou matrícula\" size=\"18\"></label>",
        "<label>Token de acesso<input id=\"c-token\" type=\"password\" autocomplete=\"off\" placeholder=\"token\" size=\"18\"></label>",
        "<button>Salvar</button>",
        "<button type=\"button\" class=\"sec\" id=\"c-trocar\">Trocar de posto</button>",
        "<a href=\"/\" style=\"margin-left:auto;align-self:center;font-weight:600\">Abrir o painel →</a>",
        "</form>",
        "<main>",
        "<section id=\"v-postos\" class=\"oculto\">",
        "<div class=\"trilha\">EMP / TERMINAL</div>",
        "<h1 class=\"titulo-pg\">Escolha o posto deste terminal</h1>",
        "<p class=\"sub-pg\">A escolha fica no endereço (<span class=\"mono\">/terminal#POSTO</span>): salve como favorito no tablet do posto.</p>",
        "<div class=\"grade-postos\" id=\"lista-postos\"></div>",
        "</section>",
        "<section id=\"v-trabalho\" class=\"oculto\">",
        "<div id=\"parada\" class=\"parada oculto\" role=\"alert\"></div>",
        "<div class=\"palco\">",
        "<article class=\"cartao instrucao\" id=\"instrucao\" aria-live=\"polite\"></article>",
        "<aside class=\"cartao fila\"><h2>Tarefas do posto<span class=\"cont\" id=\"fila-c\"></span></h2><div id=\"fila\"></div></aside>",
        "</div>",
        "</section>",
        "</main>",
        "<div id=\"msg\" class=\"msg oculto\" role=\"status\" aria-live=\"assertive\"></div>",
        "<script>",
        "// Terminal do operador: uma instrução por vez, botões grandes, atualização a",
        "// cada 1 s (2 s depois de uma mensagem). Cada ação manda a `versao` da etapa",
        "// que está na tela; um 409 de versão vira aviso e recarga, nunca sobrescreve.",
        "var IC = {plan: \"M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z\", wait: \"M6 19h4V5H6v14zm8-14v14h4V5h-4z\", act: \"M8 5v14l11-7z\", ok: \"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\", bad: \"M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z\", skip: \"M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z\", lapis: \"M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z\"};",
        "var ESTADO = {AGUARDANDO: \"wait\", LIBERADA: \"wait\", EM_EXECUCAO: \"act\", EM_PRODUCAO: \"act\", CONCLUIDA: \"ok\", OPERANDO: \"ok\", FALHA: \"bad\", PARADO: \"bad\", PULADA: \"skip\", PLANEJADA: \"plan\"};",
        "var ROT = {AGUARDANDO: \"aguardando\", EM_EXECUCAO: \"em execução\", CONCLUIDA: \"concluída\", FALHA: \"falha\", PULADA: \"pulada\", OPERANDO: \"operando\", PARADO: \"parado\", MECANICA: \"mecânica\", ELETRICA: \"elétrica\", FALTA_MATERIAL: \"falta de material\"};",
        "var MOTIVOS = [\"Peça fora de medida\", \"Falta de material\", \"Ferramenta danificada\", \"Defeito na peça anterior\"];",
        "var posto = \"\", tarefas = [], sel = null, atual = null, parada = null, ativos = null, sessao = null, ops = {}, opsEm = 0;",
        "var modo = \"normal\", ocupado = false, assinatura = \"\", vistoFalha = {}, timer = 0, depoisMsg = false, ultimaOk = 0;",
        "",
        "function esc(s) { return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) { return {\"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", \"\\\"\": \"&quot;\", \"'\": \"&#39;\"}[c]; }); }",
        "function num(n) { return Number(n || 0).toLocaleString(\"pt-BR\", {maximumFractionDigits: 2}); }",
        "function hora(ms) { return ms ? new Date(ms).toLocaleTimeString(\"pt-BR\", {hour: \"2-digit\", minute: \"2-digit\"}) : \"\"; }",
        "function rot(s) { s = String(s == null ? \"\" : s); return ROT[s] || s.replace(/_/g, \" \").toLowerCase(); }",
        "function tag(s) { var k = ESTADO[s] || \"plan\"; return \"<span class='tag st-\" + k + \"'><svg viewBox='0 0 24 24' aria-hidden='true'><path d='\" + IC[k] + \"'/></svg>\" + esc(rot(s)) + \"</span>\"; }",
        "function ico(k) { return \"<svg viewBox='0 0 24 24' aria-hidden='true'><path d='\" + IC[k] + \"'/></svg>\"; }",
        "function ler(k) { try { return localStorage.getItem(k) || \"\"; } catch (e) { return \"\"; } }",
        "function guardar(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }",
        "function $(id) { return document.getElementById(id); }",
        "",
        "function api(metodo, caminho, corpo) {",
        "  var op = {method: metodo, headers: {}}, tk = ler(\"emp_token\");",
        "  if (tk) op.headers.Authorization = \"Bearer \" + tk;",
        "  if (corpo) { op.headers[\"Content-Type\"] = \"application/x-www-form-urlencoded\"; op.body = new URLSearchParams(corpo).toString(); }",
        "  return fetch(caminho, op).then(function (r) {",
        "    return r.text().then(function (t) {",
        "      var j = null; try { j = JSON.parse(t); } catch (e) {}",
        "      if (!r.ok) { var er = new Error((j && j.erro) || (\"HTTP \" + r.status)); er.status = r.status; throw er; }",
        "      return j;",
        "    });",
        "  });",
        "}",
        "function tenta(p, padrao) { return p.catch(function () { return padrao; }); }",
        "",
        "var msgT = 0;",
        "function mensagem(texto, tipo) {",
        "  var m = $(\"msg\"); m.textContent = texto; m.className = \"msg\" + (tipo ? \" \" + tipo : \"\");",
        "  clearTimeout(msgT); msgT = setTimeout(function () { m.className = \"msg oculto\"; }, 4500);",
        "  depoisMsg = true;",
        "}",
        "",
        "// A fila pode trazer a etapa aninhada ({op, etapa:{...}}) ou achatada ({op, numero, ...}).",
        "function tarefaDe(t) {",
        "  var e = t.etapa && typeof t.etapa === \"object\" ? t.etapa : t;",
        "  return {op: t.op != null ? t.op : (t.op_id != null ? t.op_id : t.id), numero: e.numero != null ? e.numero : t.etapa,",
        "    produto: t.produto || \"\", descricao_produto: t.descricao_produto || t.produto_descricao || \"\", quantidade: t.quantidade,",
        "    operacao: e.operacao || \"\", descricao: e.descricao || \"\", instrucao: e.instrucao || t.instrucao || \"\", posto: e.posto || t.posto || posto,",
        "    status: e.status || \"AGUARDANDO\", versao: e.versao, entrada: e.entrada, boas: e.boas || 0, refugo: e.refugo || 0,",
        "    inicio: e.inicio, operador: e.operador || \"\", erro: e.erro || \"\", parametros: t.parametros || null, n: t.indice || 0, m: t.total_etapas || 0};",
        "}",
        "function chave(t) { return t ? t.op + \"/\" + t.numero : \"\"; }",
        "",
        "// ── ciclo de atualização ──────────────────────────────────",
        "function agenda(ms) { clearTimeout(timer); timer = setTimeout(ciclo, ms); }",
        "function ciclo() {",
        "  var p = posto ? carregaPosto() : carregaPostos();",
        "  p.then(function () { ultimaOk = Date.now(); selo(true); }, function (e) {",
        "    selo(false, e);",
        "    if (e && e.status === 401) { $(\"cfg\").classList.remove(\"oculto\"); $(\"c-token\").focus(); }",
        "  }).then(function () {",
        "    var ms = depoisMsg ? 2000 : 1000; depoisMsg = false;",
        "    agenda(posto ? ms : 3000);",
        "  });",
        "}",
        "function selo(ok, erro) {",
        "  var s = $(\"selo\");",
        "  if (ok) { s.className = \"selo\"; void s.offsetWidth; s.className = \"selo vivo\"; s.textContent = \"atualizado às \" + new Date(ultimaOk).toLocaleTimeString(\"pt-BR\"); }",
        "  else if (erro && erro.status) { s.className = \"selo sem\"; s.textContent = \"erro \" + erro.status + \" · \" + erro.message; }",
        "  else { s.className = \"selo sem\"; s.textContent = \"sem conexão\" + (ultimaOk ? \" · última às \" + new Date(ultimaOk).toLocaleTimeString(\"pt-BR\") : \"\"); }",
        "}",
        "function inicio() {",
        "  return Promise.all([api(\"GET\", \"/api/sistema/modulos\"), tenta(api(\"GET\", \"/api/sistema/sessao\"), null)]).then(function (r) {",
        "    ativos = {}; r[0].forEach(function (m) { if (m.estado === \"ativo\") ativos[m.id] = true; });",
        "    sessao = r[1];",
        "    if (!ler(\"emp_operador\") && sessao) $(\"t-operador\").textContent = sessao.usuario;",
        "  });",
        "}",
        "// Reiniciar e pular são de pcp/admin (o servidor responde 403 aos outros perfis).",
        "function gestor() { return !!sessao && (sessao.perfil === \"admin\" || sessao.perfil === \"pcp\"); }",
        "function operador() { return ler(\"emp_operador\") || (sessao ? sessao.usuario : \"\"); }",
        "",
        "function carregaPostos() {",
        "  return (ativos ? Promise.resolve() : inicio()).then(function () {",
        "    return Promise.all([api(\"GET\", \"/api/cadastros/postos\"), ativos.manutencao ? tenta(api(\"GET\", \"/api/manutencao/postos\"), []) : Promise.resolve([])]);",
        "  }).then(function (r) {",
        "    var est = {}; r[1].forEach(function (p) { est[p.posto.codigo] = p; });",
        "    $(\"lista-postos\").innerHTML = r[0].length ? r[0].map(function (p) {",
        "      var e = est[p.codigo], st = e ? e.estado : \"\";",
        "      return \"<a class='cartao-posto \" + st + \"' href='#\" + encodeURIComponent(p.codigo) + \"'><b>\" + esc(p.codigo) + \"</b><span class='d'>\" + esc(p.descricao) + \"</span>\" + (st ? \"<span>\" + tag(st) + \"</span>\" : \"\") + \"<span class='ir'>ABRIR TERMINAL →</span></a>\";",
        "    }).join(\"\") : \"<div class='cartao nada'><h1>Nenhum posto</h1><p>Cadastre os postos de trabalho no painel, em Cadastros.</p></div>\";",
        "  });",
        "}",
        "",
        "function carregaPosto() {",
        "  return (ativos ? Promise.resolve() : inicio()).then(function () {",
        "    return Promise.all([",
        "      api(\"GET\", \"/api/producao/fila?posto=\" + encodeURIComponent(posto)),",
        "      ativos.manutencao ? tenta(api(\"GET\", \"/api/manutencao/postos\"), null) : Promise.resolve(null),",
        "      ativos.roteiros && Date.now() - opsEm > 30000 ? tenta(api(\"GET\", \"/api/roteiros/operacoes\"), null) : Promise.resolve(null)",
        "    ]);",
        "  }).then(function (r) {",
        "    tarefas = (r[0] || []).map(tarefaDe);",
        "    if (r[1]) { var p = r[1].filter(function (x) { return x.posto.codigo === posto; })[0]; parada = p && p.estado === \"PARADO\" ? (p.parada || {}) : null; }",
        "    if (r[2]) { ops = {}; r[2].forEach(function (o) { ops[o.codigo] = o; }); opsEm = Date.now(); }",
        "    var t = tarefas.filter(function (x) { return chave(x) === sel; })[0] || tarefas[0] || null;",
        "    if (!t) { atual = null; sel = null; return; }",
        "    sel = chave(t);",
        "    // O detalhe da OP completa a etapa: n de m, entrada, descrição, versão atual.",
        "    return tenta(api(\"GET\", \"/api/producao/ordem?id=\" + encodeURIComponent(t.op)), null).then(function (o) {",
        "      if (o && o.etapas) {",
        "        var i = -1; o.etapas.forEach(function (e, k) { if (String(e.numero) === String(t.numero)) i = k; });",
        "        if (i >= 0) {",
        "          var e = o.etapas[i];",
        "          [\"operacao\", \"descricao\", \"instrucao\", \"status\", \"versao\", \"entrada\", \"boas\", \"refugo\", \"inicio\", \"operador\", \"erro\"].forEach(function (c) { if (e[c] != null && e[c] !== \"\") t[c] = e[c]; });",
        "          t.n = i + 1; t.m = o.etapas.length;",
        "        }",
        "        t.produto = o.produto || t.produto; t.quantidade = o.quantidade;",
        "      }",
        "      atual = t;",
        "    });",
        "  }).then(desenha);",
        "}",
        "",
        "// ── desenho ───────────────────────────────────────────────",
        "function desenha() {",
        "  estadoPosto();",
        "  $(\"fila-c\").textContent = tarefas.length ? tarefas.length + (tarefas.length > 1 ? \" tarefas\" : \" tarefa\") : \"vazia\";",
        "  $(\"fila\").innerHTML = tarefas.length ? tarefas.map(function (t) {",
        "    return \"<button class='tarefa e-\" + (ESTADO[t.status] || \"plan\") + (chave(t) === sel ? \" sel\" : \"\") + \"' data-k='\" + esc(chave(t)) + \"'><b>\" + esc(t.descricao || t.operacao || \"Etapa \" + t.numero) + \"</b>\" + tag(t.status) +",
        "      \"<small><span class='id'>OP-\" + esc(String(t.op).padStart(3, \"0\")) + \"</span> \" + esc(t.produto) + \" · etapa \" + esc(t.numero) + \"</small></button>\";",
        "  }).join(\"\") : \"<div class='vazio'>Nenhuma tarefa na fila.</div>\";",
        "  var pa = $(\"parada\");",
        "  if (parada) {",
        "    pa.classList.remove(\"oculto\");",
        "    pa.innerHTML = \"<div class='ico'>\" + ico(\"bad\") + \"</div><div><small>POSTO PARADO\" + (parada.inicio ? \" · DESDE \" + hora(parada.inicio) : \"\") + \"</small><b>\" + esc(rot(parada.categoria || \"PARADO\")) + \"</b><span>\" + esc(parada.motivo || \"Parada aberta na manutenção.\") + \"</span></div>\";",
        "  } else pa.classList.add(\"oculto\");",
        "  var t = atual, el = $(\"instrucao\");",
        "  // Só redesenha a instrução quando algo mudou: não apaga o que o operador digita.",
        "  var sig = JSON.stringify([t, !!parada, modo, ocupado]);",
        "  if (sig === assinatura) return;",
        "  var guardados = {}; el.querySelectorAll(\"input,textarea\").forEach(function (i) { guardados[i.id] = i.value; });",
        "  assinatura = sig;",
        "  if (!t) {",
        "    el.className = \"cartao instrucao nada\";",
        "    el.innerHTML = \"<div class='ico'>\" + ico(\"ok\") + \"</div><h1>Nenhuma tarefa</h1><p>A fila do posto \" + esc(posto) + \" está vazia. Esta tela se atualiza sozinha quando chegar trabalho.</p>\";",
        "    return;",
        "  }",
        "  var k = ESTADO[t.status] || \"plan\", falta = Math.max(0, Number(t.entrada || 0) - Number(t.boas) - Number(t.refugo));",
        "  var pisca = t.status === \"FALHA\" && !vistoFalha[chave(t)]; if (t.status === \"FALHA\") vistoFalha[chave(t)] = 1;",
        "  el.className = \"cartao instrucao e-\" + k + (pisca ? \" pisca\" : \"\");",
        "  var pct = t.entrada ? Math.min(100, 100 * (Number(t.boas) + Number(t.refugo)) / t.entrada) : 0, nled = Math.round(pct / 100 * 16), led = \"\";",
        "  for (var i = 0; i < 16; i++) led += \"<i\" + (i < nled ? \" class='on'\" : \"\") + \"></i>\";",
        "  var h = \"<div class='i-topo'><span class='id'>OP-\" + esc(String(t.op).padStart(3, \"0\")) + \"</span><span><b>\" + esc(t.produto) + \"</b>\" + (t.descricao_produto ? \" · \" + esc(t.descricao_produto) : \"\") + (t.quantidade ? \" · \" + num(t.quantidade) + \" un.\" : \"\") + \"</span>\" +",
        "    \"<span class='etapa'>etapa \" + esc(t.numero) + (t.m ? \" · \" + t.n + \" de \" + t.m : \"\") + \"</span>\" + tag(t.status) + \"</div>\" +",
        "    \"<h1 class='i-titulo'>\" + esc(t.descricao || t.operacao || \"Etapa \" + t.numero) + \"</h1>\" +",
        "    \"<p class='i-frase\" + (t.instrucao ? \"\" : \" vaz\") + \"'>\" + esc(t.instrucao || \"Sem instrução cadastrada para esta etapa.\") + \"</p>\" +",
        "    (t.status === \"FALHA\" ? \"<div class='falhou'><b>Concluída com erro:</b> \" + esc(t.erro || \"sem motivo informado\") + \"</div>\" : \"\") +",
        "    \"<div class='i-nums'><div><small>ENTRADA</small><b>\" + num(t.entrada) + \"</b></div><div><small>BOAS</small><b>\" + num(t.boas) + \"</b></div><div class='\" + (Number(t.refugo) > 0 ? \"neg\" : \"\") + \"'><small>REFUGO</small><b>\" + num(t.refugo) + \"</b></div><div><small>FALTA</small><b>\" + num(falta) + \"</b></div></div>\" +",
        "    \"<div class='led\" + (pct >= 100 ? \" cheio\" : \"\") + \"'>\" + led + \"<span>\" + Math.round(pct) + \"%</span></div>\";",
        "  h += acoes(t);",
        "  if (parada) h += \"<div class='bloqueio'>Ações bloqueadas: o posto está parado. A manutenção libera ao encerrar a parada.</div>\";",
        "  el.innerHTML = h;",
        "  Object.keys(guardados).forEach(function (id) { var i = $(id); if (i && guardados[id] !== \"\") i.value = guardados[id]; });",
        "  el.querySelectorAll(\".medida input\").forEach(confere);",
        "  var bloq = !!parada || ocupado;",
        "  el.querySelectorAll(\"button\").forEach(function (b) { if (bloq && !b.dataset.livre) b.disabled = true; });",
        "}",
        "function botao(acao, rotulo, cls, icone) { return \"<button class='grande \" + (cls || \"\") + \"' data-a='\" + acao + \"'>\" + (icone ? ico(icone) : \"\") + rotulo + \"</button>\"; }",
        "function acoes(t) {",
        "  if (modo === \"apontar\") {",
        "    var o = ops[t.operacao], par = t.parametros || (o && o.parametros) || [];",
        "    return \"<div class='campos'>\" + passo(\"ap-boas\", \"Boas\") + passo(\"ap-refugo\", \"Refugo\") + \"</div>\" +",
        "      (par.length ? \"<div class='campos'>\" + par.map(function (p, i) {",
        "        return \"<label class='medida campo-n'><span>\" + esc(p.nome) + (p.unidade ? \" (\" + esc(p.unidade) + \")\" : \"\") + \"</span><input id='md-\" + i + \"' data-nome='\" + esc(p.nome) + \"' data-min='\" + esc(p.min) + \"' data-max='\" + esc(p.max) + \"' inputmode='decimal' autocomplete='off'><small>limite \" + num(p.min) + \" a \" + num(p.max) + \" <span class='res'></span></small></label>\";",
        "      }).join(\"\") + \"</div>\" : \"\") +",
        "      \"<div class='i-acoes'>\" + botao(\"enviar-apontamento\", \"Registrar apontamento\", \"\", \"ok\") + botao(\"voltar\", \"Voltar\", \"sec\") + \"</div>\";",
        "  }",
        "  if (modo === \"erro\") {",
        "    return \"<div class='motivos'>\" + MOTIVOS.map(function (m) { return \"<button type='button' class='sec' data-a='motivo' data-livre='1'>\" + esc(m) + \"</button>\"; }).join(\"\") + \"</div>\" +",
        "      \"<label style='margin-bottom:14px'>Motivo do erro<textarea id='er-motivo' rows='2' placeholder='o que aconteceu?'></textarea></label>\" +",
        "      \"<div class='i-acoes'>\" + botao(\"enviar-erro\", \"Confirmar erro\", \"bad\", \"bad\") + botao(\"voltar\", \"Voltar\", \"sec\") + \"</div>\";",
        "  }",
        "  if (t.status === \"AGUARDANDO\") return \"<div class='i-acoes'>\" + botao(\"iniciar\", \"Iniciar\", \"tudo\", \"act\") + \"</div>\";",
        "  if (t.status === \"EM_EXECUCAO\") return \"<div class='i-acoes'>\" + botao(\"apontar\", \"Apontar\", \"\", \"lapis\") + botao(\"concluir\", \"Concluir\", \"ok\", \"ok\") +",
        "    botao(\"erro\", \"Concluir com erro\", \"bad-l\", \"bad\") + (gestor() ? botao(\"reiniciar\", \"Reiniciar\", \"sec menor\") : \"\") + \"</div>\";",
        "  if (t.status === \"FALHA\") return gestor() ? \"<div class='i-acoes'>\" + botao(\"reiniciar\", \"Reiniciar etapa\", \"tudo\", \"wait\") + \"</div>\"",
        "    : \"<div class='bloqueio'>Chame o PCP: reiniciar uma etapa em falha exige o perfil pcp ou admin.</div>\";",
        "  return \"\";",
        "}",
        "function passo(id, rotulo) {",
        "  return \"<div class='campo-n'><span>\" + rotulo + \"</span><div class='passo'><button type='button' class='sec' data-a='menos' data-c='\" + id + \"' data-livre='1' aria-label='menos 1'>−</button>\" +",
        "    \"<input id='\" + id + \"' inputmode='numeric' autocomplete='off' placeholder='0' aria-label='\" + rotulo + \"'><button type='button' class='sec' data-a='mais' data-c='\" + id + \"' data-livre='1' aria-label='mais 1'>+</button></div></div>\";",
        "}",
        "function confere(i) {",
        "  var v = parseFloat(String(i.value).replace(\",\", \".\")), mn = parseFloat(i.dataset.min), mx = parseFloat(i.dataset.max), l = i.closest(\".medida\");",
        "  l.classList.remove(\"dentro\", \"fora\"); var r = l.querySelector(\".res\"); r.textContent = \"\";",
        "  if (i.value === \"\" || isNaN(v)) return;",
        "  var ok = (isNaN(mn) || v >= mn) && (isNaN(mx) || v <= mx);",
        "  l.classList.add(ok ? \"dentro\" : \"fora\"); r.textContent = ok ? \"· dentro\" : \"· fora do limite\";",
        "}",
        "",
        "// ── ações ─────────────────────────────────────────────────",
        "function valor(id) { var i = $(id); return i ? String(i.value).trim().replace(\",\", \".\") : \"\"; }",
        "function executa(acao, extra, ok, tipo) {",
        "  var t = atual; if (!t || ocupado || parada) return;",
        "  ocupado = true; desenha();",
        "  var corpo = {versao: t.versao == null ? \"\" : String(t.versao), operador: operador()};",
        "  Object.keys(extra || {}).forEach(function (k) { corpo[k] = extra[k]; });",
        "  api(\"POST\", \"/api/producao/etapa/\" + acao + \"?op=\" + encodeURIComponent(t.op) + \"&etapa=\" + encodeURIComponent(t.numero), corpo).then(function () {",
        "    modo = \"normal\"; mensagem(ok, tipo);",
        "  }, function (e) {",
        "    if (e.status === 409 && /outra pessoa|vers/i.test(e.message)) { modo = \"normal\"; mensagem(\"A tarefa foi alterada por outra pessoa. Recarregando…\", \"aviso\"); }",
        "    else mensagem(e.message, \"erro\");",
        "  }).then(function () { ocupado = false; assinatura = \"\"; clearTimeout(timer); ciclo(); });",
        "}",
        "$(\"instrucao\").addEventListener(\"click\", function (ev) {",
        "  var b = ev.target.closest(\"button\"); if (!b || b.disabled) return;",
        "  var a = b.dataset.a;",
        "  if (a === \"iniciar\") executa(\"iniciar\", null, \"Etapa iniciada.\");",
        "  else if (a === \"concluir\") executa(\"concluir\", null, \"Etapa concluída.\");",
        "  else if (a === \"reiniciar\") executa(\"reiniciar\", null, \"Etapa reiniciada.\");",
        "  else if (a === \"apontar\" || a === \"erro\") { modo = a; assinatura = \"\"; desenha(); var f = $(a === \"erro\" ? \"er-motivo\" : \"ap-boas\"); if (f) f.focus(); }",
        "  else if (a === \"voltar\") { modo = \"normal\"; assinatura = \"\"; desenha(); }",
        "  else if (a === \"mais\" || a === \"menos\") { var i = $(b.dataset.c), v = parseInt(i.value, 10) || 0; i.value = Math.max(0, v + (a === \"mais\" ? 1 : -1)); }",
        "  else if (a === \"motivo\") { $(\"er-motivo\").value = b.textContent; }",
        "  else if (a === \"enviar-erro\") {",
        "    var m = valor(\"er-motivo\"); if (!m) { mensagem(\"Informe o motivo do erro.\", \"erro\"); $(\"er-motivo\").focus(); return; }",
        "    executa(\"erro\", {motivo: m}, \"Etapa concluída com erro.\", \"aviso\");",
        "  } else if (a === \"enviar-apontamento\") {",
        "    var bo = valor(\"ap-boas\") || \"0\", re = valor(\"ap-refugo\") || \"0\";",
        "    if (!(Number(bo) > 0 || Number(re) > 0)) { mensagem(\"Informe as boas e/ou o refugo.\", \"erro\"); $(\"ap-boas\").focus(); return; }",
        "    var md = []; document.querySelectorAll(\".medida input\").forEach(function (i) { if (i.value !== \"\") md.push(i.dataset.nome + \"=\" + String(i.value).replace(\",\", \".\")); });",
        "    executa(\"apontar\", {boas: bo, refugo: re, medicoes: md.join(\";\")}, \"Apontamento registrado: \" + num(bo) + \" boas, \" + num(re) + \" refugo.\");",
        "  }",
        "});",
        "$(\"instrucao\").addEventListener(\"input\", function (ev) { if (ev.target.closest(\".medida\")) confere(ev.target); });",
        "$(\"fila\").addEventListener(\"click\", function (ev) {",
        "  var b = ev.target.closest(\".tarefa\"); if (!b) return;",
        "  sel = b.dataset.k; modo = \"normal\"; assinatura = \"\"; clearTimeout(timer); ciclo();",
        "});",
        "",
        "// ── posto, operador e token ───────────────────────────────",
        "function abrePosto() {",
        "  posto = decodeURIComponent((location.hash || \"\").slice(1)).toUpperCase();",
        "  sel = null; atual = null; tarefas = []; parada = null; modo = \"normal\"; assinatura = \"\";",
        "  $(\"v-postos\").classList.toggle(\"oculto\", !!posto);",
        "  $(\"v-trabalho\").classList.toggle(\"oculto\", !posto);",
        "  $(\"b-posto\").classList.toggle(\"oculto\", !posto);",
        "  $(\"t-posto\").textContent = posto || \"—\";",
        "  document.title = posto ? posto + \" · Terminal EMP\" : \"EMP · Terminal do operador\";",
        "  $(\"instrucao\").innerHTML = \"\"; $(\"fila\").innerHTML = \"\";",
        "  clearTimeout(timer); ciclo();",
        "}",
        "function estadoPosto() { $(\"t-estado\").innerHTML = posto && ativos && ativos.manutencao ? tag(parada ? \"PARADO\" : \"OPERANDO\") : \"\"; }",
        "$(\"c-operador\").value = ler(\"emp_operador\"); $(\"c-token\").value = ler(\"emp_token\");",
        "$(\"t-operador\").textContent = ler(\"emp_operador\") || \"—\";",
        "function abreCfg() { var c = $(\"cfg\"); c.classList.toggle(\"oculto\"); if (!c.classList.contains(\"oculto\")) $(\"c-operador\").focus(); }",
        "$(\"btn-cfg\").onclick = abreCfg; $(\"btn-quem\").onclick = abreCfg;",
        "$(\"cfg\").onsubmit = function (ev) {",
        "  ev.preventDefault();",
        "  guardar(\"emp_operador\", $(\"c-operador\").value.trim()); guardar(\"emp_token\", $(\"c-token\").value.trim());",
        "  $(\"t-operador\").textContent = operador() || \"—\"; $(\"cfg\").classList.add(\"oculto\");",
        "  ativos = null; assinatura = \"\"; mensagem(\"Configuração salva.\"); clearTimeout(timer); ciclo();",
        "};",
        "$(\"c-trocar\").onclick = function () { $(\"cfg\").classList.add(\"oculto\"); location.hash = \"\"; };",
        "window.onhashchange = abrePosto;",
        "abrePosto();",
        "</script>",
        "</body>",
        "</html>"
    ];
}

pub fn pagina() -> string ={
    return join(_linhas(), "\n");
}
