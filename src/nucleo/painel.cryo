// ============================================================
//  painel.cryo — painel web do EMP, servido pelo próprio núcleo
//
//  O navegador só executa HTML/CSS/JS, então a página vive aqui como
//  texto: UMA string Cryo por linha da página, unidas por join. Assim
//  o binário continua sendo um único .exe, sem arquivos ao lado.
//
//  Visual no padrão das aplicações MES4/FactoryViews: barra superior
//  branca (☰, nome do app, usuário, alertas, idioma, marca), trilho de
//  ícones à esquerda com as ações da tela, faixa de navegação (breadcrumb),
//  título grande, cartões brancos arredondados, estados com ícone
//  (✓ azul, anel cinza, ✕ vermelho), tela inicial em blocos e rodapé
//  centralizado. A marca exibida é a do EMP.
//
//  A página descobre os módulos ativos em /api/sistema/modulos e
//  esconde menus e blocos dos que não estão no ar — um módulo removido
//  some sem alterar este arquivo.
//
//  Telas: início, visão geral, ordens, estoque, manutenção, qualidade
//  (plugin), cadastros, eventos e módulos. Deep-link pelo hash: /#manutencao
//
//  Ao editar: aspas viram \", barras invertidas \\ e `${` vira
//  \${ (senão é interpolação Cryo).
// ============================================================

fn _linhas() -> string[] ={
    return [
        "<!doctype html>",
        "<html lang=\"pt-br\">",
        "<head>",
        "<meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">",
        "<title>EMP · Engineering Modular Process</title>",
        "<style>",
        ":root{--bg:#f0f2f4;--card:#fff;--ink:#333;--ink2:#1f1f1f;--muted:#6c7680;--line:#d3d8dd;--line2:#e6e9ec;--crumb:#d3d8dd;--tile:#e3e7ea;--blue:#0091dc;--accent:#0091dc;--blue-d:#0071b9;--blue-bg:#e5f4fb;--blue-l:#c9e7f7;--wait:#b0b8bf;--plan:#d3d8dd;--ok:#0091dc;--warn:#f0a000;--bad:#d50000;--bad-bg:#fde8e8}",
        "*{box-sizing:border-box}",
        "body{margin:0;font-family:\"Fira Sans\",\"Segoe UI\",Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink);font-size:14px;line-height:1.45}",
        "svg{display:block}",
        "a{color:var(--blue)}",
        ".topbar{position:fixed;top:0;left:0;right:0;height:50px;background:#fff;border-bottom:1px solid var(--line2);display:flex;align-items:center;z-index:20}",
        ".icbtn{width:46px;height:50px;display:grid;place-items:center;background:none;border:0;padding:0;color:var(--ink2);cursor:pointer;position:relative}",
        ".icbtn svg{width:22px;height:22px;fill:currentColor}",
        ".icbtn:hover{color:var(--blue);background:none}",
        ".app-nome{font-weight:700;font-size:15px;color:var(--ink2);margin-left:18px;letter-spacing:.2px}",
        ".topbar .dir{margin-left:auto;display:flex;align-items:center;gap:4px;height:100%}",
        ".topbar .dir .icbtn{width:40px}",
        "#btn-user{color:var(--blue)}",
        "#btn-user svg,#btn-sino svg{width:18px;height:18px}",
        ".badge{position:absolute;top:10px;right:6px;min-width:16px;height:16px;padding:0 4px;border-radius:8px;background:var(--bad);color:#fff;font-size:10px;font-weight:700;line-height:16px;text-align:center}",
        ".badge:empty{display:none}",
        ".idioma{font-size:14px;color:var(--ink2);padding:0 18px 0 8px}",
        ".logo{font-weight:800;font-size:26px;color:var(--blue);letter-spacing:1px;padding-right:12px;font-family:Arial,Helvetica,sans-serif;font-style:italic;transform:skewX(-6deg)}",
        ".rail{position:fixed;top:50px;left:0;bottom:0;width:46px;background:#fff;border-right:1px solid var(--line2);display:flex;flex-direction:column;align-items:center;padding:10px 0;z-index:15}",
        ".rail .icbtn{height:46px}",
        ".rail .fim{margin-top:auto}",
        ".icbtn.oculto,.rail .oculto{display:none}",
        ".drawer{position:fixed;top:50px;left:0;bottom:0;width:280px;background:#fff;box-shadow:4px 0 16px #0002;transform:translateX(-105%);transition:transform .18s ease;z-index:18;display:flex;flex-direction:column}",
        ".drawer.aberto{transform:none}",
        ".drawer h3{font-size:12px;color:var(--muted);font-weight:600;margin:18px 20px 6px;text-transform:uppercase;letter-spacing:.5px}",
        "nav a{display:flex;align-items:center;gap:14px;padding:11px 20px;color:var(--ink2);text-decoration:none;border-left:3px solid transparent}",
        "nav a:hover{background:var(--bg);color:var(--blue)}",
        "nav a.ativo{color:var(--blue);border-left-color:var(--blue);background:var(--blue-bg);font-weight:600}",
        "nav a.oculto{display:none}",
        "nav a svg{width:20px;height:20px;fill:currentColor;flex:none}",
        ".veu{position:fixed;inset:50px 0 0 0;background:#0003;z-index:17;display:none}",
        ".veu.aberto{display:block}",
        ".menu-user{position:fixed;top:54px;right:120px;width:280px;background:#fff;box-shadow:0 4px 18px #0003;padding:14px 16px;z-index:25;display:none}",
        ".menu-user.aberto{display:block}",
        ".menu-user b{display:block;font-size:15px;color:var(--ink2)}",
        ".menu-user small{color:var(--muted)}",
        ".menu-user label{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted);margin-top:12px}",
        ".palco{margin:50px 0 0 46px;min-height:calc(100vh - 50px);display:flex;flex-direction:column}",
        ".crumb{background:var(--crumb);padding:10px 14px;font-size:12px;color:var(--ink2)}",
        ".crumb a{color:var(--ink2);text-decoration:none}",
        ".crumb a:hover{text-decoration:underline}",
        ".crumb .sep{margin:0 6px}",
        ".crumb b{font-weight:700}",
        "main{padding:20px 14px 10px;min-width:0;flex:1}",
        "header.topo{margin:0 0 18px}",
        "header.topo h1{font-size:26px;margin:0;font-weight:700;color:var(--ink2)}",
        "header.topo .sub{color:var(--muted);font-size:13px;margin-top:2px}",
        "footer.rodape{text-align:center;color:#8b949c;font-size:11px;padding:18px 0 22px;line-height:2}",
        "footer.rodape a{color:#8b949c;text-decoration:none;margin:0 6px}",
        "input,select,button{font:inherit}",
        "input,select{padding:7px 9px;border:0;border-bottom:1px solid #9aa3ab;border-radius:0;background:#f6f7f8;min-width:0;color:var(--ink2)}",
        "input:focus,select:focus{outline:0;border-bottom:2px solid var(--blue);background:#fff}",
        "button{padding:7px 16px;border:0;border-radius:2px;background:var(--blue);color:#fff;cursor:pointer;font-weight:600}",
        "button:hover{background:var(--blue-d)}",
        "button.sec{background:none;color:var(--blue);padding-left:4px;padding-right:4px}",
        "button.sec:hover{background:none;text-decoration:underline}",
        "button.ok{background:var(--blue)}",
        "button.bad{background:var(--bad)}",
        "button.mini{padding:4px 10px;font-size:12px}",
        ".grid{display:grid;gap:16px}",
        ".kpis{grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}",
        ".dois{grid-template-columns:repeat(auto-fit,minmax(360px,1fr))}",
        ".card{background:var(--card);border:1px solid var(--line2);border-radius:8px;padding:16px 20px 18px;min-width:0}",
        ".card>div:not(.postos){overflow-x:auto}",
        ".card h2{font-size:16px;margin:0 0 14px;font-weight:700;color:var(--ink2);display:flex;align-items:center;gap:8px}",
        ".card h2 .cont{margin-left:auto;color:var(--muted);font-weight:400;font-size:12px}",
        ".card.destaque{border-color:var(--blue);box-shadow:0 0 0 1px var(--blue)}",
        ".kpi{padding:14px 16px}",
        ".kpi .rot{color:var(--ink2);font-size:13px;font-weight:600}",
        ".kpi .val{font-size:30px;font-weight:700;margin-top:4px;color:var(--ink2)}",
        ".kpi .det{color:var(--muted);font-size:12px;margin-top:2px}",
        ".kpi.alerta .val{color:var(--bad)}",
        ".kpi.bom .val{color:var(--blue)}",
        ".legenda{display:inline-block;padding:12px 14px;font-size:14px}",
        ".legenda h2{font-size:14px;margin:0 0 8px}",
        ".legenda div{display:flex;align-items:center;gap:10px;margin:3px 0}",
        ".legenda i{width:14px;height:14px;display:inline-block}",
        ".topo-ordens{display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap}",
        ".topo-ordens .hora{font-size:11px;color:var(--ink2)}",
        "table{width:100%;border-collapse:collapse}",
        "th{text-align:left;font-size:12px;color:var(--ink2);font-weight:700;padding:10px 8px;border-bottom:1px solid var(--line2);white-space:nowrap}",
        "td{padding:11px 8px;border-bottom:1px solid var(--line2);vertical-align:middle;color:var(--ink2)}",
        "tr:last-child td{border-bottom:0}",
        "tbody tr:hover td{background:#f7f9fa}",
        "td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}",
        ".tag{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;color:var(--ink2)}",
        ".tag i{width:18px;height:18px;border-radius:50%;flex:none;display:inline-grid;place-items:center;font-style:normal;font-size:11px;font-weight:700;color:#fff;line-height:1}",
        ".st-ok i{background:var(--blue)}",
        ".st-ok i::after{content:\"\\2713\"}",
        ".st-wait i{background:var(--wait);border:2px solid var(--wait);box-shadow:inset 0 0 0 3px #fff}",
        ".st-plan i{background:var(--plan)}",
        ".st-act i{background:var(--blue-l);border:2px solid var(--blue)}",
        ".st-bad i{background:var(--bad)}",
        ".st-bad i::after{content:\"\\2715\";font-size:10px}",
        ".barra{height:6px;background:var(--line2);border-radius:3px;overflow:hidden;min-width:90px}",
        ".barra i{display:block;height:100%;background:var(--blue)}",
        ".form{display:flex;flex-wrap:wrap;gap:12px 14px;align-items:end}",
        ".form label{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink2);font-weight:600}",
        ".postos{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px}",
        ".posto{border:1px solid var(--line2);border-radius:8px;padding:14px;background:#fff}",
        ".posto.PARADO{border-color:var(--bad);box-shadow:0 0 0 1px var(--bad)}",
        ".posto b{display:block;font-size:15px;color:var(--ink2)}",
        ".posto .d{color:var(--muted);font-size:12px;margin:2px 0 10px}",
        ".posto .m{font-size:12px;margin-top:8px;color:var(--bad)}",
        ".ev{display:grid;grid-template-columns:56px 170px 1fr;gap:10px;padding:9px 0;border-bottom:1px solid var(--line2);font-size:13px}",
        ".ev:last-child{border-bottom:0}",
        ".ev .h{color:var(--muted);font-variant-numeric:tabular-nums}",
        ".ev .tp{font-weight:600;color:var(--ink2)}",
        ".ev .dd{color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}",
        ".vazio{color:var(--muted);padding:14px 0;text-align:center}",
        ".neg{color:var(--bad);font-weight:600}",
        "code{font-family:Consolas,monospace;font-size:12px;background:var(--bg);padding:1px 5px;border-radius:3px}",
        ".tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:20px}",
        ".tile{display:grid;grid-template-columns:170px 1fr;min-height:240px;background:var(--tile);text-decoration:none;color:var(--ink2);border:1px solid #d7dde2}",
        ".tile:hover{box-shadow:0 0 0 2px var(--blue)}",
        ".tile .img{background:linear-gradient(160deg,#fbfcfd,#cfd8df);display:grid;place-items:center;border-right:1px solid #d7dde2}",
        ".tile .img svg{width:84px;height:84px;fill:var(--blue)}",
        ".tile .txt{padding:22px 18px}",
        ".tile h3{font-size:26px;font-weight:600;margin:0 0 14px;line-height:1.2;color:var(--ink2)}",
        ".tile p{margin:0;font-size:14px;line-height:1.55;color:var(--ink2)}",
        ".tile.oculto{display:none}",
        ".secao{display:none}",
        ".secao.ativa{display:grid}",
        "#toast{position:fixed;right:22px;bottom:22px;display:flex;flex-direction:column;gap:8px;z-index:30}",
        "#toast div{background:#fff;color:var(--ink2);padding:12px 16px;border-left:4px solid var(--blue);box-shadow:0 4px 18px #0003;max-width:380px}",
        "#toast div.erro{border-left-color:var(--bad)}",
        "@media (max-width:820px){.app-nome{margin-left:4px}.idioma{display:none}.logo{font-size:20px}.menu-user{right:8px;left:8px;width:auto}.palco{margin-left:0;margin-bottom:46px}.rail{top:auto;right:0;width:auto;height:46px;flex-direction:row;justify-content:center;border-right:0;border-top:1px solid var(--line2);padding:0}.rail .fim{margin-top:0;margin-left:auto}.dois,.tiles{grid-template-columns:1fr}.tile{grid-template-columns:110px 1fr;min-height:0}.tile h3{font-size:20px}.tile .img svg{width:56px;height:56px}main{padding:16px 12px}.ev{grid-template-columns:48px 1fr}.ev .dd{grid-column:2}}",
        "</style>",
        "</head>",
        "<body>",
        "<header class=\"topbar\">",
        "<button class=\"icbtn\" id=\"btn-menu\" title=\"Menu\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z\"/></svg></button>",
        "<span class=\"app-nome\">EMP</span>",
        "<div class=\"dir\">",
        "<button class=\"icbtn\" id=\"btn-user\" title=\"Sessão\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/></svg></button>",
        "<button class=\"icbtn\" id=\"btn-sino\" title=\"Alertas\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z\"/></svg><span class=\"badge\" id=\"alertas\"></span></button>",
        "<span class=\"idioma\">PT</span>",
        "<span class=\"logo\">EMP</span>",
        "</div>",
        "</header>",
        "<div class=\"menu-user\" id=\"menu-user\">",
        "<b id=\"sessao\">…</b><small>Engineering Modular Process</small>",
        "<label>Token de acesso<input id=\"token\" type=\"password\" placeholder=\"token de acesso\"></label>",
        "</div>",
        "<aside class=\"rail\">",
        "<button class=\"icbtn\" id=\"btn-novo\" title=\"Novo\"><svg viewBox=\"0 0 24 24\"><path d=\"M13 7h-2v4H7v2h4v4h2v-4h4v-2h-4V7zm-1-5C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z\"/></svg></button>",
        "<button class=\"icbtn\" id=\"btn-atualizar\" title=\"Atualizar\"><svg viewBox=\"0 0 24 24\"><path d=\"M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z\"/></svg></button>",
        "<a class=\"icbtn fim\" href=\"#inicio\" title=\"Início e ajuda\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z\"/></svg></a>",
        "<a class=\"icbtn\" href=\"#modulos\" title=\"Módulos\"><svg viewBox=\"0 0 24 24\"><path d=\"M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z\"/></svg></a>",
        "</aside>",
        "<div class=\"veu\" id=\"veu\"></div>",
        "<div class=\"drawer\" id=\"drawer\">",
        "<h3>Aplicações</h3>",
        "<nav id=\"nav\">",
        "<a href=\"#inicio\" data-sec=\"inicio\"><svg viewBox=\"0 0 24 24\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"/></svg>Início</a>",
        "<a href=\"#geral\" data-sec=\"geral\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z\"/></svg>Visão geral</a>",
        "<a href=\"#ordens\" data-sec=\"ordens\" data-mod=\"producao\"><svg viewBox=\"0 0 24 24\"><path d=\"M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z\"/></svg>Ordens de produção</a>",
        "<a href=\"#estoque\" data-sec=\"estoque\" data-mod=\"estoque\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z\"/></svg>Estoque</a>",
        "<a href=\"#manutencao\" data-sec=\"manutencao\" data-mod=\"manutencao\"><svg viewBox=\"0 0 24 24\"><path d=\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\"/></svg>Manutenção</a>",
        "<a href=\"#qualidade\" data-sec=\"qualidade\" data-mod=\"qualidade\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>Qualidade</a>",
        "<a href=\"#cadastros\" data-sec=\"cadastros\" data-mod=\"cadastros\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z\"/></svg>Cadastros</a>",
        "</nav>",
        "<h3>Sistema</h3>",
        "<nav>",
        "<a href=\"#eventos\" data-sec=\"eventos\"><svg viewBox=\"0 0 24 24\"><path d=\"M7 2v11h3v9l7-12h-4l4-8z\"/></svg>Eventos</a>",
        "<a href=\"#modulos\" data-sec=\"modulos\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z\"/></svg>Módulos</a>",
        "</nav>",
        "</div>",
        "",
        "<div class=\"palco\">",
        "<div class=\"crumb\" id=\"crumb\"></div>",
        "<main>",
        "<header class=\"topo\">",
        "<h1 id=\"titulo\">Início</h1><div class=\"sub\" id=\"subtitulo\"></div>",
        "</header>",
        "",
        "<section class=\"secao\" id=\"s-inicio\">",
        "<div class=\"tiles\">",
        "<a class=\"tile\" href=\"#geral\"><div class=\"img\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z\"/></svg></div><div class=\"txt\"><h3>Visão geral</h3><p>Indicadores da linha em tempo real: ordens abertas, produção, refugo, disponibilidade dos postos e os últimos eventos.</p></div></a>",
        "<a class=\"tile\" href=\"#ordens\" data-mod=\"producao\"><div class=\"img\"><svg viewBox=\"0 0 24 24\"><path d=\"M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z\"/></svg></div><div class=\"txt\"><h3>Ordens de produção</h3><p>As ordens dizem o que produzir, quanto e em qual posto. Elas são planejadas, liberadas e apontadas até a conclusão.</p></div></a>",
        "<a class=\"tile\" href=\"#estoque\" data-mod=\"estoque\"><div class=\"img\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z\"/></svg></div><div class=\"txt\"><h3>Estoque</h3><p>Saldos e movimentos dos materiais. O consumo dos componentes é baixado sozinho a cada apontamento, pela estrutura do produto.</p></div></a>",
        "<a class=\"tile\" href=\"#manutencao\" data-mod=\"manutencao\"><div class=\"img\"><svg viewBox=\"0 0 24 24\"><path d=\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\"/></svg></div><div class=\"txt\"><h3>Manutenção</h3><p>Paradas dos postos de trabalho por categoria, disponibilidade na janela de 8 h e tempo médio de reparo.</p></div></a>",
        "<a class=\"tile\" href=\"#qualidade\" data-mod=\"qualidade\"><div class=\"img\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg></div><div class=\"txt\"><h3>Qualidade</h3><p>Não conformidades manuais e automáticas, abertas quando o refugo de uma ordem passa do limite.</p></div></a>",
        "<a class=\"tile\" href=\"#cadastros\" data-mod=\"cadastros\"><div class=\"img\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z\"/></svg></div><div class=\"txt\"><h3>Cadastros</h3><p>Os produtos são os blocos de construção da fábrica: matérias-primas, semiacabados e acabados, com sua estrutura e os postos.</p></div></a>",
        "</div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-geral\">",
        "<div class=\"grid kpis\" id=\"kpis\"></div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Postos de trabalho<span class=\"cont\" id=\"geral-postos-c\"></span></h2><div class=\"postos\" id=\"geral-postos\"></div></div>",
        "<div class=\"card\"><h2>Eventos recentes<span class=\"cont\">barramento</span></h2><div id=\"geral-eventos\"></div></div>",
        "</div>",
        "<div class=\"card\"><h2>Ordens em andamento</h2><div id=\"geral-ordens\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-ordens\">",
        "<div class=\"topo-ordens\"><div class=\"card legenda\" id=\"ordens-leg\"></div><span class=\"hora\" id=\"ordens-hora\"></span></div>",
        "<div class=\"card\"><h2>Nova ordem de produção</h2>",
        "<form class=\"form\" id=\"f-op\">",
        "<label>Produto<select name=\"produto\" id=\"op-produto\"></select></label>",
        "<label>Quantidade<input name=\"quantidade\" size=\"8\" required></label>",
        "<label>Posto<select name=\"posto\" id=\"op-posto\"></select></label>",
        "<button>Criar OP</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Ordens<span class=\"cont\" id=\"ordens-c\"></span></h2><div id=\"ordens\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-estoque\">",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Entrada de material</h2>",
        "<form class=\"form\" id=\"f-entrada\">",
        "<label>Produto<select name=\"produto\" id=\"ent-produto\"></select></label>",
        "<label>Quantidade<input name=\"quantidade\" size=\"8\" required></label>",
        "<label>Origem<input name=\"origem\" placeholder=\"NF / fornecedor\" size=\"14\"></label>",
        "<button>Registrar</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Ajuste de inventário</h2>",
        "<form class=\"form\" id=\"f-ajuste\">",
        "<label>Produto<select name=\"produto\" id=\"aj-produto\"></select></label>",
        "<label>Saldo contado<input name=\"saldo\" size=\"8\" required></label>",
        "<label>Motivo<input name=\"motivo\" size=\"14\"></label>",
        "<button>Ajustar</button>",
        "</form></div>",
        "</div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Saldos<span class=\"cont\" id=\"saldos-c\"></span></h2><div id=\"saldos\"></div></div>",
        "<div class=\"card\"><h2>Últimos movimentos</h2><div id=\"movimentos\"></div></div>",
        "</div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-manutencao\">",
        "<div class=\"grid kpis\" id=\"man-kpis\"></div>",
        "<div class=\"card\"><h2>Estado dos postos<span class=\"cont\">disponibilidade na janela de 8 h</span></h2><div class=\"postos\" id=\"man-postos\"></div></div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Abrir parada</h2>",
        "<form class=\"form\" id=\"f-parada\">",
        "<label>Posto<select name=\"posto\" id=\"par-posto\"></select></label>",
        "<label>Categoria<select name=\"categoria\"><option value=\"MECANICA\">Mecânica</option><option value=\"ELETRICA\">Elétrica</option><option value=\"SETUP\">Setup</option><option value=\"FALTA_MATERIAL\">Falta de material</option><option value=\"QUALIDADE\">Qualidade</option><option value=\"OUTROS\">Outros</option></select></label>",
        "<label>Motivo<input name=\"motivo\" size=\"22\" required></label>",
        "<label>Começou há (min)<input name=\"ha_minutos\" size=\"4\" value=\"0\"></label>",
        "<button class=\"bad\">Parar posto</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Minutos parados por categoria</h2><div id=\"man-cat\"></div></div>",
        "</div>",
        "<div class=\"card\"><h2>Paradas</h2><div id=\"paradas\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-qualidade\">",
        "<div class=\"card\"><h2>Registrar não conformidade</h2>",
        "<form class=\"form\" id=\"f-nc\">",
        "<label>OP<input name=\"op\" size=\"5\"></label>",
        "<label>Produto<select name=\"produto\" id=\"nc-produto\"></select></label>",
        "<label>Motivo<input name=\"motivo\" size=\"30\" required></label>",
        "<button>Registrar NC</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Não conformidades<span class=\"cont\" id=\"ncs-c\"></span></h2><div id=\"ncs\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-cadastros\">",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Novo produto</h2>",
        "<form class=\"form\" id=\"f-produto\">",
        "<label>Código<input name=\"codigo\" size=\"10\" required></label>",
        "<label>Descrição<input name=\"descricao\" size=\"20\"></label>",
        "<label>Unid.<input name=\"unidade\" size=\"4\" value=\"UN\"></label>",
        "<label>Tipo<select name=\"tipo\"><option value=\"MP\">MP · matéria-prima</option><option value=\"SA\">SA · semiacabado</option><option value=\"PA\">PA · acabado</option></select></label>",
        "<button>Salvar</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Novo posto de trabalho</h2>",
        "<form class=\"form\" id=\"f-posto\">",
        "<label>Código<input name=\"codigo\" size=\"10\" required></label>",
        "<label>Descrição<input name=\"descricao\" size=\"20\"></label>",
        "<label>Capacidade (h/dia)<input name=\"capacidade_h\" size=\"5\" value=\"8\"></label>",
        "<button>Salvar</button>",
        "</form></div>",
        "</div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Produtos<span class=\"cont\" id=\"produtos-c\"></span></h2><div id=\"produtos\"></div></div>",
        "<div class=\"card\"><h2>Estrutura do produto (BOM)</h2>",
        "<form class=\"form\" id=\"f-bom\">",
        "<label>Produto<select name=\"produto\" id=\"bom-produto\"></select></label>",
        "<label>Componente<select name=\"componente\" id=\"bom-comp\"></select></label>",
        "<label>Qtd. por unidade<input name=\"quantidade\" size=\"6\" required></label>",
        "<button>Incluir</button>",
        "</form>",
        "<div id=\"bom\" style=\"margin-top:12px\"></div></div>",
        "</div>",
        "<div class=\"card\"><h2>Postos de trabalho</h2><div id=\"postos-cad\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-eventos\">",
        "<div class=\"card\"><h2>Barramento de eventos<span class=\"cont\">últimos 100</span></h2><div id=\"eventos\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-modulos\">",
        "<div class=\"card\"><h2>Módulos registrados<span class=\"cont\">internos e plugins</span></h2><div id=\"modulos\"></div></div>",
        "</section>",
        "</main>",
        "<footer class=\"rodape\"><div id=\"versao\">EMP - Engineering Modular Process</div><div>Gestão modular da linha de produção</div></footer>",
        "</div>",
        "<div id=\"toast\"></div>",
        "<script>",
        "var TITULOS = {inicio:[\"Início\",\"\"],geral:[\"Visão geral\",\"Linha de produção em tempo real\"],ordens:[\"Ordens de produção\",\"Planejar, liberar e apontar\"],estoque:[\"Estoque\",\"Saldos, entradas e baixa automática por estrutura\"],manutencao:[\"Manutenção\",\"Paradas de posto e disponibilidade\"],qualidade:[\"Qualidade\",\"Não conformidades — plugin externo\"],cadastros:[\"Cadastros\",\"Produtos, estrutura e postos\"],eventos:[\"Eventos\",\"O que os módulos publicaram\"],modulos:[\"Módulos\",\"Núcleo, módulos internos e plugins\"]};",
        "var ROT = {EM_PRODUCAO:\"EM PRODUÇÃO\",CONCLUIDA:\"CONCLUÍDA\",MECANICA:\"MECÂNICA\",ELETRICA:\"ELÉTRICA\",FALTA_MATERIAL:\"FALTA DE MATERIAL\",ENTRADA_PRODUCAO:\"ENTRADA PRODUÇÃO\"};",
        "var ESTADO = {PLANEJADA:\"plan\",LIBERADA:\"wait\",EM_PRODUCAO:\"act\",CONCLUIDA:\"ok\",CANCELADA:\"bad\",OPERANDO:\"ok\",PARADO:\"bad\",ABERTA:\"bad\",ENCERRADA:\"ok\",ativo:\"ok\",falhou:\"bad\"};",
        "var LEGENDA = [[\"PLANEJADA\",\"planejada\",\"var(--plan)\"],[\"LIBERADA\",\"liberada\",\"var(--wait)\"],[\"EM_PRODUCAO\",\"em produção\",\"var(--blue-l)\"],[\"CONCLUIDA\",\"concluída\",\"var(--blue-d)\"],[\"CANCELADA\",\"cancelada\",\"var(--bad)\"]];",
        "function rot(s) { s = String(s == null ? \"\" : s); return ROT[s] || s.replace(/_/g, \" \"); }",
        "var ativos = {};",
        "var cache = {produtos: [], postos: []};",
        "var tk = document.getElementById(\"token\");",
        "try { tk.value = localStorage.getItem(\"emp_token\") || \"\"; } catch (e) {}",
        "tk.onchange = function () { try { localStorage.setItem(\"emp_token\", tk.value); } catch (e) {} carregar(); };",
        "",
        "function esc(s) { return String(s == null ? \"\" : s).replace(/[&<>']/g, function (c) { return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",\"'\":\"&#39;\"}[c]; }); }",
        "function num(n, d) { var v = Number(n || 0); return v.toLocaleString(\"pt-BR\", {maximumFractionDigits: d == null ? 2 : d}); }",
        "function hora(ms) { return ms ? new Date(ms).toLocaleTimeString(\"pt-BR\", {hour: \"2-digit\", minute: \"2-digit\"}) : \"\"; }",
        "function dataHora(ms) { return ms ? new Date(ms).toLocaleString(\"pt-BR\", {day: \"2-digit\", month: \"2-digit\", hour: \"2-digit\", minute: \"2-digit\"}) : \"\"; }",
        "function dur(min) { min = Math.max(0, Math.round(min)); return min < 60 ? min + \" min\" : Math.floor(min / 60) + \" h \" + (min % 60) + \" min\"; }",
        "function tag(s) { var k = String(s).split(\":\")[0]; return \"<span class='tag st-\" + (ESTADO[k] || \"plan\") + \"'><i></i>\" + esc(rot(s).toLowerCase()) + \"</span>\"; }",
        "function toast(msg, erro) { var d = document.createElement(\"div\"); d.textContent = msg; if (erro) d.className = \"erro\"; document.getElementById(\"toast\").appendChild(d); setTimeout(function () { d.remove(); }, 4200); }",
        "function tabela(cols, linhas, vazio) {",
        "  if (!linhas.length) return \"<div class='vazio'>\" + (vazio || \"Nada por aqui ainda.\") + \"</div>\";",
        "  var h = \"<table><thead><tr>\" + cols.map(function (c) { return \"<th\" + (c[1] ? \" class='num'\" : \"\") + \">\" + c[0] + \"</th>\"; }).join(\"\") + \"</tr></thead><tbody>\";",
        "  return h + linhas.map(function (l) { return \"<tr>\" + l.map(function (v, i) { return \"<td\" + (cols[i][1] ? \" class='num'\" : \"\") + \">\" + v + \"</td>\"; }).join(\"\") + \"</tr>\"; }).join(\"\") + \"</tbody></table>\";",
        "}",
        "",
        "function api(metodo, caminho, corpo) {",
        "  var op = {method: metodo, headers: {}};",
        "  if (tk.value) op.headers.Authorization = \"Bearer \" + tk.value;",
        "  if (corpo) { op.headers[\"Content-Type\"] = \"application/x-www-form-urlencoded\"; op.body = new URLSearchParams(corpo).toString(); }",
        "  return fetch(caminho, op).then(function (r) {",
        "    return r.text().then(function (t) {",
        "      var j = null; try { j = JSON.parse(t); } catch (e) {}",
        "      if (!r.ok) throw new Error((j && j.erro) || (\"HTTP \" + r.status));",
        "      return j;",
        "    });",
        "  });",
        "}",
        "function tenta(p, padrao) { return p.catch(function () { return padrao; }); }",
        "function acao(metodo, caminho, corpo, ok) {",
        "  return api(metodo, caminho, corpo).then(function (r) { toast(ok || \"Feito.\"); carregar(); return r; })",
        "    .catch(function (e) { toast(e.message, true); });",
        "}",
        "function ligarForm(id, metodo, caminho, ok) {",
        "  document.getElementById(id).onsubmit = function (ev) {",
        "    ev.preventDefault();",
        "    var dados = Object.fromEntries(new FormData(ev.target).entries());",
        "    acao(metodo, typeof caminho === \"function\" ? caminho(dados) : caminho, dados, ok).then(function (r) { if (r) ev.target.reset(); });",
        "  };",
        "}",
        "",
        "function opcoes(sel, itens, valor, rotulo) {",
        "  var el = document.getElementById(sel); if (!el) return;",
        "  var atual = el.value;",
        "  el.innerHTML = itens.map(function (i) { return \"<option value='\" + esc(valor(i)) + \"'>\" + esc(rotulo(i)) + \"</option>\"; }).join(\"\");",
        "  if (atual) el.value = atual;",
        "}",
        "function preencherSelects() {",
        "  var p = cache.produtos, prod = function (i) { return i.codigo; }, rot = function (i) { return i.codigo + \" · \" + (i.descricao || \"\"); };",
        "  opcoes(\"op-produto\", p.filter(function (i) { return i.tipo !== \"MP\"; }), prod, rot);",
        "  [\"ent-produto\", \"aj-produto\", \"bom-comp\", \"nc-produto\"].forEach(function (s) { opcoes(s, p, prod, rot); });",
        "  opcoes(\"bom-produto\", p.filter(function (i) { return i.tipo !== \"MP\"; }), prod, rot);",
        "  var postos = [{codigo: \"\", descricao: \"— sem posto —\"}].concat(cache.postos);",
        "  opcoes(\"op-posto\", postos, prod, function (i) { return i.codigo ? i.codigo + \" · \" + (i.descricao || \"\") : i.descricao; });",
        "  opcoes(\"par-posto\", cache.postos, prod, rot);",
        "}",
        "",
        "function cartaoPosto(p) {",
        "  var par = p.parada;",
        "  return \"<div class='posto \" + p.estado + \"'><b>\" + esc(p.posto.codigo) + \"</b><div class='d'>\" + esc(p.posto.descricao) + \"</div>\" + tag(p.estado) +",
        "    \" <span style='float:right;font-weight:700'>\" + num(p.disponibilidade_pct, 1) + \"%</span>\" +",
        "    \"<div class='barra' style='margin-top:10px'><i style='width:\" + Math.max(0, Math.min(100, p.disponibilidade_pct)) + \"%;background:\" + (p.disponibilidade_pct < 85 ? \"var(--warn)\" : \"var(--blue)\") + \"'></i></div>\" +",
        "    (par ? \"<div class='m'>\" + esc(rot(par.categoria)) + \" · desde \" + hora(par.inicio) + \"<br>\" + esc(par.motivo) + \"</div>\" : \"\") + \"</div>\";",
        "}",
        "function dados(s) {",
        "  return String(s || \"\").split(\"&\").map(function (par) {",
        "    var t = par.replace(/\\+/g, \" \");",
        "    try { t = decodeURIComponent(t); } catch (e) {}",
        "    return t.replace(\"=\", \": \");",
        "  }).join(\"   \");",
        "}",
        "function linhaEvento(e) {",
        "  return \"<div class='ev'><span class='h'>\" + hora(e.ts) + \"</span><span class='tp'>\" + esc(e.tipo) + \"</span><span class='dd'>\" + esc(e.origem) + \" · \" + esc(dados(e.dados)) + \"</span></div>\";",
        "}",
        "function progresso(o) {",
        "  var pct = o.quantidade ? Math.min(100, 100 * o.produzido / o.quantidade) : 0;",
        "  return \"<div style='display:flex;gap:8px;align-items:center'><div class='barra' style='flex:1'><i style='width:\" + pct + \"%'></i></div><span style='font-size:12px;color:var(--muted)'>\" + Math.round(pct) + \"%</span></div>\";",
        "}",
        "function porId(a, b) { return b.id - a.id; }",
        "function kpi(x) { return \"<div class='card kpi \" + x[3] + \"'><div class='rot'>\" + x[0] + \"</div><div class='val'>\" + x[1] + \"</div><div class='det'>\" + x[2] + \"</div></div>\"; }",
        "",
        "var telas = {",
        "  inicio: function () { return Promise.resolve(); },",
        "  geral: function () {",
        "    return Promise.all([",
        "      tenta(api(\"GET\", \"/api/producao/indicadores\"), null), tenta(api(\"GET\", \"/api/producao/ordens\"), []),",
        "      tenta(api(\"GET\", \"/api/manutencao/postos\"), []), tenta(api(\"GET\", \"/api/estoque/saldos\"), {}),",
        "      ativos.qualidade ? tenta(api(\"GET\", \"/api/qualidade/ncs\"), []) : Promise.resolve(null), tenta(api(\"GET\", \"/api/sistema/eventos?n=8\"), [])",
        "    ]).then(function (r) {",
        "      var ind = r[0] || {ordens: {}, produzido: 0, refugo: 0, refugo_pct: 0}, ops = r[1], postos = r[2], saldos = r[3], ncs = r[4], evs = r[5];",
        "      var abertas = ops.filter(function (o) { return [\"PLANEJADA\", \"LIBERADA\", \"EM_PRODUCAO\"].indexOf(o.status) >= 0; });",
        "      var parados = postos.filter(function (p) { return p.estado === \"PARADO\"; }).length;",
        "      var negativos = Object.keys(saldos).filter(function (k) { return Number(saldos[k]) < 0; }).length;",
        "      var disp = postos.length ? postos.reduce(function (s, p) { return s + p.disponibilidade_pct; }, 0) / postos.length : 100;",
        "      var k = [",
        "        [\"OPs em aberto\", abertas.length, (ind.ordens.EM_PRODUCAO || 0) + \" em produção\", \"\"],",
        "        [\"Produzido (boas)\", num(ind.produzido, 0), \"peças apontadas\", \"bom\"],",
        "        [\"Refugo\", num(ind.refugo_pct, 2) + \"%\", num(ind.refugo, 0) + \" peças\", ind.refugo_pct > 5 ? \"alerta\" : \"\"],",
        "        [\"Disponibilidade\", num(disp, 1) + \"%\", parados + \" posto(s) parado(s) agora\", disp < 85 ? \"alerta\" : \"bom\"],",
        "        [\"Alertas de estoque\", negativos, \"saldos negativos\", negativos ? \"alerta\" : \"bom\"]",
        "      ];",
        "      if (ncs) k.push([\"NCs abertas\", ncs.filter(function (n) { return n.status === \"ABERTA\"; }).length, \"qualidade\", \"\"]);",
        "      document.getElementById(\"kpis\").innerHTML = k.map(kpi).join(\"\");",
        "      document.getElementById(\"geral-postos\").innerHTML = postos.map(cartaoPosto).join(\"\") || \"<div class='vazio'>Nenhum posto cadastrado.</div>\";",
        "      document.getElementById(\"geral-postos-c\").textContent = (postos.length - parados) + \"/\" + postos.length + \" operando\";",
        "      document.getElementById(\"geral-eventos\").innerHTML = evs.map(linhaEvento).join(\"\") || \"<div class='vazio'>Sem eventos.</div>\";",
        "      document.getElementById(\"geral-ordens\").innerHTML = tabela([[\"OP\"], [\"Produto\"], [\"Posto\"], [\"Estado\"], [\"Progresso\"], [\"Produzido\", 1], [\"Refugo\", 1]],",
        "        abertas.sort(porId).map(function (o) { return [\"#\" + o.id, esc(o.produto), esc(o.posto || \"—\"), tag(o.status), progresso(o), num(o.produzido, 0) + \" / \" + num(o.quantidade, 0), num(o.refugo, 0)]; }), \"Nenhuma OP em aberto.\");",
        "    });",
        "  },",
        "  ordens: function () {",
        "    return api(\"GET\", \"/api/producao/ordens\").then(function (ops) {",
        "      var n = {}; ops.forEach(function (o) { n[o.status] = (n[o.status] || 0) + 1; });",
        "      document.getElementById(\"ordens-leg\").innerHTML = \"<h2>Ordens por estado</h2>\" + LEGENDA.map(function (l) { return \"<div><i style='background:\" + l[2] + \"'></i>\" + l[1] + \": <b>\" + (n[l[0]] || 0) + \"</b></div>\"; }).join(\"\");",
        "      document.getElementById(\"ordens-hora\").textContent = new Date().toLocaleTimeString(\"pt-BR\");",
        "      document.getElementById(\"ordens-c\").textContent = ops.length + \" no total\";",
        "      document.getElementById(\"ordens\").innerHTML = tabela([[\"Número da ordem\"], [\"Produto\"], [\"Posto\"], [\"Estado\"], [\"Progresso\"], [\"Qtd.\", 1], [\"Boas\", 1], [\"Refugo\", 1], [\"Criada\"], [\"Ações\"]],",
        "        ops.sort(porId).map(function (o) {",
        "          var a = \"\";",
        "          if (o.status === \"PLANEJADA\") a += \"<button class='mini' onclick='liberar(\" + o.id + \")'>Liberar</button> \";",
        "          if (o.status === \"LIBERADA\" || o.status === \"EM_PRODUCAO\") a += \"<input id='b\" + o.id + \"' size='4' placeholder='boas'> <input id='r\" + o.id + \"' size='4' placeholder='refugo'> <button class='mini ok' onclick='apontar(\" + o.id + \")'>Apontar</button> \";",
        "          if (o.status === \"PLANEJADA\" || o.status === \"LIBERADA\") a += \"<button class='mini sec' onclick='cancelar(\" + o.id + \")'>cancelar</button>\";",
        "          return [String(o.id), esc(o.produto), esc(o.posto || \"—\"), tag(o.status), progresso(o), num(o.quantidade, 0), num(o.produzido, 0), num(o.refugo, 0), dataHora(o.criada_em), a];",
        "        }), \"Nenhuma ordem criada.\");",
        "    });",
        "  },",
        "  estoque: function () {",
        "    return Promise.all([api(\"GET\", \"/api/estoque/saldos\"), api(\"GET\", \"/api/estoque/movimentos\")]).then(function (r) {",
        "      var s = r[0], desc = {};",
        "      cache.produtos.forEach(function (p) { desc[p.codigo] = p; });",
        "      var cods = Object.keys(s).sort();",
        "      document.getElementById(\"saldos-c\").textContent = cods.length + \" itens\";",
        "      document.getElementById(\"saldos\").innerHTML = tabela([[\"Produto\"], [\"Descrição\"], [\"Tipo\"], [\"Saldo\", 1]], cods.map(function (c) {",
        "        var p = desc[c] || {}, v = Number(s[c]);",
        "        return [esc(c), esc(p.descricao || \"\"), esc(p.tipo || \"\"), \"<span class='\" + (v < 0 ? \"neg\" : \"\") + \"'>\" + num(v) + \" \" + esc(p.unidade || \"\") + \"</span>\"];",
        "      }));",
        "      document.getElementById(\"movimentos\").innerHTML = tabela([[\"Hora\"], [\"Produto\"], [\"Tipo\"], [\"Qtd.\", 1], [\"Saldo\", 1], [\"Origem\"]],",
        "        r[1].sort(porId).slice(0, 14).map(function (m) { return [hora(m.ts), esc(m.produto), esc(rot(m.tipo).toLowerCase()), \"<span class='\" + (m.quantidade < 0 ? \"neg\" : \"\") + \"'>\" + num(m.quantidade) + \"</span>\", num(m.saldo), esc(m.origem)]; }));",
        "    });",
        "  },",
        "  manutencao: function () {",
        "    return Promise.all([api(\"GET\", \"/api/manutencao/postos\"), api(\"GET\", \"/api/manutencao/paradas\"), api(\"GET\", \"/api/manutencao/indicadores\")]).then(function (r) {",
        "      var postos = r[0], par = r[1], ind = r[2];",
        "      var disp = postos.length ? postos.reduce(function (s, p) { return s + p.disponibilidade_pct; }, 0) / postos.length : 100;",
        "      document.getElementById(\"man-kpis\").innerHTML = [[\"Paradas abertas\", ind.paradas_abertas, \"agora\", ind.paradas_abertas ? \"alerta\" : \"bom\"], [\"Disponibilidade média\", num(disp, 1) + \"%\", \"janela de 8 h\", disp < 85 ? \"alerta\" : \"bom\"], [\"MTTR\", num(ind.mttr_min, 1) + \" min\", \"tempo médio de reparo\", \"\"], [\"Paradas encerradas\", ind.paradas_encerradas, \"histórico\", \"\"]].map(kpi).join(\"\");",
        "      document.getElementById(\"man-postos\").innerHTML = postos.map(cartaoPosto).join(\"\");",
        "      var cat = ind.minutos_por_categoria, cs = Object.keys(cat), maxv = Math.max.apply(null, cs.map(function (c) { return cat[c]; }).concat([1]));",
        "      document.getElementById(\"man-cat\").innerHTML = cs.length ? cs.sort(function (a, b) { return cat[b] - cat[a]; }).map(function (c) {",
        "        return \"<div style='display:grid;grid-template-columns:150px 1fr 80px;gap:10px;align-items:center;margin:8px 0'><span>\" + esc(rot(c).toLowerCase()) + \"</span><div class='barra'><i style='width:\" + (100 * cat[c] / maxv) + \"%'></i></div><span class='num' style='text-align:right'>\" + dur(cat[c]) + \"</span></div>\";",
        "      }).join(\"\") : \"<div class='vazio'>Sem paradas registradas.</div>\";",
        "      document.getElementById(\"paradas\").innerHTML = tabela([[\"#\"], [\"Posto\"], [\"Categoria\"], [\"Motivo\"], [\"Início\"], [\"Duração\", 1], [\"Estado\"], [\"Ação\"]], par.sort(porId).map(function (p) {",
        "        var fim = p.status === \"ABERTA\" ? Date.now() : p.fim;",
        "        return [String(p.id), esc(p.posto), esc(rot(p.categoria).toLowerCase()), esc(p.motivo) + (p.solucao ? \"<br><small style='color:var(--muted)'>\" + esc(p.solucao) + \"</small>\" : \"\"), dataHora(p.inicio), dur((fim - p.inicio) / 60000), tag(p.status),",
        "          p.status === \"ABERTA\" ? \"<input id='sol\" + p.id + \"' size='14' placeholder='solução'> <button class='mini ok' onclick='encerrar(\" + p.id + \")'>Encerrar</button>\" : \"\"];",
        "      }), \"Nenhuma parada registrada.\");",
        "    });",
        "  },",
        "  qualidade: function () {",
        "    return api(\"GET\", \"/api/qualidade/ncs\").then(function (ncs) {",
        "      document.getElementById(\"ncs-c\").textContent = ncs.filter(function (n) { return n.status === \"ABERTA\"; }).length + \" abertas\";",
        "      document.getElementById(\"ncs\").innerHTML = tabela([[\"#\"], [\"OP\"], [\"Produto\"], [\"Motivo\"], [\"Origem\"], [\"Registrada\"], [\"Estado\"]],",
        "        ncs.sort(porId).map(function (n) { return [String(n.id), n.op ? esc(n.op) : \"—\", esc(n.produto), esc(n.motivo), esc(n.origem), dataHora(n.ts), tag(n.status)]; }), \"Nenhuma não conformidade.\");",
        "    });",
        "  },",
        "  cadastros: function () {",
        "    var pai = document.getElementById(\"bom-produto\").value;",
        "    return (pai ? api(\"GET\", \"/api/cadastros/estrutura?produto=\" + encodeURIComponent(pai)) : Promise.resolve([])).then(function (bom) {",
        "      document.getElementById(\"produtos-c\").textContent = cache.produtos.length + \" produtos\";",
        "      document.getElementById(\"produtos\").innerHTML = tabela([[\"Código\"], [\"Descrição\"], [\"Unid.\"], [\"Tipo\"]], cache.produtos.map(function (p) { return [esc(p.codigo), esc(p.descricao), esc(p.unidade), esc(p.tipo)]; }));",
        "      document.getElementById(\"bom\").innerHTML = tabela([[\"Componente\"], [\"Qtd. por unidade\", 1]], bom.map(function (b) { return [esc(b.componente), num(b.quantidade, 4)]; }), \"Selecione um produto com estrutura.\");",
        "      document.getElementById(\"postos-cad\").innerHTML = tabela([[\"Código\"], [\"Descrição\"], [\"Capacidade\", 1]], cache.postos.map(function (p) { return [esc(p.codigo), esc(p.descricao), num(p.capacidade_h, 1) + \" h/dia\"]; }));",
        "    });",
        "  },",
        "  eventos: function () {",
        "    return api(\"GET\", \"/api/sistema/eventos?n=100\").then(function (evs) { document.getElementById(\"eventos\").innerHTML = evs.map(linhaEvento).join(\"\") || \"<div class='vazio'>Sem eventos.</div>\"; });",
        "  },",
        "  modulos: function () {",
        "    return api(\"GET\", \"/api/sistema/modulos\").then(function (ms) {",
        "      document.getElementById(\"modulos\").innerHTML = tabela([[\"Módulo\"], [\"Nome\"], [\"Versão\"], [\"Prefixo\"], [\"Assina\"], [\"Estado\"]],",
        "        ms.map(function (m) { return [\"<b>\" + esc(m.id) + \"</b>\", esc(m.nome), esc(m.versao), \"<code>\" + esc(m.prefixo) + \"</code>\", esc((m.assina || []).join(\", \") || \"—\"), tag(m.estado)]; }));",
        "    });",
        "  }",
        "};",
        "",
        "window.liberar = function (id) { acao(\"POST\", \"/api/producao/liberar?id=\" + id, null, \"OP \" + id + \" liberada.\"); };",
        "window.cancelar = function (id) { acao(\"POST\", \"/api/producao/cancelar?id=\" + id, null, \"OP \" + id + \" cancelada.\"); };",
        "window.apontar = function (id) { acao(\"POST\", \"/api/producao/apontar?id=\" + id, {boa: document.getElementById(\"b\" + id).value || \"0\", refugo: document.getElementById(\"r\" + id).value || \"0\"}, \"Apontamento registrado na OP \" + id + \".\"); };",
        "window.encerrar = function (id) { acao(\"POST\", \"/api/manutencao/encerrar?id=\" + id, {solucao: document.getElementById(\"sol\" + id).value}, \"Parada \" + id + \" encerrada.\"); };",
        "",
        "ligarForm(\"f-op\", \"POST\", \"/api/producao/ordens\", \"OP criada.\");",
        "ligarForm(\"f-entrada\", \"POST\", \"/api/estoque/entrada\", \"Entrada registrada.\");",
        "ligarForm(\"f-ajuste\", \"POST\", \"/api/estoque/ajuste\", \"Inventário ajustado.\");",
        "ligarForm(\"f-parada\", \"POST\", \"/api/manutencao/paradas\", \"Parada aberta.\");",
        "ligarForm(\"f-nc\", \"POST\", \"/api/qualidade/ncs\", \"Não conformidade registrada.\");",
        "ligarForm(\"f-produto\", \"POST\", \"/api/cadastros/produtos\", \"Produto salvo.\");",
        "ligarForm(\"f-posto\", \"POST\", \"/api/cadastros/postos\", \"Posto salvo.\");",
        "ligarForm(\"f-bom\", \"POST\", \"/api/cadastros/estrutura\", \"Componente incluído.\");",
        "document.getElementById(\"bom-produto\").onchange = function () { telas.cadastros(); };",
        "",
        "// Menu lateral (☰), menu do usuário e trilho de ações, como no MES4.",
        "var drawer = document.getElementById(\"drawer\"), veu = document.getElementById(\"veu\"), menuUser = document.getElementById(\"menu-user\");",
        "function menu(abrir) { drawer.classList.toggle(\"aberto\", abrir); veu.classList.toggle(\"aberto\", abrir); }",
        "document.getElementById(\"btn-menu\").onclick = function () { menu(!drawer.classList.contains(\"aberto\")); };",
        "veu.onclick = function () { menu(false); };",
        "drawer.onclick = function (ev) { if (ev.target.closest(\"a\")) menu(false); };",
        "document.getElementById(\"btn-user\").onclick = function (ev) { ev.stopPropagation(); menuUser.classList.toggle(\"aberto\"); if (menuUser.classList.contains(\"aberto\")) tk.focus(); };",
        "menuUser.onclick = function (ev) { ev.stopPropagation(); };",
        "document.addEventListener(\"click\", function () { menuUser.classList.remove(\"aberto\"); });",
        "document.getElementById(\"btn-sino\").onclick = function () { location.hash = ativos.manutencao ? \"#manutencao\" : \"#geral\"; };",
        "document.getElementById(\"btn-atualizar\").onclick = function () { carregar().then(function () { toast(\"Atualizado.\"); }); };",
        "document.getElementById(\"btn-novo\").onclick = function () {",
        "  var f = document.querySelector(\".secao.ativa form\"); if (!f) return;",
        "  var card = f.closest(\".card\");",
        "  card.scrollIntoView({behavior: \"smooth\", block: \"center\"});",
        "  card.classList.add(\"destaque\"); setTimeout(function () { card.classList.remove(\"destaque\"); }, 1600);",
        "  var c = f.querySelector(\"input,select\"); if (c) c.focus({preventScroll: true});",
        "};",
        "",
        "function secaoAtual() { var s = (location.hash || \"#inicio\").slice(1); return telas[s] ? s : \"inicio\"; }",
        "function mostrar() {",
        "  var s = secaoAtual();",
        "  document.querySelectorAll(\".secao\").forEach(function (el) { el.classList.toggle(\"ativa\", el.id === \"s-\" + s); });",
        "  document.querySelectorAll(\"nav a\").forEach(function (a) { a.classList.toggle(\"ativo\", a.dataset.sec === s); });",
        "  document.getElementById(\"titulo\").textContent = TITULOS[s][0];",
        "  document.getElementById(\"subtitulo\").textContent = TITULOS[s][1];",
        "  document.getElementById(\"crumb\").innerHTML = s === \"inicio\" ? \"<b>Início</b>\" : \"<a href='#inicio'>Início</a><span class='sep'>&gt;</span><b>\" + esc(TITULOS[s][0]) + \"</b>\";",
        "  document.getElementById(\"btn-novo\").classList.toggle(\"oculto\", !document.querySelector(\"#s-\" + s + \" form\"));",
        "}",
        "function carregar() {",
        "  return Promise.all([",
        "    tenta(api(\"GET\", \"/api/sistema/modulos\"), null), tenta(api(\"GET\", \"/api/sistema/sessao\"), null),",
        "    tenta(api(\"GET\", \"/api/sistema/saude\"), null), tenta(api(\"GET\", \"/api/cadastros/produtos\"), []), tenta(api(\"GET\", \"/api/cadastros/postos\"), [])",
        "  ]).then(function (r) {",
        "    if (!r[0]) { document.getElementById(\"sessao\").textContent = \"sem acesso — informe o token\"; menuUser.classList.add(\"aberto\"); return; }",
        "    ativos = {}; r[0].forEach(function (m) { if (m.estado === \"ativo\") ativos[m.id] = true; });",
        "    document.querySelectorAll(\"[data-mod]\").forEach(function (a) { a.classList.toggle(\"oculto\", !ativos[a.dataset.mod]); });",
        "    if (r[1]) document.getElementById(\"sessao\").textContent = r[1].usuario + \" · \" + r[1].perfil + (r[1].modo_aberto ? \" · modo dev\" : \"\");",
        "    if (r[2]) document.getElementById(\"versao\").textContent = \"EMP - Engineering Modular Process v\" + r[2].versao + \" · \" + r[2].modulos + \" módulos\";",
        "    cache.produtos = r[3]; cache.postos = r[4];",
        "    preencherSelects();",
        "    Promise.all([",
        "      ativos.manutencao ? tenta(api(\"GET\", \"/api/manutencao/indicadores\"), null) : Promise.resolve(null),",
        "      ativos.qualidade ? tenta(api(\"GET\", \"/api/qualidade/ncs\"), []) : Promise.resolve([])",
        "    ]).then(function (a) {",
        "      var n = (a[0] ? a[0].paradas_abertas : 0) + a[1].filter(function (x) { return x.status === \"ABERTA\"; }).length;",
        "      document.getElementById(\"alertas\").textContent = n ? String(n) : \"\";",
        "      document.getElementById(\"btn-sino\").title = n ? n + \" alerta(s): paradas e NCs abertas\" : \"Sem alertas\";",
        "    });",
        "    var s = secaoAtual();",
        "    return telas[s]().catch(function (e) { toast(e.message, true); });",
        "  });",
        "}",
        "window.onhashchange = function () { mostrar(); carregar(); };",
        "mostrar();",
        "carregar();",
        "// Não redesenha enquanto o usuário digita: nem com campo focado, nem com",
        "// um campo de tabela (apontamento, solução) já preenchido e ainda não enviado.",
        "function digitando() {",
        "  if (document.querySelector(\"input:focus,select:focus\")) return true;",
        "  return Array.prototype.some.call(document.querySelectorAll(\".secao.ativa td input\"), function (i) { return i.value !== \"\"; });",
        "}",
        "setInterval(function () { if (!digitando()) carregar(); }, 6000);",
        "</script>",
        "</body>",
        "</html>"
    ];
}

pub fn pagina() -> string ={
    return join(_linhas(), "\n");
}
