// ============================================================
//  painel.cryo — painel web do EMP, servido pelo próprio núcleo
//
//  O navegador só executa HTML/CSS/JS, então a página vive aqui como
//  texto: UMA string Cryo por linha da página, unidas por join. Assim
//  o binário continua sendo um único .exe, sem arquivos ao lado.
//
//  Visual: sistema de design "Forja" (docs/DESIGN_SYSTEM.md) — tokens
//  em :root (claro e escuro), console grafite flutuante, laranja-forja
//  como cor de assinatura, medidores circulares nos postos, barras de
//  LED no progresso e listras de perigo para posto parado.
//
//  A página descobre os módulos ativos em /api/sistema/modulos e
//  esconde menus e blocos dos que não estão no ar — um módulo removido
//  some sem alterar este arquivo.
//
//  Telas: início, visão geral, ordens, estoque, manutenção, qualidade
//  (plugin), cadastros, eventos e módulos. Deep-link pelo hash: /#manutencao
//
//  Ao editar: aspas viram \", barras invertidas \\ e `${` vira
//  \${ (senão é interpolação Cryo).
// ============================================================

fn _linhas() -> string[] ={
    return [
        "<!doctype html>",
        "<html lang=\"pt-br\">",
        "<head>",
        "<meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">",
        "<title>EMP · Engineering Modular Process</title>",
        "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">",
        "<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap\" rel=\"stylesheet\">",
        "<style>",
        "/* ── Forja · tokens ─────────────────────────────────────── */",
        ":root{--bg:#f4f1ec;--dot:#ddd6ca;--surface:#fff;--surface-2:#faf8f5;--ink:#1b1d22;--ink-2:#4a4f59;--muted:#676c75;--line:#e9e4db;--console:#16181d;--console-2:#23262d;--console-ink:#c3c7cf;--forja:#ff5a1f;--forja-2:#ff9a3d;--forja-soft:#ffe9de;--forja-ink:#b23a0a;--ok:#0f9f6e;--ok-soft:#dcf4ea;--ok-ink:#0b7350;--warn:#e08a00;--warn-soft:#fcefd6;--bad:#e5383b;--bad-soft:#fde4e4;--bad-ink:#b8262a;--bad-strong:#c92a2a;--info:#3d6be0;--info-soft:#e4ebfc;--info-ink:#2a4fb8;--on-forja:#16181d;--neutral-soft:#efece6;--r-sm:10px;--r-md:16px;--r-lg:22px;--r-xl:28px;--sh-1:0 1px 2px rgba(27,29,34,.05),0 6px 18px rgba(27,29,34,.05);--sh-2:0 18px 40px rgba(27,29,34,.14);--glow:0 10px 24px rgba(255,90,31,.35);--f-display:\"Space Grotesk\",\"Segoe UI Variable Display\",\"Segoe UI\",system-ui,sans-serif;--f-body:\"Inter\",\"Segoe UI\",system-ui,sans-serif;--f-mono:\"JetBrains Mono\",Consolas,\"Cascadia Mono\",monospace;--ease:cubic-bezier(.2,.8,.2,1)}",
        "@media (prefers-color-scheme:dark){:root{--bg:#0f1115;--dot:#1e2129;--surface:#171a20;--surface-2:#1d2027;--ink:#eef0f4;--ink-2:#b6bbc5;--muted:#8b919c;--forja-ink:#ff8a57;--ok-ink:#3fd39b;--bad-ink:#ff7b7d;--info-ink:#8aa8ff;--line:#272b34;--console:#0a0b0e;--console-2:#1a1d23;--forja-soft:#3a1d12;--ok-soft:#0f2e24;--warn-soft:#33260c;--bad-soft:#3a1617;--info-soft:#17223f;--neutral-soft:#23262d;--sh-1:0 1px 2px rgba(0,0,0,.3),0 6px 18px rgba(0,0,0,.25);--sh-2:0 18px 40px rgba(0,0,0,.5)}}",
        "*{box-sizing:border-box}",
        "body{margin:0;font-family:var(--f-body);font-size:14px;line-height:1.5;color:var(--ink);background:var(--bg);background-image:radial-gradient(var(--dot) 1px,transparent 1.2px);background-size:22px 22px;-webkit-font-smoothing:antialiased}",
        "svg{display:block}",
        "a{color:var(--forja-ink)}",
        ":focus-visible{outline:3px solid var(--forja);outline-offset:2px}",
        ".mono{font-family:var(--f-mono)}",
        "/* ── estrutura ──────────────────────────────────────────── */",
        ".app{display:grid;grid-template-columns:262px 1fr;min-height:100vh}",
        ".console{position:sticky;top:14px;margin:14px 0 14px 14px;height:calc(100vh - 28px);background:var(--console);color:var(--console-ink);border-radius:var(--r-xl);display:flex;flex-direction:column;padding:20px 14px 14px;box-shadow:var(--sh-2);overflow:hidden}",
        ".console::before{content:\"\";position:absolute;inset:auto -60px -80px auto;width:220px;height:220px;background:radial-gradient(circle,rgba(255,90,31,.28),transparent 65%);pointer-events:none}",
        ".marca{display:flex;align-items:center;gap:12px;padding:0 8px 22px}",
        ".marca svg{width:38px;height:38px;flex:none}",
        ".marca b{display:block;font-family:var(--f-display);font-size:22px;letter-spacing:.5px;color:#fff;line-height:1}",
        ".marca small{display:block;font-family:var(--f-mono);font-size:9px;letter-spacing:1.4px;color:#8a909b;margin-top:5px}",
        ".console h3{font-family:var(--f-mono);font-size:10px;letter-spacing:1.6px;color:#8a909b;margin:14px 10px 6px;font-weight:600}",
        "nav a{position:relative;display:flex;align-items:center;gap:12px;padding:10px 12px;margin:2px 0;color:var(--console-ink);text-decoration:none;border-radius:12px;font-weight:500;transition:background .18s var(--ease),color .18s var(--ease)}",
        "nav a svg{width:19px;height:19px;fill:currentColor;flex:none;opacity:.85}",
        "nav a:hover{background:var(--console-2);color:#fff}",
        "nav a.ativo{background:linear-gradient(135deg,var(--forja),var(--forja-2));color:var(--on-forja);font-weight:600;box-shadow:var(--glow)}",
        "nav a.ativo svg{opacity:1}",
        "nav a.oculto{display:none}",
        "nav a .qt{margin-left:auto;font-family:var(--f-mono);font-size:11px;padding:1px 8px;border-radius:99px;background:var(--bad-strong);color:#fff}",
        "nav a .qt:empty{display:none}",
        ".operador{margin-top:auto;background:var(--console-2);border-radius:var(--r-md);padding:12px;position:relative}",
        ".operador .linha{display:flex;align-items:center;gap:10px}",
        ".avatar{width:36px;height:36px;border-radius:12px;background:linear-gradient(135deg,#3a3f4a,#22252c);display:grid;place-items:center;font-family:var(--f-display);font-weight:700;color:#fff;flex:none;border:1px solid #343944}",
        ".operador b{display:block;color:#fff;font-size:13px;font-weight:600;line-height:1.2}",
        ".operador small{font-family:var(--f-mono);font-size:10px;color:#8a909b}",
        ".operador input{width:100%;margin-top:10px;background:var(--console);border-color:#2f333c;color:#fff}",
        ".versao{font-family:var(--f-mono);font-size:10px;color:#8a909b;padding:10px 8px 0;letter-spacing:.4px}",
        "main{padding:28px 32px 40px;min-width:0}",
        ".cabeca{display:flex;align-items:flex-end;gap:16px;margin-bottom:24px;flex-wrap:wrap}",
        ".trilha{font-family:var(--f-mono);font-size:11px;letter-spacing:1.2px;color:var(--muted);text-transform:uppercase}",
        ".trilha i{font-style:normal;color:var(--forja);margin:0 6px}",
        ".cabeca h1{font-family:var(--f-display);font-size:34px;line-height:1.1;margin:6px 0 4px;font-weight:700;letter-spacing:-.6px}",
        ".cabeca .sub{color:var(--ink-2)}",
        ".cabeca .acoes{margin-left:auto;display:flex;gap:8px;align-items:center}",
        ".aovivo{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 14px;border-radius:99px;background:var(--surface);border:1px solid var(--line);font-family:var(--f-mono);font-size:12px;color:var(--ink-2);box-shadow:var(--sh-1)}",
        ".aovivo::before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--ok);color:var(--ok);animation:pulso 2s infinite}",
        ".redondo{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--surface);border:1px solid var(--line);color:var(--ink);cursor:pointer;position:relative;box-shadow:var(--sh-1);padding:0;transition:transform .18s var(--ease)}",
        ".redondo:hover{transform:translateY(-1px);color:var(--forja);box-shadow:var(--sh-1)}",
        ".redondo svg{width:18px;height:18px;fill:currentColor}",
        ".redondo .qt{position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;padding:0 5px;border-radius:99px;background:var(--bad-strong);color:#fff;font:600 10px/18px var(--f-mono);text-align:center;border:2px solid var(--bg)}",
        ".redondo .qt:empty{display:none}",
        ".oculto{display:none!important}",
        "/* ── controles ──────────────────────────────────────────── */",
        "input,select,button{font:inherit}",
        "input,select{height:40px;padding:0 12px;border:1px solid var(--line);border-radius:12px;background:var(--surface-2);color:var(--ink);min-width:0;transition:border-color .15s,box-shadow .15s}",
        "input:focus,select:focus{outline:0;border-color:var(--forja);box-shadow:0 0 0 4px var(--forja-soft);background:var(--surface)}",
        "button{height:40px;padding:0 18px;border:0;border-radius:12px;background:linear-gradient(135deg,var(--forja),var(--forja-2));color:var(--on-forja);font-weight:600;cursor:pointer;box-shadow:0 6px 16px rgba(255,90,31,.25);transition:transform .15s var(--ease),box-shadow .15s}",
        "button:hover{transform:translateY(-1px);box-shadow:var(--glow)}",
        "button:active{transform:none}",
        "button.sec{background:transparent;color:var(--ink-2);box-shadow:none;border:1px solid var(--line)}",
        "button.sec:hover{color:var(--ink);background:var(--surface-2)}",
        "button.ok{background:var(--ink);color:var(--surface);box-shadow:none}",
        "button.bad{background:var(--bad-strong);color:#fff;box-shadow:0 6px 16px rgba(229,56,59,.25)}",
        "button.mini{height:32px;padding:0 12px;font-size:12px;border-radius:10px}",
        "td input{height:32px;width:74px;border-radius:10px}",
        ".form{display:flex;flex-wrap:wrap;gap:12px;align-items:end}",
        ".form label{display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:600;color:var(--ink-2)}",
        "/* ── superfícies ────────────────────────────────────────── */",
        ".grid{display:grid;gap:18px}",
        ".secao{display:none}",
        ".secao.ativa{display:grid;animation:entra .35s var(--ease)}",
        ".kpis{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}",
        ".dois{grid-template-columns:repeat(auto-fit,minmax(380px,1fr))}",
        ".card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:20px 22px;box-shadow:var(--sh-1);min-width:0}",
        ".card>div:not(.postos){overflow-x:auto}",
        ".card h2{font-family:var(--f-display);font-size:17px;font-weight:600;margin:0 0 16px;display:flex;align-items:center;gap:10px;letter-spacing:-.2px}",
        ".card h2 .cont{margin-left:auto;font-family:var(--f-mono);font-size:11px;font-weight:500;color:var(--muted);background:var(--surface-2);border:1px solid var(--line);padding:3px 10px;border-radius:99px;letter-spacing:.2px}",
        ".card.destaque{animation:destaque 1.4s var(--ease)}",
        ".kpi{position:relative;overflow:hidden;padding:18px 20px 20px}",
        ".kpi .rot{font-family:var(--f-mono);font-size:10px;letter-spacing:1.3px;text-transform:uppercase;color:var(--muted)}",
        ".kpi .val{font-family:var(--f-display);font-size:40px;font-weight:700;line-height:1.05;margin-top:10px;letter-spacing:-1px;font-variant-numeric:tabular-nums}",
        ".kpi .det{color:var(--ink-2);font-size:12px;margin-top:4px}",
        ".kpi::after{content:\"\";position:absolute;left:20px;right:20px;bottom:0;height:3px;border-radius:3px 3px 0 0;background:var(--line)}",
        ".kpi.bom::after{background:var(--ok)}",
        ".kpi.alerta::after{background:var(--bad)}",
        ".kpi.alerta .val{color:var(--bad-ink)}",
        ".kpi .sinal{position:absolute;top:16px;right:16px;width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:var(--neutral-soft);color:var(--ink-2)}",
        ".kpi.bom .sinal{background:var(--ok-soft);color:var(--ok-ink)}",
        ".kpi.alerta .sinal{background:var(--bad-soft);color:var(--bad-ink)}",
        ".kpi .sinal svg{width:16px;height:16px;fill:currentColor}",
        "/* ── dados ──────────────────────────────────────────────── */",
        "table{width:100%;border-collapse:separate;border-spacing:0}",
        "th{text-align:left;font-family:var(--f-mono);font-size:10px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);padding:0 10px 10px;border-bottom:1px solid var(--line);white-space:nowrap}",
        "td{padding:12px 10px;border-bottom:1px solid var(--line);vertical-align:middle;white-space:nowrap}",
        "tr:last-child td{border-bottom:0}",
        "tbody tr:hover td{background:var(--surface-2)}",
        "tbody tr:hover td:first-child{border-radius:12px 0 0 12px}",
        "tbody tr:hover td:last-child{border-radius:0 12px 12px 0}",
        "td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}",
        ".id{font-family:var(--f-mono);font-size:12px;font-weight:600;padding:3px 8px;border-radius:8px;background:var(--surface-2);border:1px solid var(--line);white-space:nowrap}",
        ".tag{display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 11px;border-radius:99px;font-size:12px;font-weight:600;white-space:nowrap;background:var(--neutral-soft);color:var(--ink-2)}",
        ".tag::before{content:\"\";width:7px;height:7px;border-radius:50%;background:currentColor}",
        ".st-ok{background:var(--ok-soft);color:var(--ok-ink)}",
        ".st-wait{background:var(--info-soft);color:var(--info-ink)}",
        ".st-act{background:var(--forja-soft);color:var(--forja-ink)}",
        ".st-act::before{animation:pulso 1.6s infinite}",
        ".st-bad{color:var(--bad-ink);background:repeating-linear-gradient(-45deg,var(--bad-soft) 0 7px,var(--surface) 7px 10px);box-shadow:inset 0 0 0 1px var(--bad-soft)}",
        ".led{display:flex;gap:3px;align-items:center;min-width:130px}",
        ".led i{flex:1;height:8px;border-radius:3px;background:var(--line)}",
        ".led i.on{background:var(--forja)}",
        ".led.cheio i.on{background:var(--ok)}",
        ".led span{font-family:var(--f-mono);font-size:11px;color:var(--muted);margin-left:8px;min-width:34px;text-align:right}",
        ".barra{height:8px;background:var(--line);border-radius:99px;overflow:hidden;min-width:90px}",
        ".barra i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--forja),var(--forja-2))}",
        ".distrib{display:flex;height:14px;border-radius:99px;overflow:hidden;background:var(--line);gap:3px}",
        ".distrib i{display:block;height:100%}",
        ".chips{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:14px;font-size:13px;color:var(--ink-2)}",
        ".chips span{display:inline-flex;align-items:center;gap:8px}",
        ".chips i{width:10px;height:10px;border-radius:3px;display:inline-block}",
        ".chips b{font-family:var(--f-mono);color:var(--ink)}",
        "/* ── máquinas ───────────────────────────────────────────── */",
        ".postos{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;align-items:start}",
        ".posto{position:relative;display:grid;grid-template-columns:68px 1fr;gap:14px;align-items:center;padding:16px;border-radius:var(--r-md);background:var(--surface-2);border:1px solid var(--line);overflow:hidden}",
        ".posto b{font-family:var(--f-display);font-size:16px;font-weight:700;letter-spacing:-.2px}",
        ".posto .d{color:var(--muted);font-size:12px;margin:1px 0 8px}",
        ".posto.PARADO{border-color:var(--bad);background:var(--surface)}",
        ".posto.PARADO::before{content:\"\";position:absolute;left:0;right:0;top:0;height:6px;background:repeating-linear-gradient(-45deg,var(--bad) 0 8px,#ffd400 8px 16px)}",
        ".posto .m{grid-column:1/-1;font-size:12px;color:var(--bad-ink);background:var(--bad-soft);border-radius:10px;padding:8px 10px;line-height:1.4}",
        ".medidor{--p:0;--c:var(--ok);width:68px;height:68px;border-radius:50%;background:conic-gradient(var(--c) calc(var(--p)*1%),var(--line) 0);display:grid;place-items:center}",
        ".medidor span{width:52px;height:52px;border-radius:50%;background:var(--surface);display:grid;place-items:center;font-family:var(--f-display);font-weight:700;font-size:14px;letter-spacing:-.3px}",
        "/* ── eventos ────────────────────────────────────────────── */",
        ".linha-tempo{position:relative;padding-left:22px}",
        ".linha-tempo::before{content:\"\";position:absolute;left:6px;top:6px;bottom:6px;width:2px;background:var(--line);border-radius:2px}",
        ".ev{position:relative;display:grid;grid-template-columns:56px 1fr;gap:2px 12px;padding:8px 0}",
        ".ev::before{content:\"\";position:absolute;left:-21px;top:13px;width:10px;height:10px;border-radius:50%;background:var(--surface);border:2px solid var(--forja)}",
        ".ev .h{font-family:var(--f-mono);font-size:11px;color:var(--muted);padding-top:2px}",
        ".ev .tp{font-family:var(--f-mono);font-size:12px;font-weight:600}",
        ".ev .dd{grid-column:2;color:var(--ink-2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}",
        ".vazio{color:var(--muted);padding:22px 0;text-align:center}",
        ".neg{color:var(--bad-ink);font-weight:600}",
        "code{font-family:var(--f-mono);font-size:12px;background:var(--surface-2);border:1px solid var(--line);padding:2px 7px;border-radius:7px}",
        "/* ── início ─────────────────────────────────────────────── */",
        ".heroi{position:relative;overflow:hidden;border-radius:var(--r-xl);padding:28px 30px;background:radial-gradient(circle at 88% 15%,rgba(255,154,61,.6),transparent 42%),radial-gradient(circle at 70% 120%,rgba(255,90,31,.35),transparent 50%),linear-gradient(135deg,#1b1d22,#2a2018);color:#fff;box-shadow:var(--sh-2)}",
        ".heroi::after{content:\"\";position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.08) 1px,transparent 1.2px);background-size:18px 18px;pointer-events:none}",
        ".heroi .trilha{color:#ffb98f}",
        ".heroi h2{position:relative;z-index:1;font-family:var(--f-display);font-size:30px;margin:8px 0 22px;font-weight:700;letter-spacing:-.6px;max-width:620px;line-height:1.15}",
        ".heroi .nums{display:flex;flex-wrap:wrap;gap:14px;position:relative;z-index:1}",
        ".heroi .num{min-width:150px;padding:14px 18px;border-radius:var(--r-md);background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(6px)}",
        ".heroi .num b{display:block;font-family:var(--f-display);font-size:32px;font-weight:700;letter-spacing:-.8px;line-height:1.1}",
        ".heroi .num small{font-family:var(--f-mono);font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:#d7d9de}",
        ".tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px}",
        ".tile{position:relative;display:flex;flex-direction:column;gap:10px;padding:22px;border-radius:var(--r-lg);background:var(--surface);border:1px solid var(--line);box-shadow:var(--sh-1);text-decoration:none;color:var(--ink);transition:transform .2s var(--ease),box-shadow .2s var(--ease),border-color .2s}",
        ".tile:hover{transform:translateY(-3px);box-shadow:var(--sh-2);border-color:var(--forja-soft)}",
        ".tile .ico{width:52px;height:52px;border-radius:16px;display:grid;place-items:center;background:var(--forja-soft);color:var(--forja-ink)}",
        ".tile .ico svg{width:26px;height:26px;fill:currentColor}",
        ".tile h3{font-family:var(--f-display);font-size:20px;font-weight:700;margin:6px 0 0;letter-spacing:-.3px}",
        ".tile p{margin:0;color:var(--ink-2);font-size:13px;line-height:1.55}",
        ".tile .ir{margin-top:auto;padding-top:8px;font-family:var(--f-mono);font-size:11px;letter-spacing:1px;color:var(--forja-ink);font-weight:600}",
        "/* ── avisos ─────────────────────────────────────────────── */",
        "#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;z-index:30}",
        "#toast div{display:flex;align-items:center;gap:10px;background:var(--console);color:#fff;padding:11px 18px;border-radius:99px;box-shadow:var(--sh-2);max-width:440px;animation:entra .25s var(--ease)}",
        "#toast div::before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--ok);flex:none}",
        "#toast div.erro::before{background:var(--bad)}",
        "@keyframes pulso{0%{box-shadow:0 0 0 0 currentColor}70%{box-shadow:0 0 0 6px transparent}100%{box-shadow:0 0 0 0 transparent}}",
        "@keyframes entra{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}",
        "@keyframes destaque{0%{box-shadow:0 0 0 0 var(--forja)}30%{box-shadow:0 0 0 5px var(--forja-soft)}100%{box-shadow:var(--sh-1)}}",
        "@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}",
        "@media (max-width:900px){.app{grid-template-columns:1fr}.console{position:fixed;top:auto;bottom:10px;left:10px;right:10px;margin:0;height:64px;padding:8px;border-radius:22px;flex-direction:row;z-index:20}.console::before,.marca,.console h3,.operador,.versao{display:none}.console nav{display:flex;gap:4px;overflow-x:auto}nav a{flex-direction:column;gap:2px;font-size:10px;padding:6px 10px;margin:0;white-space:nowrap}nav a svg{width:18px;height:18px}nav a .qt{position:absolute;top:2px;right:4px}main{padding:18px 14px 100px}.cabeca h1{font-size:28px}.cabeca .acoes{margin-left:0}.aovivo{display:none}.dois{grid-template-columns:1fr}.heroi{padding:22px}.heroi h2{font-size:24px}.heroi .num{min-width:0;flex:1 1 40%}}",
        "</style>",
        "</head>",
        "<body>",
        "<div class=\"app\">",
        "<aside class=\"console\">",
        "<div class=\"marca\">",
        "<svg viewBox=\"0 0 40 40\" aria-hidden=\"true\"><defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#ff5a1f\"/><stop offset=\"1\" stop-color=\"#ff9a3d\"/></linearGradient></defs><rect x=\"2\" y=\"2\" width=\"36\" height=\"36\" rx=\"11\" fill=\"url(#g)\"/><rect x=\"10\" y=\"10\" width=\"20\" height=\"5\" rx=\"2.5\" fill=\"#fff\"/><rect x=\"10\" y=\"17.5\" width=\"13\" height=\"5\" rx=\"2.5\" fill=\"#fff\" opacity=\".85\"/><rect x=\"10\" y=\"25\" width=\"20\" height=\"5\" rx=\"2.5\" fill=\"#fff\"/><circle cx=\"28\" cy=\"20\" r=\"2.5\" fill=\"#fff\" opacity=\".85\"/></svg>",
        "<div><b>EMP</b><small>ENGINEERING MODULAR PROCESS</small></div>",
        "</div>",
        "<h3>OPERAÇÃO</h3>",
        "<nav id=\"nav\">",
        "<a href=\"#inicio\" data-sec=\"inicio\"><svg viewBox=\"0 0 24 24\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"/></svg>Início</a>",
        "<a href=\"#geral\" data-sec=\"geral\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z\"/></svg>Visão geral</a>",
        "<a href=\"#ordens\" data-sec=\"ordens\" data-mod=\"producao\"><svg viewBox=\"0 0 24 24\"><path d=\"M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z\"/></svg>Ordens</a>",
        "<a href=\"#estoque\" data-sec=\"estoque\" data-mod=\"estoque\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z\"/></svg>Estoque</a>",
        "<a href=\"#manutencao\" data-sec=\"manutencao\" data-mod=\"manutencao\"><svg viewBox=\"0 0 24 24\"><path d=\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\"/></svg>Manutenção<span class=\"qt\" id=\"qt-man\"></span></a>",
        "<a href=\"#qualidade\" data-sec=\"qualidade\" data-mod=\"qualidade\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>Qualidade<span class=\"qt\" id=\"qt-ncs\"></span></a>",
        "<a href=\"#cadastros\" data-sec=\"cadastros\" data-mod=\"cadastros\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z\"/></svg>Cadastros</a>",
        "<h3>SISTEMA</h3>",
        "<a href=\"#eventos\" data-sec=\"eventos\"><svg viewBox=\"0 0 24 24\"><path d=\"M7 2v11h3v9l7-12h-4l4-8z\"/></svg>Eventos</a>",
        "<a href=\"#modulos\" data-sec=\"modulos\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z\"/></svg>Módulos</a>",
        "</nav>",
        "<div class=\"operador\">",
        "<div class=\"linha\"><div class=\"avatar\" id=\"avatar\">?</div><div><b id=\"sessao\">…</b><small>operador conectado</small></div></div>",
        "<input id=\"token\" type=\"password\" placeholder=\"token de acesso\" aria-label=\"Token de acesso\">",
        "</div>",
        "<div class=\"versao\" id=\"versao\">EMP</div>",
        "</aside>",
        "",
        "<main>",
        "<header class=\"cabeca\">",
        "<div>",
        "<div class=\"trilha\" id=\"crumb\">EMP</div>",
        "<h1 id=\"titulo\">Início</h1>",
        "<div class=\"sub\" id=\"subtitulo\"></div>",
        "</div>",
        "<div class=\"acoes\">",
        "<span class=\"aovivo\" id=\"relogio\">--:--:--</span>",
        "<button class=\"redondo\" id=\"btn-sino\" title=\"Alertas\" aria-label=\"Alertas\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z\"/></svg><span class=\"qt\" id=\"alertas\"></span></button>",
        "<button class=\"redondo\" id=\"btn-atualizar\" title=\"Atualizar\" aria-label=\"Atualizar\"><svg viewBox=\"0 0 24 24\"><path d=\"M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z\"/></svg></button>",
        "<button id=\"btn-novo\">+ Novo</button>",
        "</div>",
        "</header>",
        "",
        "<section class=\"secao grid\" id=\"s-inicio\">",
        "<div class=\"heroi\">",
        "<div class=\"trilha\">LINHA AGORA</div>",
        "<h2 id=\"heroi-frase\">Lendo a linha de produção…</h2>",
        "<div class=\"nums\" id=\"heroi-nums\"></div>",
        "</div>",
        "<div class=\"tiles\">",
        "<a class=\"tile\" href=\"#geral\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z\"/></svg></div><h3>Visão geral</h3><p>Ordens abertas, produção, refugo, disponibilidade e os últimos eventos, em tempo real.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#ordens\" data-mod=\"producao\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z\"/></svg></div><h3>Ordens de produção</h3><p>Planeje, libere e aponte. Cada ordem diz o que produzir, quanto e em qual posto.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#estoque\" data-mod=\"estoque\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z\"/></svg></div><h3>Estoque</h3><p>Saldos e movimentos. O consumo dos componentes sai sozinho a cada apontamento.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#manutencao\" data-mod=\"manutencao\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\"/></svg></div><h3>Manutenção</h3><p>Paradas por categoria, disponibilidade na janela de 8 h e tempo médio de reparo.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#qualidade\" data-mod=\"qualidade\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg></div><h3>Qualidade</h3><p>Não conformidades manuais e automáticas, quando o refugo passa do limite.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#cadastros\" data-mod=\"cadastros\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z\"/></svg></div><h3>Cadastros</h3><p>Produtos, estrutura (BOM) e postos de trabalho: os blocos que montam a fábrica.</p><span class=\"ir\">ABRIR →</span></a>",
        "</div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-geral\">",
        "<div class=\"grid kpis\" id=\"kpis\"></div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Postos de trabalho<span class=\"cont\" id=\"geral-postos-c\"></span></h2><div class=\"postos\" id=\"geral-postos\"></div></div>",
        "<div class=\"card\"><h2>Eventos recentes<span class=\"cont\">barramento</span></h2><div id=\"geral-eventos\"></div></div>",
        "</div>",
        "<div class=\"card\"><h2>Ordens em andamento</h2><div id=\"geral-ordens\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-ordens\">",
        "<div class=\"card\"><h2>Ordens por estado<span class=\"cont\" id=\"ordens-hora\"></span></h2><div id=\"ordens-leg\"></div></div>",
        "<div class=\"card\"><h2>Nova ordem de produção</h2>",
        "<form class=\"form\" id=\"f-op\">",
        "<label>Produto<select name=\"produto\" id=\"op-produto\"></select></label>",
        "<label>Quantidade<input name=\"quantidade\" size=\"8\" required></label>",
        "<label>Posto<select name=\"posto\" id=\"op-posto\"></select></label>",
        "<button>Criar OP</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Ordens<span class=\"cont\" id=\"ordens-c\"></span></h2><div id=\"ordens\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-estoque\">",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Entrada de material</h2>",
        "<form class=\"form\" id=\"f-entrada\">",
        "<label>Produto<select name=\"produto\" id=\"ent-produto\"></select></label>",
        "<label>Quantidade<input name=\"quantidade\" size=\"8\" required></label>",
        "<label>Origem<input name=\"origem\" placeholder=\"NF / fornecedor\" size=\"14\"></label>",
        "<button>Registrar</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Ajuste de inventário</h2>",
        "<form class=\"form\" id=\"f-ajuste\">",
        "<label>Produto<select name=\"produto\" id=\"aj-produto\"></select></label>",
        "<label>Saldo contado<input name=\"saldo\" size=\"8\" required></label>",
        "<label>Motivo<input name=\"motivo\" size=\"14\"></label>",
        "<button class=\"sec\">Ajustar</button>",
        "</form></div>",
        "</div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Saldos<span class=\"cont\" id=\"saldos-c\"></span></h2><div id=\"saldos\"></div></div>",
        "<div class=\"card\"><h2>Últimos movimentos</h2><div id=\"movimentos\"></div></div>",
        "</div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-manutencao\">",
        "<div class=\"grid kpis\" id=\"man-kpis\"></div>",
        "<div class=\"card\"><h2>Estado dos postos<span class=\"cont\">janela de 8 h</span></h2><div class=\"postos\" id=\"man-postos\"></div></div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Abrir parada</h2>",
        "<form class=\"form\" id=\"f-parada\">",
        "<label>Posto<select name=\"posto\" id=\"par-posto\"></select></label>",
        "<label>Categoria<select name=\"categoria\"><option value=\"MECANICA\">Mecânica</option><option value=\"ELETRICA\">Elétrica</option><option value=\"SETUP\">Setup</option><option value=\"FALTA_MATERIAL\">Falta de material</option><option value=\"QUALIDADE\">Qualidade</option><option value=\"OUTROS\">Outros</option></select></label>",
        "<label>Motivo<input name=\"motivo\" size=\"22\" required></label>",
        "<label>Começou há (min)<input name=\"ha_minutos\" size=\"4\" value=\"0\"></label>",
        "<button class=\"bad\">Parar posto</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Minutos parados por categoria</h2><div id=\"man-cat\"></div></div>",
        "</div>",
        "<div class=\"card\"><h2>Paradas</h2><div id=\"paradas\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-qualidade\">",
        "<div class=\"card\"><h2>Registrar não conformidade</h2>",
        "<form class=\"form\" id=\"f-nc\">",
        "<label>OP<input name=\"op\" size=\"5\"></label>",
        "<label>Produto<select name=\"produto\" id=\"nc-produto\"></select></label>",
        "<label>Motivo<input name=\"motivo\" size=\"30\" required></label>",
        "<button>Registrar NC</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Não conformidades<span class=\"cont\" id=\"ncs-c\"></span></h2><div id=\"ncs\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-cadastros\">",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Novo produto</h2>",
        "<form class=\"form\" id=\"f-produto\">",
        "<label>Código<input name=\"codigo\" size=\"10\" required></label>",
        "<label>Descrição<input name=\"descricao\" size=\"20\"></label>",
        "<label>Unid.<input name=\"unidade\" size=\"4\" value=\"UN\"></label>",
        "<label>Tipo<select name=\"tipo\"><option value=\"MP\">MP · matéria-prima</option><option value=\"SA\">SA · semiacabado</option><option value=\"PA\">PA · acabado</option></select></label>",
        "<button>Salvar</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Novo posto de trabalho</h2>",
        "<form class=\"form\" id=\"f-posto\">",
        "<label>Código<input name=\"codigo\" size=\"10\" required></label>",
        "<label>Descrição<input name=\"descricao\" size=\"20\"></label>",
        "<label>Capacidade (h/dia)<input name=\"capacidade_h\" size=\"5\" value=\"8\"></label>",
        "<button>Salvar</button>",
        "</form></div>",
        "</div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Produtos<span class=\"cont\" id=\"produtos-c\"></span></h2><div id=\"produtos\"></div></div>",
        "<div class=\"card\"><h2>Estrutura do produto (BOM)</h2>",
        "<form class=\"form\" id=\"f-bom\">",
        "<label>Produto<select name=\"produto\" id=\"bom-produto\"></select></label>",
        "<label>Componente<select name=\"componente\" id=\"bom-comp\"></select></label>",
        "<label>Qtd. por unidade<input name=\"quantidade\" size=\"6\" required></label>",
        "<button>Incluir</button>",
        "</form>",
        "<div id=\"bom\" style=\"margin-top:14px\"></div></div>",
        "</div>",
        "<div class=\"card\"><h2>Postos de trabalho</h2><div id=\"postos-cad\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-eventos\">",
        "<div class=\"card\"><h2>Barramento de eventos<span class=\"cont\">últimos 100</span></h2><div id=\"eventos\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-modulos\">",
        "<div class=\"card\"><h2>Módulos registrados<span class=\"cont\">internos e plugins</span></h2><div id=\"modulos\"></div></div>",
        "</section>",
        "</main>",
        "</div>",
        "<div id=\"toast\" role=\"status\" aria-live=\"polite\"></div>",
        "<script>",
        "var TITULOS = {inicio:[\"Início\",\"Bem-vindo ao chão de fábrica\"],geral:[\"Visão geral\",\"Linha de produção em tempo real\"],ordens:[\"Ordens de produção\",\"Planejar, liberar e apontar\"],estoque:[\"Estoque\",\"Saldos, entradas e baixa automática por estrutura\"],manutencao:[\"Manutenção\",\"Paradas de posto e disponibilidade\"],qualidade:[\"Qualidade\",\"Não conformidades — plugin externo\"],cadastros:[\"Cadastros\",\"Produtos, estrutura e postos\"],eventos:[\"Eventos\",\"O que os módulos publicaram\"],modulos:[\"Módulos\",\"Núcleo, módulos internos e plugins\"]};",
        "var ROT = {EM_PRODUCAO:\"EM PRODUÇÃO\",CONCLUIDA:\"CONCLUÍDA\",MECANICA:\"MECÂNICA\",ELETRICA:\"ELÉTRICA\",FALTA_MATERIAL:\"FALTA DE MATERIAL\",ENTRADA_PRODUCAO:\"ENTRADA PRODUÇÃO\"};",
        "var ESTADO = {PLANEJADA:\"plan\",LIBERADA:\"wait\",EM_PRODUCAO:\"act\",CONCLUIDA:\"ok\",CANCELADA:\"bad\",OPERANDO:\"ok\",PARADO:\"bad\",ABERTA:\"bad\",ENCERRADA:\"ok\",ativo:\"ok\",falhou:\"bad\"};",
        "var LEGENDA = [[\"PLANEJADA\",\"planejada\",\"var(--muted)\"],[\"LIBERADA\",\"liberada\",\"var(--info)\"],[\"EM_PRODUCAO\",\"em produção\",\"var(--forja)\"],[\"CONCLUIDA\",\"concluída\",\"var(--ok)\"],[\"CANCELADA\",\"cancelada\",\"var(--bad)\"]];",
        "var ICONE = {bom:\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\",alerta:\"M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z\",neutro:\"M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z\"};",
        "function rot(s) { s = String(s == null ? \"\" : s); return ROT[s] || s.replace(/_/g, \" \"); }",
        "var ativos = {};",
        "var cache = {produtos: [], postos: []};",
        "var tk = document.getElementById(\"token\");",
        "try { tk.value = localStorage.getItem(\"emp_token\") || \"\"; } catch (e) {}",
        "tk.onchange = function () { try { localStorage.setItem(\"emp_token\", tk.value); } catch (e) {} carregar(); };",
        "",
        "function esc(s) { return String(s == null ? \"\" : s).replace(/[&<>']/g, function (c) { return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",\"'\":\"&#39;\"}[c]; }); }",
        "function num(n, d) { var v = Number(n || 0); return v.toLocaleString(\"pt-BR\", {maximumFractionDigits: d == null ? 2 : d}); }",
        "function hora(ms) { return ms ? new Date(ms).toLocaleTimeString(\"pt-BR\", {hour: \"2-digit\", minute: \"2-digit\"}) : \"\"; }",
        "function dataHora(ms) { return ms ? new Date(ms).toLocaleString(\"pt-BR\", {day: \"2-digit\", month: \"2-digit\", hour: \"2-digit\", minute: \"2-digit\"}) : \"\"; }",
        "function dur(min) { min = Math.max(0, Math.round(min)); return min < 60 ? min + \" min\" : Math.floor(min / 60) + \" h \" + (min % 60) + \" min\"; }",
        "function tag(s) { var k = String(s).split(\":\")[0]; return \"<span class='tag st-\" + (ESTADO[k] || \"plan\") + \"'>\" + esc(rot(s).toLowerCase()) + \"</span>\"; }",
        "function cod(prefixo, n) { return \"<span class='id'>\" + prefixo + esc(String(n).padStart(3, \"0\")) + \"</span>\"; }",
        "function toast(msg, erro) { var d = document.createElement(\"div\"); d.textContent = msg; if (erro) d.className = \"erro\"; document.getElementById(\"toast\").appendChild(d); setTimeout(function () { d.remove(); }, 4200); }",
        "function tabela(cols, linhas, vazio) {",
        "  if (!linhas.length) return \"<div class='vazio'>\" + (vazio || \"Nada por aqui ainda.\") + \"</div>\";",
        "  var h = \"<table><thead><tr>\" + cols.map(function (c) { return \"<th\" + (c[1] ? \" class='num'\" : \"\") + \">\" + c[0] + \"</th>\"; }).join(\"\") + \"</tr></thead><tbody>\";",
        "  return h + linhas.map(function (l) { return \"<tr>\" + l.map(function (v, i) { return \"<td\" + (cols[i][1] ? \" class='num'\" : \"\") + \">\" + v + \"</td>\"; }).join(\"\") + \"</tr>\"; }).join(\"\") + \"</tbody></table>\";",
        "}",
        "",
        "function api(metodo, caminho, corpo) {",
        "  var op = {method: metodo, headers: {}};",
        "  if (tk.value) op.headers.Authorization = \"Bearer \" + tk.value;",
        "  if (corpo) { op.headers[\"Content-Type\"] = \"application/x-www-form-urlencoded\"; op.body = new URLSearchParams(corpo).toString(); }",
        "  return fetch(caminho, op).then(function (r) {",
        "    return r.text().then(function (t) {",
        "      var j = null; try { j = JSON.parse(t); } catch (e) {}",
        "      if (!r.ok) throw new Error((j && j.erro) || (\"HTTP \" + r.status));",
        "      return j;",
        "    });",
        "  });",
        "}",
        "function tenta(p, padrao) { return p.catch(function () { return padrao; }); }",
        "function acao(metodo, caminho, corpo, ok) {",
        "  return api(metodo, caminho, corpo).then(function (r) { toast(ok || \"Feito.\"); carregar(); return r; })",
        "    .catch(function (e) { toast(e.message, true); });",
        "}",
        "function ligarForm(id, metodo, caminho, ok) {",
        "  document.getElementById(id).onsubmit = function (ev) {",
        "    ev.preventDefault();",
        "    var dados = Object.fromEntries(new FormData(ev.target).entries());",
        "    acao(metodo, typeof caminho === \"function\" ? caminho(dados) : caminho, dados, ok).then(function (r) { if (r) ev.target.reset(); });",
        "  };",
        "}",
        "",
        "function opcoes(sel, itens, valor, rotulo) {",
        "  var el = document.getElementById(sel); if (!el) return;",
        "  var atual = el.value;",
        "  el.innerHTML = itens.map(function (i) { return \"<option value='\" + esc(valor(i)) + \"'>\" + esc(rotulo(i)) + \"</option>\"; }).join(\"\");",
        "  if (atual) el.value = atual;",
        "}",
        "function preencherSelects() {",
        "  var p = cache.produtos, prod = function (i) { return i.codigo; }, rot = function (i) { return i.codigo + \" · \" + (i.descricao || \"\"); };",
        "  opcoes(\"op-produto\", p.filter(function (i) { return i.tipo !== \"MP\"; }), prod, rot);",
        "  [\"ent-produto\", \"aj-produto\", \"bom-comp\", \"nc-produto\"].forEach(function (s) { opcoes(s, p, prod, rot); });",
        "  opcoes(\"bom-produto\", p.filter(function (i) { return i.tipo !== \"MP\"; }), prod, rot);",
        "  var postos = [{codigo: \"\", descricao: \"— sem posto —\"}].concat(cache.postos);",
        "  opcoes(\"op-posto\", postos, prod, function (i) { return i.codigo ? i.codigo + \" · \" + (i.descricao || \"\") : i.descricao; });",
        "  opcoes(\"par-posto\", cache.postos, prod, rot);",
        "}",
        "",
        "// Medidor circular de disponibilidade: o posto lido como um instrumento de máquina.",
        "function cartaoPosto(p) {",
        "  var par = p.parada, pct = Math.max(0, Math.min(100, p.disponibilidade_pct));",
        "  var cor = p.estado === \"PARADO\" ? \"var(--bad)\" : pct < 85 ? \"var(--warn)\" : \"var(--ok)\";",
        "  return \"<div class='posto \" + p.estado + \"'><div class='medidor' style='--p:\" + pct + \";--c:\" + cor + \"'><span>\" + num(pct, 0) + \"%</span></div>\" +",
        "    \"<div><b>\" + esc(p.posto.codigo) + \"</b><div class='d'>\" + esc(p.posto.descricao) + \"</div>\" + tag(p.estado) + \"</div>\" +",
        "    (par ? \"<div class='m'><strong>\" + esc(rot(par.categoria).toLowerCase()) + \"</strong> · desde \" + hora(par.inicio) + \"<br>\" + esc(par.motivo) + \"</div>\" : \"\") + \"</div>\";",
        "}",
        "function dados(s) {",
        "  return String(s || \"\").split(\"&\").map(function (par) {",
        "    var t = par.replace(/\\+/g, \" \");",
        "    try { t = decodeURIComponent(t); } catch (e) {}",
        "    return t.replace(\"=\", \": \");",
        "  }).join(\"   \");",
        "}",
        "function linhaEvento(e) {",
        "  return \"<div class='ev'><span class='h'>\" + hora(e.ts) + \"</span><span class='tp'>\" + esc(e.tipo) + \"</span><span class='dd'>\" + esc(e.origem) + \" · \" + esc(dados(e.dados)) + \"</span></div>\";",
        "}",
        "function eventos(evs) { return evs.length ? \"<div class='linha-tempo'>\" + evs.map(linhaEvento).join(\"\") + \"</div>\" : \"<div class='vazio'>Sem eventos.</div>\"; }",
        "// Barra de LED segmentada: 12 segmentos acendem conforme o progresso.",
        "function progresso(o) {",
        "  var pct = o.quantidade ? Math.min(100, 100 * o.produzido / o.quantidade) : 0, n = Math.round(pct / 100 * 12), s = \"\";",
        "  for (var i = 0; i < 12; i++) s += \"<i\" + (i < n ? \" class='on'\" : \"\") + \"></i>\";",
        "  return \"<div class='led\" + (pct >= 100 ? \" cheio\" : \"\") + \"'>\" + s + \"<span>\" + Math.round(pct) + \"%</span></div>\";",
        "}",
        "function porId(a, b) { return b.id - a.id; }",
        "function kpi(x) {",
        "  var ic = ICONE[x[3]] || ICONE.neutro;",
        "  return \"<div class='card kpi \" + x[3] + \"'><span class='sinal'><svg viewBox='0 0 24 24'><path d='\" + ic + \"'/></svg></span><div class='rot'>\" + x[0] + \"</div><div class='val'>\" + x[1] + \"</div><div class='det'>\" + x[2] + \"</div></div>\";",
        "}",
        "",
        "var telas = {",
        "  inicio: function () {",
        "    return Promise.all([",
        "      tenta(api(\"GET\", \"/api/producao/indicadores\"), null), tenta(api(\"GET\", \"/api/producao/ordens\"), []),",
        "      ativos.manutencao ? tenta(api(\"GET\", \"/api/manutencao/postos\"), []) : Promise.resolve([])",
        "    ]).then(function (r) {",
        "      var ind = r[0] || {produzido: 0, refugo_pct: 0}, ops = r[1], postos = r[2];",
        "      var andando = ops.filter(function (o) { return o.status === \"EM_PRODUCAO\"; }).length;",
        "      var parados = postos.filter(function (p) { return p.estado === \"PARADO\"; }).length;",
        "      document.getElementById(\"heroi-frase\").textContent = parados",
        "        ? parados + \" posto(s) parado(s) e \" + andando + \" ordem(ns) em produção agora.\"",
        "        : (andando ? andando + \" ordem(ns) em produção e todos os postos operando.\" : \"Linha pronta. Nenhuma ordem em produção agora.\");",
        "      var n = [[andando, \"em produção\"], [num(ind.produzido, 0), \"peças boas\"], [num(ind.refugo_pct, 1) + \"%\", \"refugo\"]];",
        "      if (postos.length) n.push([(postos.length - parados) + \"/\" + postos.length, \"postos operando\"]);",
        "      document.getElementById(\"heroi-nums\").innerHTML = n.map(function (x) { return \"<div class='num'><b>\" + x[0] + \"</b><small>\" + x[1] + \"</small></div>\"; }).join(\"\");",
        "    });",
        "  },",
        "  geral: function () {",
        "    return Promise.all([",
        "      tenta(api(\"GET\", \"/api/producao/indicadores\"), null), tenta(api(\"GET\", \"/api/producao/ordens\"), []),",
        "      tenta(api(\"GET\", \"/api/manutencao/postos\"), []), tenta(api(\"GET\", \"/api/estoque/saldos\"), {}),",
        "      ativos.qualidade ? tenta(api(\"GET\", \"/api/qualidade/ncs\"), []) : Promise.resolve(null), tenta(api(\"GET\", \"/api/sistema/eventos?n=8\"), [])",
        "    ]).then(function (r) {",
        "      var ind = r[0] || {ordens: {}, produzido: 0, refugo: 0, refugo_pct: 0}, ops = r[1], postos = r[2], saldos = r[3], ncs = r[4], evs = r[5];",
        "      var abertas = ops.filter(function (o) { return [\"PLANEJADA\", \"LIBERADA\", \"EM_PRODUCAO\"].indexOf(o.status) >= 0; });",
        "      var parados = postos.filter(function (p) { return p.estado === \"PARADO\"; }).length;",
        "      var negativos = Object.keys(saldos).filter(function (k) { return Number(saldos[k]) < 0; }).length;",
        "      var disp = postos.length ? postos.reduce(function (s, p) { return s + p.disponibilidade_pct; }, 0) / postos.length : 100;",
        "      var k = [",
        "        [\"OPs em aberto\", abertas.length, (ind.ordens.EM_PRODUCAO || 0) + \" em produção\", \"\"],",
        "        [\"Produzido\", num(ind.produzido, 0), \"peças boas apontadas\", \"bom\"],",
        "        [\"Refugo\", num(ind.refugo_pct, 2) + \"%\", num(ind.refugo, 0) + \" peças\", ind.refugo_pct > 5 ? \"alerta\" : \"\"],",
        "        [\"Disponibilidade\", num(disp, 1) + \"%\", parados + \" posto(s) parado(s)\", disp < 85 ? \"alerta\" : \"bom\"],",
        "        [\"Estoque\", negativos, \"saldos negativos\", negativos ? \"alerta\" : \"bom\"]",
        "      ];",
        "      if (ncs) k.push([\"NCs abertas\", ncs.filter(function (n) { return n.status === \"ABERTA\"; }).length, \"qualidade\", \"\"]);",
        "      document.getElementById(\"kpis\").innerHTML = k.map(kpi).join(\"\");",
        "      document.getElementById(\"geral-postos\").innerHTML = postos.map(cartaoPosto).join(\"\") || \"<div class='vazio'>Nenhum posto cadastrado.</div>\";",
        "      document.getElementById(\"geral-postos-c\").textContent = (postos.length - parados) + \"/\" + postos.length + \" operando\";",
        "      document.getElementById(\"geral-eventos\").innerHTML = eventos(evs);",
        "      document.getElementById(\"geral-ordens\").innerHTML = tabela([[\"OP\"], [\"Produto\"], [\"Posto\"], [\"Estado\"], [\"Progresso\"], [\"Produzido\", 1], [\"Refugo\", 1]],",
        "        abertas.sort(porId).map(function (o) { return [cod(\"OP-\", o.id), esc(o.produto), esc(o.posto || \"—\"), tag(o.status), progresso(o), num(o.produzido, 0) + \" / \" + num(o.quantidade, 0), num(o.refugo, 0)]; }), \"Nenhuma OP em aberto.\");",
        "    });",
        "  },",
        "  ordens: function () {",
        "    return api(\"GET\", \"/api/producao/ordens\").then(function (ops) {",
        "      var n = {}; ops.forEach(function (o) { n[o.status] = (n[o.status] || 0) + 1; });",
        "      var total = ops.length || 1;",
        "      document.getElementById(\"ordens-leg\").innerHTML = \"<div class='distrib'>\" + LEGENDA.map(function (l) { return n[l[0]] ? \"<i style='width:\" + (100 * n[l[0]] / total) + \"%;background:\" + l[2] + \"' title='\" + l[1] + \"'></i>\" : \"\"; }).join(\"\") + \"</div>\" +",
        "        \"<div class='chips'>\" + LEGENDA.map(function (l) { return \"<span><i style='background:\" + l[2] + \"'></i>\" + l[1] + \" <b>\" + (n[l[0]] || 0) + \"</b></span>\"; }).join(\"\") + \"</div>\";",
        "      document.getElementById(\"ordens-hora\").textContent = \"atualizado \" + new Date().toLocaleTimeString(\"pt-BR\");",
        "      document.getElementById(\"ordens-c\").textContent = ops.length + \" no total\";",
        "      document.getElementById(\"ordens\").innerHTML = tabela([[\"OP\"], [\"Produto\"], [\"Posto\"], [\"Estado\"], [\"Progresso\"], [\"Qtd.\", 1], [\"Boas\", 1], [\"Refugo\", 1], [\"Criada\"], [\"Ações\"]],",
        "        ops.sort(porId).map(function (o) {",
        "          var a = \"\";",
        "          if (o.status === \"PLANEJADA\") a += \"<button class='mini' onclick='liberar(\" + o.id + \")'>Liberar</button>\";",
        "          if (o.status === \"LIBERADA\" || o.status === \"EM_PRODUCAO\") a += \"<input id='b\" + o.id + \"' placeholder='boas'><input id='r\" + o.id + \"' placeholder='refugo'><button class='mini ok' onclick='apontar(\" + o.id + \")'>Apontar</button>\";",
        "          if (o.status === \"PLANEJADA\" || o.status === \"LIBERADA\") a += \"<button class='mini sec' onclick='cancelar(\" + o.id + \")'>Cancelar</button>\";",
        "          return [cod(\"OP-\", o.id), esc(o.produto), esc(o.posto || \"—\"), tag(o.status), progresso(o), num(o.quantidade, 0), num(o.produzido, 0), num(o.refugo, 0), dataHora(o.criada_em), \"<div style='display:flex;gap:6px;align-items:center'>\" + a + \"</div>\"];",
        "        }), \"Nenhuma ordem criada.\");",
        "    });",
        "  },",
        "  estoque: function () {",
        "    return Promise.all([api(\"GET\", \"/api/estoque/saldos\"), api(\"GET\", \"/api/estoque/movimentos\")]).then(function (r) {",
        "      var s = r[0], desc = {};",
        "      cache.produtos.forEach(function (p) { desc[p.codigo] = p; });",
        "      var cods = Object.keys(s).sort();",
        "      document.getElementById(\"saldos-c\").textContent = cods.length + \" itens\";",
        "      document.getElementById(\"saldos\").innerHTML = tabela([[\"Produto\"], [\"Descrição\"], [\"Tipo\"], [\"Saldo\", 1]], cods.map(function (c) {",
        "        var p = desc[c] || {}, v = Number(s[c]);",
        "        return [\"<span class='id'>\" + esc(c) + \"</span>\", esc(p.descricao || \"\"), esc(p.tipo || \"\"), \"<span class='\" + (v < 0 ? \"neg\" : \"\") + \"'>\" + num(v) + \" \" + esc(p.unidade || \"\") + \"</span>\"];",
        "      }));",
        "      document.getElementById(\"movimentos\").innerHTML = tabela([[\"Hora\"], [\"Produto\"], [\"Tipo\"], [\"Qtd.\", 1], [\"Saldo\", 1], [\"Origem\"]],",
        "        r[1].sort(porId).slice(0, 14).map(function (m) { return [hora(m.ts), esc(m.produto), esc(rot(m.tipo).toLowerCase()), \"<span class='\" + (m.quantidade < 0 ? \"neg\" : \"\") + \"'>\" + num(m.quantidade) + \"</span>\", num(m.saldo), esc(m.origem)]; }));",
        "    });",
        "  },",
        "  manutencao: function () {",
        "    return Promise.all([api(\"GET\", \"/api/manutencao/postos\"), api(\"GET\", \"/api/manutencao/paradas\"), api(\"GET\", \"/api/manutencao/indicadores\")]).then(function (r) {",
        "      var postos = r[0], par = r[1], ind = r[2];",
        "      var disp = postos.length ? postos.reduce(function (s, p) { return s + p.disponibilidade_pct; }, 0) / postos.length : 100;",
        "      document.getElementById(\"man-kpis\").innerHTML = [[\"Paradas abertas\", ind.paradas_abertas, \"agora\", ind.paradas_abertas ? \"alerta\" : \"bom\"], [\"Disponibilidade\", num(disp, 1) + \"%\", \"média na janela de 8 h\", disp < 85 ? \"alerta\" : \"bom\"], [\"MTTR\", num(ind.mttr_min, 1) + \" min\", \"tempo médio de reparo\", \"\"], [\"Encerradas\", ind.paradas_encerradas, \"histórico\", \"\"]].map(kpi).join(\"\");",
        "      document.getElementById(\"man-postos\").innerHTML = postos.map(cartaoPosto).join(\"\");",
        "      var cat = ind.minutos_por_categoria, cs = Object.keys(cat), maxv = Math.max.apply(null, cs.map(function (c) { return cat[c]; }).concat([1]));",
        "      document.getElementById(\"man-cat\").innerHTML = cs.length ? cs.sort(function (a, b) { return cat[b] - cat[a]; }).map(function (c) {",
        "        return \"<div style='display:grid;grid-template-columns:140px 1fr 84px;gap:12px;align-items:center;margin:10px 0'><span>\" + esc(rot(c).toLowerCase()) + \"</span><div class='barra'><i style='width:\" + (100 * cat[c] / maxv) + \"%'></i></div><span class='mono' style='text-align:right;font-size:12px'>\" + dur(cat[c]) + \"</span></div>\";",
        "      }).join(\"\") : \"<div class='vazio'>Sem paradas registradas.</div>\";",
        "      document.getElementById(\"paradas\").innerHTML = tabela([[\"Parada\"], [\"Posto\"], [\"Categoria\"], [\"Motivo\"], [\"Início\"], [\"Duração\", 1], [\"Estado\"], [\"Ação\"]], par.sort(porId).map(function (p) {",
        "        var fim = p.status === \"ABERTA\" ? Date.now() : p.fim;",
        "        return [cod(\"P-\", p.id), esc(p.posto), esc(rot(p.categoria).toLowerCase()), esc(p.motivo) + (p.solucao ? \"<br><small style='color:var(--muted)'>\" + esc(p.solucao) + \"</small>\" : \"\"), dataHora(p.inicio), dur((fim - p.inicio) / 60000), tag(p.status),",
        "          p.status === \"ABERTA\" ? \"<div style='display:flex;gap:6px'><input id='sol\" + p.id + \"' style='width:140px' placeholder='solução'><button class='mini ok' onclick='encerrar(\" + p.id + \")'>Encerrar</button></div>\" : \"\"];",
        "      }), \"Nenhuma parada registrada.\");",
        "    });",
        "  },",
        "  qualidade: function () {",
        "    return api(\"GET\", \"/api/qualidade/ncs\").then(function (ncs) {",
        "      document.getElementById(\"ncs-c\").textContent = ncs.filter(function (n) { return n.status === \"ABERTA\"; }).length + \" abertas\";",
        "      document.getElementById(\"ncs\").innerHTML = tabela([[\"NC\"], [\"OP\"], [\"Produto\"], [\"Motivo\"], [\"Origem\"], [\"Registrada\"], [\"Estado\"]],",
        "        ncs.sort(porId).map(function (n) { return [cod(\"NC-\", n.id), n.op ? cod(\"OP-\", n.op) : \"—\", esc(n.produto), esc(n.motivo), esc(n.origem), dataHora(n.ts), tag(n.status)]; }), \"Nenhuma não conformidade.\");",
        "    });",
        "  },",
        "  cadastros: function () {",
        "    var pai = document.getElementById(\"bom-produto\").value;",
        "    return (pai ? api(\"GET\", \"/api/cadastros/estrutura?produto=\" + encodeURIComponent(pai)) : Promise.resolve([])).then(function (bom) {",
        "      document.getElementById(\"produtos-c\").textContent = cache.produtos.length + \" produtos\";",
        "      document.getElementById(\"produtos\").innerHTML = tabela([[\"Código\"], [\"Descrição\"], [\"Unid.\"], [\"Tipo\"]], cache.produtos.map(function (p) { return [\"<span class='id'>\" + esc(p.codigo) + \"</span>\", esc(p.descricao), esc(p.unidade), esc(p.tipo)]; }));",
        "      document.getElementById(\"bom\").innerHTML = tabela([[\"Componente\"], [\"Qtd. por unidade\", 1]], bom.map(function (b) { return [esc(b.componente), num(b.quantidade, 4)]; }), \"Selecione um produto com estrutura.\");",
        "      document.getElementById(\"postos-cad\").innerHTML = tabela([[\"Código\"], [\"Descrição\"], [\"Capacidade\", 1]], cache.postos.map(function (p) { return [\"<span class='id'>\" + esc(p.codigo) + \"</span>\", esc(p.descricao), num(p.capacidade_h, 1) + \" h/dia\"]; }));",
        "    });",
        "  },",
        "  eventos: function () {",
        "    return api(\"GET\", \"/api/sistema/eventos?n=100\").then(function (evs) { document.getElementById(\"eventos\").innerHTML = eventos(evs); });",
        "  },",
        "  modulos: function () {",
        "    return api(\"GET\", \"/api/sistema/modulos\").then(function (ms) {",
        "      document.getElementById(\"modulos\").innerHTML = tabela([[\"Módulo\"], [\"Nome\"], [\"Versão\"], [\"Prefixo\"], [\"Assina\"], [\"Estado\"]],",
        "        ms.map(function (m) { return [\"<span class='id'>\" + esc(m.id) + \"</span>\", esc(m.nome), esc(m.versao), \"<code>\" + esc(m.prefixo) + \"</code>\", esc((m.assina || []).join(\", \") || \"—\"), tag(m.estado)]; }));",
        "    });",
        "  }",
        "};",
        "",
        "window.liberar = function (id) { acao(\"POST\", \"/api/producao/liberar?id=\" + id, null, \"OP \" + id + \" liberada.\"); };",
        "window.cancelar = function (id) { acao(\"POST\", \"/api/producao/cancelar?id=\" + id, null, \"OP \" + id + \" cancelada.\"); };",
        "window.apontar = function (id) { acao(\"POST\", \"/api/producao/apontar?id=\" + id, {boa: document.getElementById(\"b\" + id).value || \"0\", refugo: document.getElementById(\"r\" + id).value || \"0\"}, \"Apontamento registrado na OP \" + id + \".\"); };",
        "window.encerrar = function (id) { acao(\"POST\", \"/api/manutencao/encerrar?id=\" + id, {solucao: document.getElementById(\"sol\" + id).value}, \"Parada \" + id + \" encerrada.\"); };",
        "",
        "ligarForm(\"f-op\", \"POST\", \"/api/producao/ordens\", \"OP criada.\");",
        "ligarForm(\"f-entrada\", \"POST\", \"/api/estoque/entrada\", \"Entrada registrada.\");",
        "ligarForm(\"f-ajuste\", \"POST\", \"/api/estoque/ajuste\", \"Inventário ajustado.\");",
        "ligarForm(\"f-parada\", \"POST\", \"/api/manutencao/paradas\", \"Parada aberta.\");",
        "ligarForm(\"f-nc\", \"POST\", \"/api/qualidade/ncs\", \"Não conformidade registrada.\");",
        "ligarForm(\"f-produto\", \"POST\", \"/api/cadastros/produtos\", \"Produto salvo.\");",
        "ligarForm(\"f-posto\", \"POST\", \"/api/cadastros/postos\", \"Posto salvo.\");",
        "ligarForm(\"f-bom\", \"POST\", \"/api/cadastros/estrutura\", \"Componente incluído.\");",
        "document.getElementById(\"bom-produto\").onchange = function () { telas.cadastros(); };",
        "",
        "document.getElementById(\"btn-sino\").onclick = function () { location.hash = ativos.manutencao ? \"#manutencao\" : \"#geral\"; };",
        "document.getElementById(\"btn-atualizar\").onclick = function () { carregar().then(function () { toast(\"Atualizado.\"); }); };",
        "document.getElementById(\"btn-novo\").onclick = function () {",
        "  var f = document.querySelector(\".secao.ativa form\"); if (!f) return;",
        "  var card = f.closest(\".card\");",
        "  card.scrollIntoView({behavior: \"smooth\", block: \"center\"});",
        "  card.classList.remove(\"destaque\"); void card.offsetWidth; card.classList.add(\"destaque\");",
        "  var c = f.querySelector(\"input,select\"); if (c) c.focus({preventScroll: true});",
        "};",
        "function relogio() { document.getElementById(\"relogio\").textContent = \"AO VIVO \" + new Date().toLocaleTimeString(\"pt-BR\"); }",
        "setInterval(relogio, 1000); relogio();",
        "",
        "function secaoAtual() { var s = (location.hash || \"#inicio\").slice(1); return telas[s] ? s : \"inicio\"; }",
        "function mostrar() {",
        "  var s = secaoAtual();",
        "  document.querySelectorAll(\".secao\").forEach(function (el) { el.classList.toggle(\"ativa\", el.id === \"s-\" + s); });",
        "  document.querySelectorAll(\"nav a\").forEach(function (a) { a.classList.toggle(\"ativo\", a.dataset.sec === s); });",
        "  document.getElementById(\"titulo\").textContent = TITULOS[s][0];",
        "  document.getElementById(\"subtitulo\").textContent = TITULOS[s][1];",
        "  document.getElementById(\"crumb\").innerHTML = \"EMP<i>/</i>\" + esc(TITULOS[s][0]);",
        "  document.getElementById(\"btn-novo\").classList.toggle(\"oculto\", !document.querySelector(\"#s-\" + s + \" form\"));",
        "}",
        "function carregar() {",
        "  return Promise.all([",
        "    tenta(api(\"GET\", \"/api/sistema/modulos\"), null), tenta(api(\"GET\", \"/api/sistema/sessao\"), null),",
        "    tenta(api(\"GET\", \"/api/sistema/saude\"), null), tenta(api(\"GET\", \"/api/cadastros/produtos\"), []), tenta(api(\"GET\", \"/api/cadastros/postos\"), [])",
        "  ]).then(function (r) {",
        "    if (!r[0]) { document.getElementById(\"sessao\").textContent = \"sem acesso\"; tk.focus(); return; }",
        "    ativos = {}; r[0].forEach(function (m) { if (m.estado === \"ativo\") ativos[m.id] = true; });",
        "    document.querySelectorAll(\"[data-mod]\").forEach(function (a) { a.classList.toggle(\"oculto\", !ativos[a.dataset.mod]); });",
        "    if (r[1]) {",
        "      document.getElementById(\"sessao\").textContent = r[1].usuario + \" · \" + r[1].perfil + (r[1].modo_aberto ? \" · dev\" : \"\");",
        "      document.getElementById(\"avatar\").textContent = String(r[1].usuario || \"?\").slice(0, 2).toUpperCase();",
        "    }",
        "    if (r[2]) document.getElementById(\"versao\").textContent = \"v\" + r[2].versao + \" · \" + r[2].modulos + \" módulos\";",
        "    cache.produtos = r[3]; cache.postos = r[4];",
        "    preencherSelects();",
        "    Promise.all([",
        "      ativos.manutencao ? tenta(api(\"GET\", \"/api/manutencao/indicadores\"), null) : Promise.resolve(null),",
        "      ativos.qualidade ? tenta(api(\"GET\", \"/api/qualidade/ncs\"), []) : Promise.resolve([])",
        "    ]).then(function (a) {",
        "      var pm = a[0] ? a[0].paradas_abertas : 0, nc = a[1].filter(function (x) { return x.status === \"ABERTA\"; }).length;",
        "      document.getElementById(\"qt-man\").textContent = pm ? String(pm) : \"\";",
        "      document.getElementById(\"qt-ncs\").textContent = nc ? String(nc) : \"\";",
        "      document.getElementById(\"alertas\").textContent = pm + nc ? String(pm + nc) : \"\";",
        "      document.getElementById(\"btn-sino\").title = pm + nc ? (pm + nc) + \" alerta(s): paradas e NCs abertas\" : \"Sem alertas\";",
        "    });",
        "    var s = secaoAtual();",
        "    return telas[s]().catch(function (e) { toast(e.message, true); });",
        "  });",
        "}",
        "window.onhashchange = function () { mostrar(); carregar(); window.scrollTo(0, 0); };",
        "mostrar();",
        "carregar();",
        "// Não redesenha enquanto o usuário digita: nem com campo focado, nem com",
        "// um campo de tabela (apontamento, solução) já preenchido e ainda não enviado.",
        "function digitando() {",
        "  if (document.querySelector(\"input:focus,select:focus\")) return true;",
        "  return Array.prototype.some.call(document.querySelectorAll(\".secao.ativa td input\"), function (i) { return i.value !== \"\"; });",
        "}",
        "setInterval(function () { if (!digitando()) carregar(); }, 6000);",
        "</script>",
        "</body>",
        "</html>"
    ];
}

pub fn pagina() -> string ={
    return join(_linhas(), "\n");
}
