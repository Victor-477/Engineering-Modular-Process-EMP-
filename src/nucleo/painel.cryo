// ============================================================
//  painel.cryo — painel web do EMP, servido pelo próprio núcleo
//
//  O navegador só executa HTML/CSS/JS, então a página vive aqui como
//  texto: UMA string Cryo por linha da página, unidas por join. Assim
//  o binário continua sendo um único .exe, sem arquivos ao lado.
//
//  Visual: sistema de design "Forja" (docs/DESIGN_SYSTEM.md) — tokens
//  em :root (claro e escuro), console grafite flutuante, laranja-forja
//  como cor de assinatura, medidores circulares nos postos, barras de
//  LED no progresso e listras de perigo para posto parado.
//
//  A página descobre os módulos ativos em /api/sistema/modulos e
//  esconde menus e blocos dos que não estão no ar — um módulo removido
//  some sem alterar este arquivo.
//
//  Telas: início, visão geral, pedidos, ordens, estoque (saldos,
//  endereços, reposição), manutenção, OEE, qualidade (plugin),
//  cadastros (produtos, clientes, roteiros), eventos e módulos.
//  Deep-link pelo hash: /#manutencao, /#pedidos/12, /#oee/24
//
//  Ao editar: aspas viram \", barras invertidas \\ e `${` vira
//  \${ (senão é interpolação Cryo).
// ============================================================

// Tokens do Forja (claro e escuro). O terminal do operador usa os mesmos,
// então uma cor muda num lugar só.
pub fn tokens_css() -> string ={
    return join([
        ":root{--bg:#f4f1ec;--dot:#ddd6ca;--surface:#fff;--surface-2:#faf8f5;--ink:#1b1d22;--ink-2:#4a4f59;--muted:#676c75;--line:#e9e4db;--console:#16181d;--console-2:#23262d;--console-ink:#c3c7cf;--forja:#ff5a1f;--forja-2:#ff9a3d;--forja-soft:#ffe9de;--forja-ink:#b23a0a;--ok:#0f9f6e;--ok-soft:#dcf4ea;--ok-ink:#0b7350;--warn:#e08a00;--warn-soft:#fcefd6;--warn-ink:#8f5800;--bad:#e5383b;--bad-soft:#fde4e4;--bad-ink:#b8262a;--bad-strong:#c92a2a;--info:#3d6be0;--info-soft:#e4ebfc;--info-ink:#2a4fb8;--on-forja:#16181d;--neutral-soft:#efece6;--r-sm:10px;--r-md:16px;--r-lg:22px;--r-xl:28px;--sh-1:0 1px 2px rgba(27,29,34,.05),0 6px 18px rgba(27,29,34,.05);--sh-2:0 18px 40px rgba(27,29,34,.14);--glow:0 10px 24px rgba(255,90,31,.35);--f-display:\"Space Grotesk\",\"Segoe UI Variable Display\",\"Segoe UI\",system-ui,sans-serif;--f-body:\"Inter\",\"Segoe UI\",system-ui,sans-serif;--f-mono:\"JetBrains Mono\",Consolas,\"Cascadia Mono\",monospace;--ease:cubic-bezier(.2,.8,.2,1)}",
        "@media (prefers-color-scheme:dark){:root{--bg:#0f1115;--dot:#1e2129;--surface:#171a20;--surface-2:#1d2027;--ink:#eef0f4;--ink-2:#b6bbc5;--muted:#8b919c;--forja-ink:#ff8a57;--ok-ink:#3fd39b;--bad-ink:#ff7b7d;--info-ink:#8aa8ff;--line:#272b34;--console:#0a0b0e;--console-2:#1a1d23;--forja-soft:#3a1d12;--ok-soft:#0f2e24;--warn-soft:#33260c;--warn-ink:#f2b448;--bad-soft:#3a1617;--info-soft:#17223f;--neutral-soft:#23262d;--sh-1:0 1px 2px rgba(0,0,0,.3),0 6px 18px rgba(0,0,0,.25);--sh-2:0 18px 40px rgba(0,0,0,.5)}}"
    ], "\n");
}

fn _linhas() -> string[] ={
    return [
        "<!doctype html>",
        "<html lang=\"pt-br\">",
        "<head>",
        "<meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">",
        "<title>EMP · Engineering Modular Process</title>",
        "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">",
        "<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap\" rel=\"stylesheet\">",
        "<style>",
        "/* ── Forja · tokens ─────────────────────────────────────── */",
        tokens_css(),
        "*{box-sizing:border-box}",
        "body{margin:0;font-family:var(--f-body);font-size:14px;line-height:1.5;color:var(--ink);background:var(--bg);background-image:radial-gradient(var(--dot) 1px,transparent 1.2px);background-size:22px 22px;-webkit-font-smoothing:antialiased}",
        "svg{display:block}",
        "a{color:var(--forja-ink)}",
        ":focus-visible{outline:3px solid var(--forja);outline-offset:2px}",
        ".mono{font-family:var(--f-mono)}",
        "/* ── estrutura ──────────────────────────────────────────── */",
        ".app{display:grid;grid-template-columns:262px 1fr;min-height:100vh}",
        ".console{position:sticky;top:14px;margin:14px 0 14px 14px;height:calc(100vh - 28px);background:var(--console);color:var(--console-ink);border-radius:var(--r-xl);display:flex;flex-direction:column;padding:20px 14px 14px;box-shadow:var(--sh-2);overflow:hidden}",
        ".console::before{content:\"\";position:absolute;inset:auto -60px -80px auto;width:220px;height:220px;background:radial-gradient(circle,rgba(255,90,31,.28),transparent 65%);pointer-events:none}",
        ".marca{display:flex;align-items:center;gap:12px;padding:0 8px 22px}",
        ".marca svg{width:38px;height:38px;flex:none}",
        ".marca b{display:block;font-family:var(--f-display);font-size:22px;letter-spacing:.5px;color:#fff;line-height:1}",
        ".marca small{display:block;font-family:var(--f-mono);font-size:9px;letter-spacing:1.4px;color:#8a909b;margin-top:5px}",
        ".console h3{font-family:var(--f-mono);font-size:10px;letter-spacing:1.6px;color:#8a909b;margin:14px 10px 6px;font-weight:600}",
        "nav a{position:relative;display:flex;align-items:center;gap:12px;padding:10px 12px;margin:2px 0;color:var(--console-ink);text-decoration:none;border-radius:12px;font-weight:500;transition:background .18s var(--ease),color .18s var(--ease)}",
        "nav a svg{width:19px;height:19px;fill:currentColor;flex:none;opacity:.85}",
        "nav a:hover{background:var(--console-2);color:#fff}",
        "nav a.ativo{background:linear-gradient(135deg,var(--forja),var(--forja-2));color:var(--on-forja);font-weight:600;box-shadow:var(--glow)}",
        "nav a.ativo svg{opacity:1}",
        "nav a.oculto{display:none}",
        "nav a .qt{margin-left:auto;font-family:var(--f-mono);font-size:11px;padding:1px 8px;border-radius:99px;background:var(--bad-strong);color:#fff}",
        "nav a .qt:empty{display:none}",
        ".operador{margin-top:auto;background:var(--console-2);border-radius:var(--r-md);padding:12px;position:relative}",
        ".operador .linha{display:flex;align-items:center;gap:10px}",
        ".avatar{width:36px;height:36px;border-radius:12px;background:linear-gradient(135deg,#3a3f4a,#22252c);display:grid;place-items:center;font-family:var(--f-display);font-weight:700;color:#fff;flex:none;border:1px solid #343944}",
        ".operador b{display:block;color:#fff;font-size:13px;font-weight:600;line-height:1.2}",
        ".operador small{font-family:var(--f-mono);font-size:10px;color:#8a909b}",
        ".operador input{width:100%;margin-top:10px;background:var(--console);border-color:#2f333c;color:#fff}",
        ".versao{font-family:var(--f-mono);font-size:10px;color:#8a909b;padding:10px 8px 0;letter-spacing:.4px}",
        "main{padding:28px 32px 40px;min-width:0}",
        ".cabeca{display:flex;align-items:flex-end;gap:16px;margin-bottom:24px;flex-wrap:wrap}",
        ".trilha{font-family:var(--f-mono);font-size:11px;letter-spacing:1.2px;color:var(--muted);text-transform:uppercase}",
        ".trilha i{font-style:normal;color:var(--forja);margin:0 6px}",
        ".cabeca h1{font-family:var(--f-display);font-size:34px;line-height:1.1;margin:6px 0 4px;font-weight:700;letter-spacing:-.6px}",
        ".cabeca .sub{color:var(--ink-2)}",
        ".cabeca .acoes{margin-left:auto;display:flex;gap:8px;align-items:center}",
        ".aovivo{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 14px;border-radius:99px;background:var(--surface);border:1px solid var(--line);font-family:var(--f-mono);font-size:12px;color:var(--ink-2);box-shadow:var(--sh-1)}",
        ".aovivo::before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--ok);color:var(--ok);animation:pulso 2s infinite}",
        ".redondo{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--surface);border:1px solid var(--line);color:var(--ink);cursor:pointer;position:relative;box-shadow:var(--sh-1);padding:0;transition:transform .18s var(--ease)}",
        ".redondo:hover{transform:translateY(-1px);color:var(--forja);box-shadow:var(--sh-1)}",
        ".redondo svg{width:18px;height:18px;fill:currentColor}",
        ".redondo .qt{position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;padding:0 5px;border-radius:99px;background:var(--bad-strong);color:#fff;font:600 10px/18px var(--f-mono);text-align:center;border:2px solid var(--bg)}",
        ".redondo .qt:empty{display:none}",
        ".oculto{display:none!important}",
        "/* ── controles ──────────────────────────────────────────── */",
        "input,select,button{font:inherit}",
        "input,select{height:40px;padding:0 12px;border:1px solid var(--line);border-radius:12px;background:var(--surface-2);color:var(--ink);min-width:0;transition:border-color .15s,box-shadow .15s}",
        "input:focus,select:focus{outline:0;border-color:var(--forja);box-shadow:0 0 0 4px var(--forja-soft);background:var(--surface)}",
        "button{height:40px;padding:0 18px;border:0;border-radius:12px;background:linear-gradient(135deg,var(--forja),var(--forja-2));color:var(--on-forja);font-weight:600;cursor:pointer;box-shadow:0 6px 16px rgba(255,90,31,.25);transition:transform .15s var(--ease),box-shadow .15s}",
        "button:hover{transform:translateY(-1px);box-shadow:var(--glow)}",
        "button:active{transform:none}",
        "button.sec{background:transparent;color:var(--ink-2);box-shadow:none;border:1px solid var(--line)}",
        "button.sec:hover{color:var(--ink);background:var(--surface-2)}",
        "button.ok{background:var(--ink);color:var(--surface);box-shadow:none}",
        "button.bad{background:var(--bad-strong);color:#fff;box-shadow:0 6px 16px rgba(229,56,59,.25)}",
        "button.mini{height:32px;padding:0 12px;font-size:12px;border-radius:10px}",
        "td input{height:32px;width:74px;border-radius:10px}",
        ".form{display:flex;flex-wrap:wrap;gap:12px;align-items:end}",
        ".form label{display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:600;color:var(--ink-2)}",
        "/* ── superfícies ────────────────────────────────────────── */",
        ".grid{display:grid;gap:18px}",
        ".secao{display:none}",
        ".secao.ativa{display:grid;animation:entra .35s var(--ease)}",
        ".kpis{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}",
        ".dois{grid-template-columns:repeat(auto-fit,minmax(380px,1fr))}",
        ".card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:20px 22px;box-shadow:var(--sh-1);min-width:0}",
        ".card>div:not(.postos){overflow-x:auto}",
        ".card h2{font-family:var(--f-display);font-size:17px;font-weight:600;margin:0 0 16px;display:flex;align-items:center;gap:10px;letter-spacing:-.2px}",
        ".card h2 .cont{margin-left:auto;font-family:var(--f-mono);font-size:11px;font-weight:500;color:var(--muted);background:var(--surface-2);border:1px solid var(--line);padding:3px 10px;border-radius:99px;letter-spacing:.2px}",
        ".card.destaque{animation:destaque 1.4s var(--ease)}",
        ".kpi{position:relative;overflow:hidden;padding:18px 20px 20px}",
        ".kpi .rot{font-family:var(--f-mono);font-size:10px;letter-spacing:1.3px;text-transform:uppercase;color:var(--muted)}",
        ".kpi .val{font-family:var(--f-display);font-size:40px;font-weight:700;line-height:1.05;margin-top:10px;letter-spacing:-1px;font-variant-numeric:tabular-nums}",
        ".kpi .det{color:var(--ink-2);font-size:12px;margin-top:4px}",
        ".kpi::after{content:\"\";position:absolute;left:20px;right:20px;bottom:0;height:3px;border-radius:3px 3px 0 0;background:var(--line)}",
        ".kpi.bom::after{background:var(--ok)}",
        ".kpi.alerta::after{background:var(--bad)}",
        ".kpi.alerta .val{color:var(--bad-ink)}",
        ".kpi .sinal{position:absolute;top:16px;right:16px;width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:var(--neutral-soft);color:var(--ink-2)}",
        ".kpi.bom .sinal{background:var(--ok-soft);color:var(--ok-ink)}",
        ".kpi.alerta .sinal{background:var(--bad-soft);color:var(--bad-ink)}",
        ".kpi .sinal svg{width:16px;height:16px;fill:currentColor}",
        "/* ── dados ──────────────────────────────────────────────── */",
        "table{width:100%;border-collapse:separate;border-spacing:0}",
        "th{text-align:left;font-family:var(--f-mono);font-size:10px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);padding:0 10px 10px;border-bottom:1px solid var(--line);white-space:nowrap}",
        "td{padding:12px 10px;border-bottom:1px solid var(--line);vertical-align:middle;white-space:nowrap}",
        "tr:last-child td{border-bottom:0}",
        "tbody tr:hover td{background:var(--surface-2)}",
        "tbody tr:hover td:first-child{border-radius:12px 0 0 12px}",
        "tbody tr:hover td:last-child{border-radius:0 12px 12px 0}",
        "td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}",
        ".id{font-family:var(--f-mono);font-size:12px;font-weight:600;padding:3px 8px;border-radius:8px;background:var(--surface-2);border:1px solid var(--line);white-space:nowrap}",
        ".tag{display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 11px;border-radius:99px;font-size:12px;font-weight:600;white-space:nowrap;background:var(--neutral-soft);color:var(--ink-2)}",
        ".tag::before{content:\"\";width:7px;height:7px;border-radius:50%;background:currentColor}",
        ".st-ok{background:var(--ok-soft);color:var(--ok-ink)}",
        ".st-wait{background:var(--info-soft);color:var(--info-ink)}",
        ".st-act{background:var(--forja-soft);color:var(--forja-ink)}",
        ".st-act::before{animation:pulso 1.6s infinite}",
        ".st-bad{color:var(--bad-ink);background:repeating-linear-gradient(-45deg,var(--bad-soft) 0 7px,var(--surface) 7px 10px);box-shadow:inset 0 0 0 1px var(--bad-soft)}",
        ".st-skip{background:var(--neutral-soft);color:var(--ink-2)}",
        "/* Estado = ícone + cor, sempre juntos: o ícone substitui o ponto. */",
        ".tag.ic{gap:6px;padding-left:9px}",
        ".tag.ic::before{display:none}",
        ".tag svg{width:14px;height:14px;fill:currentColor;flex:none}",
        ".st-act svg{animation:vivo 1.6s infinite}",
        ".e-plan{--eb:var(--muted)}.e-wait{--eb:var(--info)}.e-act{--eb:var(--forja)}.e-ok{--eb:var(--ok)}.e-bad{--eb:var(--bad)}.e-skip{--eb:var(--line)}",
        "tr[class*=e-] td:first-child{box-shadow:inset 4px 0 0 var(--eb)}",
        "tr.pisca td{animation:pisca 1.2s var(--ease) 1}",
        "a.id{color:var(--ink);text-decoration:none}",
        "a.id:hover{border-color:var(--forja);color:var(--forja-ink)}",
        "/* ── moldura de lista ───────────────────────────────────── */",
        ".barra-lista{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}",
        ".barra-lista input{flex:1 1 200px;max-width:300px;height:36px}",
        ".barra-lista select{height:36px}",
        ".barra-lista .n{margin-left:auto;font-family:var(--f-mono);font-size:11px;color:var(--muted)}",
        ".aviso-filtro{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--info-ink);background:var(--info-soft);border-radius:10px;padding:6px 12px;margin-bottom:10px}",
        ".aviso-filtro a{color:inherit}",
        "/* ── abas internas ──────────────────────────────────────── */",
        ".abas{display:inline-flex;gap:4px;padding:4px;border-radius:14px;background:var(--surface);border:1px solid var(--line);box-shadow:var(--sh-1);justify-self:start}",
        ".abas a{padding:8px 16px;border-radius:10px;text-decoration:none;color:var(--ink-2);font-weight:600}",
        ".abas a:hover{background:var(--surface-2);color:var(--ink)}",
        ".abas a.ativo{background:var(--console);color:#fff}",
        ".aba{display:none}",
        ".aba.ativa{display:grid}",
        "/* ── fluxo de etapas ────────────────────────────────────── */",
        ".op-cab{display:flex;flex-wrap:wrap;gap:14px 26px;align-items:center;margin-bottom:20px}",
        ".op-cab .voltar{font-family:var(--f-mono);font-size:11px;letter-spacing:1px;font-weight:600;text-decoration:none;flex-basis:100%}",
        ".op-cab .prod b{display:block;font-family:var(--f-display);font-size:22px;letter-spacing:-.3px}",
        ".op-cab .prod span{color:var(--ink-2)}",
        ".op-cab .nums{display:flex;gap:22px;flex-wrap:wrap}",
        ".op-cab .nums small,.etapa-dados small{display:block;font-family:var(--f-mono);font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted)}",
        ".op-cab .nums b{font-family:var(--f-display);font-size:22px;font-variant-numeric:tabular-nums}",
        ".op-cab .led{flex:1 1 220px;max-width:360px}",
        ".fluxo{position:relative;display:grid;gap:12px;padding-left:46px}",
        ".fluxo::before{content:\"\";position:absolute;left:17px;top:20px;bottom:20px;width:2px;background:var(--line);border-radius:2px}",
        ".etapa{position:relative;padding:14px 16px;border-radius:var(--r-md);background:var(--surface-2);border:1px solid var(--line);border-left:5px solid var(--eb)}",
        ".etapa.atual{background:var(--surface);box-shadow:0 0 0 3px var(--forja-soft)}",
        ".etapa.pisca{animation:pisca 1.2s var(--ease) 1}",
        ".etapa .no{position:absolute;left:-46px;top:12px;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:var(--surface);border:2px solid var(--eb);color:var(--ink-2)}",
        ".etapa .no svg{width:16px;height:16px;fill:currentColor}",
        ".etapa.e-act .no{color:var(--forja-ink)}.etapa.e-ok .no{color:var(--ok-ink)}.etapa.e-bad .no{color:var(--bad-ink)}.etapa.e-wait .no{color:var(--info-ink)}",
        ".etapa-topo{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center}",
        ".etapa-topo b{font-family:var(--f-display);font-size:16px;font-weight:600}",
        ".etapa-topo .d{color:var(--ink-2)}",
        ".etapa-topo .tag{margin-left:auto}",
        ".etapa-instr{color:var(--ink-2);font-size:13px;margin-top:4px}",
        ".etapa-dados{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px 16px;margin-top:12px;font-size:13px}",
        ".etapa-dados span{font-variant-numeric:tabular-nums}",
        ".atraso{color:var(--bad-ink);font-weight:600}",
        ".etapa-op{font-family:var(--f-mono);font-size:11px;color:var(--muted);margin-top:4px}",
        ".etapa-op svg{display:inline-block;width:11px;height:11px;fill:var(--bad-ink);vertical-align:-1px;margin-left:5px}",
        "/* Ações da linha da OP quebram em duas linhas: a tabela cabe em 1440 px. */",
        ".acoes-op{display:flex;flex-wrap:wrap;gap:6px;align-items:center;max-width:220px}",
        ".acoes-op input{width:64px}",
        "td .led{min-width:104px}",
        ".etapa-erro{margin-top:10px;font-size:13px;color:var(--bad-ink);background:var(--bad-soft);border-radius:10px;padding:8px 10px}",
        ".etapa-acoes{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px;align-items:center}",
        ".etapa-acoes input{height:32px;width:200px;border-radius:10px}",
        ".passos{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:14px 0 4px}",
        ".passos i{font-style:normal;color:var(--muted)}",
        ".term{font-family:var(--f-mono);font-size:10px;letter-spacing:1px;font-weight:600;text-decoration:none;white-space:nowrap}",
        ".led{display:flex;gap:3px;align-items:center;min-width:130px}",
        ".led i{flex:1;height:8px;border-radius:3px;background:var(--line)}",
        ".led i.on{background:var(--forja)}",
        ".led.cheio i.on{background:var(--ok)}",
        ".led span{font-family:var(--f-mono);font-size:11px;color:var(--muted);margin-left:8px;min-width:34px;text-align:right}",
        ".barra{height:8px;background:var(--line);border-radius:99px;overflow:hidden;min-width:90px}",
        ".barra i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--forja),var(--forja-2))}",
        ".distrib{display:flex;height:14px;border-radius:99px;overflow:hidden;background:var(--line);gap:3px}",
        ".distrib i{display:block;height:100%}",
        ".chips{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:14px;font-size:13px;color:var(--ink-2)}",
        ".chips span{display:inline-flex;align-items:center;gap:8px}",
        ".chips i{width:10px;height:10px;border-radius:3px;display:inline-block}",
        ".chips b{font-family:var(--f-mono);color:var(--ink)}",
        "/* ── máquinas ───────────────────────────────────────────── */",
        ".postos{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;align-items:start}",
        ".posto{position:relative;display:grid;grid-template-columns:68px 1fr;gap:14px;align-items:center;padding:16px;border-radius:var(--r-md);background:var(--surface-2);border:1px solid var(--line);overflow:hidden}",
        ".posto b{font-family:var(--f-display);font-size:16px;font-weight:700;letter-spacing:-.2px}",
        ".posto .d{color:var(--muted);font-size:12px;margin:1px 0 8px}",
        ".posto{border-left:5px solid var(--ok)}",
        ".posto.PARADO{border-color:var(--bad);border-left-color:var(--bad);background:var(--surface)}",
        ".posto .term{display:block;margin-top:8px}",
        ".posto.PARADO::before{content:\"\";position:absolute;left:0;right:0;top:0;height:6px;background:repeating-linear-gradient(-45deg,var(--bad) 0 8px,#ffd400 8px 16px)}",
        ".posto .m{grid-column:1/-1;font-size:12px;color:var(--bad-ink);background:var(--bad-soft);border-radius:10px;padding:8px 10px;line-height:1.4}",
        ".medidor{--p:0;--c:var(--ok);width:68px;height:68px;border-radius:50%;background:conic-gradient(var(--c) calc(var(--p)*1%),var(--line) 0);display:grid;place-items:center}",
        ".medidor span{width:52px;height:52px;border-radius:50%;background:var(--surface);display:grid;place-items:center;font-family:var(--f-display);font-weight:700;font-size:14px;letter-spacing:-.3px}",
        "/* ── eventos ────────────────────────────────────────────── */",
        ".linha-tempo{position:relative;padding-left:22px}",
        ".linha-tempo::before{content:\"\";position:absolute;left:6px;top:6px;bottom:6px;width:2px;background:var(--line);border-radius:2px}",
        ".ev{position:relative;display:grid;grid-template-columns:56px 1fr;gap:2px 12px;padding:8px 0}",
        ".ev::before{content:\"\";position:absolute;left:-21px;top:13px;width:10px;height:10px;border-radius:50%;background:var(--surface);border:2px solid var(--forja)}",
        ".ev .h{font-family:var(--f-mono);font-size:11px;color:var(--muted);padding-top:2px}",
        ".ev .tp{font-family:var(--f-mono);font-size:12px;font-weight:600}",
        ".ev .dd{grid-column:2;color:var(--ink-2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}",
        ".vazio{color:var(--muted);padding:22px 0;text-align:center}",
        ".neg{color:var(--bad-ink);font-weight:600}",
        "code{font-family:var(--f-mono);font-size:12px;background:var(--surface-2);border:1px solid var(--line);padding:2px 7px;border-radius:7px}",
        "/* ── início ─────────────────────────────────────────────── */",
        ".heroi{position:relative;overflow:hidden;border-radius:var(--r-xl);padding:28px 30px;background:radial-gradient(circle at 88% 15%,rgba(255,154,61,.6),transparent 42%),radial-gradient(circle at 70% 120%,rgba(255,90,31,.35),transparent 50%),linear-gradient(135deg,#1b1d22,#2a2018);color:#fff;box-shadow:var(--sh-2)}",
        ".heroi::after{content:\"\";position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.08) 1px,transparent 1.2px);background-size:18px 18px;pointer-events:none}",
        ".heroi .trilha{color:#ffb98f}",
        ".heroi h2{position:relative;z-index:1;font-family:var(--f-display);font-size:30px;margin:8px 0 22px;font-weight:700;letter-spacing:-.6px;max-width:620px;line-height:1.15}",
        ".heroi .nums{display:flex;flex-wrap:wrap;gap:14px;position:relative;z-index:1}",
        ".heroi .num{min-width:150px;padding:14px 18px;border-radius:var(--r-md);background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(6px)}",
        ".heroi .num b{display:block;font-family:var(--f-display);font-size:32px;font-weight:700;letter-spacing:-.8px;line-height:1.1}",
        ".heroi .num small{font-family:var(--f-mono);font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:#d7d9de}",
        ".tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px}",
        ".tile{position:relative;display:flex;flex-direction:column;gap:10px;padding:22px;border-radius:var(--r-lg);background:var(--surface);border:1px solid var(--line);box-shadow:var(--sh-1);text-decoration:none;color:var(--ink);transition:transform .2s var(--ease),box-shadow .2s var(--ease),border-color .2s}",
        ".tile:hover{transform:translateY(-3px);box-shadow:var(--sh-2);border-color:var(--forja-soft)}",
        ".tile .ico{width:52px;height:52px;border-radius:16px;display:grid;place-items:center;background:var(--forja-soft);color:var(--forja-ink)}",
        ".tile .ico svg{width:26px;height:26px;fill:currentColor}",
        ".tile h3{font-family:var(--f-display);font-size:20px;font-weight:700;margin:6px 0 0;letter-spacing:-.3px}",
        ".tile p{margin:0;color:var(--ink-2);font-size:13px;line-height:1.55}",
        ".tile .ir{margin-top:auto;padding-top:8px;font-family:var(--f-mono);font-size:11px;letter-spacing:1px;color:var(--forja-ink);font-weight:600}",
        "/* ── fase 2 · pedidos ───────────────────────────────────── */",
        ".sinal-atraso{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 9px;border-radius:99px;font-size:11px;font-weight:600;color:var(--bad-ink);background:var(--bad-soft);white-space:nowrap;margin-left:6px}",
        ".sinal-atraso svg{width:13px;height:13px;fill:currentColor}",
        ".itens-ped{display:grid;gap:8px;flex:1 1 100%}",
        ".item-ped{display:flex;gap:8px;align-items:center}",
        ".item-ped select{flex:1 1 220px;max-width:340px}",
        ".item-ped input{width:110px}",
        ".item-ped .rem{width:40px;padding:0;background:transparent;color:var(--ink-2);border:1px solid var(--line);box-shadow:none}",
        ".item-ped .rem:hover{color:var(--bad-ink);border-color:var(--bad)}",
        ".quebra{white-space:normal;min-width:110px;max-width:200px}",
        ".ops-ped{display:flex;flex-wrap:wrap;gap:4px;max-width:220px;white-space:normal}",
        ".ped-acoes{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:16px;padding-top:16px;border-top:1px solid var(--line)}",
        ".ped-acoes select,.ped-acoes input{height:36px}",
        ".ped-obs{color:var(--ink-2);font-size:13px;margin:-8px 0 16px;white-space:pre-line}",
        "/* ── fase 2 · estoque ───────────────────────────────────── */",
        ".enderecos{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px}",
        ".endereco{display:grid;gap:4px;text-align:left;height:auto;padding:14px 16px;border-radius:var(--r-md);background:var(--surface-2);border:1px solid var(--line);color:var(--ink);box-shadow:none;font-weight:400;cursor:pointer}",
        ".endereco:hover{transform:translateY(-1px);box-shadow:var(--sh-1);border-color:var(--forja-soft)}",
        ".endereco.sel{background:var(--surface);box-shadow:0 0 0 3px var(--forja-soft);border-color:var(--forja)}",
        ".endereco b{font-family:var(--f-display);font-size:16px;font-weight:700;letter-spacing:-.2px}",
        ".endereco .tp{font-family:var(--f-mono);font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted)}",
        ".endereco .d{font-size:12px;color:var(--ink-2)}",
        ".endereco .q{font-family:var(--f-mono);font-size:11px;color:var(--muted)}",
        ".endereco .neg{font-family:var(--f-mono);font-size:11px}",
        ".por-end{display:grid;grid-template-columns:minmax(90px,auto) 1fr auto;gap:10px 14px;align-items:center}",
        ".por-end .barra{min-width:60px}",
        ".por-end .v{font-family:var(--f-mono);font-size:12px;text-align:right}",
        ".reposicao{position:relative;height:10px;border-radius:99px;background:var(--line);min-width:150px;margin:6px 0}",
        ".reposicao .fx{position:absolute;top:0;bottom:0;background:var(--ok-soft);box-shadow:inset 0 0 0 1px var(--ok)}",
        ".reposicao .sd{position:absolute;top:-3px;width:4px;height:16px;border-radius:2px;margin-left:-2px;background:var(--ink)}",
        ".reposicao.baixo .sd{background:var(--bad)}",
        ".reposicao.baixo{background:repeating-linear-gradient(-45deg,var(--bad-soft) 0 6px,var(--line) 6px 9px)}",
        ".rep-leg{display:flex;justify-content:space-between;font-family:var(--f-mono);font-size:10px;color:var(--muted)}",
        "/* ── fase 2 · OEE ───────────────────────────────────────── */",
        ".janela{display:inline-flex;gap:4px;padding:4px;border-radius:14px;background:var(--surface);border:1px solid var(--line);box-shadow:var(--sh-1)}",
        ".janela a{padding:8px 16px;border-radius:10px;text-decoration:none;color:var(--ink-2);font-weight:600;font-family:var(--f-mono);font-size:12px}",
        ".janela a:hover{background:var(--surface-2);color:var(--ink)}",
        ".janela a.ativo{background:var(--console);color:#fff}",
        ".topo-oee{display:flex;flex-wrap:wrap;gap:12px;align-items:center}",
        ".topo-oee .nota{color:var(--muted);font-size:12px}",
        ".oee-linha{display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:center}",
        ".oee-linha .anel{position:relative;z-index:1;width:156px;height:156px}",
        ".oee-linha .anel svg{width:156px;height:156px}",
        ".oee-linha .anel b{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--f-display);font-size:38px;font-weight:700;letter-spacing:-1px}",
        ".oee-linha .anel small{position:absolute;left:0;right:0;bottom:36px;text-align:center;font-family:var(--f-mono);font-size:10px;letter-spacing:1.2px;color:#d7d9de}",
        ".conta{position:relative;z-index:1;display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px}",
        ".conta .fat{min-width:130px;padding:12px 16px;border-radius:var(--r-md);background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12)}",
        ".conta .fat b{display:block;font-family:var(--f-display);font-size:28px;font-weight:700;letter-spacing:-.6px;line-height:1.1}",
        ".conta .fat small{font-family:var(--f-mono);font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:#d7d9de}",
        ".conta .op{font-family:var(--f-display);font-size:26px;color:#ffb98f}",
        ".conta .fat.res{background:linear-gradient(135deg,var(--forja),var(--forja-2));border:0;color:var(--on-forja)}",
        ".conta .fat.res small{color:var(--on-forja)}",
        ".heroi .faixa-meta{position:relative;z-index:1;margin-top:16px;font-size:13px;color:#d7d9de}",
        ".oee-postos{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}",
        ".oee-posto{display:grid;gap:12px;padding:16px;border-radius:var(--r-md);background:var(--surface-2);border:1px solid var(--line);border-left:5px solid var(--eb,var(--line))}",
        ".oee-posto .cab{display:grid;grid-template-columns:68px 1fr;gap:14px;align-items:center}",
        ".oee-posto b{font-family:var(--f-display);font-size:16px;font-weight:700}",
        ".oee-posto .d{color:var(--muted);font-size:12px;margin:1px 0 6px}",
        ".fatores{display:grid;gap:7px}",
        ".fator{display:grid;grid-template-columns:96px 1fr 46px;gap:10px;align-items:center;font-size:12px;color:var(--ink-2)}",
        ".fator .barra{min-width:0;height:7px}",
        ".fator .barra i{background:var(--ink-2)}",
        ".fator span:last-child{font-family:var(--f-mono);text-align:right;color:var(--ink)}",
        ".oee-posto .min{display:flex;flex-wrap:wrap;gap:4px 14px;font-family:var(--f-mono);font-size:11px;color:var(--muted)}",
        ".oee-posto .min b{font-family:var(--f-mono);font-size:11px;color:var(--ink);font-weight:600}",
        ".tl{display:grid;grid-template-columns:110px 1fr;gap:6px 14px;align-items:center}",
        ".tl .p{font-family:var(--f-mono);font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}",
        ".tl svg{width:100%;height:26px;border-radius:8px;overflow:hidden}",
        ".tl .eixo{grid-column:2;display:flex;justify-content:space-between;font-family:var(--f-mono);font-size:10px;color:var(--muted)}",
        ".tl rect{cursor:default}",
        ".serie-cab{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:-4px 0 12px}",
        ".serie-cab select{height:36px}",
        ".serie-cab .nota{color:var(--muted);font-size:12px}",
        ".grafico{position:relative}",
        ".grafico svg{width:100%;height:auto;overflow:visible}",
        ".grafico text{font-family:var(--f-mono);font-size:10px;fill:var(--muted)}",
        ".grafico .grade{stroke:var(--line);stroke-width:1}",
        ".grafico .meta{stroke:var(--ok);stroke-width:1.5;stroke-dasharray:5 4}",
        ".grafico .col{fill:var(--forja)}",
        ".grafico .col.vazia{fill:var(--line)}",
        ".grafico .alvo{fill:transparent}",
        ".grafico .alvo:hover+.col,.grafico g:hover .col{opacity:.75}",
        ".dica{position:absolute;pointer-events:none;z-index:5;background:var(--console);color:#fff;border-radius:12px;padding:9px 12px;font-size:12px;line-height:1.5;box-shadow:var(--sh-2);white-space:nowrap;transform:translate(-50%,-100%);margin-top:-10px}",
        ".dica b{font-family:var(--f-mono);font-size:11px;color:#ffb98f;display:block}",
        "@media (max-width:900px){.oee-linha{grid-template-columns:1fr;justify-items:start}.tl{grid-template-columns:76px 1fr}.item-ped select{flex:1 1 120px}.item-ped input{width:76px}}",
        ".st-warn{background:var(--warn-soft);color:var(--warn-ink)}",
        "/* ── avisos ─────────────────────────────────────────────── */",
        "#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;z-index:30}",
        "#toast div{display:flex;align-items:center;gap:10px;background:var(--console);color:#fff;padding:11px 18px;border-radius:99px;box-shadow:var(--sh-2);max-width:440px;animation:entra .25s var(--ease)}",
        "#toast div::before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--ok);flex:none}",
        "#toast div.erro::before{background:var(--bad)}",
        "@keyframes pulso{0%{box-shadow:0 0 0 0 currentColor}70%{box-shadow:0 0 0 6px transparent}100%{box-shadow:0 0 0 0 transparent}}",
        "@keyframes vivo{50%{opacity:.35}}",
        "@keyframes pisca{0%,100%{background:var(--surface-2)}35%{background:var(--bad-soft)}}",
        "@keyframes entra{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}",
        "@keyframes destaque{0%{box-shadow:0 0 0 0 var(--forja)}30%{box-shadow:0 0 0 5px var(--forja-soft)}100%{box-shadow:var(--sh-1)}}",
        "@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}",
        "@media (max-width:900px){.app{grid-template-columns:1fr}.console{position:fixed;top:auto;bottom:10px;left:10px;right:10px;margin:0;height:64px;padding:8px;border-radius:22px;flex-direction:row;z-index:20}.console::before,.marca,.console h3,.operador,.versao{display:none}.console nav{display:flex;gap:4px;overflow-x:auto}nav a{flex-direction:column;gap:2px;font-size:10px;padding:6px 10px;margin:0;white-space:nowrap}nav a svg{width:18px;height:18px}nav a .qt{position:absolute;top:2px;right:4px}main{padding:18px 14px 100px}.cabeca h1{font-size:28px}.cabeca .acoes{margin-left:0}.aovivo{display:none}.dois{grid-template-columns:1fr}.heroi{padding:22px}.heroi h2{font-size:24px}.heroi .num{min-width:0;flex:1 1 40%}.fluxo{padding-left:0}.fluxo::before,.etapa .no{display:none}}",
        "</style>",
        "</head>",
        "<body>",
        "<div class=\"app\">",
        "<aside class=\"console\">",
        "<div class=\"marca\">",
        "<svg viewBox=\"0 0 40 40\" aria-hidden=\"true\"><defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#ff5a1f\"/><stop offset=\"1\" stop-color=\"#ff9a3d\"/></linearGradient></defs><rect x=\"2\" y=\"2\" width=\"36\" height=\"36\" rx=\"11\" fill=\"url(#g)\"/><rect x=\"10\" y=\"10\" width=\"20\" height=\"5\" rx=\"2.5\" fill=\"#fff\"/><rect x=\"10\" y=\"17.5\" width=\"13\" height=\"5\" rx=\"2.5\" fill=\"#fff\" opacity=\".85\"/><rect x=\"10\" y=\"25\" width=\"20\" height=\"5\" rx=\"2.5\" fill=\"#fff\"/><circle cx=\"28\" cy=\"20\" r=\"2.5\" fill=\"#fff\" opacity=\".85\"/></svg>",
        "<div><b>EMP</b><small>ENGINEERING MODULAR PROCESS</small></div>",
        "</div>",
        "<h3>OPERAÇÃO</h3>",
        "<nav id=\"nav\">",
        "<a href=\"#inicio\" data-sec=\"inicio\"><svg viewBox=\"0 0 24 24\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"/></svg>Início</a>",
        "<a href=\"#geral\" data-sec=\"geral\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z\"/></svg>Visão geral</a>",
        "<a href=\"#pedidos\" data-sec=\"pedidos\" data-mod=\"pedidos\"><svg viewBox=\"0 0 24 24\"><path d=\"M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1.003 1.003 0 0020 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z\"/></svg>Pedidos<span class=\"qt\" id=\"qt-ped\"></span></a>",
        "<a href=\"#mrp\" data-sec=\"mrp\" data-mod=\"mrp\"><svg viewBox=\"0 0 24 24\"><path d=\"M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z\"/></svg>MRP / PCP<span class=\"qt\" id=\"qt-mrp\"></span></a>",
        "<a href=\"#ordens\" data-sec=\"ordens\" data-mod=\"producao\"><svg viewBox=\"0 0 24 24\"><path d=\"M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z\"/></svg>Ordens</a>",
        "<a href=\"#programacao\" data-sec=\"programacao\" data-mod=\"programacao\"><svg viewBox=\"0 0 24 24\"><path d=\"M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z\"/></svg>Programação<span class=\"qt\" id=\"qt-prog\"></span></a>",
        "<a href=\"#estoque\" data-sec=\"estoque\" data-mod=\"estoque\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z\"/></svg>Estoque<span class=\"qt\" id=\"qt-sug\"></span></a>",
        "<a href=\"#manutencao\" data-sec=\"manutencao\" data-mod=\"manutencao\"><svg viewBox=\"0 0 24 24\"><path d=\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\"/></svg>Manutenção<span class=\"qt\" id=\"qt-man\"></span></a>",
        "<a href=\"#oee\" data-sec=\"oee\" data-mod=\"indicadores\"><svg viewBox=\"0 0 24 24\"><path d=\"M20.38 8.57l-1.23 1.85a8 8 0 0 1-.22 7.58H5.07A8 8 0 0 1 15.58 6.85l1.85-1.23A10 10 0 0 0 3.35 19a2 2 0 0 0 1.72 1h13.85a2 2 0 0 0 1.74-1 10 10 0 0 0-.27-10.44zm-9.79 6.84a2 2 0 0 0 2.83 0l5.66-8.49-8.49 5.66a2 2 0 0 0 0 2.83z\"/></svg>OEE</a>",
        "<a href=\"#qualidade\" data-sec=\"qualidade\" data-mod=\"qualidade\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>Qualidade<span class=\"qt\" id=\"qt-ncs\"></span></a>",
        "<a href=\"#cadastros\" data-sec=\"cadastros\" data-mod=\"cadastros\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z\"/></svg>Cadastros</a>",
        "<a href=\"/terminal\" data-mod=\"producao\"><svg viewBox=\"0 0 24 24\"><path d=\"M17 1H7C5.9 1 5 1.9 5 3v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-5 21c-.83 0-1.5-.67-1.5-1.5S11.17 19 12 19s1.5.67 1.5 1.5S12.83 22 12 22zm5-4H7V4h10v14z\"/></svg>Terminal</a>",
        "<h3>SISTEMA</h3>",
        "<a href=\"#eventos\" data-sec=\"eventos\"><svg viewBox=\"0 0 24 24\"><path d=\"M7 2v11h3v9l7-12h-4l4-8z\"/></svg>Eventos</a>",
        "<a href=\"#modulos\" data-sec=\"modulos\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z\"/></svg>Módulos</a>",
        "</nav>",
        "<div class=\"operador\">",
        "<div class=\"linha\"><div class=\"avatar\" id=\"avatar\">?</div><div><b id=\"sessao\">…</b><small>operador conectado</small></div></div>",
        "<input id=\"token\" type=\"password\" placeholder=\"token de acesso\" aria-label=\"Token de acesso\">",
        "</div>",
        "<div class=\"versao\" id=\"versao\">EMP</div>",
        "</aside>",
        "",
        "<main>",
        "<header class=\"cabeca\">",
        "<div>",
        "<div class=\"trilha\" id=\"crumb\">EMP</div>",
        "<h1 id=\"titulo\">Início</h1>",
        "<div class=\"sub\" id=\"subtitulo\"></div>",
        "</div>",
        "<div class=\"acoes\">",
        "<span class=\"aovivo\" id=\"relogio\">--:--:--</span>",
        "<button class=\"redondo\" id=\"btn-sino\" title=\"Alertas\" aria-label=\"Alertas\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z\"/></svg><span class=\"qt\" id=\"alertas\"></span></button>",
        "<button class=\"redondo\" id=\"btn-atualizar\" title=\"Atualizar\" aria-label=\"Atualizar\"><svg viewBox=\"0 0 24 24\"><path d=\"M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z\"/></svg></button>",
        "<button id=\"btn-novo\">+ Novo</button>",
        "</div>",
        "</header>",
        "",
        "<section class=\"secao grid\" id=\"s-inicio\">",
        "<div class=\"heroi\">",
        "<div class=\"trilha\">LINHA AGORA</div>",
        "<h2 id=\"heroi-frase\">Lendo a linha de produção…</h2>",
        "<div class=\"nums\" id=\"heroi-nums\"></div>",
        "</div>",
        "<div class=\"tiles\">",
        "<a class=\"tile\" href=\"#geral\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z\"/></svg></div><h3>Visão geral</h3><p>Ordens abertas, produção, refugo, disponibilidade e os últimos eventos, em tempo real.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#pedidos\" data-mod=\"pedidos\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1.003 1.003 0 0020 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z\"/></svg></div><h3>Pedidos</h3><p>Pedidos de clientes com prazo: gere as OPs da falta, acompanhe o atraso e expeça.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#ordens\" data-mod=\"producao\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z\"/></svg></div><h3>Ordens de produção</h3><p>Planeje, libere e aponte. Cada ordem diz o que produzir, quanto e em qual posto.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#programacao\" data-mod=\"programacao\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z\"/></svg></div><h3>Programação (APS)</h3><p>Sequenciamento de OPs por posto, balanceamento de capacidade, detecção de gargalos e prazos.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#estoque\" data-mod=\"estoque\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z\"/></svg></div><h3>Estoque</h3><p>Saldos por endereço, transferências e reposição por mínimo e máximo. O consumo sai sozinho a cada apontamento.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#manutencao\" data-mod=\"manutencao\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z\"/></svg></div><h3>Manutenção</h3><p>Paradas por categoria, disponibilidade na janela de 8 h e tempo médio de reparo.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#oee\" data-mod=\"indicadores\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M20.38 8.57l-1.23 1.85a8 8 0 0 1-.22 7.58H5.07A8 8 0 0 1 15.58 6.85l1.85-1.23A10 10 0 0 0 3.35 19a2 2 0 0 0 1.72 1h13.85a2 2 0 0 0 1.74-1 10 10 0 0 0-.27-10.44zm-9.79 6.84a2 2 0 0 0 2.83 0l5.66-8.49-8.49 5.66a2 2 0 0 0 0 2.83z\"/></svg></div><h3>OEE</h3><p>Disponibilidade × desempenho × qualidade por posto, linha do tempo de estados e série por hora.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#qualidade\" data-mod=\"qualidade\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg></div><h3>Qualidade</h3><p>Não conformidades manuais e automáticas, quando o refugo passa do limite.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"#cadastros\" data-mod=\"cadastros\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z\"/></svg></div><h3>Cadastros</h3><p>Produtos, estrutura (BOM), postos e roteiros: os blocos que montam a fábrica.</p><span class=\"ir\">ABRIR →</span></a>",
        "<a class=\"tile\" href=\"/terminal\" data-mod=\"producao\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M17 1H7C5.9 1 5 1.9 5 3v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-5 21c-.83 0-1.5-.67-1.5-1.5S11.17 19 12 19s1.5.67 1.5 1.5S12.83 22 12 22zm5-4H7V4h10v14z\"/></svg></div><h3>Terminal do operador</h3><p>Tela cheia para o tablet do posto: uma instrução por vez, botões grandes.</p><span class=\"ir\">ABRIR →</span></a>",
        "</div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-geral\">",
        "<div class=\"grid kpis\" id=\"kpis\"></div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Postos de trabalho<span class=\"cont\" id=\"geral-postos-c\"></span></h2><div class=\"postos\" id=\"geral-postos\"></div></div>",
        "<div class=\"card\"><h2>Eventos recentes<span class=\"cont\">barramento</span></h2><div id=\"geral-eventos\"></div></div>",
        "</div>",
        "<div class=\"card\"><h2>Ordens em andamento</h2><div id=\"geral-ordens\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-pedidos\">",
        "<div class=\"card oculto\" id=\"ped-detalhe\"></div>",
        "<div class=\"card so-lista\"><h2>Pedidos por estado<span class=\"cont\" id=\"pedidos-atr\"></span></h2><div id=\"pedidos-leg\"></div></div>",
        "<div class=\"card so-lista\"><h2>Novo pedido</h2>",
        "<form class=\"form\" id=\"f-pedido\">",
        "<label>Cliente<select name=\"cliente\" id=\"ped-cliente\" required></select></label>",
        "<label>Prazo (dias)<input name=\"prazo_dias\" size=\"4\" value=\"7\" required></label>",
        "<label style=\"flex:1 1 240px\">Observação<input name=\"observacao\" placeholder=\"opcional\"></label>",
        "<div class=\"itens-ped\" id=\"ped-itens\"></div>",
        "<button type=\"button\" class=\"sec\" id=\"ped-mais\">+ Item</button>",
        "<button>Criar pedido</button>",
        "</form></div>",
        "<div class=\"card so-lista\"><h2>Pedidos<span class=\"cont\" id=\"pedidos-c\"></span></h2><div id=\"pedidos\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-mrp\">",
        "<div class=\"card\">",
        "<div style=\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px\">",
        "<div><b>Planejamento de Necessidades de Materiais</b><div style=\"color:var(--muted);font-size:12px;margin-top:2px\">Explosão da estrutura (BOM) combinando demanda de pedidos e estoque mínimo</div></div>",
        "<button class=\"ok\" id=\"btn-mrp-gerar\" onclick=\"gerarOrdensMrp()\">Gerar Ordens de Produção (MRP)</button>",
        "</div>",
        "</div>",
        "<div class=\"card\"><h2>Plano de Necessidades<span class=\"cont\" id=\"mrp-c\"></span></h2><div id=\"mrp-tabela\"></div></div>",
        "</section>",
        "<section class=\"secao grid\" id=\"s-ordens\">",
        "<div class=\"card oculto\" id=\"op-detalhe\"></div>",
        "<div class=\"card so-lista\"><h2>Ordens por estado<span class=\"cont\" id=\"ordens-hora\"></span></h2><div id=\"ordens-leg\"></div></div>",
        "<div class=\"card so-lista\"><h2>Nova ordem de produção</h2>",
        "<form class=\"form\" id=\"f-op\">",
        "<label>Produto<select name=\"produto\" id=\"op-produto\"></select></label>",
        "<label>Quantidade<input name=\"quantidade\" size=\"8\" required></label>",
        "<label>Posto<select name=\"posto\" id=\"op-posto\"></select></label>",
        "<button>Criar OP</button>",
        "</form></div>",
        "<div class=\"card so-lista\"><h2>Ordens<span class=\"cont\" id=\"ordens-c\"></span></h2><div id=\"ordens\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-programacao\">",
        "<div class=\"card\"><h2>Carga e Capacidade por Posto de Trabalho<span class=\"cont\" id=\"prog-postos-c\"></span></h2><div class=\"postos\" id=\"prog-postos\"></div></div>",
        "<div class=\"card\">",
        "<div style=\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:12px\">",
        "<div><h2 style=\"margin:0\">Fila de Sequenciamento e Projeção de Cronograma (APS)<span class=\"cont\" id=\"prog-agenda-c\"></span></h2><div style=\"color:var(--muted);font-size:12px;margin-top:2px\">Sequenciamento inteligente por prioridade do PCP, Earliest Due Date (prazo de entrega do pedido) e FIFO</div></div>",
        "<div style=\"display:flex;align-items:center;gap:8px\"><label style=\"font-size:12px;font-weight:600;color:var(--ink-2)\">Filtrar posto:<select id=\"prog-filtro-posto\" onchange=\"carregarAgendaProg()\" style=\"height:34px;padding:0 8px\"></select></label></div>",
        "</div>",
        "<div id=\"prog-agenda-tabela\"></div>",
        "</div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-estoque\">",
        "<nav class=\"abas\" aria-label=\"Estoque\"><a href=\"#estoque\" data-aba=\"saldos\">Saldos e movimentos</a><a href=\"#estoque/posicoes\" data-aba=\"posicoes\">Endereços e posições</a><a href=\"#estoque/reposicao\" data-aba=\"reposicao\">Reposição<span class=\"qt\" id=\"qt-sug-aba\"></span></a></nav>",
        "<div class=\"card oculto\" id=\"est-produto\"></div>",
        "<div class=\"aba grid\" data-aba=\"saldos\">",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Entrada de material</h2>",
        "<form class=\"form\" id=\"f-entrada\">",
        "<label>Produto<select name=\"produto\" id=\"ent-produto\"></select></label>",
        "<label>Quantidade<input name=\"quantidade\" size=\"8\" required></label>",
        "<label>Endereço<select name=\"endereco\" id=\"ent-endereco\" class=\"sel-endereco\"></select></label>",
        "<label>Origem<input name=\"origem\" placeholder=\"NF / fornecedor\" size=\"14\"></label>",
        "<button>Registrar</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Ajuste de inventário</h2>",
        "<form class=\"form\" id=\"f-ajuste\">",
        "<label>Produto<select name=\"produto\" id=\"aj-produto\"></select></label>",
        "<label>Endereço<select name=\"endereco\" id=\"aj-endereco\" class=\"sel-endereco\"></select></label>",
        "<label>Saldo contado<input name=\"saldo\" size=\"8\" required></label>",
        "<label>Motivo<input name=\"motivo\" size=\"14\"></label>",
        "<button class=\"sec\">Ajustar</button>",
        "</form></div>",
        "</div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Saldos<span class=\"cont\" id=\"saldos-c\"></span></h2><div id=\"saldos\"></div></div>",
        "<div class=\"card\"><h2>Últimos movimentos</h2><div id=\"movimentos\"></div></div>",
        "</div>",
        "</div>",
        "<div class=\"aba grid\" data-aba=\"posicoes\">",
        "<div class=\"card\"><h2>Endereços<span class=\"cont\" id=\"enderecos-c\"></span></h2><div class=\"enderecos\" id=\"enderecos\"></div></div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Transferência entre endereços</h2>",
        "<form class=\"form\" id=\"f-transferir\">",
        "<label>Produto<select name=\"produto\" id=\"tr-produto\"></select></label>",
        "<label>De<select name=\"de\" id=\"tr-de\" class=\"sel-endereco\"></select></label>",
        "<label>Para<select name=\"para\" id=\"tr-para\" class=\"sel-endereco\"></select></label>",
        "<label>Quantidade<input name=\"quantidade\" size=\"8\" required></label>",
        "<button>Transferir</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Novo endereço</h2>",
        "<form class=\"form\" id=\"f-endereco\">",
        "<label>Código<input name=\"codigo\" size=\"10\" required></label>",
        "<label>Descrição<input name=\"descricao\" size=\"16\"></label>",
        "<label>Tipo<select name=\"tipo\" id=\"end-tipo\"><option value=\"ALMOXARIFADO\">Almoxarifado</option><option value=\"LINHA\">Linha (posto)</option><option value=\"EXPEDICAO\">Expedição</option><option value=\"QUARENTENA\">Quarentena</option></select></label>",
        "<label>Posto<select name=\"posto\" id=\"end-posto\"></select></label>",
        "<button>Salvar</button>",
        "</form></div>",
        "</div>",
        "<div class=\"card\"><h2>Posições<span class=\"cont\" id=\"posicoes-c\"></span></h2><div id=\"posicoes\"></div></div>",
        "</div>",
        "<div class=\"aba grid\" data-aba=\"reposicao\">",
        "<div class=\"card\"><h2>Sugestões de reposição<span class=\"cont\" id=\"sugestoes-c\"></span></h2><div id=\"sugestoes\"></div></div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Regra de reposição</h2>",
        "<form class=\"form\" id=\"f-reposicao\">",
        "<label>Produto<select name=\"produto\" id=\"rep-produto\"></select></label>",
        "<label>Mínimo<input name=\"minimo\" size=\"6\" required></label>",
        "<label>Máximo<input name=\"maximo\" size=\"6\" required></label>",
        "<label>Tipo<select name=\"tipo\"><option value=\"PRODUZIR\">Produzir</option><option value=\"COMPRAR\">Comprar</option></select></label>",
        "<label>Endereço<select name=\"endereco\" id=\"rep-endereco\" class=\"sel-endereco\"></select></label>",
        "<button>Salvar regra</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Como funciona</h2><p style=\"margin:0;color:var(--ink-2)\">Quando o saldo de um produto fica abaixo do <b>mínimo</b>, ele entra nas sugestões com a quantidade que leva o saldo de volta ao <b>máximo</b>. As do tipo <i>produzir</i> viram uma OP com um clique; as do tipo <i>comprar</i> são atendidas fora do EMP e voltam por uma entrada de material.</p></div>",
        "</div>",
        "<div class=\"card\"><h2>Regras<span class=\"cont\" id=\"regras-c\"></span></h2><div id=\"regras\"></div></div>",
        "</div>",
        "</section>",
        "<section class=\"secao grid\" id=\"s-manutencao\">",
        "<div class=\"grid kpis\" id=\"man-kpis\"></div>",
        "<div class=\"card\"><h2>Estado dos postos<span class=\"cont\">janela de 8 h</span></h2><div class=\"postos\" id=\"man-postos\"></div></div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Abrir parada</h2>",
        "<form class=\"form\" id=\"f-parada\">",
        "<label>Posto<select name=\"posto\" id=\"par-posto\"></select></label>",
        "<label>Categoria<select name=\"categoria\"><option value=\"MECANICA\">Mecânica</option><option value=\"ELETRICA\">Elétrica</option><option value=\"SETUP\">Setup</option><option value=\"FALTA_MATERIAL\">Falta de material</option><option value=\"QUALIDADE\">Qualidade</option><option value=\"OUTROS\">Outros</option></select></label>",
        "<label>Motivo<input name=\"motivo\" size=\"22\" required></label>",
        "<label>Começou há (min)<input name=\"ha_minutos\" size=\"4\" value=\"0\"></label>",
        "<button class=\"bad\">Parar posto</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Minutos parados por categoria</h2><div id=\"man-cat\"></div></div>",
        "</div>",
        "<div class=\"card\"><h2>Paradas</h2><div id=\"paradas\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-oee\">",
        "<div class=\"topo-oee\"><nav class=\"janela\" aria-label=\"Janela\"><a href=\"#oee\" data-janela=\"8\">8 h</a><a href=\"#oee/24\" data-janela=\"24\">24 h</a></nav><span class=\"nota\" id=\"oee-nota\"></span></div>",
        "<div class=\"heroi\" id=\"oee-heroi\"><div class=\"trilha\">OEE DA LINHA</div><div class=\"vazio\" style=\"color:#d7d9de\">Lendo os indicadores…</div></div>",
        "<div class=\"card\"><h2>OEE por posto<span class=\"cont\" id=\"oee-postos-c\"></span></h2><div class=\"oee-postos\" id=\"oee-postos\"></div></div>",
        "<div class=\"card\"><h2>Linha do tempo dos postos<span class=\"cont\" id=\"oee-tl-c\"></span></h2><div id=\"oee-tl\"></div><div class=\"chips\" id=\"oee-tl-leg\"></div></div>",
        "<div class=\"card\"><h2>OEE por hora<span class=\"cont\" id=\"oee-serie-c\"></span></h2>",
        "<div class=\"serie-cab\"><label class=\"nota\" for=\"oee-serie-posto\">Série de</label><select id=\"oee-serie-posto\" aria-label=\"Série de\"></select><span class=\"nota\">meta 85% · passe o mouse numa coluna para ver os três fatores</span></div>",
        "<div class=\"grafico\" id=\"oee-serie\"></div></div>",
        "</section>",
        "<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs><pattern id=\"p-parado\" width=\"8\" height=\"8\" patternUnits=\"userSpaceOnUse\" patternTransform=\"rotate(45)\"><rect width=\"8\" height=\"8\" style=\"fill:var(--bad)\"/><rect width=\"3\" height=\"8\" style=\"fill:var(--bad-soft)\"/></pattern></defs></svg>",
        "<section class=\"secao grid\" id=\"s-qualidade\">",
        "<div class=\"card\"><h2>Registrar não conformidade</h2>",
        "<form class=\"form\" id=\"f-nc\">",
        "<label>OP<input name=\"op\" size=\"5\"></label>",
        "<label>Produto<select name=\"produto\" id=\"nc-produto\"></select></label>",
        "<label>Motivo<input name=\"motivo\" size=\"30\" required></label>",
        "<button>Registrar NC</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Não conformidades<span class=\"cont\" id=\"ncs-c\"></span></h2><div id=\"ncs\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-cadastros\">",
        "<nav class=\"abas\" aria-label=\"Cadastros\"><a href=\"#cadastros\" data-aba=\"base\">Produtos e postos</a><a href=\"#cadastros/clientes\" data-aba=\"clientes\" data-mod=\"pedidos\">Clientes</a><a href=\"#cadastros/roteiros\" data-aba=\"roteiros\" data-mod=\"roteiros\">Roteiros</a></nav>",
        "<div class=\"aba grid\" data-aba=\"base\">",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Novo produto</h2>",
        "<form class=\"form\" id=\"f-produto\">",
        "<label>Código<input name=\"codigo\" size=\"10\" required></label>",
        "<label>Descrição<input name=\"descricao\" size=\"20\"></label>",
        "<label>Unid.<input name=\"unidade\" size=\"4\" value=\"UN\"></label>",
        "<label>Tipo<select name=\"tipo\"><option value=\"MP\">MP · matéria-prima</option><option value=\"SA\">SA · semiacabado</option><option value=\"PA\">PA · acabado</option></select></label>",
        "<button>Salvar</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Novo posto de trabalho</h2>",
        "<form class=\"form\" id=\"f-posto\">",
        "<label>Código<input name=\"codigo\" size=\"10\" required></label>",
        "<label>Descrição<input name=\"descricao\" size=\"20\"></label>",
        "<label>Capacidade (h/dia)<input name=\"capacidade_h\" size=\"5\" value=\"8\"></label>",
        "<button>Salvar</button>",
        "</form></div>",
        "</div>",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Produtos<span class=\"cont\" id=\"produtos-c\"></span></h2><div id=\"produtos\"></div></div>",
        "<div class=\"card\"><h2>Estrutura do produto (BOM)</h2>",
        "<form class=\"form\" id=\"f-bom\">",
        "<label>Produto<select name=\"produto\" id=\"bom-produto\"></select></label>",
        "<label>Componente<select name=\"componente\" id=\"bom-comp\"></select></label>",
        "<label>Qtd. por unidade<input name=\"quantidade\" size=\"6\" required></label>",
        "<label>Etapa consumo<input name=\"etapa\" size=\"4\" value=\"0\" title=\"0 = início/geral, 1..N = etapa específica\"></label>",
        "<button>Incluir</button>",
        "</form>",
        "<div id=\"bom\" style=\"margin-top:14px\"></div></div>",
        "</div>",
        "<div class=\"card\"><h2>Postos de trabalho<span class=\"cont\" id=\"postos-cad-c\"></span></h2><div id=\"postos-cad\"></div></div>",
        "</div>",
        "<div class=\"aba grid\" data-aba=\"clientes\">",
        "<div class=\"card\"><h2>Novo cliente</h2>",
        "<form class=\"form\" id=\"f-cliente\">",
        "<label>Código<input name=\"codigo\" size=\"10\" required></label>",
        "<label>Nome<input name=\"nome\" size=\"22\" required></label>",
        "<label>CNPJ / CPF<input name=\"documento\" size=\"16\"></label>",
        "<label>Contato<input name=\"contato\" size=\"14\"></label>",
        "<label>E-mail<input name=\"email\" type=\"email\" size=\"20\"></label>",
        "<label>Telefone<input name=\"telefone\" size=\"14\"></label>",
        "<label style=\"flex:1 1 260px\">Endereço<input name=\"endereco\"></label>",
        "<button>Salvar cliente</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Clientes<span class=\"cont\" id=\"clientes-c\"></span></h2><div id=\"clientes\"></div></div>",
        "</div>",
        "<div class=\"aba grid\" data-aba=\"roteiros\">",
        "<div class=\"grid dois\">",
        "<div class=\"card\"><h2>Nova operação</h2>",
        "<form class=\"form\" id=\"f-operacao\">",
        "<label>Código<input name=\"codigo\" size=\"10\" required></label>",
        "<label>Descrição<input name=\"descricao\" size=\"18\"></label>",
        "<label>Tipo<select name=\"tipo\"><option value=\"MANUAL\">Manual</option><option value=\"AUTOMATICA\">Automática</option></select></label>",
        "<label style=\"flex:1 1 100%\">Instrução ao operador<input name=\"instrucao\" placeholder=\"frase curta que aparece no terminal\"></label>",
        "<label style=\"flex:1 1 260px\">Parâmetros medidos<input name=\"parametros\" placeholder=\"nome:unidade:mín:máx;…  ex.: altura:mm:9.8:10.2\"></label>",
        "<button>Salvar operação</button>",
        "</form></div>",
        "<div class=\"card\"><h2>Capacidade posto × operação</h2>",
        "<form class=\"form\" id=\"f-capacidade\">",
        "<label>Posto<select name=\"posto\" id=\"cap-posto\"></select></label>",
        "<label>Operação<select name=\"operacao\" id=\"cap-operacao\"></select></label>",
        "<label>Tempo padrão (min/un.)<input name=\"tempo_min\" size=\"6\" required></label>",
        "<button>Salvar</button>",
        "</form>",
        "<div id=\"capacidades\" style=\"margin-top:14px\"></div></div>",
        "</div>",
        "<div class=\"card\"><h2>Roteiro do produto<span class=\"cont\" id=\"roteiro-c\"></span></h2>",
        "<form class=\"form\" id=\"f-etapa\">",
        "<label>Produto<select name=\"produto\" id=\"rot-produto\"></select></label>",
        "<label>Nº<input name=\"numero\" size=\"4\" required placeholder=\"10\"></label>",
        "<label>Operação<select name=\"operacao\" id=\"rot-operacao\"></select></label>",
        "<label>Posto<select name=\"posto\" id=\"rot-posto\"></select></label>",
        "<label>Tempo (min/un.)<input name=\"tempo_min\" size=\"5\" placeholder=\"capacidade\"></label>",
        "<label style=\"flex:1 1 240px\">Instrução<input name=\"instrucao\" placeholder=\"vazio = a da operação\"></label>",
        "<button>Salvar etapa</button>",
        "</form>",
        "<div class=\"passos\" id=\"roteiro-passos\"></div>",
        "<div id=\"roteiro\"></div></div>",
        "<div class=\"card\"><h2>Operações<span class=\"cont\" id=\"operacoes-c\"></span></h2><div id=\"operacoes\"></div></div>",
        "</div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-eventos\">",
        "<div class=\"card\"><h2>Barramento de eventos<span class=\"cont\">últimos 100</span></h2><div id=\"eventos\"></div></div>",
        "</section>",
        "",
        "<section class=\"secao grid\" id=\"s-modulos\">",
        "<div class=\"card\"><h2>Módulos registrados<span class=\"cont\">internos e plugins</span></h2><div id=\"modulos\"></div></div>",
        "</section>",
        "</main>",
        "</div>",
        "<div id=\"toast\" role=\"status\" aria-live=\"polite\"></div>",
        "<script>",
        "var TITULOS = {ordem:[\"Ordem de produção\",\"Fluxo de etapas: planejado × real\"],roteiros:[\"Roteiros\",\"Operações, roteiro por produto e capacidades\"],clientes:[\"Clientes\",\"Quem compra: cadastro usado nos pedidos\"],pedido:[\"Pedido\",\"Itens, saldo de cada item e ordens ligadas\"],pedidos:[\"Pedidos\",\"Pedidos de clientes, OPs da falta e expedição\"],mrp:[\"MRP / PCP\",\"Planejamento de necessidades de materiais e geração de ordens\"],programacao:[\"Programação da Produção\",\"Sequenciamento por posto, balanceamento de capacidade e gargalos\"],posicoes:[\"Endereços e posições\",\"Onde está cada produto e transferências\"],reposicao:[\"Reposição\",\"Mínimo e máximo por produto e sugestões\"],estoque_produto:[\"Produto\",\"Saldo por endereço e movimentos\"],oee:[\"OEE\",\"Disponibilidade × desempenho × qualidade por posto\"],inicio:[\"Início\",\"Bem-vindo ao chão de fábrica\"],geral:[\"Visão geral\",\"Linha de produção em tempo real\"],ordens:[\"Ordens de produção\",\"Planejar, liberar e apontar\"],estoque:[\"Estoque\",\"Saldos, entradas, endereços e reposição\"],manutencao:[\"Manutenção\",\"Paradas de posto e disponibilidade\"],qualidade:[\"Qualidade\",\"Não conformidades — plugin externo\"],cadastros:[\"Cadastros\",\"Produtos, estrutura e postos\"],eventos:[\"Eventos\",\"O que os módulos publicaram\"],modulos:[\"Módulos\",\"Núcleo, módulos internos e plugins\"]};",
        "var ROT = {EM_PRODUCAO:\"EM PRODUÇÃO\",EM_EXECUCAO:\"EM EXECUÇÃO\",AUTOMATICA:\"AUTOMÁTICA\",CONCLUIDA:\"CONCLUÍDA\",MECANICA:\"MECÂNICA\",ELETRICA:\"ELÉTRICA\",FALTA_MATERIAL:\"FALTA DE MATERIAL\",ENTRADA_PRODUCAO:\"ENTRADA PRODUÇÃO\",EXPEDICAO:\"EXPEDIÇÃO\",TRANSFERENCIA:\"TRANSFERÊNCIA\"};",
        "var ESTADO = {AGUARDANDO:\"wait\",EM_EXECUCAO:\"act\",FALHA:\"bad\",PULADA:\"skip\",PLANEJADA:\"plan\",LIBERADA:\"wait\",EM_PRODUCAO:\"act\",CONCLUIDA:\"ok\",CANCELADA:\"bad\",OPERANDO:\"ok\",PARADO:\"bad\",ABERTA:\"bad\",ENCERRADA:\"ok\",ativo:\"ok\",falhou:\"bad\",ABERTO:\"wait\",PRONTO:\"ok\",EXPEDIDO:\"skip\",CANCELADO:\"bad\",OCIOSO:\"wait\"};",
        "var LEGENDA = [[\"PLANEJADA\",\"planejada\",\"var(--muted)\"],[\"LIBERADA\",\"liberada\",\"var(--info)\"],[\"EM_PRODUCAO\",\"em produção\",\"var(--forja)\"],[\"CONCLUIDA\",\"concluída\",\"var(--ok)\"],[\"CANCELADA\",\"cancelada\",\"var(--bad)\"]];",
        "// Ícone de cada classe de estado: planejada (calendário), aguardando (pausa),",
        "// ativa (play), concluída (check), falha (alerta), pulada (avançar).",
        "var ICONE_ST = {plan:\"M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z\",wait:\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\",act:\"M8 5v14l11-7z\",ok:\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\",bad:\"M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z\",skip:\"M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z\",envio:\"M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\",relogio:\"M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z\",x:\"M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z\"};",
        "var ICONE_DE = {CANCELADA:\"x\",CANCELADO:\"x\",EXPEDIDO:\"envio\"};",
        "var ICONE = {bom:\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\",alerta:\"M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z\",neutro:\"M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z\"};",
        "function rot(s) { s = String(s == null ? \"\" : s); return ROT[s] || s.replace(/_/g, \" \"); }",
        "var ativos = {};",
        "var cache = {produtos: [], postos: [], operacoes: [], roteiro: null, clientes: [], enderecos: []};",
        "var sessao = null, vistoFalha = {};",
        "var tk = document.getElementById(\"token\");",
        "try { tk.value = localStorage.getItem(\"emp_token\") || \"\"; } catch (e) {}",
        "tk.onchange = function () { try { localStorage.setItem(\"emp_token\", tk.value); } catch (e) {} carregar(); };",
        "",
        "function esc(s) { return String(s == null ? \"\" : s).replace(/[&<>']/g, function (c) { return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",\"'\":\"&#39;\"}[c]; }); }",
        "function num(n, d) { var v = Number(n || 0); return v.toLocaleString(\"pt-BR\", {maximumFractionDigits: d == null ? 2 : d}); }",
        "function hora(ms) { return ms ? new Date(ms).toLocaleTimeString(\"pt-BR\", {hour: \"2-digit\", minute: \"2-digit\"}) : \"\"; }",
        "function dataHora(ms) { return ms ? new Date(ms).toLocaleString(\"pt-BR\", {day: \"2-digit\", month: \"2-digit\", hour: \"2-digit\", minute: \"2-digit\"}) : \"\"; }",
        "function dur(min) { min = Math.max(0, Math.round(min)); return min < 60 ? min + \" min\" : Math.floor(min / 60) + \" h \" + (min % 60) + \" min\"; }",
        "function classe(s) { return ESTADO[String(s).split(\":\")[0]] || \"plan\"; }",
        "function icone(s) { var k = String(s).split(\":\")[0]; return \"<svg viewBox='0 0 24 24' aria-hidden='true'><path d='\" + ICONE_ST[ICONE_DE[k] || classe(k)] + \"'/></svg>\"; }",
        "function tag(s) { return \"<span class='tag ic st-\" + classe(s) + \"'>\" + icone(s) + esc(rot(s).toLowerCase()) + \"</span>\"; }",
        "// Falha pisca uma vez só: o redesenho a cada 6 s não repete a animação.",
        "function pisca(chave, falhou) { if (!falhou || vistoFalha[chave]) return \"\"; vistoFalha[chave] = 1; return \" pisca\"; }",
        "function linkOp(id) { return \"<a class='id' href='#ordens/\" + esc(id) + \"' title='Abrir o fluxo de etapas'>OP-\" + esc(String(id).padStart(3, \"0\")) + \"</a>\"; }",
        "function linkTerminal(posto) { return posto ? \"<a class='term' href='/terminal#\" + encodeURIComponent(posto) + \"' title='Abrir o terminal do posto'>TERMINAL →</a>\" : \"\"; }",
        "function podeGerir() { return !!sessao && (sessao.perfil === \"admin\" || sessao.perfil === \"pcp\"); }",
        "function cod(prefixo, n) { return \"<span class='id'>\" + prefixo + esc(String(n).padStart(3, \"0\")) + \"</span>\"; }",
        "function toast(msg, erro) { var d = document.createElement(\"div\"); d.textContent = msg; if (erro) d.className = \"erro\"; document.getElementById(\"toast\").appendChild(d); setTimeout(function () { d.remove(); }, 4200); }",
        "function tabela(cols, linhas, vazio) {",
        "  if (!linhas.length) return \"<div class='vazio'>\" + (vazio || \"Nada por aqui ainda.\") + \"</div>\";",
        "  var h = \"<table><thead><tr>\" + cols.map(function (c) { return \"<th\" + (c[1] ? \" class='num'\" : \"\") + \">\" + c[0] + \"</th>\"; }).join(\"\") + \"</tr></thead><tbody>\";",
        "  return h + linhas.map(function (l) { return \"<tr\" + (l.cls ? \" class='\" + l.cls + \"'\" : \"\") + \">\" + l.map(function (v, i) { return \"<td\" + (cols[i][1] ? \" class='num'\" : \"\") + \">\" + v + \"</td>\"; }).join(\"\") + \"</tr>\"; }).join(\"\") + \"</tbody></table>\";",
        "}",
        "",
        "// Moldura de lista: filtro de texto (e de estado), aviso \"lista filtrada · limpar\"",
        "// e exportação CSV feita no navegador. itens: [{c: células HTML, d: valores",
        "// para o CSV, estado, cls}]; o filtro sobrevive à atualização automática.",
        "var MOLD = {};",
        "function moldura(id, cols, itens, opt) {",
        "  var el = document.getElementById(id), m = MOLD[id] || (MOLD[id] = {q: \"\", est: \"\"});",
        "  m.cols = cols; m.itens = itens; m.opt = opt || {};",
        "  var est = m.opt.estados ? \"<select class='f-est' aria-label='Filtrar por estado' onchange='filtrar(\\\"\" + id + \"\\\")'><option value=''>\" + (m.opt.todos || \"todos os estados\") + \"</option>\" +",
        "    m.opt.estados.map(function (e) { return \"<option value='\" + esc(e[0]) + \"'\" + (m.est === e[0] ? \" selected\" : \"\") + \">\" + esc(e[1]) + \"</option>\"; }).join(\"\") + \"</select>\" : \"\";",
        "  el.innerHTML = \"<div class='barra-lista'><input type='search' class='f-q' placeholder='Filtrar…' aria-label='Filtrar a lista' value='\" + esc(m.q) + \"' oninput='filtrar(\\\"\" + id + \"\\\")'>\" + est +",
        "    \"<span class='n'></span><button class='mini sec' onclick='exportar(\\\"\" + id + \"\\\")'>Exportar CSV</button></div><div class='aviso-filtro oculto'></div><div class='corpo-lista'></div>\";",
        "  corpoLista(id);",
        "}",
        "function corpoLista(id) {",
        "  var m = MOLD[id], el = document.getElementById(id), q = m.q.trim().toLowerCase();",
        "  m.vis = m.itens.filter(function (it) { return (!q || (it.busca || it.d.join(\" \")).toLowerCase().indexOf(q) >= 0) && (!m.est || it.estado === m.est); });",
        "  var filtrada = m.vis.length !== m.itens.length || !!(q || m.est);",
        "  el.querySelector(\".corpo-lista\").innerHTML = tabela(m.cols, m.vis.map(function (it) { var l = it.c.slice(); l.cls = it.cls; return l; }), filtrada && m.itens.length ? \"Nada corresponde ao filtro.\" : m.opt.vazio);",
        "  el.querySelector(\".n\").textContent = m.vis.length + (m.vis.length === 1 ? \" item\" : \" itens\");",
        "  var av = el.querySelector(\".aviso-filtro\");",
        "  av.classList.toggle(\"oculto\", !filtrada);",
        "  av.innerHTML = \"lista filtrada · \" + m.vis.length + \" de \" + m.itens.length + \" · <a href='#' onclick='limpar(\\\"\" + id + \"\\\");return false'>limpar</a>\";",
        "}",
        "window.filtrar = function (id) {",
        "  var el = document.getElementById(id), m = MOLD[id], s = el.querySelector(\".f-est\");",
        "  m.q = el.querySelector(\".f-q\").value; m.est = s ? s.value : \"\"; corpoLista(id);",
        "};",
        "window.limpar = function (id) {",
        "  var el = document.getElementById(id), m = MOLD[id], s = el.querySelector(\".f-est\");",
        "  m.q = \"\"; m.est = \"\"; el.querySelector(\".f-q\").value = \"\"; if (s) s.value = \"\"; corpoLista(id);",
        "};",
        "function campoCsv(v) {",
        "  v = v == null ? \"\" : (typeof v === \"number\" ? String(v).replace(\".\", \",\") : String(v));",
        "  return /[\";\\n]/.test(v) ? \"\\\"\" + v.replace(/\"/g, \"\\\"\\\"\") + \"\\\"\" : v;",
        "}",
        "window.exportar = function (id) {",
        "  var m = MOLD[id], linhas = [m.opt.csv.map(campoCsv).join(\";\")].concat(m.vis.map(function (it) { return it.d.map(campoCsv).join(\";\"); }));",
        "  var a = document.createElement(\"a\");",
        "  a.href = URL.createObjectURL(new Blob([\"\\ufeff\" + linhas.join(\"\\r\\n\")], {type: \"text/csv;charset=utf-8\"}));",
        "  a.download = (m.opt.arquivo || id) + \"-\" + new Date().toISOString().slice(0, 10) + \".csv\";",
        "  document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 1000);",
        "  toast(m.vis.length + \" linha(s) exportada(s).\");",
        "};",
        "",
        "function api(metodo, caminho, corpo) {",
        "  var op = {method: metodo, headers: {}};",
        "  if (tk.value) op.headers.Authorization = \"Bearer \" + tk.value;",
        "  if (corpo) { op.headers[\"Content-Type\"] = \"application/x-www-form-urlencoded\"; op.body = new URLSearchParams(corpo).toString(); }",
        "  return fetch(caminho, op).then(function (r) {",
        "    return r.text().then(function (t) {",
        "      var j = null; try { j = JSON.parse(t); } catch (e) {}",
        "      if (!r.ok) { var er = new Error((j && j.erro) || (\"HTTP \" + r.status)); er.status = r.status; er.dados = j; throw er; }",
        "      return j;",
        "    });",
        "  });",
        "}",
        "function tenta(p, padrao) { return p.catch(function () { return padrao; }); }",
        "function acao(metodo, caminho, corpo, ok) {",
        "  return api(metodo, caminho, corpo).then(function (r) { toast(ok || \"Feito.\"); carregar(); return r; })",
        "    .catch(function (e) { toast(e.message, true); });",
        "}",
        "function ligarForm(id, metodo, caminho, ok) {",
        "  document.getElementById(id).onsubmit = function (ev) {",
        "    ev.preventDefault();",
        "    var dados = Object.fromEntries(new FormData(ev.target).entries());",
        "    acao(metodo, typeof caminho === \"function\" ? caminho(dados) : caminho, dados, ok).then(function (r) { if (r) ev.target.reset(); });",
        "  };",
        "}",
        "",
        "function opcoes(sel, itens, valor, rotulo) {",
        "  var el = typeof sel === \"string\" ? document.getElementById(sel) : sel; if (!el) return;",
        "  var atual = el.value;",
        "  el.innerHTML = itens.map(function (i) { return \"<option value='\" + esc(valor(i)) + \"'>\" + esc(rotulo(i)) + \"</option>\"; }).join(\"\");",
        "  if (atual) el.value = atual;",
        "}",
        "function preencherSelects() {",
        "  var p = cache.produtos, prod = function (i) { return i.codigo; }, rot = function (i) { return i.codigo + \" · \" + (i.descricao || \"\"); };",
        "  opcoes(\"op-produto\", p.filter(function (i) { return i.tipo !== \"MP\"; }), prod, rot);",
        "  [\"ent-produto\", \"aj-produto\", \"bom-comp\", \"nc-produto\"].forEach(function (s) { opcoes(s, p, prod, rot); });",
        "  opcoes(\"bom-produto\", p.filter(function (i) { return i.tipo !== \"MP\"; }), prod, rot);",
        "  var postos = [{codigo: \"\", descricao: \"— sem posto —\"}].concat(cache.postos);",
        "  opcoes(\"op-posto\", postos, prod, function (i) { return i.codigo ? i.codigo + \" · \" + (i.descricao || \"\") : i.descricao; });",
        "  opcoes(\"par-posto\", cache.postos, prod, rot);",
        "  opcoes(\"rot-produto\", p.filter(function (i) { return i.tipo !== \"MP\"; }), prod, rot);",
        "  [\"rot-posto\", \"cap-posto\"].forEach(function (s) { opcoes(s, cache.postos, prod, rot); });",
        "  [\"rot-operacao\", \"cap-operacao\"].forEach(function (s) { opcoes(s, cache.operacoes, prod, rot); });",
        "  opcoes(\"ped-cliente\", cache.clientes, prod, function (i) { return i.codigo + \" · \" + (i.nome || \"\"); });",
        "  document.querySelectorAll(\".item-ped select\").forEach(function (s) { opcoes(s, produtosVenda(), prod, rot); });",
        "  [\"tr-produto\", \"rep-produto\"].forEach(function (s) { opcoes(s, p, prod, rot); });",
        "  document.querySelectorAll(\".sel-endereco\").forEach(function (s) { opcoes(s, enderecos(), prod, rotEndereco); });",
        "  opcoes(\"end-posto\", postos, prod, function (i) { return i.codigo ? i.codigo + \" · \" + (i.descricao || \"\") : i.descricao; });",
        "}",
        "",
        "// Medidor circular de disponibilidade: o posto lido como um instrumento de máquina.",
        "function cartaoPosto(p) {",
        "  var par = p.parada, pct = Math.max(0, Math.min(100, p.disponibilidade_pct));",
        "  var cor = p.estado === \"PARADO\" ? \"var(--bad)\" : pct < 85 ? \"var(--warn)\" : \"var(--ok)\";",
        "  return \"<div class='posto \" + p.estado + \"'><div class='medidor' style='--p:\" + pct + \";--c:\" + cor + \"'><span>\" + num(pct, 0) + \"%</span></div>\" +",
        "    \"<div><b>\" + esc(p.posto.codigo) + \"</b><div class='d'>\" + esc(p.posto.descricao) + \"</div>\" + tag(p.estado) + linkTerminal(p.posto.codigo) + \"</div>\" +",
        "    (par ? \"<div class='m'><strong>\" + esc(rot(par.categoria).toLowerCase()) + \"</strong> · desde \" + hora(par.inicio) + \"<br>\" + esc(par.motivo) + \"</div>\" : \"\") + \"</div>\";",
        "}",
        "function dados(s) {",
        "  return String(s || \"\").split(\"&\").map(function (par) {",
        "    var t = par.replace(/\\+/g, \" \");",
        "    try { t = decodeURIComponent(t); } catch (e) {}",
        "    return t.replace(\"=\", \": \");",
        "  }).join(\"   \");",
        "}",
        "function linhaEvento(e) {",
        "  return \"<div class='ev'><span class='h'>\" + hora(e.ts) + \"</span><span class='tp'>\" + esc(e.tipo) + \"</span><span class='dd'>\" + esc(e.origem) + \" · \" + esc(dados(e.dados)) + \"</span></div>\";",
        "}",
        "function eventos(evs) { return evs.length ? \"<div class='linha-tempo'>\" + evs.map(linhaEvento).join(\"\") + \"</div>\" : \"<div class='vazio'>Sem eventos.</div>\"; }",
        "// Barra de LED segmentada: 12 segmentos acendem conforme o progresso.",
        "function progresso(o) {",
        "  var pct = o.quantidade ? Math.min(100, 100 * o.produzido / o.quantidade) : 0, n = Math.round(pct / 100 * 12), s = \"\";",
        "  for (var i = 0; i < 12; i++) s += \"<i\" + (i < n ? \" class='on'\" : \"\") + \"></i>\";",
        "  return \"<div class='led\" + (pct >= 100 ? \" cheio\" : \"\") + \"'>\" + s + \"<span>\" + Math.round(pct) + \"%</span></div>\";",
        "}",
        "function porId(a, b) { return b.id - a.id; }",
        "// Etapa atual de uma OP (\"10 · ESTAMPAR · 1/3\"), quando a OP já tem etapas.",
        "function etapaAtual(o) {",
        "  var et = o.etapas || [], i = -1;",
        "  et.forEach(function (e, k) { if (String(e.numero) === String(o.etapa_atual)) i = k; });",
        "  return i < 0 ? null : {e: et[i], n: i + 1, m: et.length};",
        "}",
        "function falhou(o) { return (o.etapas || []).some(function (e) { return e.status === \"FALHA\"; }); }",
        "function linhaOp(o) { var f = falhou(o); return \"e-\" + (f ? \"bad\" : classe(o.status)) + pisca(\"op\" + o.id, f); }",
        "function celEtapa(o) {",
        "  var a = etapaAtual(o); if (!a) return \"\";",
        "  return \"<div class='etapa-op'>\" + esc(a.e.numero) + \" · \" + esc(a.e.operacao) + \" · \" + a.n + \"/\" + a.m + (a.e.status === \"FALHA\" ? \"<svg viewBox='0 0 24 24' role='img' aria-label='falha'><path d='\" + ICONE_ST.bad + \"'/></svg>\" : \"\") + \"</div>\";",
        "}",
        "function kpi(x) {",
        "  var ic = ICONE[x[3]] || ICONE.neutro;",
        "  return \"<div class='card kpi \" + x[3] + \"'><span class='sinal'><svg viewBox='0 0 24 24'><path d='\" + ic + \"'/></svg></span><div class='rot'>\" + x[0] + \"</div><div class='val'>\" + x[1] + \"</div><div class='det'>\" + x[2] + \"</div></div>\";",
        "}",
        "",
        "function faixa(a, b) { return a ? hora(a) + \" → \" + (b ? hora(b) : \"…\") : \"—\"; }",
        "// Atraso do real sobre o planejado, em minutos (só quando passa de 1 min).",
        "function atraso(e) {",
        "  if (!e.fim_planejado) return \"\";",
        "  var fim = e.fim || (e.status === \"CONCLUIDA\" || e.status === \"PULADA\" ? 0 : Date.now()), m = Math.round((fim - e.fim_planejado) / 60000);",
        "  if (!fim || m < 1) return \"\";",
        "  return \" <span class='atraso'>\" + (e.inicio ? \"+\" : \"atrasada \") + dur(m) + \"</span>\";",
        "}",
        "// Última medição de cada parâmetro, marcada fora do limite quando for o caso.",
        "function medicoes(e) {",
        "  var ult = {}; (e.medicoes || []).forEach(function (m) { ult[m.nome] = m; });",
        "  var ks = Object.keys(ult); if (!ks.length) return \"\";",
        "  return \"<div><small>Medições</small><span>\" + ks.map(function (k) { var m = ult[k];",
        "    return \"<span class='\" + (m.dentro ? \"\" : \"neg\") + \"' title='limite \" + num(m.min) + \" a \" + num(m.max) + \"'>\" + esc(m.nome) + \" \" + num(m.valor) + (m.unidade ? \" \" + esc(m.unidade) : \"\") + (m.dentro ? \"\" : \" · fora\") + \"</span>\"; }).join(\"<br>\") + \"</span></div>\";",
        "}",
        "function detalheOp(o) {",
        "  var et = o.etapas || [], ger = podeGerir();",
        "  document.getElementById(\"titulo\").textContent = \"OP-\" + String(o.id).padStart(3, \"0\");",
        "  document.getElementById(\"crumb\").innerHTML = \"EMP<i>/</i>Ordens de produção<i>/</i>OP-\" + esc(String(o.id).padStart(3, \"0\"));",
        "  var p = cache.produtos.filter(function (x) { return x.codigo === o.produto; })[0] || {};",
        "  var h = \"<div class='op-cab'><a class='voltar' href='#ordens'>← TODAS AS ORDENS</a>\" +",
        "    \"<div class='prod'><b><a href='#cadastros/roteiros/\" + encodeURIComponent(o.produto) + \"' title='Abrir o roteiro do produto' style='color:inherit'>\" + esc(o.produto) + \"</a></b><span>\" + esc(p.descricao || \"\") + \"</span></div>\" + tag(falhou(o) ? \"FALHA\" : o.status) +",
        "    \"<div class='nums'><div><small>Quantidade</small><b>\" + num(o.quantidade, 0) + \"</b></div><div><small>Boas</small><b>\" + num(o.produzido, 0) + \"</b></div><div><small>Refugo</small><b>\" + num(o.refugo, 0) + \"</b></div><div><small>Criada</small><b style='font-size:15px'>\" + dataHora(o.criada_em) + \"</b></div></div>\" +",
        "    progresso(o) + \"</div>\";",
        "  h += \"<h2>Fluxo de etapas<span class='cont'>\" + (et.length ? et.length + \" etapa(s)\" : \"sem etapas\") + \"</span></h2>\";",
        "  if (!et.length) {",
        "    h += \"<div class='vazio'>\" + (o.status === \"PLANEJADA\" ? \"As etapas são copiadas do roteiro do produto quando a OP é liberada. <button class='mini' onclick='liberar(\" + o.id + \")'>Liberar agora</button>\" : \"Esta OP não tem etapas registradas.\") + \"</div>\";",
        "  } else {",
        "    h += \"<div class='fluxo'>\" + et.map(function (e) {",
        "      var k = classe(e.status), id = o.id + \"-\" + e.numero, a = [], f = e.status === \"FALHA\";",
        "      var chamar = function (acao, rotulo, cls) { return \"<button class='mini \" + (cls || \"\") + \"' onclick='etapa(\\\"\" + acao + \"\\\",\" + o.id + \",\" + JSON.stringify(e.numero) + \",\" + JSON.stringify(e.versao == null ? \"\" : e.versao) + \")'>\" + rotulo + \"</button>\"; };",
        "      if (e.status === \"AGUARDANDO\") a.push(chamar(\"iniciar\", \"Iniciar\"));",
        "      if (e.status === \"EM_EXECUCAO\") { a.push(chamar(\"concluir\", \"Concluir\", \"ok\")); a.push(chamar(\"erro\", \"Concluir com erro\", \"sec\")); }",
        "      if (ger && (e.status === \"EM_EXECUCAO\" || f)) a.push(chamar(\"reiniciar\", \"Reiniciar\", \"sec\"));",
        "      if (ger && (e.status === \"AGUARDANDO\" || f)) a.push(chamar(\"pular\", \"Pular\", \"sec\"));",
        "      var motivo = a.join(\"\").indexOf(\"erro\") >= 0 || a.join(\"\").indexOf(\"pular\") >= 0;",
        "      return \"<div class='etapa e-\" + k + (String(e.numero) === String(o.etapa_atual) ? \" atual\" : \"\") + pisca(\"et\" + id, f) + \"'><span class='no'>\" + icone(e.status) + \"</span>\" +",
        "        \"<div class='etapa-topo'><span class='id'>\" + esc(e.numero) + \"</span><b>\" + esc(e.operacao) + \"</b><span class='d'>\" + esc(e.descricao || \"\") + \"</span>\" +",
        "        (e.posto ? \"<span class='id'>\" + esc(e.posto) + \"</span>\" + linkTerminal(e.posto) : \"\") + tag(e.status) + \"</div>\" +",
        "        (e.instrucao ? \"<div class='etapa-instr'>\" + esc(e.instrucao) + \"</div>\" : \"\") +",
        "        \"<div class='etapa-dados'><div><small>Planejado</small><span>\" + faixa(e.inicio_planejado, e.fim_planejado) + \"</span></div>\" +",
        "        \"<div><small>Real</small><span>\" + faixa(e.inicio, e.fim) + atraso(e) + \"</span></div>\" +",
        "        \"<div><small>Entrada</small><span>\" + num(e.entrada, 0) + \"</span></div>\" +",
        "        \"<div><small>Boas · refugo</small><span>\" + num(e.boas, 0) + \" · <span class='\" + (e.refugo > 0 ? \"neg\" : \"\") + \"'>\" + num(e.refugo, 0) + \"</span></span></div>\" +",
        "        \"<div><small>Operador</small><span>\" + esc(e.operador || \"—\") + \"</span></div>\" + medicoes(e) + \"</div>\" +",
        "        (e.erro ? \"<div class='etapa-erro'><b>\" + (e.status === \"PULADA\" ? \"Pulada\" : \"Erro\") + \":</b> \" + esc(e.erro) + \"</div>\" : \"\") +",
        "        (a.length ? \"<div class='etapa-acoes'>\" + a.join(\"\") + (motivo ? \"<input id='mot-\" + id + \"' placeholder='motivo (erro ou pular)' aria-label='Motivo'>\" : \"\") + \"</div>\" : \"\") + \"</div>\";",
        "    }).join(\"\") + \"</div>\";",
        "  }",
        "  document.getElementById(\"op-detalhe\").innerHTML = h;",
        "}",
        "window.etapa = function (acao, op, numero, versao) {",
        "  var corpo = {versao: String(versao), operador: sessao ? sessao.usuario : \"\"};",
        "  if (acao === \"erro\" || acao === \"pular\") {",
        "    var i = document.getElementById(\"mot-\" + op + \"-\" + numero), m = i ? i.value.trim() : \"\";",
        "    if (!m) { toast(\"Informe o motivo antes de \" + (acao === \"erro\" ? \"concluir com erro.\" : \"pular a etapa.\"), true); if (i) i.focus(); return; }",
        "    corpo.motivo = m;",
        "  }",
        "  var ok = {iniciar: \"iniciada\", concluir: \"concluída\", erro: \"concluída com erro\", reiniciar: \"reiniciada\", pular: \"pulada\"}[acao];",
        "  document.querySelectorAll(\"#op-detalhe .etapa-acoes button\").forEach(function (b) { b.disabled = true; });",
        "  api(\"POST\", \"/api/producao/etapa/\" + acao + \"?op=\" + op + \"&etapa=\" + encodeURIComponent(numero), corpo).then(function () {",
        "    toast(\"Etapa \" + numero + \" \" + ok + \".\");",
        "  }, function (e) {",
        "    toast(e.status === 409 && /outra pessoa|vers/i.test(e.message) ? \"A etapa foi alterada por outra pessoa. Recarregado.\" : e.message, true);",
        "  }).then(carregar);",
        "};",
        "function telaRoteiros() {",
        "  // O produto fica no endereço (/#cadastros/roteiros/SUP-02), então dá para linkar.",
        "  var sel = document.getElementById(\"rot-produto\"), alvo = parte(2);",
        "  if (alvo && Array.prototype.some.call(sel.options, function (o) { return o.value === alvo; })) sel.value = alvo;",
        "  var prod = sel.value;",
        "  return Promise.all([api(\"GET\", \"/api/roteiros/operacoes\"), api(\"GET\", \"/api/roteiros/capacidades\"),",
        "    prod ? api(\"GET\", \"/api/roteiros/roteiro?produto=\" + encodeURIComponent(prod)) : Promise.resolve(null)]).then(function (r) {",
        "    cache.operacoes = r[0]; cache.roteiro = r[2];",
        "    preencherSelects();",
        "    document.getElementById(\"operacoes-c\").textContent = r[0].length + \" operações\";",
        "    var faixaPar = function (x) { return esc(x.nome) + \" \" + num(x.min) + \"–\" + num(x.max) + (x.unidade ? \" \" + esc(x.unidade) : \"\"); };",
        "    moldura(\"operacoes\", [[\"Código\"], [\"Descrição\"], [\"Tipo\"], [\"Instrução\"], [\"Parâmetros\"]], r[0].map(function (o) {",
        "      var par = o.parametros || [];",
        "      return {c: [\"<span class='id'>\" + esc(o.codigo) + \"</span>\", esc(o.descricao), esc(rot(o.tipo).toLowerCase()), \"<span style='white-space:normal'>\" + esc(o.instrucao) + \"</span>\", par.map(faixaPar).join(\"<br>\") || \"—\"],",
        "        d: [o.codigo, o.descricao, o.tipo, o.instrucao, par.map(function (x) { return x.nome + \":\" + (x.unidade || \"\") + \":\" + x.min + \":\" + x.max; }).join(\";\")], estado: o.tipo};",
        "    }), {vazio: \"Nenhuma operação cadastrada.\", estados: [[\"MANUAL\", \"manual\"], [\"AUTOMATICA\", \"automática\"]], todos: \"todos os tipos\", csv: [\"Código\", \"Descrição\", \"Tipo\", \"Instrução\", \"Parâmetros\"], arquivo: \"operacoes\"});",
        "    moldura(\"capacidades\", [[\"Posto\"], [\"Operação\"], [\"Tempo por unidade\", 1]], r[1].map(function (c) {",
        "      return {c: [\"<span class='id'>\" + esc(c.posto) + \"</span>\", esc(c.operacao), num(c.tempo_min, 2) + \" min/un.\"], d: [c.posto, c.operacao, Number(c.tempo_min)]};",
        "    }), {vazio: \"Nenhuma capacidade cadastrada.\", csv: [\"Posto\", \"Operação\", \"Tempo por unidade (min)\"], arquivo: \"capacidades\"});",
        "    var et = ((r[2] && r[2].etapas) || []).slice().sort(function (a, b) { return a.numero - b.numero; });",
        "    document.getElementById(\"roteiro-c\").textContent = prod ? et.length + \" etapa(s)\" : \"\";",
        "    document.getElementById(\"roteiro-passos\").innerHTML = et.map(function (e) { return \"<span class='id'>\" + esc(e.numero) + \" \" + esc(e.operacao) + \"</span>\"; }).join(\"<i>→</i>\");",
        "    document.getElementById(\"roteiro\").innerHTML = tabela([[\"Nº\", 1], [\"Operação\"], [\"Posto\"], [\"Tempo\", 1], [\"Instrução\"], [\"Ações\"]], et.map(function (e) {",
        "      return [esc(e.numero), esc(e.operacao), \"<span class='id'>\" + esc(e.posto) + \"</span>\", (Number(e.tempo_min) ? num(e.tempo_min, 2) + \" min/un.\" : \"<span style='color:var(--muted)'>da capacidade</span>\"), \"<span style='white-space:normal'>\" + esc(e.instrucao || \"\") + \"</span>\",",
        "        \"<div style='display:flex;gap:6px'><button class='mini sec' onclick='editarEtapa(\" + JSON.stringify(e.numero) + \")'>Editar</button><button class='mini sec' onclick='removerEtapa(\" + JSON.stringify(e.numero) + \")'>Remover</button></div>\"];",
        "    }), prod ? \"Este produto ainda não tem roteiro: inclua a primeira etapa acima (ex.: 10, 20, 30…).\" : \"Cadastre um produto SA ou PA para montar o roteiro.\");",
        "  });",
        "}",
        "window.editarEtapa = function (numero) {",
        "  var e = ((cache.roteiro && cache.roteiro.etapas) || []).filter(function (x) { return String(x.numero) === String(numero); })[0]; if (!e) return;",
        "  var f = document.getElementById(\"f-etapa\");",
        "  f.numero.value = e.numero; f.operacao.value = e.operacao; f.posto.value = e.posto; f.tempo_min.value = e.tempo_min; f.instrucao.value = e.instrucao || \"\";",
        "  f.numero.focus();",
        "};",
        "window.removerEtapa = function (numero) {",
        "  var prod = document.getElementById(\"rot-produto\").value;",
        "  if (!confirm(\"Remover a etapa \" + numero + \" do roteiro de \" + prod + \"?\")) return;",
        "  acao(\"POST\", \"/api/roteiros/remover_etapa?produto=\" + encodeURIComponent(prod) + \"&numero=\" + encodeURIComponent(numero), null, \"Etapa \" + numero + \" removida.\");",
        "};",
        "",
        "// ── fase 2 · comuns ─────────────────────────────────────────",
        "// Uma sub-tela com abas (.abas + .aba) mostra a aba pelo nome; \"\" esconde todas.",
        "function mostrarAba(sec, nome) {",
        "  document.querySelectorAll(sec + \" .abas a\").forEach(function (a) { a.classList.toggle(\"ativo\", a.dataset.aba === nome); });",
        "  document.querySelectorAll(sec + \" .aba\").forEach(function (a) { a.classList.toggle(\"ativa\", a.dataset.aba === nome); });",
        "}",
        "// Barra de distribuição + chips (a mesma das ordens), para qualquer legenda [estado, rótulo, cor].",
        "function distribuicao(leg, n) {",
        "  var total = leg.reduce(function (s, l) { return s + (n[l[0]] || 0); }, 0) || 1;",
        "  return \"<div class='distrib'>\" + leg.map(function (l) { return n[l[0]] ? \"<i style='width:\" + (100 * n[l[0]] / total) + \"%;background:\" + l[2] + \"' title='\" + l[1] + \"'></i>\" : \"\"; }).join(\"\") + \"</div>\" +",
        "    \"<div class='chips'>\" + leg.map(function (l) { return \"<span><i style='background:\" + l[2] + \"'></i>\" + l[1] + \" <b>\" + (n[l[0]] || 0) + \"</b></span>\"; }).join(\"\") + \"</div>\";",
        "}",
        "function linkProduto(c) { return \"<a class='id' href='#estoque/produto/\" + encodeURIComponent(c) + \"' title='Saldo por endereço e movimentos'>\" + esc(c) + \"</a>\"; }",
        "function descProduto(c) { var p = cache.produtos.filter(function (x) { return x.codigo === c; })[0]; return p ? p.descricao || \"\" : \"\"; }",
        "function abertaOp(o) { return [\"PLANEJADA\", \"LIBERADA\", \"EM_PRODUCAO\"].indexOf(o.status) >= 0; }",
        "",
        "// ── fase 2 · pedidos ────────────────────────────────────────",
        "var LEG_PED = [[\"ABERTO\", \"aberto\", \"var(--info)\"], [\"EM_PRODUCAO\", \"em produção\", \"var(--forja)\"], [\"PRONTO\", \"pronto\", \"var(--ok)\"], [\"EXPEDIDO\", \"expedido\", \"var(--muted)\"], [\"CANCELADO\", \"cancelado\", \"var(--bad)\"]];",
        "function codPed(id) { return \"PED-\" + String(id).padStart(3, \"0\"); }",
        "function linkPed(id) { return \"<a class='id' href='#pedidos/\" + esc(id) + \"' title='Abrir o pedido'>\" + esc(codPed(id)) + \"</a>\"; }",
        "function podeVender() { return !!sessao && [\"admin\", \"pcp\", \"comercial\"].indexOf(sessao.perfil) >= 0; }",
        "function nomeCliente(c, p) { var x = cache.clientes.filter(function (k) { return k.codigo === c; })[0]; return x ? x.nome : (p && p.nome_cliente) || \"\"; }",
        "// Atraso = não expedido e passou da entrega prevista (o servidor calcula `atrasado`).",
        "function sinalAtraso(p) {",
        "  if (!p.atrasado) return \"\";",
        "  var m = Math.max(1, Math.round((Date.now() - p.entrega_prevista) / 60000)), h = Math.floor(m / 60);",
        "  return \"<span class='sinal-atraso' title='Entrega prevista para \" + esc(dataHora(p.entrega_prevista)) + \"'><svg viewBox='0 0 24 24' aria-hidden='true'><path d='\" + ICONE_ST.relogio + \"'/></svg>atrasado \" + (m < 60 ? m + \" min\" : h < 48 ? h + \" h\" : Math.floor(h / 24) + \" d\") + \"</span>\";",
        "}",
        "function resumoItens(p) {",
        "  var it = p.itens || [];",
        "  return it.slice(0, 2).map(function (i) { return esc(i.produto) + \" × \" + num(i.quantidade); }).join(\", \") + (it.length > 2 ? \" <span style='color:var(--muted)'>+\" + (it.length - 2) + \"</span>\" : \"\");",
        "}",
        "function opsDoPedido(p) { return (p.ops || []).map(function (n) { return linkOp(n); }).join(\"\"); }",
        "// Cobertura do pedido pelo saldo livre, na barra de LED (expedido = cheio).",
        "function cobertura(p) {",
        "  if (p.status === \"CANCELADO\") return \"<span style='color:var(--muted)'>—</span>\";",
        "  var q = 0, c = 0;",
        "  (p.itens || []).forEach(function (i) { q += Number(i.quantidade); c += Math.min(Number(i.quantidade), Math.max(0, Number(i.saldo))); });",
        "  return progresso({quantidade: q, produzido: p.status === \"EXPEDIDO\" ? q : c});",
        "}",
        "function acoesPedido(p) {",
        "  if (!podeVender()) return \"\";",
        "  var a = \"\";",
        "  if (p.status === \"ABERTO\") a += \"<button class='mini' onclick='gerarOps(\" + p.id + \")'>Gerar OPs</button>\";",
        "  if (p.status === \"PRONTO\") a += \"<button class='mini ok' onclick='expedir(\" + p.id + \")'>Expedir</button>\";",
        "  if ([\"ABERTO\", \"EM_PRODUCAO\", \"PRONTO\"].indexOf(p.status) >= 0) a += \"<button class='mini sec' onclick='cancelarPed(\" + p.id + \")'>Cancelar</button>\";",
        "  return a;",
        "}",
        "function detalhePed(p, ops) {",
        "  var it = p.itens || [], ger = podeVender(), aberto = [\"ABERTO\", \"EM_PRODUCAO\", \"PRONTO\"].indexOf(p.status) >= 0;",
        "  var cli = cache.clientes.filter(function (k) { return k.codigo === p.cliente; })[0] || {};",
        "  document.getElementById(\"titulo\").textContent = codPed(p.id);",
        "  var h = \"<div class='op-cab'><a class='voltar' href='#pedidos'>← TODOS OS PEDIDOS</a>\" +",
        "    \"<div class='prod'><b>\" + esc(cli.nome || p.nome_cliente || p.cliente) + \"</b><span>\" + esc(p.cliente) + (cli.contato ? \" · \" + esc(cli.contato) : \"\") + (cli.telefone ? \" · \" + esc(cli.telefone) : \"\") + \"</span></div>\" + tag(p.status) + sinalAtraso(p) +",
        "    \"<div class='nums'><div><small>Itens</small><b>\" + it.length + \"</b></div><div><small>Criado</small><b style='font-size:15px'>\" + dataHora(p.criado_em) + \"</b></div>\" +",
        "    \"<div><small>Entrega prevista</small><b style='font-size:15px'\" + (p.atrasado ? \" class='atraso'\" : \"\") + \">\" + dataHora(p.entrega_prevista) + \"</b></div>\" +",
        "    (p.expedido_em ? \"<div><small>Expedido</small><b style='font-size:15px'>\" + dataHora(p.expedido_em) + \"</b></div>\" : \"\") + \"</div>\" + cobertura(p) + \"</div>\";",
        "  if (p.observacao) h += \"<div class='ped-obs'>\" + esc(p.observacao) + \"</div>\";",
        "  if (p.status === \"CANCELADO\" && p.motivo) h += \"<div class='etapa-erro' style='margin:-6px 0 16px'><b>Cancelado:</b> \" + esc(p.motivo) + \"</div>\";",
        "  h += \"<h2>Itens<span class='cont'>saldo livre de cada produto</span></h2>\" + tabela([[\"Produto\"], [\"Descrição\"], [\"Quantidade\", 1], [\"Saldo\", 1], [\"Falta\", 1], [\"Cobertura\"], [\"OPs\"]], it.map(function (i) {",
        "    var q = Number(i.quantidade), s = Number(i.saldo), f = Math.max(0, q - s);",
        "    return [linkProduto(i.produto), esc(descProduto(i.produto)), num(q), \"<span class='\" + (s < 0 ? \"neg\" : \"\") + \"'>\" + num(s) + \"</span>\", f && p.status !== \"EXPEDIDO\" ? \"<span class='neg'>\" + num(f) + \"</span>\" : \"—\",",
        "      progresso({quantidade: q, produzido: p.status === \"EXPEDIDO\" ? q : Math.max(0, Math.min(q, s))}), \"<div class='ops-ped'>\" + ((i.ops || []).map(linkOp).join(\"\") || \"—\") + \"</div>\"];",
        "  }), \"Pedido sem itens.\");",
        "  var ligadas = ops.filter(function (o) { return (p.ops || []).map(String).indexOf(String(o.id)) >= 0 || o.origem === codPed(p.id) || o.origem === \"PED-\" + p.id; }).sort(porId);",
        "  h += \"<h2 style='margin-top:22px'>Ordens ligadas<span class='cont'>\" + ligadas.length + \" OP(s)</span></h2>\" + tabela([[\"OP\"], [\"Produto\"], [\"Posto\"], [\"Estado · etapa\"], [\"Progresso\"], [\"Qtd.\", 1], [\"Boas\", 1]], ligadas.map(function (o) {",
        "    var l = [linkOp(o.id), esc(o.produto), esc(o.posto || \"—\"), tag(o.status) + celEtapa(o), progresso(o), num(o.quantidade, 0), num(o.produzido, 0)]; l.cls = linhaOp(o); return l;",
        "  }), p.status === \"ABERTO\" ? \"Nenhuma OP ainda: “Gerar OPs” cria uma OP para a falta de cada item.\" : \"Nenhuma OP ligada a este pedido.\");",
        "  if (ger && aberto) {",
        "    h += \"<div class='ped-acoes'>\";",
        "    if (p.status === \"ABERTO\") h += \"<select id='ped-posto' aria-label='Posto das OPs'><option value=''>— posto do roteiro —</option>\" + cache.postos.map(function (x) { return \"<option value='\" + esc(x.codigo) + \"'>\" + esc(x.codigo) + \"</option>\"; }).join(\"\") + \"</select><button onclick='gerarOps(\" + p.id + \", document.getElementById(\\\"ped-posto\\\").value)'>Gerar OPs</button>\";",
        "    h += \"<button class='\" + (p.status === \"PRONTO\" ? \"\" : \"sec\") + \"' onclick='expedir(\" + p.id + \")'\" + (p.status === \"PRONTO\" ? \"\" : \" title='Expede em qualquer estado aberto, desde que o saldo livre cubra todos os itens'\") + \">Expedir</button>\";",
        "    h += \"<input id='ped-motivo' placeholder='motivo do cancelamento' aria-label='Motivo do cancelamento' style='flex:1 1 200px;max-width:320px'><button class='sec' onclick='cancelarPed(\" + p.id + \", document.getElementById(\\\"ped-motivo\\\").value)'>Cancelar pedido</button></div>\";",
        "  }",
        "  document.getElementById(\"ped-detalhe\").innerHTML = h;",
        "}",
        "window.gerarOps = function (id, posto) {",
        "  api(\"POST\", \"/api/pedidos/gerar_ops?id=\" + id, {posto: posto || \"\"}).then(function (r) {",
        "    var n = r && r.ops ? r.ops.length : 0;",
        "    toast(codPed(id) + \": \" + (n ? n + \" OP(s) para a falta.\" : \"o saldo já cobre os itens, nenhuma OP precisou ser criada.\"));",
        "  }, function (e) { toast(e.message, true); }).then(carregar);",
        "};",
        "// Expedir confere o saldo livre de todos os itens; o 409 traz as faltas.",
        "window.expedir = function (id) {",
        "  api(\"POST\", \"/api/pedidos/expedir?id=\" + id, {}).then(function () { toast(codPed(id) + \" expedido.\"); }, function (e) {",
        "    var f = e.dados && e.dados.faltas;",
        "    toast(f && f.length ? \"Sem saldo para expedir: \" + f.map(function (x) { return x.produto + \" falta \" + num(Number(x.quantidade) - Number(x.saldo)); }).join(\", \") + \".\" : e.message, true);",
        "  }).then(carregar);",
        "};",
        "window.cancelarPed = function (id, motivo) {",
        "  if (motivo == null) motivo = prompt(\"Motivo do cancelamento do \" + codPed(id) + \":\");",
        "  if (motivo == null) return;",
        "  if (!String(motivo).trim()) { toast(\"Informe o motivo do cancelamento.\", true); var i = document.getElementById(\"ped-motivo\"); if (i) i.focus(); return; }",
        "  acao(\"POST\", \"/api/pedidos/cancelar?id=\" + id, {motivo: motivo.trim()}, codPed(id) + \" cancelado. As OPs já criadas continuam.\");",
        "};",
        "// Linhas de item do novo pedido: produto + quantidade, quantas forem precisas.",
        "function produtosVenda() { return cache.produtos.filter(function (i) { return i.tipo !== \"MP\"; }); }",
        "function novaLinhaItem() {",
        "  var d = document.createElement(\"div\"); d.className = \"item-ped\";",
        "  d.innerHTML = \"<select aria-label='Produto do item'></select><input placeholder='quantidade' aria-label='Quantidade do item' inputmode='decimal'><button type='button' class='rem' title='Remover item' aria-label='Remover item'>×</button>\";",
        "  opcoes(d.querySelector(\"select\"), produtosVenda(), function (i) { return i.codigo; }, function (i) { return i.codigo + \" · \" + (i.descricao || \"\"); });",
        "  d.querySelector(\".rem\").onclick = function () { var c = document.getElementById(\"ped-itens\"); if (c.children.length > 1) d.remove(); else d.querySelector(\"input\").value = \"\"; };",
        "  document.getElementById(\"ped-itens\").appendChild(d);",
        "  return d;",
        "}",
        "function itensIniciais() { document.getElementById(\"ped-itens\").innerHTML = \"\"; novaLinhaItem(); }",
        "document.getElementById(\"ped-mais\").onclick = function () { novaLinhaItem().querySelector(\"select\").focus(); };",
        "document.getElementById(\"f-pedido\").onsubmit = function (ev) {",
        "  ev.preventDefault();",
        "  var f = ev.target, itens = [], ruim = \"\";",
        "  f.querySelectorAll(\".item-ped\").forEach(function (l) {",
        "    var q = l.querySelector(\"input\").value.trim().replace(\",\", \".\");",
        "    if (!q) return;",
        "    if (!(Number(q) > 0)) ruim = q;",
        "    itens.push(l.querySelector(\"select\").value + \":\" + q);",
        "  });",
        "  if (ruim) { toast(\"Quantidade inválida: \" + ruim, true); return; }",
        "  if (!itens.length) { toast(\"Inclua pelo menos um item com quantidade.\", true); f.querySelector(\".item-ped input\").focus(); return; }",
        "  var dados = {cliente: f.cliente.value, prazo_dias: f.prazo_dias.value, observacao: f.observacao.value, itens: itens.join(\";\")};",
        "  acao(\"POST\", \"/api/pedidos/pedidos\", dados, \"Pedido criado.\").then(function (r) {",
        "    if (!r) return;",
        "    f.reset(); itensIniciais();",
        "    if (r.id) location.hash = \"#pedidos/\" + r.id;",
        "  });",
        "};",
        "function telaPedidos() {",
        "  if (sub()) return Promise.all([api(\"GET\", \"/api/pedidos/pedido?id=\" + encodeURIComponent(sub())), tenta(api(\"GET\", \"/api/producao/ordens\"), [])]).then(function (r) { detalhePed(r[0], r[1]); });",
        "  return api(\"GET\", \"/api/pedidos/pedidos\").then(function (ps) {",
        "    var n = {}, atr = ps.filter(function (p) { return p.atrasado; }).length;",
        "    ps.forEach(function (p) { n[p.status] = (n[p.status] || 0) + 1; });",
        "    document.getElementById(\"pedidos-leg\").innerHTML = distribuicao(LEG_PED, n);",
        "    var ca = document.getElementById(\"pedidos-atr\");",
        "    ca.innerHTML = atr ? \"<a href='#' onclick='filtrarAtrasados();return false' style='color:var(--bad-ink)'>\" + atr + \" atrasado(s)</a>\" : \"nenhum atrasado\";",
        "    document.getElementById(\"pedidos-c\").textContent = ps.length + \" no total\";",
        "    if (!cache.clientes.length) document.getElementById(\"ped-cliente\").innerHTML = \"<option value=''>— cadastre um cliente em Cadastros → Clientes —</option>\";",
        "    moldura(\"pedidos\", [[\"Pedido\"], [\"Cliente\"], [\"Itens\"], [\"Estado\"], [\"Entrega prevista\"], [\"Cobertura\"], [\"OPs\"], [\"Ações\"]],",
        "      ps.slice().sort(porId).map(function (p) {",
        "        var nome = nomeCliente(p.cliente, p);",
        "        return {c: [linkPed(p.id), \"<div class='quebra'><b style='font-weight:600'>\" + esc(nome || p.cliente) + \"</b>\" + (nome ? \"<br><span class='mono' style='font-size:11px;color:var(--muted)'>\" + esc(p.cliente) + \"</span>\" : \"\") + \"</div>\", \"<div class='quebra'>\" + resumoItens(p) + \"</div>\", \"<div class='quebra' style='display:flex;flex-wrap:wrap;gap:4px'>\" + tag(p.status) + sinalAtraso(p) + \"</div>\",",
        "          \"<span\" + (p.atrasado ? \" class='atraso'\" : \"\") + \">\" + dataHora(p.entrega_prevista) + \"</span>\", cobertura(p), \"<div class='ops-ped'>\" + (opsDoPedido(p) || \"—\") + \"</div>\", \"<div class='acoes-op'>\" + acoesPedido(p) + \"</div>\"],",
        "          d: [codPed(p.id), p.cliente, nome, (p.itens || []).map(function (i) { return i.produto + \":\" + i.quantidade; }).join(\";\"), rot(p.status).toLowerCase(), p.atrasado ? \"sim\" : \"não\", dataHora(p.entrega_prevista), dataHora(p.criado_em), (p.ops || []).join(\" \")],",
        "          busca: [codPed(p.id), p.cliente, nome, rot(p.status), p.atrasado ? \"atrasado\" : \"\", (p.itens || []).map(function (i) { return i.produto; }).join(\" \")].join(\" \"),",
        "          estado: p.status, cls: \"e-\" + (p.atrasado ? \"bad\" : classe(p.status))};",
        "      }), {vazio: \"Nenhum pedido ainda. Crie o primeiro acima.\", estados: LEG_PED.map(function (l) { return [l[0], l[1]]; }), csv: [\"Pedido\", \"Cliente\", \"Nome\", \"Itens\", \"Estado\", \"Atrasado\", \"Entrega prevista\", \"Criado\", \"OPs\"], arquivo: \"pedidos\"});",
        "  });",
        "}",
        "window.filtrarAtrasados = function () { var m = MOLD.pedidos; if (!m) return; m.q = \"atrasado\"; m.est = \"\"; var el = document.getElementById(\"pedidos\"); el.querySelector(\".f-q\").value = \"atrasado\"; corpoLista(\"pedidos\"); el.scrollIntoView({behavior: \"smooth\", block: \"start\"}); };",
        "function telaMrp() {",
        "  return api(\"GET\", \"/api/mrp/plano\").then(function (plano) {",
        "    document.getElementById(\"mrp-c\").textContent = (plano || []).length + \" item(ns) no plano\";",
        "    var comFalta = (plano || []).filter(function (it) { return it.necessidade_liquida > 0; }).length;",
        "    var b = document.getElementById(\"qt-mrp\");",
        "    if (b) b.textContent = comFalta ? String(comFalta) : \"\";",
        "    moldura(\"mrp-tabela\", [[\"Nível\", 1], [\"Produto\"], [\"Descrição\"], [\"Tipo\"], [\"Demanda\", 1], [\"Saldo\", 1], [\"Em Prod.\", 1], [\"Líquida\", 1], [\"Ação\"], [\"Posto\"]], (plano || []).map(function (it) {",
        "      var acaoTag = it.acao === \"PRODUZIR\" ? \"<span class='tag act'>PRODUZIR</span>\" : \"<span class='tag ok'>COMPRAR</span>\";",
        "      if (it.necessidade_liquida <= 0) acaoTag = \"<span style='color:var(--muted)'>coberto</span>\";",
        "      return {",
        "        c: [String(it.nivel), linkProduto(it.produto), esc(it.descricao), esc(it.tipo), num(it.demanda_bruta) + \" \" + esc(it.unidade), num(it.saldo), num(it.em_producao), \"<b class='\" + (it.necessidade_liquida > 0 ? \"neg\" : \"\") + \"'>\" + num(it.necessidade_liquida) + \"</b>\", acaoTag, esc(it.posto || \"—\")],",
        "        d: [it.nivel, it.produto, it.descricao, it.tipo, it.demanda_bruta, it.saldo, it.em_producao, it.necessidade_liquida, it.acao, it.posto || \"\"],",
        "        estado: it.acao, cls: it.necessidade_liquida > 0 ? \"e-bad\" : \"e-ok\"",
        "      };",
        "    }), {vazio: \"Nenhuma necessidade pendente no momento.\", estados: [[\"PRODUZIR\", \"produzir\"], [\"COMPRAR\", \"comprar\"]], csv: [\"Nivel\", \"Produto\", \"Descricao\", \"Tipo\", \"Demanda\", \"Saldo\", \"EmProducao\", \"Liquida\", \"Acao\", \"Posto\"], arquivo: \"mrp_plano\"});",
        "  });",
        "}",
        "window.gerarOrdensMrp = function () {",
        "  api(\"POST\", \"/api/mrp/gerar_ordens\", {}).then(function (res) {",
        "    var n = res && res.length ? res.length : 0;",
        "    if (n > 0) {",
        "      toast(n + \" ordem(ns) de produção gerada(s) pelo MRP com sucesso!\");",
        "      location.hash = \"#ordens\";",
        "    } else {",
        "      toast(\"Nenhuma ordem nova necessária (tudo coberto por estoque ou OPs abertas).\");",
        "      carregar();",
        "    }",
        "  }, function (e) { toast(e.message, true); });",
        "};",
        "function telaProgramacao() {",
        "  return Promise.all([",
        "    api(\"GET\", \"/api/programacao/capacidade\"),",
        "    tenta(api(\"GET\", \"/api/cadastros/postos\"), [])",
        "  ]).then(function (r) {",
        "    var capacidade = r[0] || [], postosCad = r[1] || [];",
        "    var gargalos = capacidade.filter(function (c) { return c.gargalo; });",
        "    var cEl = document.getElementById(\"prog-postos-c\");",
        "    if (cEl) cEl.textContent = capacidade.length + \" postos · \" + (gargalos.length ? gargalos.map(function(g){return g.posto;}).join(\", \") + \" gargalo\" : \"balanceado\");",
        "    var sel = document.getElementById(\"prog-filtro-posto\");",
        "    if (sel) {",
        "      var valAtual = sel.value;",
        "      var opts = \"<option value=''>Todos os postos</option>\";",
        "      postosCad.forEach(function (p) { ",
        "        opts += \"<option value='\" + esc(p.codigo) + \"'\" + (p.codigo === valAtual ? \" selected\" : \"\") + \">\" + esc(p.codigo) + \" - \" + esc(p.descricao || \"\") + \"</option>\";",
        "      });",
        "      sel.innerHTML = opts;",
        "    }",
        "    var containerPostos = document.getElementById(\"prog-postos\");",
        "    if (containerPostos) {",
        "      if (!capacidade.length) {",
        "        containerPostos.innerHTML = \"<div class='vazio'>Nenhum posto cadastrado.</div>\";",
        "      } else {",
        "        containerPostos.innerHTML = capacidade.map(function (pc) {",
        "          var cor = pc.ocupacao_pct > 100 ? \"var(--bad)\" : (pc.ocupacao_pct >= 85 ? \"var(--warn)\" : \"var(--ok)\");",
        "          var badgeGargalo = pc.gargalo ? \"<span class='tag bad' style='margin-left:6px;font-size:10px;padding:2px 8px;height:auto'>GARGALO</span>\" : \"\";",
        "          var badgeSobrecarga = pc.ocupacao_pct > 100 ? \"<span class='tag bad' style='margin-left:6px;font-size:10px;padding:2px 8px;height:auto'>SOBRECARGA</span>\" : \"\";",
        "          var pctVal = Math.min(100, Math.round(pc.ocupacao_pct));",
        "          return \"<div class='card' style='padding:16px;background:var(--surface-2);border-left:5px solid \" + cor + \"'>\" + ",
        "            \"<div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:6px'>\" + ",
        "              \"<div><b>\" + esc(pc.posto) + \"</b> <span style='font-size:12px;color:var(--muted)'>\" + esc(pc.descricao) + \"</span></div>\" + ",
        "              \"<div>\" + badgeGargalo + badgeSobrecarga + \"</div>\" + ",
        "            \"</div>\" + ",
        "            \"<div style='display:flex;align-items:baseline;justify-content:space-between;margin:8px 0'>\" + ",
        "              \"<span style='font-family:var(--f-display);font-size:26px;font-weight:700;color:\" + (pc.ocupacao_pct > 100 ? \"var(--bad-ink)\" : \"var(--ink)\") + \"'>\" + num(pc.ocupacao_pct, 1) + \"%</span>\" + ",
        "              \"<span class='mono' style='font-size:12px;color:var(--ink-2)'>\" + num(pc.carga_h, 1) + \" h / \" + num(pc.capacidade_h, 1) + \" h</span>\" + ",
        "            \"</div>\" + ",
        "            \"<div class='barra' style='height:8px;background:var(--line);border-radius:4px;overflow:hidden'><i style='display:block;height:100%;width:\" + pctVal + \"%;background:\" + cor + \"'></i></div>\" + ",
        "            \"<div style='display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:8px'>\" + ",
        "              \"<span>\" + pc.tarefas_pendentes + \" tarefa(s) pendente(s)</span>\" + ",
        "              \"<span>\" + dur(pc.carga_min) + \"</span>\" + ",
        "            \"</div>\" + ",
        "          \"</div>\";",
        "        }).join(\"\");",
        "      }",
        "    }",
        "    return carregarAgendaProg();",
        "  });",
        "}",
        "function carregarAgendaProg() {",
        "  var sel = document.getElementById(\"prog-filtro-posto\");",
        "  var pt = sel ? sel.value : \"\";",
        "  return api(\"GET\", \"/api/programacao/agenda\" + (pt ? \"?posto=\" + encodeURIComponent(pt) : \"\")).then(function (agenda) {",
        "    agenda = agenda || [];",
        "    var cAgenda = document.getElementById(\"prog-agenda-c\");",
        "    if (cAgenda) cAgenda.textContent = agenda.length + \" operação(ões) na fila\";",
        "    moldura(\"prog-agenda-tabela\", [",
        "      [\"OP\"], [\"Etapa\"], [\"Posto\"], [\"Produto\"], [\"Qtd.\", 1], [\"Duração\", 1],",
        "      [\"Prioridade\", 1], [\"Prazo Pedido\"], [\"Início Est.\"], [\"Fim Est.\"], [\"Situação\"]",
        "    ], agenda.map(function (it) {",
        "      var situacao = \"\";",
        "      if (it.atraso_previsto) {",
        "        situacao = \"<span class='tag bad'>ATRASO PREVISTO</span>\";",
        "      } else if (it.status === \"EM_EXECUCAO\") {",
        "        situacao = \"<span class='tag act'>EM EXECUÇÃO</span>\";",
        "      } else {",
        "        situacao = \"<span class='tag ok'>NO PRAZO</span>\";",
        "      }",
        "      var prioInput = \"<div style='display:flex;align-items:center;gap:4px;justify-content:flex-end'>\" + ",
        "        \"<input id='prio-\" + it.op + \"' type='number' value='\" + (it.prioridade || 0) + \"' style='width:52px;height:28px;text-align:right;padding:0 4px'>\" + ",
        "        \"<button class='mini sec' onclick='salvarPrioridadeProg(\" + it.op + \")' style='height:28px;padding:0 8px'>OK</button>\" + ",
        "      \"</div>\";",
        "      return {",
        "        c: [",
        "          linkOp(it.op),",
        "          esc(it.etapa + \" · \" + it.operacao),",
        "          esc(it.posto),",
        "          linkProduto(it.produto),",
        "          num(it.quantidade, 0),",
        "          dur(it.duracao_min),",
        "          prioInput,",
        "          it.entrega_pedido ? dataHora(it.entrega_pedido) : \"<span style='color:var(--muted)'>—</span>\",",
        "          dataHora(it.inicio_estimado),",
        "          dataHora(it.fim_estimado),",
        "          situacao",
        "        ],",
        "        d: [",
        "          \"OP-\" + String(it.op).padStart(3, \"0\"),",
        "          it.etapa + \" - \" + it.operacao,",
        "          it.posto,",
        "          it.produto,",
        "          it.quantidade,",
        "          it.duracao_min,",
        "          it.prioridade,",
        "          it.entrega_pedido ? dataHora(it.entrega_pedido) : \"\",",
        "          dataHora(it.inicio_estimado),",
        "          dataHora(it.fim_estimado),",
        "          it.atraso_previsto ? \"Atraso previsto\" : (it.status === \"EM_EXECUCAO\" ? \"Em execução\" : \"No prazo\")",
        "        ],",
        "        estado: it.status,",
        "        cls: it.atraso_previsto ? \"e-bad\" : (it.status === \"EM_EXECUCAO\" ? \"e-act\" : \"e-plan\")",
        "      };",
        "    }), {",
        "      vazio: \"Nenhuma operação pendente na fila de programação.\",",
        "      csv: [\"OP\", \"Etapa\", \"Posto\", \"Produto\", \"Quantidade\", \"DuracaoMin\", \"Prioridade\", \"PrazoPedido\", \"InicioEstimado\", \"FimEstimado\", \"Situacao\"],",
        "      arquivo: \"agenda_programacao\"",
        "    });",
        "  });",
        "}",
        "window.salvarPrioridadeProg = function (op) {",
        "  var el = document.getElementById(\"prio-\" + op);",
        "  var prio = el ? el.value : \"0\";",
        "  api(\"POST\", \"/api/programacao/priorizar\", \"op=\" + encodeURIComponent(op) + \"&prioridade=\" + encodeURIComponent(prio)).then(function () {",
        "    toast(\"Prioridade da OP-\" + String(op).padStart(3, \"0\") + \" atualizada para \" + prio + \"!\");",
        "    telaProgramacao();",
        "  }, function (err) {",
        "    toast(\"Erro ao salvar prioridade: \" + err.message, true);",
        "  });",
        "};",
        "function telaClientes() {",
        "  return tenta(api(\"GET\", \"/api/pedidos/pedidos\"), []).then(function (ps) {",
        "    var abertos = {};",
        "    ps.forEach(function (p) { if ([\"ABERTO\", \"EM_PRODUCAO\", \"PRONTO\"].indexOf(p.status) >= 0) abertos[p.cliente] = (abertos[p.cliente] || 0) + 1; });",
        "    document.getElementById(\"clientes-c\").textContent = cache.clientes.length + \" clientes\";",
        "    moldura(\"clientes\", [[\"Código\"], [\"Nome\"], [\"CNPJ / CPF\"], [\"Contato\"], [\"E-mail\"], [\"Telefone\"], [\"Pedidos em aberto\", 1]], cache.clientes.map(function (c) {",
        "      return {c: [\"<span class='id'>\" + esc(c.codigo) + \"</span>\", \"<div class='quebra'><b style='font-weight:600'>\" + esc(c.nome) + \"</b>\" + (c.endereco ? \"<br><small style='color:var(--muted)'>\" + esc(c.endereco) + \"</small>\" : \"\") + \"</div>\", esc(c.documento || \"—\"), esc(c.contato || \"—\"),",
        "        c.email ? \"<a href='mailto:\" + esc(c.email) + \"'>\" + esc(c.email) + \"</a>\" : \"—\", esc(c.telefone || \"—\"), abertos[c.codigo] ? \"<a href='#pedidos' onclick='filtrarCliente(\\\"\" + esc(c.codigo) + \"\\\")'>\" + abertos[c.codigo] + \"</a>\" : \"0\"],",
        "        d: [c.codigo, c.nome, c.documento || \"\", c.contato || \"\", c.email || \"\", c.telefone || \"\", c.endereco || \"\", abertos[c.codigo] || 0]};",
        "    }), {vazio: \"Nenhum cliente cadastrado.\", csv: [\"Código\", \"Nome\", \"Documento\", \"Contato\", \"E-mail\", \"Telefone\", \"Endereço\", \"Pedidos em aberto\"], arquivo: \"clientes\"});",
        "  });",
        "}",
        "window.filtrarCliente = function (c) { MOLD.pedidos = {q: c, est: \"\"}; };",
        "",
        "// ── fase 2 · estoque endereçado ─────────────────────────────",
        "var TIPOS_END = {ALMOXARIFADO: \"almoxarifado\", LINHA: \"linha\", EXPEDICAO: \"expedição\", QUARENTENA: \"quarentena\"};",
        "var entradaPendente = null;",
        "function enderecos() {",
        "  var e = cache.enderecos.slice();",
        "  // GERAL primeiro: é o padrão da API e o que o formulário volta a mostrar depois de enviar.",
        "  var g = e.filter(function (x) { return x.codigo === \"GERAL\"; })[0] || {codigo: \"GERAL\", descricao: \"Estoque geral\", tipo: \"ALMOXARIFADO\", posto: \"\"};",
        "  return [g].concat(e.filter(function (x) { return x.codigo !== \"GERAL\"; }));",
        "}",
        "function rotEndereco(e) { return e.codigo + \" · \" + (TIPOS_END[e.tipo] || String(e.tipo || \"\").toLowerCase()) + (e.posto ? \" · \" + e.posto : \"\"); }",
        "function telaSaldos() {",
        "  return Promise.all([api(\"GET\", \"/api/estoque/saldos\"), api(\"GET\", \"/api/estoque/movimentos\")]).then(function (r) {",
        "    var s = r[0], desc = {};",
        "    cache.produtos.forEach(function (p) { desc[p.codigo] = p; });",
        "    var cods = Object.keys(s).sort();",
        "    document.getElementById(\"saldos-c\").textContent = cods.length + \" itens\";",
        "    moldura(\"saldos\", [[\"Produto\"], [\"Descrição\"], [\"Tipo\"], [\"Saldo\", 1]], cods.map(function (c) {",
        "      var p = desc[c] || {}, v = Number(s[c]);",
        "      return {c: [linkProduto(c), esc(p.descricao || \"\"), esc(p.tipo || \"\"), \"<span class='\" + (v < 0 ? \"neg\" : \"\") + \"'>\" + num(v) + \" \" + esc(p.unidade || \"\") + \"</span>\"],",
        "        d: [c, p.descricao || \"\", p.tipo || \"\", v, p.unidade || \"\"], estado: v < 0 ? \"NEG\" : (p.tipo || \"\")};",
        "    }), {estados: [[\"MP\", \"MP · matéria-prima\"], [\"SA\", \"SA · semiacabado\"], [\"PA\", \"PA · acabado\"], [\"NEG\", \"saldo negativo\"]], todos: \"todos os tipos\", csv: [\"Produto\", \"Descrição\", \"Tipo\", \"Saldo\", \"Unidade\"], arquivo: \"saldos\"});",
        "    document.getElementById(\"movimentos\").innerHTML = tabela([[\"Hora\"], [\"Produto\"], [\"Tipo\"], [\"Endereço\"], [\"Qtd.\", 1], [\"Saldo\", 1], [\"Origem\"]],",
        "      r[1].sort(porId).slice(0, 14).map(function (m) { return [hora(m.ts), esc(m.produto), esc(rot(m.tipo).toLowerCase()), m.endereco ? \"<span class='id'>\" + esc(m.endereco) + \"</span>\" : \"—\", \"<span class='\" + (m.quantidade < 0 ? \"neg\" : \"\") + \"'>\" + num(m.quantidade) + \"</span>\", num(m.saldo), esc(m.origem)]; }));",
        "    if (entradaPendente) {",
        "      var f = document.getElementById(\"f-entrada\"), x = entradaPendente; entradaPendente = null;",
        "      f.produto.value = x.produto; f.quantidade.value = x.quantidade; if (x.endereco) f.endereco.value = x.endereco; f.origem.value = \"reposição\";",
        "      f.closest(\".card\").scrollIntoView({behavior: \"smooth\", block: \"center\"}); f.quantidade.focus({preventScroll: true});",
        "    }",
        "  });",
        "}",
        "window.verEndereco = function (cod) {",
        "  var m = MOLD.posicoes; if (!m) return;",
        "  m.est = m.est === cod ? \"\" : cod; m.q = \"\";",
        "  var el = document.getElementById(\"posicoes\"), s = el.querySelector(\".f-est\"); if (s) s.value = m.est; el.querySelector(\".f-q\").value = \"\";",
        "  corpoLista(\"posicoes\"); cartoesEndereco();",
        "  if (m.est) el.scrollIntoView({behavior: \"smooth\", block: \"start\"});",
        "};",
        "var posCache = [];",
        "function cartoesEndereco() {",
        "  var sel = MOLD.posicoes ? MOLD.posicoes.est : \"\", tot = {};",
        "  posCache.forEach(function (p) { var t = tot[p.endereco] || (tot[p.endereco] = {n: 0, q: 0, neg: 0}); t.n++; t.q += Number(p.quantidade); if (Number(p.quantidade) < 0) t.neg++; });",
        "  var es = enderecos();",
        "  document.getElementById(\"enderecos-c\").textContent = es.length + \" endereços\";",
        "  document.getElementById(\"enderecos\").innerHTML = es.map(function (e) {",
        "    var t = tot[e.codigo] || {n: 0, q: 0, neg: 0};",
        "    return \"<button type='button' class='endereco\" + (sel === e.codigo ? \" sel\" : \"\") + \"' onclick='verEndereco(\\\"\" + esc(e.codigo) + \"\\\")' aria-pressed='\" + (sel === e.codigo) + \"' title='Ver as posições deste endereço'>\" +",
        "      \"<span class='tp'>\" + esc(TIPOS_END[e.tipo] || e.tipo) + (e.posto ? \" · \" + esc(e.posto) : \"\") + \"</span><b>\" + esc(e.codigo) + \"</b><span class='d'>\" + esc(e.descricao || \"\") + \"</span>\" +",
        "      \"<span class='q'>\" + t.n + \" produto(s) · \" + num(t.q) + \" un.</span>\" + (t.neg ? \"<span class='neg'>\" + t.neg + \" saldo(s) negativo(s)</span>\" : \"\") + \"</button>\";",
        "  }).join(\"\");",
        "}",
        "function telaPosicoes() {",
        "  return api(\"GET\", \"/api/estoque/posicoes\").then(function (ps) {",
        "    posCache = ps;",
        "    var tipo = {}; enderecos().forEach(function (e) { tipo[e.codigo] = e; });",
        "    document.getElementById(\"posicoes-c\").textContent = ps.length + \" posições\";",
        "    moldura(\"posicoes\", [[\"Endereço\"], [\"Tipo\"], [\"Produto\"], [\"Descrição\"], [\"Quantidade\", 1]], ps.slice().sort(function (a, b) { return (a.endereco + a.produto).localeCompare(b.endereco + b.produto); }).map(function (p) {",
        "      var e = tipo[p.endereco] || {}, v = Number(p.quantidade);",
        "      return {c: [\"<span class='id'>\" + esc(p.endereco) + \"</span>\", esc(TIPOS_END[e.tipo] || e.tipo || \"—\"), linkProduto(p.produto), esc(descProduto(p.produto)), \"<span class='\" + (v < 0 ? \"neg\" : \"\") + \"'>\" + num(v) + \"</span>\"],",
        "        d: [p.endereco, e.tipo || \"\", p.produto, descProduto(p.produto), v], estado: p.endereco, cls: v < 0 ? \"e-bad\" : \"\"};",
        "    }), {vazio: \"Nenhum saldo em endereço ainda.\", estados: enderecos().map(function (e) { return [e.codigo, e.codigo]; }), todos: \"todos os endereços\", csv: [\"Endereço\", \"Tipo\", \"Produto\", \"Descrição\", \"Quantidade\"], arquivo: \"posicoes\"});",
        "    cartoesEndereco();",
        "  });",
        "}",
        "// Faixa de reposição: a banda verde vai do mínimo ao máximo; o traço é o saldo.",
        "function faixaReposicao(saldo, min, max) {",
        "  var esc_ = Math.max(max * 1.25, saldo, 1), p = function (v) { return Math.max(0, Math.min(100, 100 * v / esc_)); };",
        "  return \"<div class='reposicao\" + (saldo < min ? \" baixo\" : \"\") + \"' title='mínimo \" + num(min) + \" · máximo \" + num(max) + \" · saldo \" + num(saldo) + \"' role='img' aria-label='saldo \" + num(saldo) + \" entre mínimo \" + num(min) + \" e máximo \" + num(max) + \"'>\" +",
        "    \"<span class='fx' style='left:\" + p(min) + \"%;width:\" + (p(max) - p(min)) + \"%'></span><span class='sd' style='left:\" + p(saldo) + \"%'></span></div>\";",
        "}",
        "function telaReposicao() {",
        "  return Promise.all([api(\"GET\", \"/api/estoque/sugestoes\"), api(\"GET\", \"/api/estoque/reposicao\"), api(\"GET\", \"/api/estoque/saldos\"), tenta(api(\"GET\", \"/api/producao/ordens\"), []), tenta(api(\"GET\", \"/api/estoque/posicoes\"), [])]).then(function (r) {",
        "    var sug = r[0], regras = r[1], saldos = r[2], abertas = {}, pos = {};",
        "    r[4].forEach(function (x) { pos[x.endereco + \"|\" + x.produto] = Number(x.quantidade); });",
        "    cache.regras = regras;",
        "    r[3].filter(abertaOp).forEach(function (o) { (abertas[o.produto] = abertas[o.produto] || []).push(o); });",
        "    document.getElementById(\"sugestoes-c\").textContent = sug.length ? sug.length + \" abaixo do mínimo\" : \"tudo acima do mínimo\";",
        "    document.getElementById(\"sugestoes\").innerHTML = tabela([[\"Produto\"], [\"Descrição\"], [\"Tipo\"], [\"Saldo\", 1], [\"Em Prod.\", 1], [\"Projetado\", 1], [\"Mínimo\", 1], [\"Máximo\", 1], [\"Sugerido\", 1], [\"Ação\"]], sug.map(function (s) {",
        "      var q = Math.ceil(Number(s.quantidade_sugerida)), ab = abertas[s.produto] || [], a;",
        "      if (s.tipo === \"PRODUZIR\") {",
        "        a = (ab.length ? \"<span style='font-size:12px;color:var(--muted)'>em aberto: </span>\" + ab.map(function (o) { return linkOp(o.id); }).join(\" \") + \" \" : \"\") +",
        "          \"<button class='mini\" + (ab.length ? \" sec\" : \"\") + \"' onclick='criarOpReposicao(\\\"\" + esc(s.produto) + \"\\\",\" + q + \")'>\" + (ab.length ? \"Criar outra OP\" : \"Criar OP\") + \"</button>\";",
        "      } else {",
        "        a = \"<button class='mini sec' onclick='darEntrada(\\\"\" + esc(s.produto) + \"\\\",\" + q + \",\\\"\" + esc(s.endereco || \"\") + \"\\\")' title='A compra é feita fora do EMP; registre a entrada quando chegar'>Registrar entrada</button>\";",
        "      }",
        "      var ep = Number(s.em_producao || 0), sp = Number(s.saldo_projetado != null ? s.saldo_projetado : s.saldo);",
        "      var l = [linkProduto(s.produto), esc(descProduto(s.produto)), esc(rot(s.tipo).toLowerCase()), \"<span class='neg'>\" + num(s.saldo) + \"</span>\", num(ep), \"<b>\" + num(sp) + \"</b>\", num(s.minimo), num(s.maximo), \"<b>\" + num(q) + \"</b>\", \"<div class='acoes-op' style='max-width:300px'>\" + a + \"</div>\"];",
        "      l.cls = \"e-bad\"; return l;",
        "    }), \"Nenhum produto abaixo do mínimo.\");",
        "    document.getElementById(\"regras-c\").textContent = regras.length + \" regra(s)\";",
        "    moldura(\"regras\", [[\"Produto\"], [\"Tipo\"], [\"Endereço\"], [\"Mínimo\", 1], [\"Máximo\", 1], [\"Saldo vigiado\", 1], [\"Faixa\"]], regras.map(function (g) {",
        "      // Regra com endereço vigia só aquele endereço; sem endereço, o saldo total.",
        "      var v = g.endereco ? (pos[g.endereco + \"|\" + g.produto] || 0) : Number(saldos[g.produto] || 0), mi = Number(g.minimo), ma = Number(g.maximo);",
        "      return {c: [linkProduto(g.produto), esc(rot(g.tipo).toLowerCase()), g.endereco ? \"<span class='id'>\" + esc(g.endereco) + \"</span>\" : \"<span style='color:var(--muted)'>saldo total</span>\", num(mi), num(ma), \"<span class='\" + (v < mi ? \"neg\" : \"\") + \"'>\" + num(v) + \"</span>\", faixaReposicao(v, mi, ma)],",
        "        d: [g.produto, g.tipo, g.endereco || \"\", mi, ma, v], estado: g.tipo, cls: v < mi ? \"e-bad\" : \"e-ok\"};",
        "    }), {vazio: \"Nenhuma regra de reposição.\", estados: [[\"PRODUZIR\", \"produzir\"], [\"COMPRAR\", \"comprar\"]], todos: \"todos os tipos\", csv: [\"Produto\", \"Tipo\", \"Endereço\", \"Mínimo\", \"Máximo\", \"Saldo vigiado\"], arquivo: \"reposicao\"});",
        "  });",
        "}",
        "window.criarOpReposicao = function (produto, q) {",
        "  api(\"POST\", \"/api/producao/ordens\", {produto: produto, quantidade: String(q), posto: \"\", origem: \"REPOSICAO\"}).then(function (r) {",
        "    toast((r && r.id ? \"OP-\" + String(r.id).padStart(3, \"0\") : \"OP\") + \" criada: \" + num(q) + \" × \" + produto + \" (reposição).\");",
        "  }, function (e) { toast(e.message, true); }).then(carregar);",
        "};",
        "window.darEntrada = function (produto, q, endereco) {",
        "  entradaPendente = {produto: produto, quantidade: String(q), endereco: endereco || \"\"};",
        "  location.hash = \"#estoque\";",
        "};",
        "function detalheProdutoEstoque(cod) {",
        "  return Promise.all([api(\"GET\", \"/api/estoque/saldos?produto=\" + encodeURIComponent(cod)), api(\"GET\", \"/api/estoque/movimentos\"), tenta(api(\"GET\", \"/api/estoque/reposicao\"), [])]).then(function (r) {",
        "    var s = r[0] || {}, pe = s.por_endereco || {}, ks = Object.keys(pe).sort(), p = cache.produtos.filter(function (x) { return x.codigo === cod; })[0] || {};",
        "    var regra = r[2].filter(function (g) { return g.produto === cod; })[0], tipo = {};",
        "    enderecos().forEach(function (e) { tipo[e.codigo] = e; });",
        "    var maxv = Math.max.apply(null, ks.map(function (k) { return Math.abs(Number(pe[k])); }).concat([1])), total = Number(s.saldo || 0);",
        "    document.getElementById(\"titulo\").textContent = cod;",
        "    var h = \"<div class='op-cab'><a class='voltar' href='#estoque'>← SALDOS</a><div class='prod'><b>\" + esc(cod) + \"</b><span>\" + esc(p.descricao || \"\") + (p.tipo ? \" · \" + esc(p.tipo) : \"\") + \"</span></div>\" +",
        "      \"<div class='nums'><div><small>Saldo total</small><b class='\" + (total < 0 ? \"neg\" : \"\") + \"'>\" + num(total) + \" \" + esc(p.unidade || \"\") + \"</b></div><div><small>Endereços</small><b>\" + ks.length + \"</b></div>\" +",
        "      (regra ? \"<div><small>Reposição</small><b style='font-size:15px'>\" + num(regra.minimo) + \" – \" + num(regra.maximo) + \" · \" + esc(rot(regra.tipo).toLowerCase()) + \"</b></div>\" : \"\") + \"</div>\" +",
        "      (regra ? \"<div style='flex:1 1 220px;max-width:360px'>\" + faixaReposicao(total, Number(regra.minimo), Number(regra.maximo)) + \"</div>\" : \"\") + \"</div>\";",
        "    h += \"<h2>Saldo por endereço</h2>\" + (ks.length ? \"<div class='por-end'>\" + ks.map(function (k) {",
        "      var v = Number(pe[k]), e = tipo[k] || {};",
        "      return \"<span><span class='id'>\" + esc(k) + \"</span> <small style='color:var(--muted)'>\" + esc(TIPOS_END[e.tipo] || \"\") + \"</small></span><div class='barra'><i style='width:\" + (100 * Math.abs(v) / maxv) + \"%\" + (v < 0 ? \";background:var(--bad)\" : \"\") + \"'></i></div><span class='v\" + (v < 0 ? \" neg\" : \"\") + \"'>\" + num(v) + \"</span>\";",
        "    }).join(\"\") + \"</div>\" : \"<div class='vazio'>Sem saldo em nenhum endereço.</div>\");",
        "    var ms = r[1].filter(function (m) { return m.produto === cod; }).sort(porId).slice(0, 20);",
        "    h += \"<h2 style='margin-top:22px'>Movimentos<span class='cont'>últimos \" + ms.length + \"</span></h2>\" + tabela([[\"Quando\"], [\"Tipo\"], [\"Endereço\"], [\"Qtd.\", 1], [\"Saldo no endereço\", 1], [\"Saldo total\", 1], [\"Origem\"]], ms.map(function (m) {",
        "      return [dataHora(m.ts), esc(rot(m.tipo).toLowerCase()), m.endereco ? \"<span class='id'>\" + esc(m.endereco) + \"</span>\" : \"—\", \"<span class='\" + (m.quantidade < 0 ? \"neg\" : \"\") + \"'>\" + num(m.quantidade) + \"</span>\", m.saldo_endereco == null ? \"—\" : num(m.saldo_endereco), num(m.saldo), esc(m.origem)];",
        "    }), \"Nenhum movimento deste produto.\");",
        "    document.getElementById(\"est-produto\").innerHTML = h;",
        "  });",
        "}",
        "function telaEstoque() {",
        "  var s = sub();",
        "  if (s === \"produto\") return detalheProdutoEstoque(parte(2));",
        "  if (s === \"posicoes\") return telaPosicoes();",
        "  if (s === \"reposicao\") return telaReposicao();",
        "  return telaSaldos();",
        "}",
        "document.getElementById(\"end-tipo\").onchange = function () { document.getElementById(\"end-posto\").disabled = this.value !== \"LINHA\"; };",
        "document.getElementById(\"end-posto\").disabled = true;",
        "",
        "// ── fase 2 · OEE ────────────────────────────────────────────",
        "// OEE = disponibilidade × desempenho × qualidade (frações 0..1, vindas do módulo",
        "// indicadores). Referência 85%; abaixo de 60% é o alerta do módulo (EMP_OEE_ALERTA).",
        "var oeeSerie = \"\";",
        "function pct(f) { return num(100 * Number(f || 0), 1) + \"%\"; }",
        "function nivelOee(f) { return f >= 0.85 ? \"ok\" : f >= 0.6 ? \"warn\" : \"bad\"; }",
        "function corOee(f) { return {ok: \"var(--ok)\", warn: \"var(--warn)\", bad: \"var(--bad)\"}[nivelOee(f)]; }",
        "function tagOee(f) {",
        "  var n = nivelOee(f), t = {ok: \"na referência\", warn: \"abaixo de 85%\", bad: \"abaixo de 60%\"}[n];",
        "  return \"<span class='tag ic st-\" + n + \"'><svg viewBox='0 0 24 24' aria-hidden='true'><path d='\" + (n === \"ok\" ? ICONE_ST.ok : ICONE_ST.bad) + \"'/></svg>\" + t + \"</span>\";",
        "}",
        "function janelaOee() { return sub() === \"24\" ? 24 : 8; }",
        "function fator(rotulo, f, nota) { return \"<div class='fator'><span>\" + rotulo + \"</span><div class='barra'><i style='width:\" + (nota ? 0 : Math.max(0, Math.min(100, 100 * f))) + \"%'></i></div><span\" + (nota ? \" title='sem tempo operando ou sem tempo padrão na janela: o desempenho não foi medido e entra como 100% no OEE'\" : \"\") + \">\" + (nota || num(100 * f, 0) + \"%\") + \"</span></div>\"; }",
        "// Desempenho sem tempo operando ou sem tempo padrão não é medido (vale 1 no OEE).",
        "function pctDesemp(o) { return o && o.desempenho_medido === false && Number(o.desempenho) > 0 ? \"sem tempo\" : pct(o ? o.desempenho : 0); }",
        "function heroiOee(l, horas) {",
        "  var f = Number(l.oee || 0), C = 2 * Math.PI * 66;",
        "  var anel = \"<div class='anel'><svg viewBox='0 0 156 156' aria-hidden='true'><circle cx='78' cy='78' r='66' fill='none' stroke='rgba(255,255,255,.14)' stroke-width='12'/>\" +",
        "    \"<circle cx='78' cy='78' r='66' fill='none' style='stroke:\" + corOee(f) + \"' stroke-width='12' stroke-linecap='round' stroke-dasharray='\" + (C * Math.max(0, Math.min(1, f))).toFixed(1) + \" \" + C.toFixed(1) + \"' transform='rotate(-90 78 78)'/></svg><b>\" + num(100 * f, 0) + \"%</b><small>OEE · \" + horas + \" H</small></div>\";",
        "  var fat = function (r, v, c) { return \"<div class='fat\" + (c || \"\") + \"'><b>\" + pct(v) + \"</b><small>\" + r + \"</small></div>\"; };",
        "  return \"<div class='trilha'>OEE DA LINHA · ÚLTIMAS \" + horas + \" H</div><div class='oee-linha'>\" + anel + \"<div><div class='conta'>\" + fat(\"disponibilidade\", l.disponibilidade) + \"<span class='op'>×</span>\" + fat(\"desempenho\", l.desempenho) + \"<span class='op'>×</span>\" + fat(\"qualidade\", l.qualidade) + \"<span class='op'>=</span>\" + fat(\"OEE\", f, \" res\") + \"</div>\" +",
        "    \"<div class='faixa-meta'>\" + tagOee(f) + \" &nbsp;Referência 85% · o módulo avisa (<code style='background:transparent;color:inherit;border-color:rgba(255,255,255,.2)'>indicadores.oee_baixo</code>) abaixo de 60%.</div></div></div>\";",
        "}",
        "function cartaoOee(p, estado) {",
        "  var f = Number(p.oee || 0), d = cache.postos.filter(function (x) { return x.codigo === p.posto; })[0] || {};",
        "  return \"<div class='oee-posto' style='--eb:\" + corOee(f) + \"'><div class='cab'><div class='medidor' style='--p:\" + Math.round(100 * f) + \";--c:\" + corOee(f) + \"'><span>\" + num(100 * f, 0) + \"%</span></div>\" +",
        "    \"<div><b>\" + esc(p.posto) + \"</b><div class='d'>\" + esc(d.descricao || \"\") + \"</div>\" + (estado ? tag(estado) : \"\") + \"</div></div>\" +",
        "    \"<div class='fatores'>\" + fator(\"Disponibilidade\", Number(p.disponibilidade || 0)) + fator(\"Desempenho\", Number(p.desempenho || 0), p.desempenho_medido === false && Number(p.desempenho) > 0 ? \"—\" : \"\") + fator(\"Qualidade\", Number(p.qualidade || 0)) + \"</div>\" +",
        "    \"<div class='min'><span>operando <b>\" + dur(p.min_operando) + \"</b></span><span>parado <b>\" + dur(p.min_parado) + \"</b></span><span>ocioso <b>\" + dur(p.min_ocioso) + \"</b></span><span>boas <b>\" + num(p.boas, 0) + \"</b></span><span>refugo <b\" + (p.refugo > 0 ? \" class='neg'\" : \"\") + \">\" + num(p.refugo, 0) + \"</b></span></div></div>\";",
        "}",
        "var COR_ESTADO = {OPERANDO: \"fill:var(--ok)\", PARADO: \"fill:url(#p-parado)\", OCIOSO: \"fill:var(--info);fill-opacity:.25\"};",
        "function linhaTempo(postos, segs, t0, t1) {",
        "  var span = t1 - t0 || 1, W = 1000;",
        "  var linhas = postos.map(function (p) {",
        "    var rs = segs.filter(function (s) { return s.posto === p; }).map(function (s) {",
        "      var a = Math.max(Number(s.inicio), t0), b = Math.min(Number(s.fim) || t1, t1);",
        "      if (b <= a) return \"\";",
        "      var x = (a - t0) / span * W, w = Math.max(1.5, (b - a) / span * W);",
        "      return \"<rect x='\" + x.toFixed(1) + \"' y='0' width='\" + w.toFixed(1) + \"' height='26' style='\" + (COR_ESTADO[s.estado] || \"fill:var(--line)\") + \"'><title>\" + esc(rot(s.estado).toLowerCase() + \" · \" + hora(a) + \" → \" + (Number(s.fim) ? hora(b) : \"agora\") + \" (\" + dur((b - a) / 60000) + \")\" + (s.motivo ? \" · \" + s.motivo : \"\")) + \"</title></rect>\";",
        "    }).join(\"\");",
        "    return \"<span class='p' title='\" + esc(p) + \"'>\" + esc(p) + \"</span><svg viewBox='0 0 \" + W + \" 26' preserveAspectRatio='none' role='img' aria-label='Linha do tempo de \" + esc(p) + \"'><rect width='\" + W + \"' height='26' style='fill:var(--surface-2)'><title>sem registro</title></rect>\" + rs + \"</svg>\";",
        "  }).join(\"\");",
        "  var marcas = [0, 1, 2, 3, 4].map(function (i) { return \"<span>\" + (i === 4 ? \"agora\" : hora(t0 + span * i / 4)) + \"</span>\"; }).join(\"\");",
        "  return postos.length ? \"<div class='tl'>\" + linhas + \"<div class='eixo'>\" + marcas + \"</div></div>\" : \"<div class='vazio'>Nenhum posto cadastrado.</div>\";",
        "}",
        "// Colunas de OEE por hora, com a meta de 85% tracejada. Desenhado aqui, sem biblioteca.",
        "function colunaPath(x, y, w, h, r) {",
        "  r = Math.min(r, w / 2, h); if (h <= 0) return \"\";",
        "  return \"M\" + x + \",\" + (y + h) + \"V\" + (y + r) + \"Q\" + x + \",\" + y + \" \" + (x + r) + \",\" + y + \"H\" + (x + w - r) + \"Q\" + (x + w) + \",\" + y + \" \" + (x + w) + \",\" + (y + r) + \"V\" + (y + h) + \"Z\";",
        "}",
        "var serieAtual = [];",
        "function graficoSerie(el, serie) {",
        "  serieAtual = serie;",
        "  var W = Math.max(320, el.clientWidth || 900), H = 230, ml = 40, mr = 10, mt = 12, mb = 26, pw = W - ml - mr, ph = H - mt - mb;",
        "  var n = serie.length || 1, banda = pw / n, gap = Math.max(2, banda * 0.22), bw = Math.max(2, banda - gap);",
        "  var y = function (f) { return mt + ph * (1 - Math.max(0, Math.min(1, f))); };",
        "  var s = \"<svg viewBox='0 0 \" + W + \" \" + H + \"' width='\" + W + \"' height='\" + H + \"' role='img' aria-label='OEE por hora'>\";",
        "  [0, 0.25, 0.5, 0.75, 1].forEach(function (g) { s += \"<line class='grade' x1='\" + ml + \"' x2='\" + (W - mr) + \"' y1='\" + y(g) + \"' y2='\" + y(g) + \"'/><text x='\" + (ml - 8) + \"' y='\" + (y(g) + 3) + \"' text-anchor='end'>\" + (g * 100) + \"%</text>\"; });",
        "  var passo = Math.max(1, Math.ceil(n * 44 / pw));",
        "  serie.forEach(function (b, i) {",
        "    var f = Number(b.oee || 0), x = ml + i * banda + gap / 2;",
        "    s += \"<g data-i='\" + i + \"'><rect class='alvo' x='\" + (ml + i * banda) + \"' y='\" + mt + \"' width='\" + banda + \"' height='\" + ph + \"'/>\" +",
        "      (f > 0 ? \"<path class='col' d='\" + colunaPath(x, y(f), bw, y(0) - y(f), 4) + \"'/>\" : \"<rect class='col vazia' x='\" + x + \"' y='\" + (y(0) - 2) + \"' width='\" + bw + \"' height='2'/>\") + \"</g>\";",
        "    if (i % passo === 0) s += \"<text x='\" + (x + bw / 2) + \"' y='\" + (H - 8) + \"' text-anchor='middle'>\" + hora(b.inicio) + \"</text>\";",
        "  });",
        "  s += \"<line class='meta' x1='\" + ml + \"' x2='\" + (W - mr) + \"' y1='\" + y(0.85) + \"' y2='\" + y(0.85) + \"'/><text x='\" + (W - mr) + \"' y='\" + (y(0.85) - 5) + \"' text-anchor='end' style='fill:var(--ok-ink)'>meta 85%</text></svg>\";",
        "  var tab = \"<details style='margin-top:10px'><summary class='nota' style='cursor:pointer;color:var(--muted);font-size:12px'>ver em tabela</summary>\" + tabela([[\"Hora\"], [\"Disponibilidade\", 1], [\"Desempenho\", 1], [\"Qualidade\", 1], [\"OEE\", 1]], serie.map(function (b) {",
        "    return [hora(b.inicio) + \" → \" + hora(b.fim), pct(b.disponibilidade), pctDesemp(b), pct(b.qualidade), \"<b>\" + pct(b.oee) + \"</b>\"];",
        "  })) + \"</details>\";",
        "  var aberto = el.querySelector(\"details\") && el.querySelector(\"details\").open;",
        "  el.innerHTML = s + \"<div class='dica oculto'></div>\" + tab;",
        "  if (aberto) el.querySelector(\"details\").open = true;",
        "}",
        "function dicaSerie(ev) {",
        "  var el = document.getElementById(\"oee-serie\"), d = el.querySelector(\".dica\"), g = ev.target && ev.target.closest ? ev.target.closest(\"[data-i]\") : null, t = g && g.querySelector(\".alvo\"), i = g ? g.dataset.i : null;",
        "  if (!d) return;",
        "  if (i == null) { d.classList.add(\"oculto\"); return; }",
        "  var b = serieAtual[Number(i)]; if (!b) return;",
        "  var r = t.getBoundingClientRect(), base = el.getBoundingClientRect(), svg = el.querySelector(\"svg\").getBoundingClientRect();",
        "  d.innerHTML = \"<b>\" + hora(b.inicio) + \" → \" + hora(b.fim) + \"</b>OEE \" + pct(b.oee) + \"<br>disponibilidade \" + pct(b.disponibilidade) + \"<br>desempenho \" + pctDesemp(b) + \"<br>qualidade \" + pct(b.qualidade);",
        "  d.style.left = Math.max(70, Math.min(base.width - 70, r.left - base.left + r.width / 2)) + \"px\";",
        "  d.style.top = (svg.top - base.top + 12 + (svg.height - 38) * (1 - Math.max(0, Math.min(1, Number(b.oee || 0))))) + \"px\";",
        "  d.classList.remove(\"oculto\");",
        "}",
        "(function () { var el = document.getElementById(\"oee-serie\"); el.onmouseover = dicaSerie; el.onclick = dicaSerie; el.onmouseleave = function () { var d = el.querySelector(\".dica\"); if (d) d.classList.add(\"oculto\"); }; })();",
        "document.getElementById(\"oee-serie-posto\").onchange = function () { oeeSerie = this.value; telas.oee(); };",
        "function telaOee() {",
        "  var h = janelaOee(), t1 = Date.now(), t0 = t1 - h * 3600000;",
        "  return Promise.all([api(\"GET\", \"/api/indicadores/oee?horas=\" + h), api(\"GET\", \"/api/indicadores/estados?horas=\" + h),",
        "    api(\"GET\", \"/api/indicadores/oee/serie?horas=\" + h + \"&passo_min=60\" + (oeeSerie ? \"&posto=\" + encodeURIComponent(oeeSerie) : \"\"))]).then(function (r) {",
        "    var o = r[0] || {linha: {}, postos: []}, segs = r[1] || [], atual = {};",
        "    // A janela vem do servidor (inicio/fim), então a linha do tempo usa o relógio dele.",
        "    if (Number(o.fim)) { t1 = Number(o.fim); t0 = Number(o.inicio) || t1 - h * 3600000; }",
        "    segs.forEach(function (s) { if (!Number(s.fim)) atual[s.posto] = s.estado; });",
        "    var nomes = o.postos.map(function (p) { return p.posto; });",
        "    cache.postos.forEach(function (p) { if (nomes.indexOf(p.codigo) < 0) nomes.push(p.codigo); });",
        "    document.getElementById(\"oee-nota\").textContent = \"janela de \" + h + \" h · \" + hora(t0) + \" → agora\";",
        "    document.getElementById(\"oee-heroi\").innerHTML = heroiOee(o.linha || {}, h);",
        "    document.getElementById(\"oee-postos-c\").textContent = o.postos.length + \" posto(s)\";",
        "    document.getElementById(\"oee-postos\").innerHTML = o.postos.map(function (p) { return cartaoOee(p, atual[p.posto]); }).join(\"\") || \"<div class='vazio'>Sem dados de posto na janela.</div>\";",
        "    document.getElementById(\"oee-tl-c\").textContent = \"últimas \" + h + \" h\";",
        "    document.getElementById(\"oee-tl\").innerHTML = linhaTempo(nomes, segs, t0, t1);",
        "    document.getElementById(\"oee-tl-leg\").innerHTML = [[\"OPERANDO\", \"operando\"], [\"PARADO\", \"parado\"], [\"OCIOSO\", \"ocioso\"]].map(function (e) {",
        "      return \"<span><svg width='22' height='12' aria-hidden='true' style='display:inline-block;border-radius:3px'><rect width='22' height='12' style='\" + COR_ESTADO[e[0]] + \"'/></svg>\" + e[1] + \"</span>\";",
        "    }).join(\"\") + \"<span><svg width='22' height='12' aria-hidden='true' style='display:inline-block;border-radius:3px;border:1px solid var(--line)'><rect width='22' height='12' style='fill:var(--surface-2)'/></svg>sem registro</span>\";",
        "    var sel = document.getElementById(\"oee-serie-posto\");",
        "    opcoes(sel, [{codigo: \"\"}].concat(nomes.map(function (n) { return {codigo: n}; })), function (i) { return i.codigo; }, function (i) { return i.codigo || \"linha inteira\"; });",
        "    sel.value = oeeSerie;",
        "    document.getElementById(\"oee-serie-c\").textContent = (oeeSerie || \"linha\") + \" · passo de 1 h\";",
        "    graficoSerie(document.getElementById(\"oee-serie\"), r[2] || []);",
        "  });",
        "}",
        "",
        "var telas = {",
        "  inicio: function () {",
        "    return Promise.all([",
        "      tenta(api(\"GET\", \"/api/producao/indicadores\"), null), tenta(api(\"GET\", \"/api/producao/ordens\"), []),",
        "      ativos.manutencao ? tenta(api(\"GET\", \"/api/manutencao/postos\"), []) : Promise.resolve([])",
        "    ]).then(function (r) {",
        "      var ind = r[0] || {produzido: 0, refugo_pct: 0}, ops = r[1], postos = r[2];",
        "      var andando = ops.filter(function (o) { return o.status === \"EM_PRODUCAO\"; }).length;",
        "      var parados = postos.filter(function (p) { return p.estado === \"PARADO\"; }).length;",
        "      document.getElementById(\"heroi-frase\").textContent = parados",
        "        ? parados + \" posto(s) parado(s) e \" + andando + \" ordem(ns) em produção agora.\"",
        "        : (andando ? andando + \" ordem(ns) em produção e todos os postos operando.\" : \"Linha pronta. Nenhuma ordem em produção agora.\");",
        "      var n = [[andando, \"em produção\"], [num(ind.produzido, 0), \"peças boas\"], [num(ind.refugo_pct, 1) + \"%\", \"refugo\"]];",
        "      if (postos.length) n.push([(postos.length - parados) + \"/\" + postos.length, \"postos operando\"]);",
        "      document.getElementById(\"heroi-nums\").innerHTML = n.map(function (x) { return \"<div class='num'><b>\" + x[0] + \"</b><small>\" + x[1] + \"</small></div>\"; }).join(\"\");",
        "    });",
        "  },",
        "  geral: function () {",
        "    return Promise.all([",
        "      tenta(api(\"GET\", \"/api/producao/indicadores\"), null), tenta(api(\"GET\", \"/api/producao/ordens\"), []),",
        "      tenta(api(\"GET\", \"/api/manutencao/postos\"), []), tenta(api(\"GET\", \"/api/estoque/saldos\"), {}),",
        "      ativos.qualidade ? tenta(api(\"GET\", \"/api/qualidade/ncs\"), []) : Promise.resolve(null), tenta(api(\"GET\", \"/api/sistema/eventos?n=8\"), []),",
        "      ativos.indicadores ? tenta(api(\"GET\", \"/api/indicadores/oee?horas=8\"), null) : Promise.resolve(null)",
        "    ]).then(function (r) {",
        "      var ind = r[0] || {ordens: {}, produzido: 0, refugo: 0, refugo_pct: 0}, ops = r[1], postos = r[2], saldos = r[3], ncs = r[4], evs = r[5];",
        "      var abertas = ops.filter(function (o) { return [\"PLANEJADA\", \"LIBERADA\", \"EM_PRODUCAO\"].indexOf(o.status) >= 0; });",
        "      var parados = postos.filter(function (p) { return p.estado === \"PARADO\"; }).length;",
        "      var negativos = Object.keys(saldos).filter(function (k) { return Number(saldos[k]) < 0; }).length;",
        "      var disp = postos.length ? postos.reduce(function (s, p) { return s + p.disponibilidade_pct; }, 0) / postos.length : 100;",
        "      var k = [",
        "        [\"OPs em aberto\", abertas.length, (ind.ordens.EM_PRODUCAO || 0) + \" em produção\", \"\"],",
        "        [\"Produzido\", num(ind.produzido, 0), \"peças boas apontadas\", \"bom\"],",
        "        [\"Refugo\", num(ind.refugo_pct, 2) + \"%\", num(ind.refugo, 0) + \" peças\", ind.refugo_pct > 5 ? \"alerta\" : \"\"],",
        "        [\"Disponibilidade\", num(disp, 1) + \"%\", parados + \" posto(s) parado(s)\", disp < 85 ? \"alerta\" : \"bom\"],",
        "        [\"Estoque\", negativos, \"saldos negativos\", negativos ? \"alerta\" : \"bom\"]",
        "      ];",
        "      if (ncs) k.push([\"NCs abertas\", ncs.filter(function (n) { return n.status === \"ABERTA\"; }).length, \"qualidade\", \"\"]);",
        "      var oee = r[6] && r[6].linha;",
        "      if (oee) k.splice(4, 0, [\"OEE da linha\", pct(oee.oee), \"D \" + num(100 * oee.disponibilidade, 0) + \"% × Desemp \" + num(100 * oee.desempenho, 0) + \"% × Q \" + num(100 * oee.qualidade, 0) + \"%\", oee.oee >= 0.85 ? \"bom\" : oee.oee < 0.6 ? \"alerta\" : \"\"]);",
        "      document.getElementById(\"kpis\").innerHTML = k.map(kpi).join(\"\");",
        "      document.getElementById(\"geral-postos\").innerHTML = postos.map(cartaoPosto).join(\"\") || \"<div class='vazio'>Nenhum posto cadastrado.</div>\";",
        "      document.getElementById(\"geral-postos-c\").textContent = (postos.length - parados) + \"/\" + postos.length + \" operando\";",
        "      document.getElementById(\"geral-eventos\").innerHTML = eventos(evs);",
        "      document.getElementById(\"geral-ordens\").innerHTML = tabela([[\"OP\"], [\"Produto\"], [\"Posto\"], [\"Estado\"], [\"Progresso\"], [\"Produzido\", 1], [\"Refugo\", 1]],",
        "        abertas.sort(porId).map(function (o) { var l = [linkOp(o.id), esc(o.produto), esc(o.posto || \"—\"), tag(o.status), progresso(o), num(o.produzido, 0) + \" / \" + num(o.quantidade, 0), num(o.refugo, 0)]; l.cls = linhaOp(o); return l; }), \"Nenhuma OP em aberto.\");",
        "    });",
        "  },",
        "  ordens: function () {",
        "    if (sub()) return api(\"GET\", \"/api/producao/ordem?id=\" + encodeURIComponent(sub())).then(detalheOp);",
        "    return api(\"GET\", \"/api/producao/ordens\").then(function (ops) {",
        "      var n = {}; ops.forEach(function (o) { n[o.status] = (n[o.status] || 0) + 1; });",
        "      var total = ops.length || 1;",
        "      document.getElementById(\"ordens-leg\").innerHTML = \"<div class='distrib'>\" + LEGENDA.map(function (l) { return n[l[0]] ? \"<i style='width:\" + (100 * n[l[0]] / total) + \"%;background:\" + l[2] + \"' title='\" + l[1] + \"'></i>\" : \"\"; }).join(\"\") + \"</div>\" +",
        "        \"<div class='chips'>\" + LEGENDA.map(function (l) { return \"<span><i style='background:\" + l[2] + \"'></i>\" + l[1] + \" <b>\" + (n[l[0]] || 0) + \"</b></span>\"; }).join(\"\") + \"</div>\";",
        "      document.getElementById(\"ordens-hora\").textContent = \"atualizado \" + new Date().toLocaleTimeString(\"pt-BR\");",
        "      document.getElementById(\"ordens-c\").textContent = ops.length + \" no total\";",
        "      moldura(\"ordens\", [[\"OP\"], [\"Produto\"], [\"Posto\"], [\"Estado · etapa\"], [\"Progresso\"], [\"Qtd.\", 1], [\"Boas\", 1], [\"Refugo\", 1], [\"Criada\"], [\"Ações\"]],",
        "        ops.sort(porId).map(function (o) {",
        "          var a = \"\";",
        "          if (o.status === \"PLANEJADA\") a += \"<button class='mini' onclick='liberar(\" + o.id + \")'>Liberar</button>\";",
        "          if (o.status === \"LIBERADA\" || o.status === \"EM_PRODUCAO\") a += \"<input id='b\" + o.id + \"' placeholder='boas'><input id='r\" + o.id + \"' placeholder='refugo'><button class='mini ok' onclick='apontar(\" + o.id + \")'>Apontar</button>\";",
        "          if (o.status === \"PLANEJADA\" || o.status === \"LIBERADA\") a += \"<button class='mini sec' onclick='cancelar(\" + o.id + \")'>Cancelar</button>\";",
        "          var et = etapaAtual(o);",
        "          return {c: [linkOp(o.id), esc(o.produto), esc(o.posto || \"—\"), tag(o.status) + celEtapa(o), progresso(o), num(o.quantidade, 0), num(o.produzido, 0), num(o.refugo, 0), dataHora(o.criada_em), \"<div class='acoes-op'>\" + a + \"</div>\"],",
        "            d: [\"OP-\" + String(o.id).padStart(3, \"0\"), o.produto, o.posto || \"\", rot(o.status).toLowerCase(), et ? et.e.numero + \" \" + et.e.operacao : \"\", Number(o.quantidade), Number(o.produzido), Number(o.refugo), dataHora(o.criada_em)],",
        "            estado: o.status, cls: linhaOp(o)};",
        "        }), {vazio: \"Nenhuma ordem criada.\", estados: LEGENDA.map(function (l) { return [l[0], l[1]]; }), csv: [\"OP\", \"Produto\", \"Posto\", \"Estado\", \"Etapa atual\", \"Quantidade\", \"Boas\", \"Refugo\", \"Criada\"], arquivo: \"ordens\"});",
        "    });",
        "  },",
        "  estoque: function () { return telaEstoque(); },",
        "  pedidos: function () { return telaPedidos(); },",
        "  mrp: function () { return telaMrp(); },",
        "  programacao: function () { return telaProgramacao(); },",
        "  oee: function () { return telaOee(); },",
        "  manutencao: function () {",
        "    return Promise.all([api(\"GET\", \"/api/manutencao/postos\"), api(\"GET\", \"/api/manutencao/paradas\"), api(\"GET\", \"/api/manutencao/indicadores\")]).then(function (r) {",
        "      var postos = r[0], par = r[1], ind = r[2];",
        "      var disp = postos.length ? postos.reduce(function (s, p) { return s + p.disponibilidade_pct; }, 0) / postos.length : 100;",
        "      document.getElementById(\"man-kpis\").innerHTML = [[\"Paradas abertas\", ind.paradas_abertas, \"agora\", ind.paradas_abertas ? \"alerta\" : \"bom\"], [\"Disponibilidade\", num(disp, 1) + \"%\", \"média na janela de 8 h\", disp < 85 ? \"alerta\" : \"bom\"], [\"MTTR\", num(ind.mttr_min, 1) + \" min\", \"tempo médio de reparo\", \"\"], [\"Encerradas\", ind.paradas_encerradas, \"histórico\", \"\"]].map(kpi).join(\"\");",
        "      document.getElementById(\"man-postos\").innerHTML = postos.map(cartaoPosto).join(\"\");",
        "      var cat = ind.minutos_por_categoria, cs = Object.keys(cat), maxv = Math.max.apply(null, cs.map(function (c) { return cat[c]; }).concat([1]));",
        "      document.getElementById(\"man-cat\").innerHTML = cs.length ? cs.sort(function (a, b) { return cat[b] - cat[a]; }).map(function (c) {",
        "        return \"<div style='display:grid;grid-template-columns:140px 1fr 84px;gap:12px;align-items:center;margin:10px 0'><span>\" + esc(rot(c).toLowerCase()) + \"</span><div class='barra'><i style='width:\" + (100 * cat[c] / maxv) + \"%'></i></div><span class='mono' style='text-align:right;font-size:12px'>\" + dur(cat[c]) + \"</span></div>\";",
        "      }).join(\"\") : \"<div class='vazio'>Sem paradas registradas.</div>\";",
        "      moldura(\"paradas\", [[\"Parada\"], [\"Posto\"], [\"Categoria\"], [\"Motivo\"], [\"Início\"], [\"Duração\", 1], [\"Estado\"], [\"Ação\"]], par.sort(porId).map(function (p) {",
        "        var fim = p.status === \"ABERTA\" ? Date.now() : p.fim, min = Math.round((fim - p.inicio) / 60000);",
        "        return {c: [cod(\"P-\", p.id), esc(p.posto), esc(rot(p.categoria).toLowerCase()), esc(p.motivo) + (p.solucao ? \"<br><small style='color:var(--muted)'>\" + esc(p.solucao) + \"</small>\" : \"\"), dataHora(p.inicio), dur(min), tag(p.status),",
        "          p.status === \"ABERTA\" ? \"<div style='display:flex;gap:6px'><input id='sol\" + p.id + \"' style='width:140px' placeholder='solução'><button class='mini ok' onclick='encerrar(\" + p.id + \")'>Encerrar</button></div>\" : \"\"],",
        "          d: [\"P-\" + String(p.id).padStart(3, \"0\"), p.posto, rot(p.categoria).toLowerCase(), p.motivo, p.solucao || \"\", dataHora(p.inicio), min, rot(p.status).toLowerCase()], estado: p.status, cls: \"e-\" + classe(p.status)};",
        "      }), {vazio: \"Nenhuma parada registrada.\", estados: [[\"ABERTA\", \"aberta\"], [\"ENCERRADA\", \"encerrada\"]], csv: [\"Parada\", \"Posto\", \"Categoria\", \"Motivo\", \"Solução\", \"Início\", \"Duração (min)\", \"Estado\"], arquivo: \"paradas\"});",
        "    });",
        "  },",
        "  qualidade: function () {",
        "    return api(\"GET\", \"/api/qualidade/ncs\").then(function (ncs) {",
        "      document.getElementById(\"ncs-c\").textContent = ncs.filter(function (n) { return n.status === \"ABERTA\"; }).length + \" abertas\";",
        "      var est = {}; ncs.forEach(function (n) { est[n.status] = 1; });",
        "      moldura(\"ncs\", [[\"NC\"], [\"OP\"], [\"Produto\"], [\"Motivo\"], [\"Origem\"], [\"Registrada\"], [\"Estado\"]],",
        "        ncs.sort(porId).map(function (n) { return {c: [cod(\"NC-\", n.id), n.op ? linkOp(n.op) : \"—\", esc(n.produto), esc(n.motivo), esc(n.origem), dataHora(n.ts), tag(n.status)],",
        "          d: [\"NC-\" + String(n.id).padStart(3, \"0\"), n.op ? \"OP-\" + String(n.op).padStart(3, \"0\") : \"\", n.produto, n.motivo, n.origem, dataHora(n.ts), rot(n.status).toLowerCase()], estado: n.status, cls: \"e-\" + classe(n.status)}; }),",
        "        {vazio: \"Nenhuma não conformidade.\", estados: Object.keys(est).sort().map(function (k) { return [k, rot(k).toLowerCase()]; }), csv: [\"NC\", \"OP\", \"Produto\", \"Motivo\", \"Origem\", \"Registrada\", \"Estado\"], arquivo: \"nao-conformidades\"});",
        "    });",
        "  },",
        "  cadastros: function () {",
        "    if (sub() === \"roteiros\" && ativos.roteiros) return telaRoteiros();",
        "    if (sub() === \"clientes\" && ativos.pedidos) return telaClientes();",
        "    var pai = document.getElementById(\"bom-produto\").value;",
        "    return (pai ? api(\"GET\", \"/api/cadastros/estrutura?produto=\" + encodeURIComponent(pai)) : Promise.resolve([])).then(function (bom) {",
        "      document.getElementById(\"produtos-c\").textContent = cache.produtos.length + \" produtos\";",
        "      moldura(\"produtos\", [[\"Código\"], [\"Descrição\"], [\"Unid.\"], [\"Tipo\"]], cache.produtos.map(function (p) {",
        "        return {c: [\"<span class='id'>\" + esc(p.codigo) + \"</span>\", esc(p.descricao), esc(p.unidade), esc(p.tipo)], d: [p.codigo, p.descricao, p.unidade, p.tipo], estado: p.tipo};",
        "      }), {estados: [[\"MP\", \"MP · matéria-prima\"], [\"SA\", \"SA · semiacabado\"], [\"PA\", \"PA · acabado\"]], todos: \"todos os tipos\", csv: [\"Código\", \"Descrição\", \"Unidade\", \"Tipo\"], arquivo: \"produtos\"});",
        "      document.getElementById(\"bom\").innerHTML = tabela([[\"Componente\"], [\"Qtd. por unidade\", 1], [\"Etapa\", 1]], bom.map(function (b) { return [esc(b.componente), num(b.quantidade, 4), b.etapa ? \"Etapa \" + b.etapa : \"Início (0)\"]; }), \"Selecione um produto com estrutura.\");",
        "      document.getElementById(\"postos-cad-c\").textContent = cache.postos.length + \" postos\";",
        "      moldura(\"postos-cad\", [[\"Código\"], [\"Descrição\"], [\"Capacidade\", 1], [\"Terminal\"]], cache.postos.map(function (p) {",
        "        return {c: [\"<span class='id'>\" + esc(p.codigo) + \"</span>\", esc(p.descricao), num(p.capacidade_h, 1) + \" h/dia\", linkTerminal(p.codigo)], d: [p.codigo, p.descricao, Number(p.capacidade_h)]};",
        "      }), {csv: [\"Código\", \"Descrição\", \"Capacidade (h/dia)\"], arquivo: \"postos\"});",
        "    });",
        "  },",
        "  eventos: function () {",
        "    return api(\"GET\", \"/api/sistema/eventos?n=100\").then(function (evs) { document.getElementById(\"eventos\").innerHTML = eventos(evs); });",
        "  },",
        "  modulos: function () {",
        "    return api(\"GET\", \"/api/sistema/modulos\").then(function (ms) {",
        "      document.getElementById(\"modulos\").innerHTML = tabela([[\"Módulo\"], [\"Nome\"], [\"Versão\"], [\"Prefixo\"], [\"Assina\"], [\"Estado\"]],",
        "        ms.map(function (m) { return [\"<span class='id'>\" + esc(m.id) + \"</span>\", esc(m.nome), esc(m.versao), \"<code>\" + esc(m.prefixo) + \"</code>\", esc((m.assina || []).join(\", \") || \"—\"), tag(m.estado)]; }));",
        "    });",
        "  }",
        "};",
        "",
        "window.liberar = function (id) { acao(\"POST\", \"/api/producao/liberar?id=\" + id, null, \"OP \" + id + \" liberada.\"); };",
        "window.cancelar = function (id) { acao(\"POST\", \"/api/producao/cancelar?id=\" + id, null, \"OP \" + id + \" cancelada.\"); };",
        "window.apontar = function (id) { acao(\"POST\", \"/api/producao/apontar?id=\" + id, {boa: document.getElementById(\"b\" + id).value || \"0\", refugo: document.getElementById(\"r\" + id).value || \"0\"}, \"Apontamento registrado na OP \" + id + \".\"); };",
        "window.encerrar = function (id) { acao(\"POST\", \"/api/manutencao/encerrar?id=\" + id, {solucao: document.getElementById(\"sol\" + id).value}, \"Parada \" + id + \" encerrada.\"); };",
        "",
        "ligarForm(\"f-op\", \"POST\", \"/api/producao/ordens\", \"OP criada.\");",
        "ligarForm(\"f-entrada\", \"POST\", \"/api/estoque/entrada\", \"Entrada registrada.\");",
        "ligarForm(\"f-ajuste\", \"POST\", \"/api/estoque/ajuste\", \"Inventário ajustado.\");",
        "ligarForm(\"f-transferir\", \"POST\", \"/api/estoque/transferir\", \"Transferência registrada.\");",
        "ligarForm(\"f-endereco\", \"POST\", \"/api/estoque/enderecos\", \"Endereço salvo.\");",
        "ligarForm(\"f-reposicao\", \"POST\", \"/api/estoque/reposicao\", \"Regra de reposição salva.\");",
        "ligarForm(\"f-cliente\", \"POST\", \"/api/pedidos/clientes\", \"Cliente salvo.\");",
        "itensIniciais();",
        "ligarForm(\"f-parada\", \"POST\", \"/api/manutencao/paradas\", \"Parada aberta.\");",
        "ligarForm(\"f-nc\", \"POST\", \"/api/qualidade/ncs\", \"Não conformidade registrada.\");",
        "ligarForm(\"f-produto\", \"POST\", \"/api/cadastros/produtos\", \"Produto salvo.\");",
        "ligarForm(\"f-posto\", \"POST\", \"/api/cadastros/postos\", \"Posto salvo.\");",
        "ligarForm(\"f-bom\", \"POST\", \"/api/cadastros/estrutura\", \"Componente incluído.\");",
        "document.getElementById(\"bom-produto\").onchange = function () { telas.cadastros(); };",
        "ligarForm(\"f-operacao\", \"POST\", \"/api/roteiros/operacoes\", \"Operação salva.\");",
        "ligarForm(\"f-capacidade\", \"POST\", \"/api/roteiros/capacidade\", \"Capacidade salva.\");",
        "// Etapa do roteiro: mantém o produto escolhido depois de salvar.",
        "document.getElementById(\"f-etapa\").onsubmit = function (ev) {",
        "  ev.preventDefault();",
        "  var f = ev.target, dados = Object.fromEntries(new FormData(f).entries());",
        "  acao(\"POST\", \"/api/roteiros/etapa\", dados, \"Etapa \" + dados.numero + \" salva no roteiro de \" + dados.produto + \".\").then(function (r) {",
        "    if (r) [\"numero\", \"tempo_min\", \"instrucao\"].forEach(function (c) { f[c].value = \"\"; });",
        "  });",
        "};",
        "document.getElementById(\"rot-produto\").onchange = function () { location.hash = \"#cadastros/roteiros/\" + encodeURIComponent(this.value); };",
        "",
        "document.getElementById(\"btn-sino\").onclick = function () { location.hash = ativos.manutencao ? \"#manutencao\" : \"#geral\"; };",
        "document.getElementById(\"btn-atualizar\").onclick = function () { carregar().then(function () { toast(\"Atualizado.\"); }); };",
        "document.getElementById(\"btn-novo\").onclick = function () {",
        "  var f = Array.prototype.filter.call(document.querySelectorAll(\".secao.ativa form\"), function (x) { return x.offsetParent !== null; })[0]; if (!f) return;",
        "  var card = f.closest(\".card\");",
        "  card.scrollIntoView({behavior: \"smooth\", block: \"center\"});",
        "  card.classList.remove(\"destaque\"); void card.offsetWidth; card.classList.add(\"destaque\");",
        "  var c = f.querySelector(\"input,select\"); if (c) c.focus({preventScroll: true});",
        "};",
        "function relogio() { document.getElementById(\"relogio\").textContent = \"AO VIVO \" + new Date().toLocaleTimeString(\"pt-BR\"); }",
        "setInterval(relogio, 1000); relogio();",
        "",
        "function secaoAtual() { var s = (location.hash || \"#inicio\").slice(1).split(\"/\")[0]; return telas[s] ? s : \"inicio\"; }",
        "function parte(i) { return decodeURIComponent((location.hash || \"\").slice(1).split(\"/\")[i] || \"\"); }",
        "function sub() { return parte(1); }",
        "function mostrar() {",
        "  var s = secaoAtual(), sb = sub();",
        "  document.querySelectorAll(\".secao\").forEach(function (el) { el.classList.toggle(\"ativa\", el.id === \"s-\" + s); });",
        "  document.querySelectorAll(\"#nav a\").forEach(function (a) { a.classList.toggle(\"ativo\", a.dataset.sec === s); });",
        "  var t = TITULOS[s], titulo = t[0], trilha = [esc(TITULOS[s][0])];",
        "  var det = s === \"ordens\" && !!sb, dp = s === \"pedidos\" && !!sb;",
        "  var cad = s === \"cadastros\" ? (sb === \"roteiros\" || sb === \"clientes\" ? sb : \"base\") : \"\";",
        "  var est = s === \"estoque\" ? ([\"posicoes\", \"reposicao\", \"produto\"].indexOf(sb) >= 0 ? sb : \"saldos\") : \"\";",
        "  if (det) { t = TITULOS.ordem; titulo = \"OP-\" + sb.padStart(3, \"0\"); }",
        "  if (dp) { t = TITULOS.pedido; titulo = \"PED-\" + sb.padStart(3, \"0\"); }",
        "  if (cad && cad !== \"base\") { t = TITULOS[cad]; titulo = t[0]; }",
        "  if (est && est !== \"saldos\") { t = TITULOS[est === \"produto\" ? \"estoque_produto\" : est]; titulo = est === \"produto\" ? parte(2) : t[0]; }",
        "  if (titulo !== TITULOS[s][0]) trilha.push(esc(titulo));",
        "  document.getElementById(\"titulo\").textContent = titulo;",
        "  document.getElementById(\"subtitulo\").textContent = t[1];",
        "  document.getElementById(\"crumb\").innerHTML = \"EMP<i>/</i>\" + trilha.join(\"<i>/</i>\");",
        "  document.getElementById(\"op-detalhe\").classList.toggle(\"oculto\", !det);",
        "  document.querySelectorAll(\"#s-ordens .so-lista\").forEach(function (c) { c.classList.toggle(\"oculto\", det); });",
        "  if (s === \"ordens\" && !det) document.getElementById(\"op-detalhe\").innerHTML = \"\";",
        "  document.getElementById(\"ped-detalhe\").classList.toggle(\"oculto\", !dp);",
        "  document.querySelectorAll(\"#s-pedidos .so-lista\").forEach(function (c) { c.classList.toggle(\"oculto\", dp); });",
        "  if (s === \"pedidos\" && !dp) document.getElementById(\"ped-detalhe\").innerHTML = \"\";",
        "  if (cad) mostrarAba(\"#s-cadastros\", cad);",
        "  if (est) mostrarAba(\"#s-estoque\", est === \"produto\" ? \"\" : est);",
        "  document.querySelector(\"#s-estoque .abas\").classList.toggle(\"oculto\", est === \"produto\");",
        "  document.getElementById(\"est-produto\").classList.toggle(\"oculto\", est !== \"produto\");",
        "  if (est !== \"produto\") document.getElementById(\"est-produto\").innerHTML = \"\";",
        "  document.querySelectorAll(\"#s-oee .janela a\").forEach(function (a) { a.classList.toggle(\"ativo\", a.dataset.janela === String(janelaOee())); });",
        "  var temForm = Array.prototype.some.call(document.querySelectorAll(\"#s-\" + s + \" form\"), function (f) { return f.offsetParent !== null; });",
        "  document.getElementById(\"btn-novo\").classList.toggle(\"oculto\", det || dp || !temForm);",
        "}",
        "function carregar() {",
        "  return Promise.all([",
        "    tenta(api(\"GET\", \"/api/sistema/modulos\"), null), tenta(api(\"GET\", \"/api/sistema/sessao\"), null),",
        "    tenta(api(\"GET\", \"/api/sistema/saude\"), null), tenta(api(\"GET\", \"/api/cadastros/produtos\"), []), tenta(api(\"GET\", \"/api/cadastros/postos\"), [])",
        "  ]).then(function (r) {",
        "    if (!r[0]) { document.getElementById(\"sessao\").textContent = \"sem acesso\"; tk.focus(); return; }",
        "    ativos = {}; r[0].forEach(function (m) { if (m.estado === \"ativo\") ativos[m.id] = true; });",
        "    document.querySelectorAll(\"[data-mod]\").forEach(function (a) { a.classList.toggle(\"oculto\", !ativos[a.dataset.mod]); });",
        "    sessao = r[1];",
        "    if (r[1]) {",
        "      document.getElementById(\"sessao\").textContent = r[1].usuario + \" · \" + r[1].perfil + (r[1].modo_aberto ? \" · dev\" : \"\");",
        "      document.getElementById(\"avatar\").textContent = String(r[1].usuario || \"?\").slice(0, 2).toUpperCase();",
        "    }",
        "    if (r[2]) document.getElementById(\"versao\").textContent = \"v\" + r[2].versao + \" · \" + r[2].modulos + \" módulos\";",
        "    cache.produtos = r[3]; cache.postos = r[4];",
        "    preencherSelects();",
        "    Promise.all([",
        "      ativos.manutencao ? tenta(api(\"GET\", \"/api/manutencao/indicadores\"), null) : Promise.resolve(null),",
        "      ativos.qualidade ? tenta(api(\"GET\", \"/api/qualidade/ncs\"), []) : Promise.resolve([]),",
        "      ativos.pedidos ? tenta(api(\"GET\", \"/api/pedidos/pedidos\"), []) : Promise.resolve([]),",
        "      ativos.estoque ? tenta(api(\"GET\", \"/api/estoque/sugestoes\"), []) : Promise.resolve([]),",
        "      ativos.mrp ? tenta(api(\"GET\", \"/api/mrp/plano\"), []) : Promise.resolve([]),",
        "      ativos.programacao ? tenta(api(\"GET\", \"/api/programacao/capacidade\"), []) : Promise.resolve([])",
        "    ]).then(function (a) {",
        "      var pm = a[0] ? a[0].paradas_abertas : 0, nc = a[1].filter(function (x) { return x.status === \"ABERTA\"; }).length;",
        "      var pa = (a[2] || []).filter(function (p) { return p.atrasado; }).length, sg = (a[3] || []).length;",
        "      var mrpFalta = (a[4] || []).filter(function (x) { return x.necessidade_liquida > 0; }).length;",
        "      var sc = (a[5] || []).filter(function (x) { return x.ocupacao_pct > 100; }).length;",
        "      document.getElementById(\"qt-man\").textContent = pm ? String(pm) : \"\";",
        "      document.getElementById(\"qt-ncs\").textContent = nc ? String(nc) : \"\";",
        "      document.getElementById(\"qt-ped\").textContent = pa ? String(pa) : \"\";",
        "      document.getElementById(\"qt-ped\").title = pa ? pa + \" pedido(s) atrasado(s)\" : \"\";",
        "      var elMrp = document.getElementById(\"qt-mrp\"); if (elMrp) { elMrp.textContent = mrpFalta ? String(mrpFalta) : \"\"; elMrp.title = mrpFalta ? mrpFalta + \" item(ns) com necessidade líquida\" : \"\"; }",
        "      var elProg = document.getElementById(\"qt-prog\"); if (elProg) { elProg.textContent = sc ? String(sc) : \"\"; elProg.title = sc ? sc + \" posto(s) sobrecarregado(s)\" : \"\"; }",
        "      document.getElementById(\"qt-sug\").textContent = sg ? String(sg) : \"\";",
        "      document.getElementById(\"qt-sug\").title = sg ? sg + \" produto(s) abaixo do mínimo\" : \"\";",
        "      document.getElementById(\"qt-sug-aba\").textContent = sg ? String(sg) : \"\";",
        "      document.getElementById(\"alertas\").textContent = pm + nc + pa + sc ? String(pm + nc + pa + sc) : \"\";",
        "      document.getElementById(\"btn-sino\").title = pm + nc + pa + sc ? (pm + nc + pa + sc) + \" alerta(s): paradas, NCs abertas, pedidos atrasados e sobrecargas\" : \"Sem alertas\";",
        "    });",
        "    // Clientes e endereços entram nos selects antes de a tela desenhar.",
        "    return Promise.all([",
        "      ativos.pedidos ? tenta(api(\"GET\", \"/api/pedidos/clientes\"), []) : Promise.resolve([]),",
        "      ativos.estoque ? tenta(api(\"GET\", \"/api/estoque/enderecos\"), []) : Promise.resolve([])",
        "    ]).then(function (x) {",
        "      cache.clientes = x[0] || []; cache.enderecos = x[1] || [];",
        "      preencherSelects();",
        "      var s = secaoAtual();",
        "      return telas[s]().catch(function (e) { toast(e.message, true); });",
        "    });",
        "  });",
        "}",
        "window.onhashchange = function () { mostrar(); carregar(); window.scrollTo(0, 0); };",
        "mostrar();",
        "carregar();",
        "// Não redesenha enquanto o usuário digita: nem com campo focado, nem com",
        "// um campo de tabela (apontamento, solução) já preenchido e ainda não enviado.",
        "function digitando() {",
        "  if (document.querySelector(\"input:focus,select:focus\")) return true;",
        "  return Array.prototype.some.call(document.querySelectorAll(\".secao.ativa td input,.secao.ativa .fluxo input\"), function (i) { return i.value !== \"\"; });",
        "}",
        "setInterval(function () { if (!digitando()) carregar(); }, 6000);",
        "</script>",
        "</body>",
        "</html>"
    ];
}

pub fn pagina() -> string ={
    return join(_linhas(), "\n");
}
