// ============================================================
//  main.cryo — EMP: servidor de gestão de linha de produção
//
//  Inicialização:
//    1. lê a configuração (variáveis de ambiente)
//    2. registra os módulos internos (modulos/catalogo.cryo)
//    3. descobre os módulos externos (plugins/*.json)
//    4. inicia tudo em ordem de dependência
//    5. laço: aceita -> autentica -> despacha -> responde -> drena eventos
//
//  Configuração:
//    ERP_PORTA      (8080)
//    ERP_DADOS      (dados)       diretório de dados
//    ERP_PLUGINS    (plugins)     diretório de manifestos de plugins
//    ERP_TOKENS     ("")          "token:usuario:perfil,..." — vazio = modo dev
//
//  Build Windows (executável único, sem VM nem Python em runtime):
//    python Burnout/pyro.py build src/main.cryo -o build/emp.exe
// ============================================================

import "nucleo/contrato.cryo"  as k;
import "nucleo/registro.cryo"  as reg;
import "nucleo/eventos.cryo"   as ev;
import "nucleo/seguranca.cryo" as seg;
import "nucleo/auditoria.cryo" as audit;
import "nucleo/plugins.cryo"   as plugins;
import "nucleo/painel.cryo"    as painel;
import "nucleo/terminal.cryo"  as terminal;
import "modulos/catalogo.cryo" as catalogo;

const string VERSAO = "0.2.0";

fn cfg(string nome, string padrao) -> string ={
    string v = env(nome);
    if (len(v) == 0) { return padrao; }
    return v;
}

// ── rotas do próprio núcleo (/api/sistema) ────────────────

fn sistema(string path, k::Requisicao r) -> k::Resposta ={
    if (path == "/api/sistema/saude") {
        return k::ok("{\"status\":\"ok\",\"versao\":" + json_encode(VERSAO)
            + ",\"modulos\":" + to_string(reg::total())
            + ",\"eventos_publicados\":" + to_string(ev::total_publicados()) + "}");
    }
    if (path == "/api/sistema/modulos") {
        return k::ok(reg::listar_json());
    }
    if (path == "/api/sistema/eventos") {
        int n = parse_int(k::param(r, "n")) ?? 30;
        return k::ok(ev::recentes_json(clamp(n, 1, 100)));
    }
    if (path == "/api/sistema/sessao") {
        return k::ok("{\"usuario\":" + json_encode(r.usuario)
            + ",\"perfil\":" + json_encode(r.perfil)
            + ",\"modo_aberto\":" + to_string(seg::modo_aberto()) + "}");
    }
    return k::nao_encontrado();
}

fn html(string corpo) -> k::Resposta ={
    return k::Resposta { status: 200, tipo: "text/html; charset=utf-8", corpo: corpo };
}

fn atender(map<string,string> req) -> k::Resposta ={
    string path = req["path"];
    // As páginas não exigem token; a API que elas chamam, sim.
    if (path == "/" && req["method"] == "GET") {
        return html(painel::pagina());
    }
    if (path == "/terminal" && req["method"] == "GET") {
        return html(terminal::pagina());
    }
    string quem = seg::identificar(req);
    if (len(quem) == 0) {
        return k::erro(401, "não autenticado");
    }
    string[] up = split(quem, ":");
    k::Requisicao r = k::Requisicao {
        metodo: req["method"], rota: "", query: req["query"],
        corpo: req["body"], usuario: up[0], perfil: up[1]
    };
    if (starts_with(path, "/api/sistema/")) {
        return sistema(path, r);
    }
    k::Resposta resp = reg::despachar(path, r);
    if (!k::eh_leitura(r) && resp.status < 300) {
        audit::registrar(r.usuario, r.metodo + " " + path, r.query);
    }
    return resp;
}

// ── inicialização ─────────────────────────────────────────

int porta = parse_int(cfg("ERP_PORTA", "8080")) ?? 8080;
string dir_dados = cfg("ERP_DADOS", "dados");
string dir_plugins = cfg("ERP_PLUGINS", "plugins");

if (!is_dir(dir_dados)) { make_dir(dir_dados); }
audit::abrir(dir_dados + "/auditoria", 20);
int n_tokens = seg::configurar(env("ERP_TOKENS"));

print("EMP " + VERSAO);
for (k::Modulo m in catalogo::todos()) {
    string falha = reg::registrar(m);
    if (len(falha) > 0) { print("  [recusado] " + falha); }
}
for (k::Modulo m in plugins::descobrir(dir_plugins)) {
    string falha = reg::registrar(m);
    if (len(falha) > 0) { print("  [plugin recusado] " + falha); }
}
int ativos = reg::iniciar_todos(dir_dados);
// Entrega já o que os módulos publicaram ao iniciar (ex.: manutenção
// reanuncia paradas abertas), antes da primeira requisição.
reg::drenar_eventos(1000);
print("  módulos ativos: " + to_string(ativos) + " de " + to_string(reg::total()));
if (seg::modo_aberto()) {
    print("  ATENÇÃO: ERP_TOKENS vazio — modo desenvolvimento, sem autenticação");
} else {
    print("  usuários configurados: " + to_string(n_tokens));
}

if (!http_listen(porta)) {
    print("não foi possível abrir a porta " + to_string(porta));
} else {
    // 127.0.0.1, não "localhost": o servidor nativo só escuta IPv4 e o
    // Windows tenta ::1 primeiro — ~200 ms a mais por conexão (L-22).
    print("  ouvindo em http://127.0.0.1:" + to_string(porta) + "  (painel em /, terminal em /terminal)");
    while (true) {
        map<string,string> req = http_accept();
        if (len(req["method"]) > 0) {
            k::Resposta resp = atender(req);
            http_respond(resp.status, resp.tipo, resp.corpo);
            reg::drenar_eventos(1000);
        }
    }
}
