    return join([
        "<footer class=\"footer\">",
        "  <div class=\"footer-wrap\">",
        "    <div style=\"font-family:var(--f-display);font-size:22px;color:#fff;font-weight:700\">EMP · Engineering Modular Process</div>",
        "    <p>ERP e MES Industrial Modular Desenvolvido 100% em Cryo · Compilação Nativa AOT MinGW GCC</p>",
        "    <div class=\"footer-links\">",
        "      <a href=\"#inicio\">Início</a>",
        "      <a href=\"#terminal\">Terminal do Agente</a>",
        "      <a href=\"#fases\">10 Fases Modulares</a>",
        "      <a href=\"#arquitetura\">Arquitetura</a>",
        "      <a href=\"/api/saude\" target=\"_blank\">Verificar /api/saude</a>",
        "      <a href=\"http://127.0.0.1:8080\" target=\"_blank\">Painel Fabril (8080)</a>",
        "    </div>",
        "    <div class=\"footer-copy\">EMP Industrial v0.2.0 · Executável nativo Windows · 101 Testes Automatizados</div>",
        "  </div>",
        "</footer>"
    ], "\n");
}

fn _js() -> string ={
    return join([
        "<script>",
        "(function(){",
        "  var form = document.getElementById('form-prompt');",
        "  var input = document.getElementById('prompt-input');",
        "  var btnEnviar = document.getElementById('btn-enviar');",
        "  var btnLimpar = document.getElementById('btn-limpar');",
        "  var screen = document.getElementById('terminal-screen');",
        "  var pills = document.querySelectorAll('.quick-pill');",
        "",
        "  function horaAtual(){",
        "    var d = new Date();",
        "    return ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'+('0'+d.getSeconds()).slice(-2);",
        "  }",
        "",
        "  function escaparHtml(t){",
        "    var d = document.createElement('div');",
        "    d.textContent = t;",
        "    return d.innerHTML;",
        "  }",
        "",
        "  function formatarResposta(cmd, data, modoSimulado){",
        "    var wrap = document.createElement('div');",
        "    wrap.className = 'term-entry';",
        "    var statusTag = data.status === 'ok' ? '<span class=\"term-badge tb-ok\">STATUS: OK</span>' : '<span class=\"term-badge tb-act\">STATUS: ALERTA</span>';",
        "    var acaoTag = data.acao ? '<span class=\"term-badge tb-act\">' + escaparHtml(data.acao) + '</span>' : '';",
        "    var badgeSim = modoSimulado ? '<span class=\"term-badge\" style=\"background:#33260c;color:#f2b448;border:1px solid #e08a00\">MODO ESTÁTICO</span>' : '';",
        "",
        "    var gridHtml = '';",
        "    if(data.dados && typeof data.dados === 'object'){",
        "      gridHtml = '<div class=\"term-grid\">';",
        "      for(var k in data.dados){",
        "        var v = data.dados[k];",
        "        var vStr = typeof v === 'object' ? JSON.stringify(v) : String(v);",
        "        gridHtml += '<div class=\"term-metric\"><div class=\"tm-lbl\">' + escaparHtml(k.replace(/_/g,' ')) + '</div><div class=\"tm-val\">' + escaparHtml(vStr) + '</div></div>';",
        "      }",
        "      gridHtml += '</div>';",
        "    }",
        "",
        "    wrap.innerHTML = '<div class=\"term-cmd-line\">[' + horaAtual() + '] &gt; <b>' + escaparHtml(cmd) + '</b> ' + badgeSim + '</div>' +",
        "      '<div class=\"term-card\">' +",
        "      '  <div class=\"term-header\">' + statusTag + acaoTag + '</div>' +",
        "      '  <div class=\"term-msg\">' + escaparHtml(data.mensagem || 'Comando processado com sucesso.') + '</div>' +",
        "      gridHtml +",
        "      '</div>';",
        "    screen.appendChild(wrap);",
        "    screen.scrollTop = screen.scrollHeight;",
        "  }",
        "",
        "  function fallbackLocal(cmd){",
        "    var c = cmd.toLowerCase().trim();",
        "    if(c.indexOf('status') >= 0 || c.indexOf('fabrica') >= 0 || c.indexOf('fábrica') >= 0){",
        "      return { status:'ok', acao:'CONSULTA_STATUS_FABRICA', mensagem:'Operação fabril em ritmo nominal. 6 postos ativos em produção, 1 em manutenção preventiva. OEE consolidado da linha em 88.4%.', dados:{ postos_ativos:6, postos_parados:1, oee_linha_pct:88.4, disponibilidade_pct:94.2, desempenho_pct:95.1, qualidade_pct:98.7, turno_vigente:'T1 - Manhã' } };",
        "    }",
        "    if(c.indexOf('otif') >= 0 || c.indexOf('kpi') >= 0){",
        "      return { status:'ok', acao:'CONSULTA_OTIF_KPIS', mensagem:'Índice OTIF consolidado em 92.8% (superando meta de 85.0%). Refugo global controlado em 1.4% (teto: 5.0%).', dados:{ otif_pct:92.8, meta_otif_pct:85.0, pedidos_avaliados:48, pedidos_no_prazo:45, refugo_global_pct:1.4, teto_refugo_pct:5.0, custo_perdas_mes_brl:1420.50 } };",
        "    }",
        "    if(c.indexOf('arquiv') >= 0 || c.indexOf('tblfin') >= 0){",
        "      return { status:'ok', acao:'EXPURGO_HISTORICO_TBLFIN', mensagem:'Rotina de arquivamento executada (Fase 10): 14 ordens concluídas congeladas em tblFinOrder e tblFinStep. Memória operacional liberada e latência de queries acelerada em 64%.', dados:{ ops_arquivadas:14, etapas_congeladas:42, colecao_ordens:'tblFinOrder', colecao_etapas:'tblFinStep', politica_retencao_dias:30, reversibilidade:'TOTAL' } };",
        "    }",
        "    if(c.indexOf('sensor') >= 0 || c.indexOf('iot') >= 0 || c.indexOf('telemetria') >= 0){",
        "      return { status:'ok', acao:'TELEMETRIA_IOT_CHAO_FABRICA', mensagem:'Telemetria IoT em tempo real (Fase 9): Todos os sensores operando dentro dos parâmetros de segurança. Intertravamento armado e seguro.', dados:{ prensa_01_temp_c:64.2, prensa_01_pressao_bar:142.8, solda_02_temp_c:185.0, torno_cnc_vibracao_mm_s:1.1, intertravamento:'ARMADO_SEGURO', pulsos_clp_hoje:12850 } };",
        "    }",
        "    if(c.indexOf('turno') >= 0 || c.indexOf('operador') >= 0){",
        "      return { status:'ok', acao:'CONSULTA_TURNOS_OPERADORES', mensagem:'Turno T1 (06:00 - 14:00) ativo com 12 operadores alocados nos postos de trabalho. Eficiência média de 96.2% e qualidade em 99.1%.', dados:{ turno_ativo:'T1', jornada:'06:00 - 14:00', operadores_alocados:12, eficiencia_media_pct:96.2, qualidade_media_pct:99.1, destaque:'Carlos Silva (OP-104 - 99.8% ef.)' } };",
        "    }",
        "    return { status:'ok', acao:'LISTAR_COMANDOS', mensagem:'Agente Industrial EMP pronto para atendimento. Use os atalhos rápidos ou consulte as 10 fases modulares.', dados:{ comandos:['status fábrica','otif e kpis','arquivar ops','sensores iot','turnos e operadores','ajuda'], fases_suportadas:10 } };",
        "  }",
        "",
        "  function enviarPrompt(cmd){",
        "    if(!cmd || !cmd.trim()) return;",
        "    cmd = cmd.trim();",
        "    btnEnviar.disabled = true;",
        "    btnEnviar.textContent = 'Processando...';",
        "",
        "    fetch('/api/prompt', {",
        "      method: 'POST',",
        "      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },",
        "      body: 'prompt=' + encodeURIComponent(cmd)",
        "    })",
        "    .then(function(res){",
        "      if(!res.ok) throw new Error('HTTP ' + res.status);",
        "      return res.json();",
        "    })",
        "    .then(function(data){",
        "      formatarResposta(cmd, data, false);",
        "    })",
        "    .catch(function(err){",
        "      console.warn('API /api/prompt offline ou falha:', err);",
        "      var fallback = fallbackLocal(cmd);",
        "      formatarResposta(cmd, fallback, true);",
        "    })",
        "    .finally(function(){",
        "      btnEnviar.disabled = false;",
        "      btnEnviar.textContent = '⚡ Executar Prompt';",
        "      input.value = '';",
        "      input.focus();",
        "    });",
        "  }",
        "",
        "  btnEnviar.addEventListener('click', function(){",
        "    enviarPrompt(input.value);",
        "  });",
        "",
        "  input.addEventListener('keydown', function(e){",
        "    if(e.key === 'Enter'){",
        "      e.preventDefault();",
        "      enviarPrompt(input.value);",
        "    }",
        "  });",
        "",
        "  btnLimpar.addEventListener('click', function(){",
        "    screen.innerHTML = '<div class=\"term-entry\"><div class=\"term-cmd-line\">[SISTEMA] <b>Console reinicializado</b></div><div class=\"term-card\"><div class=\"term-header\"><span class=\"term-badge tb-ok\">PRONTO</span></div><div class=\"term-msg\">Console limpo. Digite um comando ou clique em uma das pills acima.</div></div></div>';",
        "    input.focus();",
        "  });",
        "",
        "  for(var i=0; i<pills.length; i++){",
        "    pills[i].addEventListener('click', function(){",
        "      var c = this.getAttribute('data-cmd');",
        "      input.value = c;",
        "      enviarPrompt(c);",
        "    });",
        "  }",
        "})();",
        "</script>"
    ], "\n");
}

pub fn pagina_html() -> string ={
    return "<!doctype html>\n<html lang=\"pt-br\">\n<head>\n"
        + "  <meta charset=\"utf-8\">\n"
        + "  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n"
        + "  <title>EMP Industrial ERP · Manufatura Modular Nativa em Cryo</title>\n"
        + "  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n"
        + "  <link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n"
        + _css()
        + "</head>\n<body>\n"
        + _nav()
        + "<main>\n"
        + _hero()
        + _terminal()
        + _fases()
        + _arquitetura()
        + "</main>\n"
        + _footer()
        + _js()
        + "\n</body>\n</html>";
}

// ── inicializacao e laco do servidor ──

int porta = parse_int(cfg("ERP_LANDING_PORT", "8088")) ?? 8088;

if (!is_dir("build")) {
    make_dir("build");
}

string conteudo_html = pagina_html();
bool ok_escrita = write_file("build/landing.html", conteudo_html);

if (ok_escrita) {
    print("[EMP Landing] Pagina estatica salva em build/landing.html (" + to_string(len(conteudo_html)) + " bytes)");
} else {
    print("[EMP Landing] AVISO: Nao foi possivel escrever build/landing.html");
}

if (cfg("ERP_STATIC_ONLY", "0") == "1") {
    print("[EMP Landing] ERP_STATIC_ONLY=1: finalizando sem iniciar servidor HTTP.");
} else {
    if (!http_listen(porta)) {
        print("[EMP Landing] ERRO: Falha ao abrir porta " + to_string(porta));
    } else {
        print("[EMP Landing] Servidor HTTP ativo em http://127.0.0.1:" + to_string(porta));
        print("  Rotas disponiveis:");
        print("    GET  /            -> Landing Page completa Forja");
        print("    GET  /api/saude   -> Estado do servidor em JSON");
        print("    POST /api/prompt  -> Endpoint de prompt do agente");
        print("  Aguardando requisicoes (Ctrl+C para encerrar)...");

        while (true) {
            map<string,string> req = http_accept();
            string m = req["method"];
            if (len(m) == 0) { continue; }
            string p = req["path"];

            if (m == "OPTIONS") {
                http_respond(204, "text/plain", "");
            } else if ((p == "/" || p == "/landing.html" || p == "/index.html") && m == "GET") {
                http_respond(200, "text/html; charset=utf-8", conteudo_html);
            } else if (p == "/api/saude" && (m == "GET" || m == "HEAD")) {
                http_respond(200, "application/json; charset=utf-8", responder_saude(porta));
            } else if (p == "/api/prompt") {
                string prompt_recebido = extrair_prompt(req);
                string resposta_json = interpretar_prompt(prompt_recebido);
                http_respond(200, "application/json; charset=utf-8", resposta_json);
            } else {
                http_respond(404, "application/json; charset=utf-8", "{\"status\":\"erro\",\"mensagem\":\"Rota nao encontrada\"}");
            }
        }
    }
}
