fn _terminal() -> string ={
    return join([
        "<section class=\"section-wrap\" id=\"terminal\">",
        "  <div class=\"sec-header\">",
        "    <div class=\"sec-tag\">Terminal Cognitivo · Endpoint POST /api/prompt</div>",
        "    <h2 class=\"sec-title\">Prompt do Agente Especialista EMP</h2>",
        "    <p class=\"sec-sub\">Interaja diretamente com o núcleo operacional. Clique nos atalhos rápidos abaixo ou digite instruções livres para consultar KPIs, disparar arquivamento ou inspecionar telemetria.</p>",
        "  </div>",
        "  <div class=\"terminal-box\">",
        "    <div class=\"terminal-top\">",
        "      <div class=\"terminal-dots\">",
        "        <span class=\"t-dot t-red\"></span><span class=\"t-dot t-yel\"></span><span class=\"t-dot t-grn\"></span>",
        "      </div>",
        "      <div class=\"terminal-title\">EMP INDUSTRIAL AGENT · DISPATCHER v0.2.0 · POST /api/prompt</div>",
        "      <div class=\"terminal-pill\"><span class=\"dot-live\" style=\"width:6px;height:6px\"></span>ONLINE · 8088</div>",
        "    </div>",
        "    <div class=\"pills-bar\">",
        "      <span class=\"pills-label\">Atalhos Rápidos:</span>",
        "      <button class=\"quick-pill\" data-cmd=\"status fábrica\">🏭 status fábrica</button>",
        "      <button class=\"quick-pill\" data-cmd=\"otif e kpis\">📊 otif e kpis</button>",
        "      <button class=\"quick-pill\" data-cmd=\"arquivar ops\">🗄️ arquivar ops</button>",
        "      <button class=\"quick-pill\" data-cmd=\"sensores iot\">⚡ sensores iot</button>",
        "      <button class=\"quick-pill\" data-cmd=\"turnos e operadores\">👥 turnos e operadores</button>",
        "      <button class=\"quick-pill\" data-cmd=\"ajuda\">❓ ajuda</button>",
        "    </div>",
        "    <div class=\"prompt-form-wrap\">",
        "      <form class=\"prompt-form\" id=\"form-prompt\" onsubmit=\"return false;\">",
        "        <div class=\"prompt-input-group\">",
        "          <span class=\"prompt-prefix\">&gt;</span>",
        "          <input type=\"text\" id=\"prompt-input\" class=\"prompt-input\" placeholder=\"Digite um comando ou clique nas pills acima (ex: 'status fábrica', 'arquivar ops')...\" autocomplete=\"off\">",
        "        </div>",
        "        <button type=\"button\" id=\"btn-enviar\" class=\"btn-prompt\">⚡ Executar Prompt</button>",
        "        <button type=\"button\" id=\"btn-limpar\" class=\"btn-clear\">Limpar</button>",
        "      </form>",
        "    </div>",
        "    <div class=\"terminal-screen\" id=\"terminal-screen\">",
        "      <div class=\"term-entry\">",
        "        <div class=\"term-cmd-line\">[SISTEMA] <b>EMP Agent Daemon v0.2.0 conectado</b></div>",
        "        <div class=\"term-card\">",
        "          <div class=\"term-header\">",
        "            <span class=\"term-badge tb-ok\">STATUS: OK</span>",
        "            <span class=\"term-badge tb-act\">INICIALIZADO</span>",
        "          </div>",
        "          <div class=\"term-msg\">Agente industrial nativo ativo. Barramento de eventos assíncrono pub/sub monitorando 10 fases modulares. Envie um comando para iniciar.</div>",
        "        </div>",
        "      </div>",
        "    </div>",
        "  </div>",
        "</section>"
    ], "\n");
}

fn _fases() -> string ={
    return join([
        "<section class=\"section-wrap\" id=\"fases\">",
        "  <div class=\"sec-header\">",
        "    <div class=\"sec-tag\">Arquitetura MES4 &amp; FactoryViews</div>",
        "    <h2 class=\"sec-title\">As 10 Fases Modulares do ERP Industrial EMP</h2>",
        "    <p class=\"sec-sub\">Da modelagem de engenharia e OEE ao controle de lotes, IoT contínuo e fechamento permanente de ordens.</p>",
        "  </div>",
        "  <div class=\"fases-grid\">",
        "    <div class=\"fase-card\">",
        "      <div class=\"fase-card-top\"><span class=\"fase-num\">Fase 01</span><span class=\"fase-tipo\">Núcleo Interno</span></div>",
        "      <h3>Cadastros, Roteiros &amp; Produção</h3>",
        "      <p>Estrutura de produto (BOM multinível), postos de trabalho, medições com limites numéricos, concorrência otimista por versão e máquina de estados de OPs executadas por etapas.</p>",
        "      <div class=\"fase-tags\"><span class=\"fase-tag\">/api/producao</span><span class=\"fase-tag\">/api/roteiros</span><span class=\"fase-tag\">op.liberada</span></div>",
        "    </div>",
        "    <div class=\"fase-card\">",
        "      <div class=\"fase-card-top\"><span class=\"fase-num\">Fase 02</span><span class=\"fase-tipo\">Núcleo Interno</span></div>",
        "      <h3>Comercial, Estoque &amp; OEE</h3>",
        "      <p>Gestão de pedidos com prazos, cálculo automático de faltas com reserva, saldos por endereço (Almoxarifado, Linha, Expedição, Quarentena) e cálculo em tempo real de OEE.</p>",
        "      <div class=\"fase-tags\"><span class=\"fase-tag\">/api/pedidos</span><span class=\"fase-tag\">/api/estoque</span><span class=\"fase-tag\">/api/indicadores</span></div>",
        "    </div>",
        "    <div class=\"fase-card\">",
        "      <div class=\"fase-card-top\"><span class=\"fase-num\">Fase 03</span><span class=\"fase-tipo\">Núcleo &amp; Plugin</span></div>",
        "      <h3>PCP / MRP &amp; Compras</h3>",
        "      <p>Explosão de necessidades líquidas cruzando pedidos e reposição com saldo e OPs em aberto. Geração automática de OPs MRP e plugin externo autônomo de compras.</p>",
        "      <div class=\"fase-tags\"><span class=\"fase-tag\">/api/mrp</span><span class=\"fase-tag\">/api/compras</span><span class=\"fase-tag\">mrp.ordens_geradas</span></div>",
        "    </div>",
        "    <div class=\"fase-card\">",
        "      <div class=\"fase-card-top\"><span class=\"fase-num\">Fase 04</span><span class=\"fase-tipo\">Núcleo Interno</span></div>",
        "      <h3>Programação APS &amp; Backflush</h3>",
        "      <p>Sequenciamento de capacidade finita por prioridade e EDD (Earliest Due Date), identificação de postos gargalo e baixa de componentes na etapa exata de consumo.</p>",
        "      <div class=\"fase-tags\"><span class=\"fase-tag\">/api/programacao</span><span class=\"fase-tag\">programacao.sobrecarga</span></div>",
        "    </div>",
        "    <div class=\"fase-card\">",
        "      <div class=\"fase-card-top\"><span class=\"fase-num\">Fase 05</span><span class=\"fase-tipo\">Núcleo Interno</span></div>",
        "      <h3>Lotes, Genealogia &amp; Recall</h3>",
        "      <p>Rastreabilidade bidirecional total. Árvore genealógica de insumos pai-filho, controle de status (Liberado, Quarentena, Bloqueado) e rastreamento de recall até clientes.</p>",
        "      <div class=\"fase-tags\"><span class=\"fase-tag\">/api/lotes</span><span class=\"fase-tag\">lote.bloqueado</span><span class=\"fase-tag\">recall</span></div>",
        "    </div>",
        "    <div class=\"fase-card\">",
        "      <div class=\"fase-card-top\"><span class=\"fase-num\">Fase 06</span><span class=\"fase-tipo\">Núcleo Interno</span></div>",
        "      <h3>Custos &amp; Manutenção Preventiva</h3>",
        "      <p>Apropriação de custo padrão (MD + MOD/GGF) vs. custo real da OP, análise de desvio financeiro e planos de manutenção preventiva disparados por horas e ciclos de produção.</p>",
        "      <div class=\"fase-tags\"><span class=\"fase-tag\">/api/custos</span><span class=\"fase-tag\">/api/manutencao</span><span class=\"fase-tag\">custos.op_fechada</span></div>",
        "    </div>",
        "    <div class=\"fase-card\">",
        "      <div class=\"fase-card-top\"><span class=\"fase-num\">Fase 07</span><span class=\"fase-tipo\">Núcleo Interno</span></div>",
        "      <h3>Turnos &amp; Eficiência Operacional</h3>",
        "      <p>Escalas industriais (T1, T2, T3), definição de turno ativo, alocação dinâmica posto × operador e cálculo automático de taxas de eficiência e qualidade por colaborador.</p>",
        "      <div class=\"fase-tags\"><span class=\"fase-tag\">/api/turnos</span><span class=\"fase-tag\">turnos.alocacao_alterada</span></div>",
        "    </div>",
        "    <div class=\"fase-card\">",
        "      <div class=\"fase-card-top\"><span class=\"fase-num\">Fase 08</span><span class=\"fase-tipo\">Núcleo Interno</span></div>",
        "      <h3>Relatórios Executivos &amp; BI</h3>",
        "      <p>Painel analítico consolidado, indicador OTIF (On-Time In-Full) de cumprimento de prazos, ranking financeiro de perdas/refugos e exportações analíticas em CSV.</p>",
        "      <div class=\"fase-tags\"><span class=\"fase-tag\">/api/relatorios</span><span class=\"fase-tag\">relatorios.alerta_gerencial</span></div>",
        "    </div>",
        "    <div class=\"fase-card\">",
        "      <div class=\"fase-card-top\"><span class=\"fase-num\">Fase 09</span><span class=\"fase-tipo\">Núcleo Interno</span></div>",
        "      <h3>Coleta Automática &amp; IoT</h3>",
        "      <p>Contadores de pulsos de CLP, telemetria contínua de sensores analógicos (temperatura, pressão, vibração), intertravamento de segurança e parada automática do posto.</p>",
        "      <div class=\"fase-tags\"><span class=\"fase-tag\">/api/coleta</span><span class=\"fase-tag\">coleta.alerta_critico</span><span class=\"fase-tag\">maquina.parada</span></div>",
        "    </div>",
        "    <div class=\"fase-card\">",
        "      <div class=\"fase-card-top\"><span class=\"fase-num\">Fase 10</span><span class=\"fase-tipo\">Núcleo Interno</span></div>",
        "      <h3>Arquivamento Histórico (tblFin*)</h3>",
        "      <p>Padrão FactoryViews/MES4: separação cirúrgica entre ordens ativas e arquivo permanente (tblFinOrder, tblFinStep), expurgo periódico por retenção e restauração reversível para auditoria.</p>",
        "      <div class=\"fase-tags\"><span class=\"fase-tag\">/api/arquivamento</span><span class=\"fase-tag\">arquivamento.op_arquivada</span></div>",
        "    </div>",
        "  </div>",
        "</section>"
    ], "\n");
}

fn _arquitetura() -> string ={
    return join([
        "<section class=\"section-wrap\" id=\"arquitetura\">",
        "  <div class=\"arch-card\">",
        "    <div class=\"sec-tag\" style=\"color:var(--forja-2)\">Pipeline Nativo Cryo / Pyro</div>",
        "    <h2 class=\"sec-title\" style=\"color:#fff\">Arquitetura de Compilação &amp; Engenharia</h2>",
        "    <p style=\"color:#c3c7cf;font-size:16px\">Como o EMP atinge desempenho nativo sem depender de runtimes externos:</p>",
        "    <div class=\"arch-pipeline\">",
        "      <div class=\"arch-step\"><div class=\"arch-pill\">Código Cryo (.cryo)</div><small style=\"color:#8a909b\">Tipos Estritos &amp; Regras</small></div>",
        "      <div class=\"arch-arrow\">➔</div>",
        "      <div class=\"arch-step\"><div class=\"arch-pill\">Bytecode Pyro (.pyro)</div><small style=\"color:#8a909b\">Validação Semântica</small></div>",
        "      <div class=\"arch-arrow\">➔</div>",
        "      <div class=\"arch-step\"><div class=\"arch-pill\">C AOT (Emissão C)</div><small style=\"color:#8a909b\">Sem Garbage Collector</small></div>",
        "      <div class=\"arch-arrow\">➔</div>",
        "      <div class=\"arch-step\"><div class=\"arch-pill\">MinGW GCC 6.3.0</div><small style=\"color:#8a909b\">Otimização Máquina</small></div>",
        "      <div class=\"arch-arrow\">➔</div>",
        "      <div class=\"arch-step\"><div class=\"arch-pill\" style=\"background:var(--forja);color:#16181d\">Executável .exe</div><small style=\"color:#8a909b\">~1MB Nativo Windows</small></div>",
        "    </div>",
        "    <div class=\"arch-grid\">",
        "      <div class=\"arch-feat\">",
        "        <h4>💎 Design System Forja</h4>",
        "        <p>Tipografia Space Grotesk, Inter e JetBrains Mono. Console grafite #16181d, assinatura laranja #ff5a1f e verde operacional #0f9f6e.</p>",
        "      </div>",
        "      <div class=\"arch-feat\">",
        "        <h4>⚡ Barramento Desacoplado</h4>",
        "        <p>Módulos comunicam-se via eventos pub/sub assíncronos. Um novo módulo pode ser adicionado sem alterar o núcleo ou módulos existentes.</p>",
        "      </div>",
        "      <div class=\"arch-feat\">",
        "        <h4>🛡️ Integridade &amp; Concorrência</h4>",
        "        <p>Controle otimista por versão de etapa de OP (HTTP 409), gravação atômica em disco e isolamento transacional para chão de fábrica.</p>",
        "      </div>",
        "    </div>",
        "  </div>",
        "</section>"
    ], "\n");
}

