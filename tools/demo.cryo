// ============================================================
//  demo.cryo — carga de demonstração do EMP, escrita em Cryo
//
//  Popula um EMP em execução com uma linha de suportes metálicos:
//  matérias-primas, semiacabado, acabados, estrutura (BOM), postos,
//  operações e roteiros, entradas de estoque, ordens em vários
//  estados executadas etapa por etapa, apontamentos, paradas de
//  máquina e — se o plugin estiver no ar — NCs.
//
//  Exige o EMP em MODO DEV (ERP_TOKENS vazio): http_post não envia
//  cabeçalhos, então não há como mandar o token (ESCOPO.md, L-09).
//
//    python ../Burnout/cryoc.py tools/demo.cryo --backend pyro --run
//    EMP_URL=http://127.0.0.1:8080   (padrão)
// ============================================================

string _url = env("EMP_URL");
if (len(_url) == 0) { _url = "http://127.0.0.1:8080"; }

int _falhas = 0;

fn post(string caminho, string corpo) -> string ={
    string r = http_post(_url + caminho, corpo);
    if (len(r) == 0 || starts_with(r, "{\"erro\"")) {
        _falhas = _falhas + 1;
        print("  ! " + caminho + "  " + corpo + "  -> " + r);
    }
    return r;
}

// O id de uma resposta JSON `{"...","id":N,...}`.
fn id_de(string json) -> string ={
    int i = find(json, "\"id\":");
    if (i < 0) { return "0"; }
    string resto = json[i + 5..];
    int fim = find(resto, ",");
    if (fim < 0) { fim = find(resto, "}"); }
    return resto[0..fim];
}

fn produto(string codigo, string descricao, string unidade, string tipo) ={
    post("/api/cadastros/produtos", "codigo=" + codigo + "&descricao=" + url_encode(descricao)
        + "&unidade=" + unidade + "&tipo=" + tipo);
}

fn componente(string pai, string comp, string qtd) ={
    post("/api/cadastros/estrutura", "produto=" + pai + "&componente=" + comp + "&quantidade=" + qtd);
}

fn posto(string codigo, string descricao, string horas) ={
    post("/api/cadastros/postos", "codigo=" + codigo + "&descricao=" + url_encode(descricao)
        + "&capacidade_h=" + horas);
}

fn op(string produto, string qtd, string posto) -> string ={
    return id_de(post("/api/producao/ordens", "produto=" + produto + "&quantidade=" + qtd + "&posto=" + posto));
}

fn liberar(string id) ={ post("/api/producao/liberar?id=" + id, ""); }

fn operacao(string codigo, string descricao, string tipo, string instrucao, string parametros) ={
    post("/api/roteiros/operacoes", "codigo=" + codigo + "&descricao=" + url_encode(descricao)
        + "&tipo=" + tipo + "&instrucao=" + url_encode(instrucao)
        + "&parametros=" + url_encode(parametros));
}

fn etapa_roteiro(string produto, string numero, string oper, string posto, string tempo) ={
    post("/api/roteiros/etapa", "produto=" + produto + "&numero=" + numero + "&operacao=" + oper
        + "&posto=" + posto + "&tempo_min=" + tempo);
}

fn capacidade(string posto, string oper, string tempo) ={
    post("/api/roteiros/capacidade", "posto=" + posto + "&operacao=" + oper + "&tempo_min=" + tempo);
}

// Só os campos de que a carga precisa; o resto do JSON é ignorado.
// json_decode aqui é seguro: o texto vem do próprio EMP (L-05).
struct EtapaVista {
    int numero;
    int versao;
    string status;
}

struct OpVista {
    EtapaVista[] etapas;
    int etapa_atual;
}

fn versao(string op, string numero) -> string ={
    OpVista v = json_decode(http_get(_url + "/api/producao/ordem?id=" + op)) as OpVista;
    for (EtapaVista e in v.etapas) {
        if (to_string(e.numero) == numero) { return to_string(e.versao); }
    }
    return "0";
}

// Uma ação de etapa com a versão atual: iniciar, apontar, concluir, erro, reiniciar, pular.
fn etapa(string op, string numero, string acao, string corpo) ={
    post("/api/producao/etapa/" + acao + "?op=" + op + "&etapa=" + numero,
        "versao=" + versao(op, numero) + "&" + corpo);
}

fn apontar(string id, string boa, string refugo, string operador) ={
    post("/api/producao/apontar?id=" + id, "boa=" + boa + "&refugo=" + refugo + "&operador=" + operador);
}

fn parada(string posto, string categoria, string motivo, string ha_minutos) -> string ={
    return id_de(post("/api/manutencao/paradas", "posto=" + posto + "&categoria=" + categoria
        + "&motivo=" + url_encode(motivo) + "&ha_minutos=" + ha_minutos));
}

print("carga de demonstração em " + _url);
string saude = http_get(_url + "/api/sistema/saude");
if (!contains(saude, "\"status\":\"ok\"")) {
    print("EMP não respondeu (ou exige token). Suba o emp.exe em modo dev e tente de novo.");
} else {
    print("- cadastros");
    produto("ACO-CH2",  "Chapa de aço 2 mm",        "KG", "MP");
    produto("PARAF-M6", "Parafuso M6 x 20",         "UN", "MP");
    produto("TINTA-PO", "Tinta epóxi em pó",        "KG", "MP");
    produto("BUCHA-08", "Bucha de nylon 8 mm",      "UN", "MP");
    produto("BASE-SUP", "Base estampada do suporte", "UN", "SA");
    produto("SUP-01",   "Suporte de parede simples", "UN", "PA");
    produto("SUP-02",   "Suporte de parede reforçado", "UN", "PA");

    componente("BASE-SUP", "ACO-CH2", "0.65");
    componente("SUP-01", "BASE-SUP", "1");
    componente("SUP-01", "PARAF-M6", "2");
    componente("SUP-01", "TINTA-PO", "0.03");
    componente("SUP-02", "ACO-CH2", "1.4");
    componente("SUP-02", "PARAF-M6", "4");
    componente("SUP-02", "BUCHA-08", "4");
    componente("SUP-02", "TINTA-PO", "0.05");

    posto("PRENSA-01",  "Prensa excêntrica 80 t", "16");
    posto("PRENSA-02",  "Prensa hidráulica 120 t", "16");
    posto("SOLDA-01",   "Célula de solda robotizada", "16");
    posto("PINTURA-01", "Cabine de pintura a pó", "8");
    posto("MONT-01",    "Bancada de montagem", "8");

    print("- operações e roteiros");
    operacao("ESTAMPAR", "Estampar base", "AUTOMATICA", "Conferir a matriz e o lote da chapa antes de iniciar",
        "espessura:mm:1.9:2.1");
    operacao("SOLDAR", "Soldar reforço", "AUTOMATICA", "Programa 12 do robô; conferir o arame",
        "corrente:A:180:220");
    operacao("PINTAR", "Pintura a pó", "MANUAL", "Pendurar as peças com 10 cm de folga; cura 20 min a 200 °C",
        "camada:um:60:90");
    operacao("MONTAR", "Montar e embalar", "MANUAL", "4 parafusos M6 e 4 buchas por suporte; torque 10 N.m",
        "torque:N.m:8:12");
    capacidade("PRENSA-01", "ESTAMPAR", "0.05");
    capacidade("PRENSA-02", "ESTAMPAR", "0.04");
    capacidade("SOLDA-01", "SOLDAR", "0.5");
    capacidade("PINTURA-01", "PINTAR", "0.3");
    capacidade("MONT-01", "MONTAR", "0.4");
    etapa_roteiro("BASE-SUP", "10", "ESTAMPAR", "PRENSA-01", "0");    // tempo da capacidade
    etapa_roteiro("SUP-02", "10", "ESTAMPAR", "PRENSA-02", "0.08");
    etapa_roteiro("SUP-02", "20", "SOLDAR", "SOLDA-01", "0");
    etapa_roteiro("SUP-02", "30", "PINTAR", "PINTURA-01", "0");
    etapa_roteiro("SUP-02", "40", "MONTAR", "MONT-01", "0");
    // SUP-01 fica sem roteiro: a OP recebe a etapa única APONTAMENTO.

    print("- estoque inicial");
    post("/api/estoque/entrada", "produto=ACO-CH2&quantidade=900&origem=NF+48213+Usiminas");
    post("/api/estoque/entrada", "produto=PARAF-M6&quantidade=6000&origem=NF+10377+Ciser");
    post("/api/estoque/entrada", "produto=TINTA-PO&quantidade=60&origem=NF+2201+WEG+Tintas");
    post("/api/estoque/entrada", "produto=BUCHA-08&quantidade=1500&origem=NF+10377+Ciser");

    print("- ordens de produção, etapas e apontamentos");
    string op1 = op("BASE-SUP", "400", "PRENSA-01");
    liberar(op1);
    apontar(op1, "180", "4", "joao");
    apontar(op1, "160", "3", "marcos");

    string op2 = op("SUP-01", "250", "MONT-01");
    liberar(op2);
    apontar(op2, "150", "2", "ana");
    apontar(op2, "100", "1", "ana");          // conclui a OP

    // SUP-02 passa por 4 postos. A OP 3 fica na solda; a OP 4 vai até o fim.
    string op3 = op("SUP-02", "200", "PRENSA-02");
    liberar(op3);
    etapa(op3, "10", "iniciar", "operador=joao");
    etapa(op3, "10", "apontar", "boas=192&refugo=8&operador=joao&medicoes=espessura%3D2.02");  // conclui
    etapa(op3, "20", "iniciar", "operador=rui");
    etapa(op3, "20", "apontar", "boas=120&refugo=2&operador=rui&medicoes=corrente%3D204");

    string op4 = op("SUP-02", "120", "PRENSA-02");
    liberar(op4);
    etapa(op4, "10", "iniciar", "operador=joao");
    etapa(op4, "10", "apontar", "boas=118&refugo=2&operador=joao&medicoes=espessura%3D1.98");
    etapa(op4, "20", "iniciar", "operador=rui");
    etapa(op4, "20", "apontar", "boas=118&operador=rui");
    etapa(op4, "30", "iniciar", "operador=bia");
    etapa(op4, "30", "apontar", "boas=50&operador=bia&medicoes=camada%3D72");
    etapa(op4, "30", "erro", "operador=bia&motivo=" + url_encode("Pistola entupida"));
    etapa(op4, "30", "reiniciar", "");
    etapa(op4, "30", "iniciar", "operador=bia");
    etapa(op4, "30", "apontar", "boas=60&refugo=8&operador=bia&medicoes=camada%3D95");  // fora do limite
    etapa(op4, "40", "iniciar", "operador=ana");
    // Última etapa: soma em produzido e publica producao.apontada com o
    // refugo das etapas anteriores (10 de 120 -> NC automática no plugin).
    etapa(op4, "40", "apontar", "boas=110&operador=ana&medicoes=torque%3D10");

    // Versão velha: alguém viu a etapa antes da última ação.
    string velha = http_post(_url + "/api/producao/etapa/apontar?op=" + op3 + "&etapa=20",
        "versao=1&boas=1&operador=rui");
    print("  apontar com versão velha -> " + velha[0..min(len(velha), 60)]);

    string op5 = op("SUP-01", "300", "PINTURA-01");
    string op6 = op("BASE-SUP", "600", "PRENSA-01");
    liberar(op6);                             // falta de aço -> estoque.falta

    print("- manutenção");
    string p1 = parada("PRENSA-02", "SETUP", "Troca de matriz para SUP-02", "95");
    post("/api/manutencao/encerrar?id=" + p1, "solucao=" + url_encode("Matriz 02 montada e aferida"));
    string p2 = parada("PINTURA-01", "MECANICA", "Esteira travada no forno de cura", "160");
    post("/api/manutencao/encerrar?id=" + p2, "solucao=" + url_encode("Corrente da esteira substituída"));
    parada("SOLDA-01", "ELETRICA", "Disjuntor do robô desarmou", "42");

    // A produção recusa apontar num posto parado (evento maquina.parada):
    // a OP 3 está na etapa 20, na SOLDA-01.
    string bloqueado = http_post(_url + "/api/producao/apontar?id=" + op3, "boa=5");
    print("  apontar na SOLDA-01 parada -> " + bloqueado);

    if (contains(http_get(_url + "/api/sistema/modulos"), "\"id\":\"qualidade\"")) {
        print("- qualidade");
        post("/api/qualidade/ncs", "op=" + op1 + "&produto=BASE-SUP&motivo=" + url_encode("Rebarba acima de 0,3 mm na estampagem"));
    }

    print("feito: " + to_string(_falhas) + " falha(s)");
}
